<?xml version="1.0" encoding="UTF-8"?><ncx version="2005-1" xmlns="http://www.daisy.org/z3986/2005/ncx/"><head><meta name="dtb:uid" content="urn:uuid:9f6ea653-c7b4-5f72-9a0f-6e47afc9a66d"/><meta name="dtb:depth" content="2"/></head><docTitle><text>Votre identité dans un téléphone</text></docTitle><navMap><navPoint id="navPoint-1" playOrder="1"><navLabel><text>Introduction</text></navLabel><content src="text/ch001.xhtml"/><navPoint id="navPoint-2" playOrder="2"><navLabel><text>Le fil de l’enquête</text></navLabel><content src="text/ch001.xhtml#fil-enquete"/></navPoint></navPoint><navPoint id="navPoint-3" playOrder="3"><navLabel><text>Volet 1 : La carte d’identité qui devient un service</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="navPoint-4" playOrder="4"><navLabel><text>À retenir</text></navLabel><content src="text/ch002.xhtml#c1-à-retenir"/></navPoint><navPoint id="navPoint-5" playOrder="5"><navLabel><text>Ce que France Identité permet à l’aéroport</text></navLabel><content src="text/ch002.xhtml#c1-ce-que-france-identité-permet-à-laéroport"/></navPoint><navPoint id="navPoint-6" playOrder="6"><navLabel><text>Une carte en plastique se montre. Une identité numérique s’exécute.</text></navLabel><content src="text/ch002.xhtml#c1-une-carte-en-plastique-se-montre-une-identité-numérique-sexécute"/></navPoint><navPoint id="navPoint-7" playOrder="7"><navLabel><text>Les trois étages du dispositif</text></navLabel><content src="text/ch002.xhtml#c1-les-trois-étages-du-dispositif"/></navPoint><navPoint id="navPoint-8" playOrder="8"><navLabel><text>Ce que mesure le compteur d’utilisateurs</text></navLabel><content src="text/ch002.xhtml#c1-ce-que-mesure-le-compteur-dutilisateurs"/></navPoint><navPoint id="navPoint-9" playOrder="9"><navLabel><text>Le premier bénéfice concret : montrer moins</text></navLabel><content src="text/ch002.xhtml#c1-le-premier-bénéfice-concret--montrer-moins"/></navPoint><navPoint id="navPoint-10" playOrder="10"><navLabel><text>Le parcour