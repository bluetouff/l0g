 l’enquête</text></navLabel><content src="text/ch009.xhtml#c8-les-huit-volets-de-lenquête"/></navPoint><navPoint id="nav-83" playOrder="83"><navLabel><text>Méthode et limites de l’enquête</text></navLabel><content src="text/ch009.xhtml#c8-méthode-et-limites-de-lenquête"/></navPoint><navPoint id="nav-84" playOrder="84"><navLabel><text>Sources documentaires</text></navLabel><content src="text/ch009.xhtml#c8-sources-documentaires"/></navPoint></navPoint><navPoint id="nav-85" playOrder="85"><navLabel><text>Rendre la reprise vérifiable</text></navLabel><content src="text/conclusion.xhtml"/></navPoint><navPoint id="nav-86" playOrder="86"><navLabel><text>Vingt et une notions pour suivre la reprise</text></navLabel><content src="text/glossary.xhtml"/></navPoint><navPoint id="nav-87" playOrder="87"><navLabel><text>Pièces de référence pour la synthèse</text></navLabel><content src="text/synthesis-sources.xhtml"/></navPoint><navPoint id="nav-88" playOrder="88"><navLabel><text>Table des infographies</text></navLabel><content src="text/figures.xhtml"/></navPoint><navPoint id="nav-89" playOrder="89"><navLabel><text>Édition et droits</text></navLabel><content src="text/colophon.xhtml"/></navPoint><navPoint id="nav-90" playOrder="90"><navLabel><text>Droits et licences</text></navLabel><content src="text/licenses.xhtml"/></navPoint></navMap></ncx>