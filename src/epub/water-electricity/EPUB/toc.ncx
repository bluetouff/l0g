<?xml version="1.0" encoding="UTF-8"?><ncx version="2005-1" xmlns="http://www.daisy.org/z3986/2005/ncx/"><head><meta name="dtb:uid" content="urn:uuid:77d620a4-f0f7-5a23-8e39-b0118442ec62"/><meta name="dtb:depth" content="2"/></head><docTitle><text>The Water Behind Electricity</text></docTitle><navMap><navPoint id="navPoint-1" playOrder="1"><navLabel><text>Introduction</text></navLabel><content src="text/ch001.xhtml"/><navPoint id="navPoint-2" playOrder="2"><navLabel><text>How to read this edition</text></navLabel><content src="text/ch001.xhtml#reading-guide"/></navPoint></navPoint><navPoint id="navPoint-3" playOrder="3"><navLabel><text>How much is one centimetre of Danube worth?</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="navPoint-4" playOrder="4"><navLabel><text>The river was not empty</text></navLabel><content src="text/ch002.xhtml#c1-the-river-was-not-empty"/></navPoint><navPoint id="navPoint-5" playOrder="5"><navLabel><text>Three days to lose three-quarters of Paks</text></navLabel><content src="text/ch002.xhtml#c1-three-days-to-lose-three-quarters-of-paks"/></navPoint><navPoint id="navPoint-6" playOrder="6"><navLabel><text>Blasting rock to buy days</text></navLabel><content src="text/ch002.xhtml#c1-blasting-rock-to-buy-days"/></navPoint><navPoint id="navPoint-7" playOrder="7"><navLabel><text>Price your own scenario</text></navLabel><content src="text/ch002.xhtml#c1-price-your-own-scenario"/></navPoint><navPoint id="navPoint-8" playOrder="8"><navLabel><text>One river, several competing power stations</text></navLabel><content src="text/ch002.xhtml#c1-one-river-several-competing-power-stations"/></navPoint><navPoint id="navPoint-9" playOrder="9"><navLabel><text>Kozloduy did not read the same river</text></navLabel><content src="text/ch002.xhtml#c1-kozloduy-did-not-read-the-same-river"/></navPoint><navPoint id="navPoint-10" playOrder="10"><navLabel><text>The grid prevented failure, not the bill</text></navLabel><content src="text/ch002.xhtml#c1-the-grid-prevented-failure-not-the-bill"/></navPoint><navPoint id="navPoint-11" playOrder="11"><navLabel><text>Repair the river or adapt the plants</text></navLabel><content src="text/ch002.xhtml#c1-repair-the-river-or-adapt-the-plants"/></navPoint></navPoint><navPoint id="navPoint-12" playOrder="12"><navLabel><text>The wet megawatt Europe cannot count</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="navPoint-13" playOrder="13"><navLabel><text>The simplest question still has no answer</text></navLabel><content src="text/ch003.xhtml#c2-the-simplest-question-still-has-no-answer"/></navPoint><navPoint id="navPoint-14" playOrder="14"><navLabel><text>An old database already contained the right columns</text></navLabel><content src="text/ch003.xhtml#c2-an-old-database-already-contained-the-right-columns"/></navPoint><navPoint id="navPoint-15" playOrder="15"><navLabel><text>A 294.3 GW floor</text></navLabel><content src="text/ch003.xhtml#c2-a-2943-gw-floor"/></navPoint><navPoint id="navPoint-16" playOrder="16"><navLabel><text>Test the perimeter</text></navLabel><content src="text/ch003.xhtml#c2-test-the-perimeter"/></navPoint><navPoint id="navPoint-17" playOrder="17"><navLabel><text>Abstraction is not consumption</text></navLabel><content src="text/ch003.xhtml#c2-abstraction-is-not-consumption"/></navPoint><navPoint id="navPoint-18" playOrder="18"><navLabel><text>Water is not one risk</text></navLabel><content src="text/ch003.xhtml#c2-water-is-not-one-risk"/></navPoint><navPoint id="navPoint-19" playOrder="19"><navLabel><text>Hydropower contains four different machines</text></navLabel><content src="text/ch003.xhtml#c2-hydropower-contains-four-different-machines"/></navPoint><navPoint id="navPoint-20" playOrder="20"><navLabel><text>The threshold turns dependence into an observed loss</text></navLabel><content src="text/ch003.xhtml#c2-the-threshold-turns-dependence-into-an-observed-loss"/></navPoint><navPoint id="navPoint-21" playOrder="21"><navLabel><text>A database organised around evidence, not a score</text></navLabel><content src="text/ch003.xhtml#c2-a-database-organised-around-evidence-not-a-score"/></navPoint><navPoint id="navPoint-22" playOrder="22"><navLabel><text>Four indicators, four questions</text></navLabel><content src="text/ch003.xhtml#c2-four-indicators-four-questions"/></navPoint><navPoint id="navPoint-23" playOrder="23"><navLabel><text>The first number must never become a prophecy</text></navLabel><content src="text/ch003.xhtml#c2-the-first-number-must-never-become-a-prophecy"/></navPoint></navPoint><navPoint id="navPoint-24" playOrder="24"><navLabel><text>The extra degree</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="navPoint-25" playOrder="25"><navLabel><text>Three steps for the same Rhône</text></navLabel><content src="text/ch004.xhtml#c3-three-steps-for-the-same-rhône"/></navPoint><navPoint id="navPoint-26" playOrder="26"><navLabel><text>A degree in the river is not a degree of reactor safety</text></navLabel><content src="text/ch004.xhtml#c3-a-degree-in-the-river-is-not-a-degree-of-reactor-safety"/></navPoint><navPoint id="navPoint-27" playOrder="27"><navLabel><text>One site, two thermal signatures</text></navLabel><content src="text/ch004.xhtml#c3-one-site-two-thermal-signatures"/></navPoint><navPoint id="navPoint-28" playOrder="28"><navLabel><text>RTE asks, the ministry confirms, ASNR decides</text></navLabel><content src="text/ch004.xhtml#c3-rte-asks-the-ministry-confirms-asnr-decides"/></navPoint><navPoint id="navPoint-29" playOrder="29"><navLabel><text>Comfortable national adequacy can coexist with a local request</text></navLabel><content src="text/ch004.xhtml#c3-comfortable-national-adequacy-can-coexist-with-a-local-request"/></navPoint><navPoint id="navPoint-30" playOrder="30"><navLabel><text>Summer 2026 did not apply one national rule</text></navLabel><content src="text/ch004.xhtml#c3-summer-2026-did-not-apply-one-national-rule"/></navPoint><navPoint id="navPoint-31" playOrder="31"><navLabel><text>Test the published rule</text></navLabel><content src="text/ch004.xhtml#c3-test-the-published-rule"/></navPoint><navPoint id="navPoint-32" playOrder="32"><navLabel><text>The grid decides quickly; the ecosystem answers slowly</text></navLabel><content src="text/ch004.xhtml#c3-the-grid-decides-quickly-the-ecosystem-answers-slowly"/></navPoint><navPoint id="navPoint-33" playOrder="33"><navLabel><text>The 2022 evidence is reassuring without closing the issue</text></navLabel><content src="text/ch004.xhtml#c3-the-2022-evidence-is-reassuring-without-closing-the-issue"/></navPoint><navPoint id="navPoint-34" playOrder="34"><navLabel><text>A rare decision, and governance that needs clearer evidence</text></navLabel><content src="text/ch004.xhtml#c3-a-rare-decision-and-governance-that-needs-clearer-evidence"/></navPoint></navPoint><navPoint id="navPoint-35" playOrder="35"><navLabel><text>The dam that chooses not to generate</text></navLabel><content src="text/ch005.xhtml"/><navPoint id="navPoint-36" playOrder="36"><navLabel><text>Switzerland buys an absence of generation</text></navLabel><content src="text/ch005.xhtml#c4-switzerland-buys-an-absence-of-generation"/></navPoint><navPoint id="navPoint-37" playOrder="37"><navLabel><text>One technology, three clocks</text></navLabel><content src="text/ch005.xhtml#c4-one-technology-three-clocks"/></navPoint><navPoint id="navPoint-38" playOrder="38"><navLabel><text>The minimum price at which a drop agrees to fall</text></navLabel><content src="text/ch005.xhtml#c4-the-minimum-price-at-which-a-drop-agrees-to-fall"/></navPoint><navPoint id="navPoint-39" playOrder="39"><navLabel><text>Importing wind to preserve rain</text></navLabel><content src="text/ch005.xhtml#c4-importing-wind-to-preserve-rain"/></navPoint><navPoint id="navPoint-40" playOrder="40"><navLabel><text>Solar does not refill a reservoir</text></navLabel><content src="text/ch005.xhtml#c4-solar-does-not-refill-a-reservoir"/></navPoint><navPoint id="navPoint-41" playOrder="41"><navLabel><text>One TWh does not always mean the same TWh</text></navLabel><content src="text/ch005.xhtml#c4-one-twh-does-not-always-mean-the-same-twh"/></navPoint><navPoint id="navPoint-42" playOrder="42"><navLabel><text>The market is not alone at the gate</text></navLabel><content src="text/ch005.xhtml#c4-the-market-is-not-alone-at-the-gate"/></navPoint><navPoint id="navPoint-43" playOrder="43"><navLabel><text>Eight fields missing from Europe&apos;s stock figures</text></navLabel><content src="text/ch005.xhtml#c4-eight-fields-missing-from-europes-stock-figures"/></navPoint><navPoint id="navPoint-44" playOrder="44"><navLabel><text>The most valuable service may be the missing megawatt-hour</text></navLabel><content src="text/ch005.xhtml#c4-the-most-valuable-service-may-be-the-missing-megawatt-hour"/></navPoint></navPoint><navPoint id="navPoint-45" playOrder="45"><navLabel><text>The model, the pump and the price of adequacy</text></navLabel><content src="text/ch006.xhtml"/><navPoint id="navPoint-46" playOrder="46"><navLabel><text>The model never promised that every plant would operate</text></navLabel><content src="text/ch006.xhtml#c5-the-model-never-promised-that-every-plant-would-operate"/></navPoint><navPoint id="navPoint-47" playOrder="47"><navLabel><text>The model already sees heat and drought</text></navLabel><content src="text/ch006.xhtml#c5-the-model-already-sees-heat-and-drought"/></navPoint><navPoint id="navPoint-48" playOrder="48"><navLabel><text>The Danube created a compound shock</text></navLabel><content src="text/ch006.xhtml#c5-the-danube-created-a-compound-shock"/></navPoint><navPoint id="navPoint-49" playOrder="49"><navLabel><text>National comments knew more than the continental headline</text></navLabel><content src="text/ch006.xhtml#c5-national-comments-knew-more-than-the-continental-headline"/></navPoint><navPoint id="navPoint-50" playOrder="50"><navLabel><text>The May verdict survived August</text></navLabel><content src="text/ch006.xhtml#c5-the-may-verdict-survived-august"/></navPoint><navPoint id="navPoint-51" playOrder="51"><navLabel><text>Test the difference between a zone and a sub-region</text></navLabel><content src="text/ch006.xhtml#c5-test-the-difference-between-a-zone-and-a-sub-region"/></navPoint><navPoint id="navPoint-52" playOrder="52"><navLabel><text>Being right can be expensive</text></navLabel><content src="text/ch006.xhtml#c5-being-right-can-be-expensive"/></navPoint><navPoint id="navPoint-53" playOrder="53"><navLabel><text>The seven-day safety net works, but its method is unfinished</text></navLabel><content src="text/ch006.xhtml#c5-the-seven-day-safety-net-works-but-its-method-is-unfinished"/></navPoint><navPoint id="navPoint-54" playOrder="54"><navLabel><text>A model can be right and still under-inform</text></navLabel><content src="text/ch006.xhtml#c5-a-model-can-be-right-and-still-under-inform"/></navPoint></navPoint><navPoint id="navPoint-55" playOrder="55"><navLabel><text>The price of cooling</text></navLabel><content src="text/ch007.xhtml"/><navPoint id="navPoint-56" playOrder="56"><navLabel><text>Six billion forints for a few centimetres</text></navLabel><content src="text/ch007.xhtml#c6-six-billion-forints-for-a-few-centimetres"/></navPoint><navPoint id="navPoint-57" playOrder="57"><navLabel><text>Four timelines, four bills</text></navLabel><content src="text/ch007.xhtml#c6-four-timelines-four-bills"/></navPoint><navPoint id="navPoint-58" playOrder="58"><navLabel><text>A cooling tower trades river withdrawals for evaporation</text></navLabel><content src="text/ch007.xhtml#c6-a-cooling-tower-trades-river-withdrawals-for-evaporation"/></navPoint><navPoint id="navPoint-59" playOrder="59"><navLabel><text>Air buys water independence with efficiency</text></navLabel><content src="text/ch007.xhtml#c6-air-buys-water-independence-with-efficiency"/></navPoint><navPoint id="navPoint-60" playOrder="60"><navLabel><text>Reclaimed water builds a second plant</text></navLabel><content src="text/ch007.xhtml#c6-reclaimed-water-builds-a-second-plant"/></navPoint><navPoint id="navPoint-61" playOrder="61"><navLabel><text>Seawater shifts the constraint to the coast</text></navLabel><content src="text/ch007.xhtml#c6-seawater-shifts-the-constraint-to-the-coast"/></navPoint><navPoint id="navPoint-62" playOrder="62"><navLabel><text>Newbuild chooses; existing assets negotiate</text></navLabel><content src="text/ch007.xhtml#c6-newbuild-chooses-existing-assets-negotiate"/></navPoint><navPoint id="navPoint-63" playOrder="63"><navLabel><text>Test an adaptation quote</text></navLabel><content src="text/ch007.xhtml#c6-test-an-adaptation-quote"/></navPoint><navPoint id="navPoint-64" playOrder="64"><navLabel><text>Secured megawatts as the denominator</text></navLabel><content src="text/ch007.xhtml#c6-secured-megawatts-as-the-denominator"/></navPoint><navPoint id="navPoint-65" playOrder="65"><navLabel><text>The adaptation portfolio</text></navLabel><content src="text/ch007.xhtml#c6-the-adaptation-portfolio"/></navPoint></navPoint><navPoint id="navPoint-66" playOrder="66"><navLabel><text>Conclusion</text></navLabel><content src="text/ch008.xhtml"/></navPoint><navPoint id="navPoint-67" playOrder="67"><navLabel><text>About this edition</text></navLabel><content src="text/ch009.xhtml"/></navPoint></navMap></ncx>
