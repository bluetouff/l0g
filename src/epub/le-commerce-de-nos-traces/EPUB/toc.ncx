<?xml version="1.0" encoding="UTF-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="fr"><head><meta name="dtb:uid" content="urn:uuid:780a986f-3bd0-4c27-8b95-e61fb1dc9872"/><meta name="dtb:depth" content="2"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>Le commerce de nos traces</text></docTitle><navMap><navPoint id="nav-1" playOrder="1"><navLabel><text>Introduction : Une seconde vie dans les fichiers</text></navLabel><content src="text/ch001.xhtml"/></navPoint><navPoint id="nav-2" playOrder="2"><navLabel><text>1. L’économie de la collecte</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="nav-3" playOrder="3"><navLabel><text>L’application apporte l’accès</text></navLabel><content src="text/ch002.xhtml#c1-lapplication-apporte-laccès"/></navPoint><navPoint id="nav-4" playOrder="4"><navLabel><text>Le clic autorise un accès, pas toutes les finalités</text></navLabel><content src="text/ch002.xhtml#c1-le-clic-autorise-un-accès-pas-toutes-les-finalités"/></navPoint><navPoint id="nav-5" playOrder="5"><navLabel><text>Dans le contrat Life360, les paiements vont dans les deux sens</text></navLabel><content src="text/ch002.xhtml#c1-dans-le-contrat-life360-les-paiements-vont-dans-les-deux-sens"/></navPoint><navPoint id="nav-6" playOrder="6"><navLabel><text>Une ligne de revenus, pas un prix par personne</text></navLabel><content src="text/ch002.xhtml#c1-une-ligne-de-revenus-pas-un-prix-par-personne"/></navPoint><navPoint id="nav-7" playOrder="7"><navLabel><text>Des données peuvent sortir d’une enchère perdue</text></navLabel><content src="text/ch002.xhtml#c1-des-données-peuvent-sortir-dune-enchère-perdue"/></navPoint><navPoint id="nav-8" playOrder="8"><navLabel><text>Chez Mobius, le réemploi dépasse la prestation</text></navLabel><content src="text/ch002.xhtml#c1-chez-mobius-le-réemploi-dépasse-la-prestation"/></navPoint><navPoint id="nav-9" playOrder="9"><navLabel><text>La valeur commence avec un usage supplémentaire</text></navLabel><content src="text/ch002.xhtml#c1-la-valeur-commence-avec-un-usage-supplémentaire"/></navPoint><navPoint id="nav-10" playOrder="10"><navLabel><text>Sources et méthode</text></navLabel><content src="text/ch002.xhtml#c1-sources-et-méthode"/></navPoint></navPoint><navPoint id="nav-11" playOrder="11"><navLabel><text>2. La chaîne des intermédiaires</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="nav-12" playOrder="12"><navLabel><text>Une commande fait intervenir plusieurs métiers</text></navLabel><content src="text/ch003.xhtml#c2-une-commande-fait-intervenir-plusieurs-métiers"/></navPoint><navPoint id="nav-13" playOrder="13"><navLabel><text>Ajouter une information ou raccorder un identifiant</text></navLabel><content src="text/ch003.xhtml#c2-ajouter-une-information-ou-raccorder-un-identifiant"/></navPoint><navPoint id="nav-14" playOrder="14"><navLabel><text>Une destination proposée n’autorise pas tous les usages</text></navLabel><content src="text/ch003.xhtml#c2-une-destination-proposée-nautorise-pas-tous-les-usages"/></navPoint><navPoint id="nav-15" playOrder="15"><navLabel><text>La chaîne publicitaire ne recense pas tous les destinataires</text></navLabel><content src="text/ch003.xhtml#c2-la-chaîne-publicitaire-ne-recense-pas-tous-les-destinataires"/></navPoint><navPoint id="nav-16" playOrder="16"><navLabel><text>Chez Gravy, les fournisseurs ne sont pas tous nommés</text></navLabel><content src="text/ch003.xhtml#c2-chez-gravy-les-fournisseurs-ne-sont-pas-tous-nommés"/></navPoint><navPoint id="nav-17" playOrder="17"><navLabel><text>Les comptes révèlent le métier d’intermédiaire</text></navLabel><content src="text/ch003.xhtml#c2-les-comptes-révèlent-le-métier-dintermédiaire"/></navPoint><navPoint id="nav-18" playOrder="18"><navLabel><text>Deezer et Mobius : la limite de la prestation</text></navLabel><content src="text/ch003.xhtml#c2-deezer-et-mobius--la-limite-de-la-prestation"/></navPoint><navPoint id="nav-19" playOrder="19"><navLabel><text>Relier les acteurs, préciser les relations</text></navLabel><content src="text/ch003.xhtml#c2-relier-les-acteurs-préciser-les-relations"/></navPoint><navPoint id="nav-20" playOrder="20"><navLabel><text>Sources et documents</text></navLabel><content src="text/ch003.xhtml#traces02-fr-sources"/></navPoint></navPoint><navPoint id="nav-21" playOrder="21"><navLabel><text>3. La fabrication des profils</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="nav-22" playOrder="22"><navLabel><text>Donner un sens commercial à un événement</text></navLabel><content src="text/ch004.xhtml#c3-donner-un-sens-commercial-à-un-événement"/></navPoint><navPoint id="nav-23" playOrder="23"><navLabel><text>Le nom du segment efface facilement les étapes du raisonnement</text></navLabel><content src="text/ch004.xhtml#c3-le-nom-du-segment-efface-facilement-les-étapes-du-raisonnement"/></navPoint><navPoint id="nav-24" playOrder="24"><navLabel><text>Agrandir une audience change parfois sa nature</text></navLabel><content src="text/ch004.xhtml#c3-agrandir-une-audience-change-parfois-sa-nature"/></navPoint><navPoint id="nav-25" playOrder="25"><navLabel><text>Transformer une sélection en référence de catalogue</text></navLabel><content src="text/ch004.xhtml#c3-transformer-une-sélection-en-référence-de-catalogue"/></navPoint><navPoint id="nav-26" playOrder="26"><navLabel><text>Une facture à l’usage, pas un tarif par personne</text></navLabel><content src="text/ch004.xhtml#c3-une-facture-à-lusage-pas-un-tarif-par-personne"/></navPoint><navPoint id="nav-27" playOrder="27"><navLabel><text>Un classement correct à 89 % peut produire une mauvaise liste</text></navLabel><content src="text/ch004.xhtml#c3-un-classement-correct-à-89--peut-produire-une-mauvaise-liste"/></navPoint><navPoint id="nav-28" playOrder="28"><navLabel><text>Les essais de terrain imposent un point de comparaison</text></navLabel><content src="text/ch004.xhtml#c3-les-essais-de-terrain-imposent-un-point-de-comparaison"/></navPoint><navPoint id="nav-29" playOrder="29"><navLabel><text>Une étiquette transparente ne certifie pas la vérité du profil</text></navLabel><content src="text/ch004.xhtml#c3-une-étiquette-transparente-ne-certifie-pas-la-vérité-du-profil"/></navPoint><navPoint id="nav-30" playOrder="30"><navLabel><text>Le profil reste une information sur quelqu’un</text></navLabel><content src="text/ch004.xhtml#c3-le-profil-reste-une-information-sur-quelquun"/></navPoint></navPoint><navPoint id="nav-31" playOrder="31"><navLabel><text>4. Les acheteurs et leurs contrats</text></navLabel><content src="text/ch005.xhtml"/><navPoint id="nav-32" playOrder="32"><navLabel><text>GM vendait des données à ceux qui vendent des notes</text></navLabel><content src="text/ch005.xhtml#c4-gm-vendait-des-données-à-ceux-qui-vendent-des-notes"/></navPoint><navPoint id="nav-33" playOrder="33"><navLabel><text>Le client suivant ne s’invente pas</text></navLabel><content src="text/ch005.xhtml#c4-le-client-suivant-ne-sinvente-pas"/></navPoint><navPoint id="nav-34" playOrder="34"><navLabel><text>Omnicom : acheter aussi le droit de revendre</text></navLabel><content src="text/ch005.xhtml#c4-omnicom--acheter-aussi-le-droit-de-revendre"/></navPoint><navPoint id="nav-35" playOrder="35"><navLabel><text>Pour les douanes, la facture commence chez un revendeur</text></navLabel><content src="text/ch005.xhtml#c4-pour-les-douanes-la-facture-commence-chez-un-revendeur"/></navPoint><navPoint id="nav-36" playOrder="36"><navLabel><text>Les journaux enregistrent les requêtes</text></navLabel><content src="text/ch005.xhtml#c4-les-journaux-enregistrent-les-requêtes"/></navPoint><navPoint id="nav-37" playOrder="37"><navLabel><text>Les CDC ont acheté des statistiques de mobilité</text></navLabel><content src="text/ch005.xhtml#c4-les-cdc-ont-acheté-des-statistiques-de-mobilité"/></navPoint><navPoint id="nav-38" playOrder="38"><navLabel><text>Le prix porte sur un périmètre</text></navLabel><content src="text/ch005.xhtml#c4-le-prix-porte-sur-un-périmètre"/></navPoint><navPoint id="nav-39" playOrder="39"><navLabel><text>Documents et périmètre de l’enquête</text></navLabel><content src="text/ch005.xhtml#c4-documents-et-périmètre-de-lenquête"/></navPoint><navPoint id="nav-40" playOrder="40"><navLabel><text>Sources</text></navLabel><content src="text/ch005.xhtml#c4-sources"/></navPoint></navPoint><navPoint id="nav-41" playOrder="41"><navLabel><text>5. La vie des copies après le contrat</text></navLabel><content src="text/ch006.xhtml"/><navPoint id="nav-42" playOrder="42"><navLabel><text>Chez Mobius, le fichier de test avait sa propre durée de vie</text></navLabel><content src="text/ch006.xhtml#c5-chez-mobius-le-fichier-de-test-avait-sa-propre-durée-de-vie"/></navPoint><navPoint id="nav-43" playOrder="43"><navLabel><text>La fin du contrat laisse des obligations à exécuter</text></navLabel><content src="text/ch006.xhtml#c5-la-fin-du-contrat-laisse-des-obligations-à-exécuter"/></navPoint><navPoint id="nav-44" playOrder="44"><navLabel><text>Les sauvegardes ont leur calendrier</text></navLabel><content src="text/ch006.xhtml#c5-les-sauvegardes-ont-leur-calendrier"/></navPoint><navPoint id="nav-45" playOrder="45"><navLabel><text>Dans la publicité, couper le flux peut arrêter les retraits</text></navLabel><content src="text/ch006.xhtml#c5-dans-la-publicité-couper-le-flux-peut-arrêter-les-retraits"/></navPoint><navPoint id="nav-46" playOrder="46"><navLabel><text>Une copie à retirer, une réimportation à empêcher</text></navLabel><content src="text/ch006.xhtml#c5-une-copie-à-retirer-une-réimportation-à-empêcher"/></navPoint><navPoint id="nav-47" playOrder="47"><navLabel><text>Les produits dérivés ont aussi une fin de vie</text></navLabel><content src="text/ch006.xhtml#c5-les-produits-dérivés-ont-aussi-une-fin-de-vie"/></navPoint><navPoint id="nav-48" playOrder="48"><navLabel><text>Avast doit effacer chez lui et écrire aux destinataires</text></navLabel><content src="text/ch006.xhtml#c5-avast-doit-effacer-chez-lui-et-écrire-aux-destinataires"/></navPoint><navPoint id="nav-49" playOrder="49"><navLabel><text>Connaître les destinataires avant de fermer la porte</text></navLabel><content src="text/ch006.xhtml#c5-connaître-les-destinataires-avant-de-fermer-la-porte"/></navPoint><navPoint id="nav-50" playOrder="50"><navLabel><text>Le coût de sortie appartient au prix du service</text></navLabel><content src="text/ch006.xhtml#c5-le-coût-de-sortie-appartient-au-prix-du-service"/></navPoint></navPoint><navPoint id="nav-51" playOrder="51"><navLabel><text>6. Le prix des règles</text></navLabel><content src="text/ch007.xhtml"/><navPoint id="nav-52" playOrder="52"><navLabel><text>Quatre effets économiques à distinguer</text></navLabel><content src="text/ch007.xhtml#c6-quatre-effets-économiques-à-distinguer"/></navPoint><navPoint id="nav-53" playOrder="53"><navLabel><text>Mobius : une amende connue, des revenus occultés</text></navLabel><content src="text/ch007.xhtml#c6-mobius--une-amende-connue-des-revenus-occultés"/></navPoint><navPoint id="nav-54" playOrder="54"><navLabel><text>Les restrictions redessinent les usages autorisés</text></navLabel><content src="text/ch007.xhtml#c6-les-restrictions-redessinent-les-usages-autorisés"/></navPoint><navPoint id="nav-55" playOrder="55"><navLabel><text>Mobilewalla : la conformité rejoint la négociation financière</text></navLabel><content src="text/ch007.xhtml#c6-mobilewalla--la-conformité-rejoint-la-négociation-financière"/></navPoint><navPoint id="nav-56" playOrder="56"><navLabel><text>Avast : de la fermeture de Jumpshot aux paiements</text></navLabel><content src="text/ch007.xhtml#c6-avast--de-la-fermeture-de-jumpshot-aux-paiements"/></navPoint><navPoint id="nav-57" playOrder="57"><navLabel><text>Le contrôle devient une dépense récurrente</text></navLabel><content src="text/ch007.xhtml#c6-le-contrôle-devient-une-dépense-récurrente"/></navPoint><navPoint id="nav-58" playOrder="58"><navLabel><text>DROP organise un retrait continu</text></navLabel><content src="text/ch007.xhtml#c6-drop-organise-un-retrait-continu"/></navPoint><navPoint id="nav-59" playOrder="59"><navLabel><text>Deux indicateurs pour deux populations</text></navLabel><content src="text/ch007.xhtml#c6-deux-indicateurs-pour-deux-populations"/></navPoint><navPoint id="nav-60" playOrder="60"><navLabel><text>La valeur suit les droits d’utilisation</text></navLabel><content src="text/ch007.xhtml#c6-la-valeur-suit-les-droits-dutilisation"/></navPoint></navPoint><navPoint id="nav-61" playOrder="61"><navLabel><text>Conclusion : Reprendre le fil des usages</text></navLabel><content src="text/ch008.xhtml"/></navPoint><navPoint id="nav-62" playOrder="62"><navLabel><text>À propos de cette édition</text></navLabel><content src="text/ch009.xhtml"/></navPoint></navMap></ncx>