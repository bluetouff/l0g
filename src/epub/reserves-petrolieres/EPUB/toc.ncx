<?xml version="1.0" encoding="UTF-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="fr"><head><meta name="dtb:uid" content="urn:uuid:72ce301b-e078-4867-a29a-21ca6c218df4"/><meta name="dtb:depth" content="2"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>Réserves pétrolières</text></docTitle><navMap><navPoint id="nav-1" playOrder="1"><navLabel><text>Introduction : Suivre le carburant jusqu’au bout</text></navLabel><content src="text/ch001.xhtml"/></navPoint><navPoint id="nav-2" playOrder="2"><navLabel><text>1. Le chemin jusqu’au diesel</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="nav-3" playOrder="3"><navLabel><text>Dans la cuve, deux formes d’assurance</text></navLabel><content src="text/ch002.xhtml#c1-dans-la-cuve-deux-formes-dassurance"/></navPoint><navPoint id="nav-4" playOrder="4"><navLabel><text>Le raffinage décide du carburant disponible</text></navLabel><content src="text/ch002.xhtml#c1-le-raffinage-décide-du-carburant-disponible"/></navPoint><navPoint id="nav-5" playOrder="5"><navLabel><text>Pourquoi les États-Unis ont choisi le brut</text></navLabel><content src="text/ch002.xhtml#c1-pourquoi-les-états-unis-ont-choisi-le-brut"/></navPoint><navPoint id="nav-6" playOrder="6"><navLabel><text>Le portefeuille SAGESS est largement raffiné</text></navLabel><content src="text/ch002.xhtml#c1-le-portefeuille-sagess-est-largement-raffiné"/></navPoint><navPoint id="nav-7" playOrder="7"><navLabel><text>Les « jours de réserve » ont un dénominateur</text></navLabel><content src="text/ch002.xhtml#c1-les--jours-de-réserve--ont-un-dénominateur"/></navPoint><navPoint id="nav-8" playOrder="8"><navLabel><text>Des décisions, puis des enlèvements</text></navLabel><content src="text/ch002.xhtml#c1-des-décisions-puis-des-enlèvements"/></navPoint><navPoint id="nav-9" playOrder="9"><navLabel><text>Le délai se joue au point de blocage</text></navLabel><content src="text/ch002.xhtml#c1-le-délai-se-joue-au-point-de-blocage"/></navPoint><navPoint id="nav-10" playOrder="10"><navLabel><text>Pour prolonger</text></navLabel><content src="text/ch002.xhtml#c1-pour-prolonger"/></navPoint><navPoint id="nav-11" playOrder="11"><navLabel><text>Sources</text></navLabel><content src="text/ch002.xhtml#c1-sources"/></navPoint><navPoint id="nav-12" playOrder="12"><navLabel><text>Périmètre et méthode</text></navLabel><content src="text/ch002.xhtml#c1-périmètre-et-méthode"/></navPoint></navPoint><navPoint id="nav-13" playOrder="13"><navLabel><text>2. Les propriétaires du secours</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="nav-14" playOrder="14"><navLabel><text>Le produit et le réservoir ont des propriétaires différents</text></navLabel><content src="text/ch003.xhtml#c2-le-produit-et-le-réservoir-ont-des-propriétaires-différents"/></navPoint><navPoint id="nav-15" playOrder="15"><navLabel><text>L’obligation commence chez celui qui alimente le marché</text></navLabel><content src="text/ch003.xhtml#c2-lobligation-commence-chez-celui-qui-alimente-le-marché"/></navPoint><navPoint id="nav-16" playOrder="16"><navLabel><text>Le pétrole attend, la dette arrive à échéance</text></navLabel><content src="text/ch003.xhtml#c2-le-pétrole-attend-la-dette-arrive-à-échéance"/></navPoint><navPoint id="nav-17" playOrder="17"><navLabel><text>Qui paie le temps passé dans les cuves ?</text></navLabel><content src="text/ch003.xhtml#c2-qui-paie-le-temps-passé-dans-les-cuves"/></navPoint><navPoint id="nav-18" playOrder="18"><navLabel><text>Le contrat qui réserve un stock sans l’acheter</text></navLabel><content src="text/ch003.xhtml#c2-le-contrat-qui-réserve-un-stock-sans-lacheter"/></navPoint><navPoint id="nav-19" playOrder="19"><navLabel><text>Une société privée dans les comptes publics</text></navLabel><content src="text/ch003.xhtml#c2-une-société-privée-dans-les-comptes-publics"/></navPoint><navPoint id="nav-20" playOrder="20"><navLabel><text>La gouvernance se juge dans les contrats</text></navLabel><content src="text/ch003.xhtml#c2-la-gouvernance-se-juge-dans-les-contrats"/></navPoint><navPoint id="nav-21" playOrder="21"><navLabel><text>Pour prolonger</text></navLabel><content src="text/ch003.xhtml#c2-pour-prolonger"/></navPoint><navPoint id="nav-22" playOrder="22"><navLabel><text>Sources</text></navLabel><content src="text/ch003.xhtml#c2-sources"/></navPoint><navPoint id="nav-23" playOrder="23"><navLabel><text>Périmètre et méthode</text></navLabel><content src="text/ch003.xhtml#c2-périmètre-et-méthode"/></navPoint></navPoint><navPoint id="nav-24" playOrder="24"><navLabel><text>3. Les kilomètres qui restent</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="nav-25" playOrder="25"><navLabel><text>Une journée pour céder, un parcours pour livrer</text></navLabel><content src="text/ch004.xhtml#c3-une-journée-pour-céder-un-parcours-pour-livrer"/></navPoint><navPoint id="nav-26" playOrder="26"><navLabel><text>La géographie s’organise avant l’urgence</text></navLabel><content src="text/ch004.xhtml#c3-la-géographie-sorganise-avant-lurgence"/></navPoint><navPoint id="nav-27" playOrder="27"><navLabel><text>Au dépôt, la contrainte prend la forme d’un débit</text></navLabel><content src="text/ch004.xhtml#c3-au-dépôt-la-contrainte-prend-la-forme-dun-débit"/></navPoint><navPoint id="nav-28" playOrder="28"><navLabel><text>Octobre 2022, une intervention sur plusieurs maillons</text></navLabel><content src="text/ch004.xhtml#c3-octobre-2022-une-intervention-sur-plusieurs-maillons"/></navPoint><navPoint id="nav-29" playOrder="29"><navLabel><text>Une pompe approvisionnée, un indicateur à part entière</text></navLabel><content src="text/ch004.xhtml#c3-une-pompe-approvisionnée-un-indicateur-à-part-entière"/></navPoint><navPoint id="nav-30" playOrder="30"><navLabel><text>Remplir les cuves pendant qu’elles se vident</text></navLabel><content src="text/ch004.xhtml#c3-remplir-les-cuves-pendant-quelles-se-vident"/></navPoint><navPoint id="nav-31" playOrder="31"><navLabel><text>La souplesse du système mérite un examen dans le temps</text></navLabel><content src="text/ch004.xhtml#c3-la-souplesse-du-système-mérite-un-examen-dans-le-temps"/></navPoint><navPoint id="nav-32" playOrder="32"><navLabel><text>Le maillon qui manque dans les données publiques</text></navLabel><content src="text/ch004.xhtml#c3-le-maillon-qui-manque-dans-les-données-publiques"/></navPoint><navPoint id="nav-33" playOrder="33"><navLabel><text>Pour prolonger</text></navLabel><content src="text/ch004.xhtml#c3-pour-prolonger"/></navPoint><navPoint id="nav-34" playOrder="34"><navLabel><text>Sources</text></navLabel><content src="text/ch004.xhtml#c3-sources"/></navPoint><navPoint id="nav-35" playOrder="35"><navLabel><text>Périmètre et méthode</text></navLabel><content src="text/ch004.xhtml#c3-périmètre-et-méthode"/></navPoint></navPoint><navPoint id="nav-36" playOrder="36"><navLabel><text>4. La raffinerie impose son rythme</text></navLabel><content src="text/ch005.xhtml"/><navPoint id="nav-37" playOrder="37"><navLabel><text>Le produit se fabrique dans plusieurs ateliers</text></navLabel><content src="text/ch005.xhtml#c4-le-produit-se-fabrique-dans-plusieurs-ateliers"/></navPoint><navPoint id="nav-38" playOrder="38"><navLabel><text>L’hydrogène travaille avant le plein</text></navLabel><content src="text/ch005.xhtml#c4-lhydrogène-travaille-avant-le-plein"/></navPoint><navPoint id="nav-39" playOrder="39"><navLabel><text>Ce que mesure le taux de marche</text></navLabel><content src="text/ch005.xhtml#c4-ce-que-mesure-le-taux-de-marche"/></navPoint><navPoint id="nav-40" playOrder="40"><navLabel><text>Les dates de Donges racontent une reprise échelonnée</text></navLabel><content src="text/ch005.xhtml#c4-les-dates-de-donges-racontent-une-reprise-échelonnée"/></navPoint><navPoint id="nav-41" playOrder="41"><navLabel><text>Les prix ouvrent des possibilités, l’équipement les délimite</text></navLabel><content src="text/ch005.xhtml#c4-les-prix-ouvrent-des-possibilités-léquipement-les-délimite"/></navPoint><navPoint id="nav-42" playOrder="42"><navLabel><text>La France produit davantage et continue d’échanger</text></navLabel><content src="text/ch005.xhtml#c4-la-france-produit-davantage-et-continue-déchanger"/></navPoint><navPoint id="nav-43" playOrder="43"><navLabel><text>Choisir le stock qui répond à la contrainte</text></navLabel><content src="text/ch005.xhtml#c4-choisir-le-stock-qui-répond-à-la-contrainte"/></navPoint><navPoint id="nav-44" playOrder="44"><navLabel><text>Pour prolonger</text></navLabel><content src="text/ch005.xhtml#c4-pour-prolonger"/></navPoint><navPoint id="nav-45" playOrder="45"><navLabel><text>Sources</text></navLabel><content src="text/ch005.xhtml#c4-sources"/></navPoint><navPoint id="nav-46" playOrder="46"><navLabel><text>Périmètre et méthode</text></navLabel><content src="text/ch005.xhtml#c4-périmètre-et-méthode"/></navPoint></navPoint><navPoint id="nav-47" playOrder="47"><navLabel><text>5. Les contrats qui ouvrent les vannes</text></navLabel><content src="text/ch006.xhtml"/><navPoint id="nav-48" playOrder="48"><navLabel><text>Un même départ, plusieurs obligations</text></navLabel><content src="text/ch006.xhtml#c5-un-même-départ-plusieurs-obligations"/></navPoint><navPoint id="nav-49" playOrder="49"><navLabel><text>Confier le secours à ceux qui savent le distribuer</text></navLabel><content src="text/ch006.xhtml#c5-confier-le-secours-à-ceux-qui-savent-le-distribuer"/></navPoint><navPoint id="nav-50" playOrder="50"><navLabel><text>Le volume proposé rencontre les offres des entreprises</text></navLabel><content src="text/ch006.xhtml#c5-le-volume-proposé-rencontre-les-offres-des-entreprises"/></navPoint><navPoint id="nav-51" playOrder="51"><navLabel><text>L’entreprise emprunte aussi un calendrier</text></navLabel><content src="text/ch006.xhtml#c5-lentreprise-emprunte-aussi-un-calendrier"/></navPoint><navPoint id="nav-52" playOrder="52"><navLabel><text>Le meilleur prix doit être exécutable</text></navLabel><content src="text/ch006.xhtml#c5-le-meilleur-prix-doit-être-exécutable"/></navPoint><navPoint id="nav-53" playOrder="53"><navLabel><text>Les noms au bout de la procédure</text></navLabel><content src="text/ch006.xhtml#c5-les-noms-au-bout-de-la-procédure"/></navPoint><navPoint id="nav-54" playOrder="54"><navLabel><text>Le contrat devient un mouvement de pétrole</text></navLabel><content src="text/ch006.xhtml#c5-le-contrat-devient-un-mouvement-de-pétrole"/></navPoint><navPoint id="nav-55" playOrder="55"><navLabel><text>Pour prolonger</text></navLabel><content src="text/ch006.xhtml#c5-pour-prolonger"/></navPoint><navPoint id="nav-56" playOrder="56"><navLabel><text>Sources</text></navLabel><content src="text/ch006.xhtml#c5-sources"/></navPoint><navPoint id="nav-57" playOrder="57"><navLabel><text>Périmètre et méthode</text></navLabel><content src="text/ch006.xhtml#c5-périmètre-et-méthode"/></navPoint></navPoint><navPoint id="nav-58" playOrder="58"><navLabel><text>6. Du marché au prix du plein</text></navLabel><content src="text/ch007.xhtml"/><navPoint id="nav-59" playOrder="59"><navLabel><text>Deux horloges commencent à tourner</text></navLabel><content src="text/ch007.xhtml#c6-deux-horloges-commencent-à-tourner"/></navPoint><navPoint id="nav-60" playOrder="60"><navLabel><text>Le Brent change de devise avant d’atteindre la station</text></navLabel><content src="text/ch007.xhtml#c6-le-brent-change-de-devise-avant-datteindre-la-station"/></navPoint><navPoint id="nav-61" playOrder="61"><navLabel><text>Dans un litre, les taxes n’ont pas toutes le même mouvement</text></navLabel><content src="text/ch007.xhtml#c6-dans-un-litre-les-taxes-nont-pas-toutes-le-même-mouvement"/></navPoint><navPoint id="nav-62" playOrder="62"><navLabel><text>Les délais mesurés par la Banque de France</text></navLabel><content src="text/ch007.xhtml#c6-les-délais-mesurés-par-la-banque-de-france"/></navPoint><navPoint id="nav-63" playOrder="63"><navLabel><text>La marge que l’on voit, les coûts que l’on cherche</text></navLabel><content src="text/ch007.xhtml#c6-la-marge-que-lon-voit-les-coûts-que-lon-cherche"/></navPoint><navPoint id="nav-64" playOrder="64"><navLabel><text>Le prix qui aurait prévalu sans intervention</text></navLabel><content src="text/ch007.xhtml#c6-le-prix-qui-aurait-prévalu-sans-intervention"/></navPoint><navPoint id="nav-65" playOrder="65"><navLabel><text>Suivre les mêmes stations, puis ouvrir les contrats</text></navLabel><content src="text/ch007.xhtml#c6-suivre-les-mêmes-stations-puis-ouvrir-les-contrats"/></navPoint><navPoint id="nav-66" playOrder="66"><navLabel><text>Pour prolonger</text></navLabel><content src="text/ch007.xhtml#c6-pour-prolonger"/></navPoint><navPoint id="nav-67" playOrder="67"><navLabel><text>Sources</text></navLabel><content src="text/ch007.xhtml#c6-sources"/></navPoint><navPoint id="nav-68" playOrder="68"><navLabel><text>Périmètre et méthode</text></navLabel><content src="text/ch007.xhtml#c6-périmètre-et-méthode"/></navPoint></navPoint><navPoint id="nav-69" playOrder="69"><navLabel><text>Conclusion : Le secours se mesure à chaque étape</text></navLabel><content src="text/ch008.xhtml"/></navPoint><navPoint id="nav-70" playOrder="70"><navLabel><text>À propos de cette édition</text></navLabel><content src="text/ch009.xhtml"/></navPoint></navMap></ncx>