<?xml version="1.0" encoding="UTF-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="fr"><head><meta name="dtb:uid" content="urn:uuid:914af826-3baf-4ef7-b120-403bc06ea4ab"/><meta name="dtb:depth" content="2"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>Le prix du ralentissement</text></docTitle><navMap><navPoint id="nav-1" playOrder="1"><navLabel><text>Introduction : Le coût du temps</text></navLabel><content src="text/ch001.xhtml"/></navPoint><navPoint id="nav-2" playOrder="2"><navLabel><text>1. Qui pourra continuer ?</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="nav-3" playOrder="3"><navLabel><text>Définir ce qui ralentirait</text></navLabel><content src="text/ch002.xhtml#c1-définir-ce-qui-ralentirait"/></navPoint><navPoint id="nav-4" playOrder="4"><navLabel><text>Le coût d’entrée passe aussi par l’évaluation</text></navLabel><content src="text/ch002.xhtml#c1-le-coût-dentrée-passe-aussi-par-lévaluation"/></navPoint><navPoint id="nav-5" playOrder="5"><navLabel><text>Accenture, partenaire commercial et évaluateur</text></navLabel><content src="text/ch002.xhtml#c1-accenture-partenaire-commercial-et-évaluateur"/></navPoint><navPoint id="nav-6" playOrder="6"><navLabel><text>Qui déciderait de la mise sur le marché ?</text></navLabel><content src="text/ch002.xhtml#c1-qui-déciderait-de-la-mise-sur-le-marché-"/></navPoint><navPoint id="nav-7" playOrder="7"><navLabel><text>Une coordination soumise au droit de la concurrence</text></navLabel><content src="text/ch002.xhtml#c1-une-coordination-soumise-au-droit-de-la-concurrence"/></navPoint><navPoint id="nav-8" playOrder="8"><navLabel><text>L’avance sur la Chine et la place des modèles ouverts</text></navLabel><content src="text/ch002.xhtml#c1-lavance-sur-la-chine-et-la-place-des-modèles-ouverts"/></navPoint><navPoint id="nav-9" playOrder="9"><navLabel><text>Les intérêts financiers du ralentissement</text></navLa