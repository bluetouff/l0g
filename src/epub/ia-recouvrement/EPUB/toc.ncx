<?xml version="1.0" encoding="UTF-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="fr"><head><meta name="dtb:uid" content="urn:uuid:6d21c893-37bc-4616-b69b-ea2d4938caf2"/><meta name="dtb:depth" content="2"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>L’IA vous demande de payer</text></docTitle><navMap><navPoint id="nav-1" playOrder="1"><navLabel><text>Introduction : Avant le message, un dossier</text></navLabel><content src="text/ch001.xhtml"/></navPoint><navPoint id="nav-2" playOrder="2"><navLabel><text>1. Qui décide de la relance ?</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="nav-3" playOrder="3"><navLabel><text>Le nom sur le message n’est pas forcément celui du créancier</text></navLabel><content src="text/ch002.xhtml#c1-le-nom-sur-le-message-nest-pas-forcément-celui-du-créancier"/></navPoint><navPoint id="nav-4" playOrder="4"><navLabel><text>Une dette doit pouvoir se vérifier hors de l’interface</text></navLabel><content src="text/ch002.xhtml#c1-une-dette-doit-pouvoir-se-vérifier-hors-de-linterface"/></navPoint><navPoint id="nav-5" playOrder="5"><navLabel><text>Avant de parler, le système choisit</text></navLabel><content src="text/ch002.xhtml#c1-avant-de-parler-le-système-choisit"/></navPoint><navPoint id="nav-6" playOrder="6"><navLabel><text>Quand un score oriente la suite du dossier</text></navLabel><content src="text/ch002.xhtml#c1-quand-un-score-oriente-la-suite-du-dossier"/></navPoint><navPoint id="nav-7" playOrder="7"><navLabel><text>Savoir à qui l’on parle</text></navLabel><content src="text/ch002.xhtml#c1-savoir-à-qui-lon-parle"/></navPoint><navPoint id="nav-8" playOrder="8"><navLabel><text>Faire suivre la correction</text></navLabel><content src="text/ch002.xhtml#c1-faire-suivre-la-correction"/></navPoint><navPoint id="nav-9" playOrder="9"><navLabel><text>Mesurer la résolution du dossier</text></navLabel><content src="text/ch002.xhtml#c1-mesurer-la-résolution-du-dossier"/></navPoint><navPoint id="nav-10" playOrder="10"><navLabel><text>Méthode et limites</text></navLabel><content src="text/ch002.xhtml#c1-méthode-et-limites"/></navPoint><navPoint id="nav-11" playOrder="11"><navLabel><text>Sources et documents</text></navLabel><content src="text/ch002.xhtml#c1-sources-et-documents"/></navPoint></navPoint><navPoint id="nav-12" playOrder="12"><navLabel><text>2. Que mesurent les gains annoncés ?</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="nav-13" playOrder="13"><navLabel><text>Les résultats annoncés ne mesurent pas la même chose</text></navLabel><content src="text/ch003.xhtml#c2-les-résultats-annoncés-ne-mesurent-pas-la-même-chose"/></navPoint><navPoint id="nav-14" playOrder="14"><navLabel><text>Ce qu’il faut conserver au dénominateur</text></navLabel><content src="text/ch003.xhtml#c2-ce-quil-faut-conserver-au-dénominateur"/></navPoint><navPoint id="nav-15" playOrder="15"><navLabel><text>Le gain peut venir du portail, du modèle ou de l’organisation</text></navLabel><content src="text/ch003.xhtml#c2-le-gain-peut-venir-du-portail-du-modèle-ou-de-lorganisation"/></navPoint><navPoint id="nav-16" playOrder="16"><navLabel><text>Les expériences de terrain imposent de regarder la suite</text></navLabel><content src="text/ch003.xhtml#c2-les-expériences-de-terrain-imposent-de-regarder-la-suite"/></navPoint><navPoint id="nav-17" playOrder="17"><navLabel><text>Ce que recouvre la baisse de « stress » annoncée par PAIR</text></navLabel><content src="text/ch003.xhtml#c2-ce-que-recouvre-la-baisse-de-stress-annoncée-par-pair"/></navPoint><navPoint id="nav-18" playOrder="18"><navLabel><text>Les absents du questionnaire de satisfaction</text></navLabel><content src="text/ch003.xhtml#c2-les-absents-du-questionnaire-de-satisfaction"/></navPoint><navPoint id="nav-19" playOrder="19"><navLabel><text>Mesurer ce qui reste après l’encaissement</text></navLabel><content src="text/ch003.xhtml#c2-mesurer-ce-qui-reste-après-lencaissement"/></navPoint><navPoint id="nav-20" playOrder="20"><navLabel><text>Ce que les documents permettent de conclure</text></navLabel><content src="text/ch003.xhtml#c2-ce-que-les-documents-permettent-de-conclure"/></navPoint></navPoint><navPoint id="nav-21" playOrder="21"><navLabel><text>3. Quand un message devient un appel à l’aide</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="nav-22" playOrder="22"><navLabel><text>La difficulté n’a pas un seul visage</text></navLabel><content src="text/ch004.xhtml#c3-la-difficulté-na-pas-un-seul-visage"/></navPoint><navPoint id="nav-23" playOrder="23"><navLabel><text>Du message au portrait enregistré</text></navLabel><content src="text/ch004.xhtml#c3-du-message-au-portrait-enregistré"/></navPoint><navPoint id="nav-24" playOrder="24"><navLabel><text>Ce que signifie l’absence d’alerte</text></navLabel><content src="text/ch004.xhtml#c3-ce-que-signifie-labsence-dalerte"/></navPoint><navPoint id="nav-25" playOrder="25"><navLabel><text>Après le repérage, la capacité d’agir</text></navLabel><content src="text/ch004.xhtml#c3-après-le-repérage-la-capacité-dagir"/></navPoint><navPoint id="nav-26" playOrder="26"><navLabel><text>Dire sa difficulté ne garantit pas un changement</text></navLabel><content src="text/ch004.xhtml#c3-dire-sa-difficulté-ne-garantit-pas-un-changement"/></navPoint><navPoint id="nav-27" playOrder="27"><navLabel><text>Aider sans constituer un dossier médical</text></navLabel><content src="text/ch004.xhtml#c3-aider-sans-constituer-un-dossier-médical"/></navPoint><navPoint id="nav-28" playOrder="28"><navLabel><text>Faire circuler l’aide, limiter la confidence</text></navLabel><content src="text/ch004.xhtml#c3-faire-circuler-laide-limiter-la-confidence"/></navPoint><navPoint id="nav-29" playOrder="29"><navLabel><text>Une protection qui reste à vérifier dans les dossiers</text></navLabel><content src="text/ch004.xhtml#c3-une-protection-qui-reste-à-vérifier-dans-les-dossiers"/></navPoint></navPoint><navPoint id="nav-30" playOrder="30"><navLabel><text>4. Corriger le dossier jusqu’au bout</text></navLabel><content src="text/ch005.xhtml"/><navPoint id="nav-31" playOrder="31"><navLabel><text>Contester le montant, vérifier les pièces</text></navLabel><content src="text/ch005.xhtml#c4-contester-le-montant-vérifier-les-pièces"/></navPoint><navPoint id="nav-32" playOrder="32"><navLabel><text>Le parcours doit accepter les exceptions</text></navLabel><content src="text/ch005.xhtml#c4-le-parcours-doit-accepter-les-exceptions"/></navPoint><navPoint id="nav-33" playOrder="33"><navLabel><text>Un accord confirmé peut être défait ailleurs</text></navLabel><content src="text/ch005.xhtml#c4-un-accord-confirmé-peut-être-défait-ailleurs"/></navPoint><navPoint id="nav-34" playOrder="34"><navLabel><text>La suspension dépend du fondement invoqué</text></navLabel><content src="text/ch005.xhtml#c4-la-suspension-dépend-du-fondement-invoqué"/></navPoint><navPoint id="nav-35" playOrder="35"><navLabel><text>Faire parvenir la correction aux outils qui agissent</text></navLabel><content src="text/ch005.xhtml#c4-faire-parvenir-la-correction-aux-outils-qui-agissent"/></navPoint><navPoint id="nav-36" playOrder="36"><navLabel><text>Des délais qui courent séparément</text></navLabel><content src="text/ch005.xhtml#c4-des-délais-qui-courent-séparément"/></navPoint><navPoint id="nav-37" playOrder="37"><navLabel><text>Vérifier la fin du problème</text></navLabel><content src="text/ch005.xhtml#c4-vérifier-la-fin-du-problème"/></navPoint><navPoint id="nav-38" playOrder="38"><navLabel><text>Sources et repères</text></navLabel><content src="text/ch005.xhtml#c4-sources-et-repères"/></navPoint></navPoint><navPoint id="nav-39" playOrder="39"><navLabel><text>5. Les contrats et les responsabilités</text></navLabel><content src="text/ch006.xhtml"/><navPoint id="nav-40" playOrder="40"><navLabel><text>Un mandat commercial, plusieurs responsabilités</text></navLabel><content src="text/ch006.xhtml#c5-un-mandat-commercial-plusieurs-responsabilités"/></navPoint><navPoint id="nav-41" playOrder="41"><navLabel><text>Les fournisseurs derrière l’interface</text></navLabel><content src="text/ch006.xhtml#c5-les-fournisseurs-derrière-linterface"/></navPoint><navPoint id="nav-42" playOrder="42"><navLabel><text>Retrouver les destinataires de ses données</text></navLabel><content src="text/ch006.xhtml#c5-retrouver-les-destinataires-de-ses-données"/></navPoint><navPoint id="nav-43" playOrder="43"><navLabel><text>Répondre, entraîner, réutiliser</text></navLabel><content src="text/ch006.xhtml#c5-répondre-entraîner-réutiliser"/></navPoint><navPoint id="nav-44" playOrder="44"><navLabel><text>Pouvoir reprendre le service</text></navLabel><content src="text/ch006.xhtml#c5-pouvoir-reprendre-le-service"/></navPoint><navPoint id="nav-45" playOrder="45"><navLabel><text>Arrêter l’action, garder une solution de service</text></navLabel><content src="text/ch006.xhtml#c5-arrêter-laction-garder-une-solution-de-service"/></navPoint><navPoint id="nav-46" playOrder="46"><navLabel><text>Les conditions de l’indemnisation</text></navLabel><content src="text/ch006.xhtml#c5-les-conditions-de-lindemnisation"/></navPoint><navPoint id="nav-47" playOrder="47"><navLabel><text>Les pièces encore manquantes</text></navLabel><content src="text/ch006.xhtml#c5-les-pièces-encore-manquantes"/></navPoint><navPoint id="nav-48" playOrder="48"><navLabel><text>Méthode et limites</text></navLabel><content src="text/ch006.xhtml#c5-méthode-et-limites"/></navPoint><navPoint id="nav-49" playOrder="49"><navLabel><text>Sources et repères</text></navLabel><content src="text/ch006.xhtml#c5-sources-et-repères"/></navPoint></navPoint><navPoint id="nav-50" playOrder="50"><navLabel><text>6. Les données, les droits et les recours</text></navLabel><content src="text/ch007.xhtml"/><navPoint id="nav-51" playOrder="51"><navLabel><text>Revenir à la dette</text></navLabel><content src="text/ch007.xhtml#c6-revenir-à-la-dette"/></navPoint><navPoint id="nav-52" playOrder="52"><navLabel><text>Le profil que l’entreprise a construit</text></navLabel><content src="text/ch007.xhtml#c6-le-profil-que-lentreprise-a-construit"/></navPoint><navPoint id="nav-53" playOrder="53"><navLabel><text>Une explication doit porter sur le cas concerné</text></navLabel><content src="text/ch007.xhtml#c6-une-explication-doit-porter-sur-le-cas-concerné"/></navPoint><navPoint id="nav-54" playOrder="54"><navLabel><text>Ce que les traces peuvent révéler</text></navLabel><content src="text/ch007.xhtml#c6-ce-que-les-traces-peuvent-révéler"/></navPoint><navPoint id="nav-55" playOrder="55"><navLabel><text>Savoir que l’interlocuteur est une IA</text></navLabel><content src="text/ch007.xhtml#c6-savoir-que-linterlocuteur-est-une-ia"/></navPoint><navPoint id="nav-56" playOrder="56"><navLabel><text>Examiner le contenu de la réponse</text></navLabel><content src="text/ch007.xhtml#c6-examiner-le-contenu-de-la-réponse"/></navPoint><navPoint id="nav-57" playOrder="57"><navLabel><text>Des démarches et des délais distincts</text></navLabel><content src="text/ch007.xhtml#c6-des-démarches-et-des-délais-distincts"/></navPoint><navPoint id="nav-58" playOrder="58"><navLabel><text>À qui demander quoi</text></navLabel><content src="text/ch007.xhtml#c6-à-qui-demander-quoi"/></navPoint><navPoint id="nav-59" playOrder="59"><navLabel><text>Du profil calculé au dossier vérifiable</text></navLabel><content src="text/ch007.xhtml#c6-du-profil-calculé-au-dossier-vérifiable"/></navPoint><navPoint id="nav-60" playOrder="60"><navLabel><text>Sources et repères</text></navLabel><content src="text/ch007.xhtml#c6-sources-et-repères"/></navPoint></navPoint><navPoint id="nav-61" playOrder="61"><navLabel><text>Conclusion : La correction doit atteindre l’action</text></navLabel><content src="text/ch008.xhtml"/></navPoint><navPoint id="nav-62" playOrder="62"><navLabel><text>À propos de cette édition</text></navLabel><content src="text/ch009.xhtml"/></navPoint></navMap></ncx>