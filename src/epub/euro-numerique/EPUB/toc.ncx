<?xml version="1.0" encoding="UTF-8"?><ncx version="2005-1" xmlns="http://www.daisy.org/z3986/2005/ncx/"><head><meta name="dtb:uid" content="urn:uuid:3db87d1a-c9ea-54ea-8d15-71bd5477f318"/><meta name="dtb:depth" content="2"/></head><docTitle><text>L’euro numérique</text></docTitle><navMap><navPoint id="navPoint-1" playOrder="1"><navLabel><text>Introduction</text></navLabel><content src="text/ch001.xhtml"/><navPoint id="navPoint-2" playOrder="2"><navLabel><text>Comment lire cette édition</text></navLabel><content src="text/ch001.xhtml#guide-lecture"/></navPoint></navPoint><navPoint id="navPoint-3" playOrder="3"><navLabel><text>Euro numérique, 1/6 : l’euro qui change de débiteur</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="navPoint-4" playOrder="4"><navLabel><text>À retenir en six lignes</text></navLabel><content src="text/ch002.xhtml#c1-à-retenir-en-six-lignes"/></navPoint><navPoint id="navPoint-5" playOrder="5"><navLabel><text>Le débiteur dépend de la forme de l’euro</text></navLabel><content src="text/ch002.xhtml#c1-le-débiteur-dépend-de-la-forme-de-leuro"/></navPoint><navPoint id="navPoint-6" playOrder="6"><navLabel><text>Le prestataire gère l’accès à la créance sur l’Eurosystème</text></navLabel><content src="text/ch002.xhtml#c1-le-prestataire-gère-laccès-à-la-créance-sur-leurosystème"/></navPoint><navPoint id="navPoint-7" playOrder="7"><navLabel><text>Quand 1 000 euros changent de bilan</text></navLabel><content src="text/ch002.xhtml#c1-quand-1-000-euros-changent-de-bilan"/></navPoint><navPoint id="navPoint-8" playOrder="8"><navLabel><text>La conversion retire une ressource au bilan bancaire</text></navLabel><content src="text/ch002.xhtml#c1-la-conversion-retire-une-ressource-au-bilan-bancaire"/></navPoint><navPoint id="navPoint-9" playOrder="9"><navLabel><text>Le plafond encadre le stock détenu</text></navLabel><content src="text/ch002.xhtml#c1-le-plafond-encadre-le-stock-détenu"/></navPoint><navPoint id="navPoint-10" playOrder="10"><navLabel><text>Le compte bancaire revient par la porte de service</text></navLabel><content src="text/ch002.xhtml#c1-le-compte-bancaire-revient-par-la-porte-de-service"/></navPoint><navPoint id="navPoint-11" playOrder="11"><navLabel><text>Les recettes des entreprises retourneraient rapidement aux bilans bancaires</text></navLabel><content src="text/ch002.xhtml#c1-les-recettes-des-entreprises-retourneraient-rapidement-aux-bilans-bancaires"/></navPoint><navPoint id="navPoint-12" playOrder="12"><navLabel><text>Le paradoxe du cash</text></navLabel><content src="text/ch002.xhtml#c1-le-paradoxe-du-cash"/></navPoint><navPoint id="navPoint-13" playOrder="13"><navLabel><text>La garantie protège les dépôts jusqu’à 100 000 euros</text></navLabel><content src="text/ch002.xhtml#c1-la-garantie-protège-les-dépôts-jusquà-100-000-euros"/></navPoint><navPoint id="navPoint-14" playOrder="14"><navLabel><text>Trois objectifs et une liberté à arbitrer</text></navLabel><content src="text/ch002.xhtml#c1-trois-objectifs-et-une-liberté-à-arbitrer"/></navPoint><navPoint id="navPoint-15" playOrder="15"><navLabel><text>L’arbitrage porte sur l’accès à la monnaie publique</text></navLabel><content src="text/ch002.xhtml#c1-larbitrage-porte-sur-laccès-à-la-monnaie-publique"/></navPoint><navPoint id="navPoint-16" playOrder="16"><navLabel><text>3 000 euros reste une hypothèse de test</text></navLabel><content src="text/ch002.xhtml#c1-3-000-euros-reste-une-hypothèse-de-test"/></navPoint><navPoint id="navPoint-17" playOrder="17"><navLabel><text>Les acquis et les inconnues au début de l’enquête</text></navLabel><content src="text/ch002.xhtml#c1-les-acquis-et-les-inconnues-au-début-de-lenquête"/></navPoint><navPoint id="navPoint-18" playOrder="18"><navLabel><text>Prochaine pièce : les 699 milliards</text></navLabel><content src="text/ch002.xhtml#c1-prochaine-pièce--les-699-milliards"/></navPoint><navPoint id="navPoint-19" playOrder="19"><navLabel><text>Sources et méthode</text></navLabel><content src="text/ch002.xhtml#c1-sources-et-méthode"/></navPoint><navPoint id="navPoint-20" playOrder="20"><navLabel><text>Limites</text></navLabel><content src="text/ch002.xhtml#c1-limites"/></navPoint></navPoint><navPoint id="navPoint-21" playOrder="21"><navLabel><text>Euro numérique, 2/6 : le stress test à 699 milliards</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="navPoint-22" playOrder="22"><navLabel><text>À retenir en sept lignes</text></navLabel><content src="text/ch003.xhtml#c2-à-retenir-en-sept-lignes"/></navPoint><navPoint id="navPoint-23" playOrder="23"><navLabel><text>Un exercice commandé par les législateurs</text></navLabel><content src="text/ch003.xhtml#c2-un-exercice-commandé-par-les-législateurs"/></navPoint><navPoint id="navPoint-24" playOrder="24"><navLabel><text>Deux scénarios fondés sur des mécanismes distincts</text></navLabel><content src="text/ch003.xhtml#c2-deux-scénarios-fondés-sur-des-mécanismes-distincts"/></navPoint><navPoint id="navPoint-25" playOrder="25"><navLabel><text>Les hypothèses bornent la portée du scénario</text></navLabel><content src="text/ch003.xhtml#c2-les-hypothèses-bornent-la-portée-du-scénario"/></navPoint><navPoint id="navPoint-26" playOrder="26"><navLabel><text>La digitalisation qui compense les sorties</text></navLabel><content src="text/ch003.xhtml#c2-la-digitalisation-qui-compense-les-sorties"/></navPoint><navPoint id="navPoint-27" playOrder="27"><navLabel><text>Derrière le chiffre, 2 025 bilans bancaires</text></navLabel><content src="text/ch003.xhtml#c2-derrière-le-chiffre-2-025-bilans-bancaires"/></navPoint><navPoint id="navPoint-28" playOrder="28"><navLabel><text>Les trois options de financement d’une banque</text></navLabel><content src="text/ch003.xhtml#c2-les-trois-options-de-financement-dune-banque"/></navPoint><navPoint id="navPoint-29" playOrder="29"><navLabel><text>Le bilan de l’Eurosystème absorbe une partie du choc</text></navLabel><content src="text/ch003.xhtml#c2-le-bilan-de-leurosystème-absorbe-une-partie-du-choc"/></navPoint><navPoint id="navPoint-30" playOrder="30"><navLabel><text>Treize banques au seuil, neuf face au collatéral</text></navLabel><content src="text/ch003.xhtml#c2-treize-banques-au-seuil-neuf-face-au-collatéral"/></navPoint><navPoint id="navPoint-31" playOrder="31"><navLabel><text>L’identité des treize banques reste confidentielle</text></navLabel><content src="text/ch003.xhtml#c2-lidentité-des-treize-banques-reste-confidentielle"/></navPoint><navPoint id="navPoint-32" playOrder="32"><navLabel><text>Les banques de détail encaissent le plus gros choc</text></navLabel><content src="text/ch003.xhtml#c2-les-banques-de-détail-encaissent-le-plus-gros-choc"/></navPoint><navPoint id="navPoint-33" playOrder="33"><navLabel><text>L’Allemagne teste le même risque avec deux autres modèles</text></navLabel><content src="text/ch003.xhtml#c2-lallemagne-teste-le-même-risque-avec-deux-autres-modèles"/></navPoint><navPoint id="navPoint-34" playOrder="34"><navLabel><text>L’absorption du choc modifie le coût du financement</text></navLabel><content src="text/ch003.xhtml#c2-labsorption-du-choc-modifie-le-coût-du-financement"/></navPoint><navPoint id="navPoint-35" playOrder="35"><navLabel><text>Le crédit bouge peu dans le modèle</text></navLabel><content src="text/ch003.xhtml#c2-le-crédit-bouge-peu-dans-le-modèle"/></navPoint><navPoint id="navPoint-36" playOrder="36"><navLabel><text>Le décor monétaire a déjà changé</text></navLabel><content src="text/ch003.xhtml#c2-le-décor-monétaire-a-déjà-changé"/></navPoint><navPoint id="navPoint-37" playOrder="37"><navLabel><text>Les taux produisent deux effets contraires</text></navLabel><content src="text/ch003.xhtml#c2-les-taux-produisent-deux-effets-contraires"/></navPoint><navPoint id="navPoint-38" playOrder="38"><navLabel><text>Les 699 milliards mesurent le canal de l’euro numérique</text></navLabel><content src="text/ch003.xhtml#c2-les-699-milliards-mesurent-le-canal-de-leuro-numérique"/></navPoint><navPoint id="navPoint-39" p