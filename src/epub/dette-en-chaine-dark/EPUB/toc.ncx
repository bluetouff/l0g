<?xml version="1.0" encoding="UTF-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="fr"><head><meta name="dtb:uid" content="urn:uuid:1d01f15a-a388-49db-aefa-399ecaa2ee9c"/><meta name="dtb:depth" content="2"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>La dette en chaîne</text></docTitle><navMap><navPoint id="nav-1" playOrder="1"><navLabel><text>Des contrats, des dates et des périmètres</text></navLabel><content src="text/method.xhtml"/></navPoint><navPoint id="nav-2" playOrder="2"><navLabel><text>Introduction : Une obligation, plusieurs vies</text></navLabel><content src="text/ch001.xhtml"/></navPoint><navPoint id="nav-3" playOrder="3"><navLabel><text>1. Le premier acheteur</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="nav-4" playOrder="4"><navLabel><text>L’argent neuf rembourse aussi les anciennes promesses</text></navLabel><content src="text/ch002.xhtml#largent-neuf-rembourse-aussi-les-anciennes-promesses"/></navPoint><navPoint id="nav-5" playOrder="5"><navLabel><text>À 10 h 50, des prix avant des noms</text></navLabel><content src="text/ch002.xhtml#à-10-h-50-des-prix-avant-des-noms"/></navPoint><navPoint id="nav-6" playOrder="6"><navLabel><text>Un coupon immobile, un prix qui descend</text></navLabel><content src="text/ch002.xhtml#un-coupon-immobile-un-prix-qui-descend"/></navPoint><navPoint id="nav-7" playOrder="7"><navLabel><text>Le lendemain, l’émission grandit encore</text></navLabel><content src="text/ch002.xhtml#le-lendemain-lémission-grandit-encore"/></navPoint><navPoint id="nav-8" playOrder="8"><navLabel><text>Le jour où la promesse devient un paiement</text></navLabel><content src="text/ch002.xhtml#le-jour-où-la-promesse-devient-un-paiement"/></navPoint><navPoint id="nav-9" playOrder="9"><navLabel><text>Aux États-Unis, les spécialistes offrent beaucoup et obtiennent peu</text></navLabel><content src="text/ch002.xhtml#aux-états-unis-les-spécialistes-offrent-beaucoup-et-obtiennent-peu"/></navPoint><navPoint id="nav-10" playOrder="10"><navLabel><text>Une adjudication révèle un prix, puis laisse des questions</text></navLabel><content src="text/ch002.xhtml#une-adjudication-révèle-un-prix-puis-laisse-des-questions"/></navPoint><navPoint id="nav-11" playOrder="11"><navLabel><text>Jusqu’où peut-on nommer le créancier ?</text></navLabel><content src="text/ch002.xhtml#jusquoù-peut-on-nommer-le-créancier-"/></navPoint><navPoint id="nav-12" playOrder="12"><navLabel><text>Sources et pièces de lecture</text></navLabel><content src="text/ch002.xhtml#sources-et-pièces-de-lecture"/></navPoint></navPoint><navPoint id="nav-13" playOrder="13"><navLabel><text>2. Le prix d’un bilan disponible</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="nav-14" playOrder="14"><navLabel><text>Le classement change après l’émission</text></navLabel><content src="text/ch003.xhtml#le-classement-change-après-lémission"/></navPoint><navPoint id="nav-15" playOrder="15"><navLabel><text>Une banque achète aussi du temps</text></navLabel><content src="text/ch003.xhtml#une-banque-achète-aussi-du-temps"/></navPoint><navPoint id="nav-16" playOrder="16"><navLabel><text>L’obligation part, le financement reste</text></navLabel><content src="text/ch003.xhtml#lobligation-part-le-financement-reste"/></navPoint><navPoint id="nav-17" playOrder="17"><navLabel><text>Les limites se décident à plusieurs étages</text></navLabel><content src="text/ch003.xhtml#les-limites-se-décident-à-plusieurs-étages"/></navPoint><navPoint id="nav-18" playOrder="18"><navLabel><text>Washington ouvre de l’espace réglementaire</text></navLabel><content src="text/ch003.xhtml#washington-ouvre-de-lespace-réglementaire"/></navPoint><navPoint id="nav-19" playOrder="19"><navLabel><text>Huit banques, deux réponses positives</text></navLabel><content src="text/ch003.xhtml#huit-banques-deux-réponses-positives"/></navPoint><navPoint id="nav-20" playOrder="20"><navLabel><text>Le client convaincu de trouver un prêt</text></navLabel><content src="text/ch003.xhtml#le-client-convaincu-de-trouver-un-prêt"/></navPoint><navPoint id="nav-21" playOrder="21"><navLabel><text>Faire circuler davantage avec les mêmes bilans</text></navLabel><content src="text/ch003.xhtml#faire-circuler-davantage-avec-les-mêmes-bilans"/></navPoint><navPoint id="nav-22" playOrder="22"><navLabel><text>Le coût revient à l’État par le prix</text></navLabel><content src="text/ch003.xhtml#le-coût-revient-à-létat-par-le-prix"/></navPoint><navPoint id="nav-23" playOrder="23"><navLabel><text>Sources et repères</text></navLabel><content src="text/ch003.xhtml#sources-et-repères"/></navPoint></navPoint><navPoint id="nav-24" playOrder="24"><navLabel><text>3. Les acheteurs à crédit</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="nav-25" playOrder="25"><navLabel><text>Les futures pour ajuster l’exposition aux taux</text></navLabel><content src="text/ch004.xhtml#les-futures-pour-ajuster-lexposition-aux-taux"/></navPoint><navPoint id="nav-26" playOrder="26"><navLabel><text>Un écart de prix à exploiter jusqu’à la sortie</text></navLabel><content src="text/ch004.xhtml#un-écart-de-prix-à-exploiter-jusquà-la-sortie"/></navPoint><navPoint id="nav-27" playOrder="27"><navLabel><text>Cent millions de titres, trois millions de capital</text></navLabel><content src="text/ch004.xhtml#cent-millions-de-titres-trois-millions-de-capital"/></navPoint><navPoint id="nav-28" playOrder="28"><navLabel><text>Une rentabilité suspendue au financement</text></navLabel><content src="text/ch004.xhtml#une-rentabilité-suspendue-au-financement"/></navPoint><navPoint id="nav-29" playOrder="29"><navLabel><text>Les appels de marge créent un besoin immédiat de cash</text></navLabel><content src="text/ch004.xhtml#les-appels-de-marge-créent-un-besoin-immédiat-de-cash"/></navPoint><navPoint id="nav-30" playOrder="30"><navLabel><text>Sous les chiffres, des stratégies à reconstituer</text></navLabel><content src="text/ch004.xhtml#sous-les-chiffres-des-stratégies-à-reconstituer"/></navPoint><navPoint id="nav-31" playOrder="31"><navLabel><text>Avril 2025 : les positions divergent</text></navLabel><content src="text/ch004.xhtml#avril-2025--les-positions-divergent"/></navPoint><navPoint id="nav-32" playOrder="32"><navLabel><text>Vendre avant que le prêteur ne l’exige</text></navLabel><content src="text/ch004.xhtml#vendre-avant-que-le-prêteur-ne-lexige"/></navPoint><navPoint id="nav-33" playOrder="33"><navLabel><text>Un créancier sous condition</text></navLabel><content src="text/ch004.xhtml#un-créancier-sous-condition"/></navPoint><navPoint id="nav-34" playOrder="34"><navLabel><text>Sources et repères</text></navLabel><content src="text/ch004.xhtml#sources-et-repères"/></navPoint></navPoint><navPoint id="nav-35" playOrder="35"><navLabel><text>4. La chaîne des garanties</text></navLabel><content src="text/ch005.xhtml"/><navPoint id="nav-36" playOrder="36"><navLabel><text>Au bout du financement, une trésorerie à placer</text></navLabel><content src="text/ch005.xhtml#au-bout-du-financement-une-trésorerie-à-placer"/></navPoint><navPoint id="nav-37" playOrder="37"><navLabel><text>Cent millions de titres, deux contrats de crédit</text></navLabel><content src="text/ch005.xhtml#cent-millions-de-titres-deux-contrats-de-crédit"/></navPoint><navPoint id="nav-38" playOrder="38"><navLabel><text>Une propriété qui circule, une exposition qui reste</text></navLabel><content src="text/ch005.xhtml#une-propriété-qui-circule-une-exposition-qui-reste"/></navPoint><navPoint id="nav-39" playOrder="39"><navLabel><text>Le calendrier du dealer</text></navLabel><content src="text/ch005.xhtml#le-calendrier-du-dealer"/></navPoint><navPoint id="nav-40" playOrder="40"><navLabel><text>Haircut nul et protections négociées</text></navLabel><content src="text/ch005.xhtml#haircut-nul-et-protections-négociées"/></navPoint><navPoint id="nav-41" playOrder="41"><navLabel><text>Les titres déjà là, la marge en plus</text></navLabel><content src="text/ch005.xhtml#les-titres-déjà-là-la-marge-en-plus"/></navPoint><navPoint id="nav-42" playOrder="42"><navLabel><text>Le règlement des engagements déjà acceptés</text></navLabel><content src="text/ch005.xhtml#le-règlement-des-engagements-déjà-acceptés"/></navPoint><navPoint id="nav-43" playOrder="43"><navLabel><text>La garantie a aussi un coût</text></navLabel><content src="text/ch005.xhtml#la-garantie-a-aussi-un-coût"/></navPoint><navPoint id="nav-44" playOrder="44"><navLabel><text>Méthode et portée de l’enquête</text></navLabel><content src="text/ch005.xhtml#méthode-et-portée-de-lenquête"/></navPoint><navPoint id="nav-45" playOrder="45"><navLabel><text>Sources et repères</text></navLabel><content src="text/ch005.xhtml#sources-et-repères"/></navPoint></navPoint><navPoint id="nav-46" playOrder="46"><navLabel><text>5. L’heure de l’appel de marge</text></navLabel><content src="text/ch006.xhtml"/><navPoint id="nav-47" playOrder="47"><navLabel><text>Deux bilans traversent le même choc</text></navLabel><content src="text/ch006.xhtml#deux-bilans-traversent-le-même-choc"/></navPoint><navPoint id="nav-48" playOrder="48"><navLabel><text>Les garanties réclamées par les contreparties</text></navLabel><content src="text/ch006.xhtml#les-garanties-réclamées-par-les-contreparties"/></navPoint><navPoint id="nav-49" playOrder="49"><navLabel><text>À onze heures, il manque quatorze millions</text></navLabel><content src="text/ch006.xhtml#à-onze-heures-il-manque-quatorze-millions"/></navPoint><navPoint id="nav-50" playOrder="50"><navLabel><text>Le trajet entre le perdant et le gagnant</text></navLabel><content src="text/ch006.xhtml#le-trajet-entre-le-perdant-et-le-gagnant"/></navPoint><navPoint id="nav-51" playOrder="51"><navLabel><text>Les ventes de 2022 laissent une trace précise</text></navLabel><content src="text/ch006.xhtml#les-ventes-de-2022-laissent-une-trace-précise"/></navPoint><navPoint id="nav-52" playOrder="52"><navLabel><text>Des réserves 