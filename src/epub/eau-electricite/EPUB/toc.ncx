<?xml version="1.0" encoding="UTF-8"?><ncx version="2005-1" xmlns="http://www.daisy.org/z3986/2005/ncx/"><head><meta name="dtb:uid" content="urn:uuid:6b9c68c0-6c5d-5f39-b518-83f6ec0db44d"/><meta name="dtb:depth" content="2"/></head><docTitle><text>L’eau derrière l’électricité</text></docTitle><navMap><navPoint id="navPoint-1" playOrder="1"><navLabel><text>Introduction</text></navLabel><content src="text/ch001.xhtml"/><navPoint id="navPoint-2" playOrder="2"><navLabel><text>Comment lire cette édition</text></navLabel><content src="text/ch001.xhtml#guide-lecture"/></navPoint></navPoint><navPoint id="navPoint-3" playOrder="3"><navLabel><text>Combien vaut un centimètre de Danube ?</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="navPoint-4" playOrder="4"><navLabel><text>Le fleuve n&apos;était pas vide</text></navLabel><content src="text/ch002.xhtml#c1-le-fleuve-nétait-pas-vide"/></navPoint><navPoint id="navPoint-5" playOrder="5"><navLabel><text>Trois jours pour perdre les trois quarts de Paks</text></navLabel><content src="text/ch002.xhtml#c1-trois-jours-pour-perdre-les-trois-quarts-de-paks"/></navPoint><navPoint id="navPoint-6" playOrder="6"><navLabel><text>Faire sauter la roche pour gagner des jours</text></navLabel><content src="text/ch002.xhtml#c1-faire-sauter-la-roche-pour-gagner-des-jours"/></navPoint><navPoint id="navPoint-7" playOrder="7"><navLabel><text>Testez le prix de votre scénario</text></navLabel><content src="text/ch002.xhtml#c1-testez-le-prix-de-votre-scénario"/></navPoint><navPoint id="navPoint-8" playOrder="8"><navLabel><text>Un seul fleuve, plusieurs centrales en concurrence</text></navLabel><content src="text/ch002.xhtml#c1-un-seul-fleuve-plusieurs-centrales-en-concurrence"/></navPoint><navPoint id="navPoint-9" playOrder="9"><navLabel><text>Kozloduy n&apos;a pas lu le même fleuve</text></navLabel><content src="text/ch002.xhtml#c1-kozloduy-na-pas-lu-le-même-fleuve"/></navPoint><navPoint id="navPoint-10" playOrder="10"><navLabel><text>Le réseau a évité la panne, pas la facture</text></navLabel><content src="text/ch002.xhtml#c1-le-réseau-a-évité-la-panne-pas-la-facture"/></navPoint><navPoint id="navPoint-11" playOrder="11"><navLabel><text>Réparer le fleuve ou adapter les centrales</text></navLabel><content src="text/ch002.xhtml#c1-réparer-le-fleuve-ou-adapter-les-centrales"/></navPoint></navPoint><navPoint id="navPoint-12" playOrder="12"><navLabel><text>Le mégawatt humide que l&apos;Europe ne sait pas compter</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="navPoint-13" playOrder="13"><navLabel><text>La question la plus simple reste sans réponse</text></navLabel><content src="text/ch003.xhtml#c2-la-question-la-plus-simple-reste-sans-réponse"/></navPoint><navPoint id="navPoint-14" playOrder="14"><navLabel><text>Une ancienne base possédait déjà les bonnes colonnes</text></navLabel><content src="text/ch003.xhtml#c2-une-ancienne-base-possédait-déjà-les-bonnes-colonnes"/></navPoint><navPoint id="navPoint-15" playOrder="15"><navLabel><text>Un plancher de 294,3 GW</text></navLabel><content src="text/ch003.xhtml#c2-un-plancher-de-2943-gw"/></navPoint><navPoint id="navPoint-16" playOrder="16"><navLabel><text>Testez le périmètre</text></navLabel><content src="text/ch003.xhtml#c2-testez-le-périmètre"/></navPoint><navPoint id="navPoint-17" playOrder="17"><navLabel><text>Prélever n&apos;est pas consommer</text></navLabel><content src="text/ch003.xhtml#c2-prélever-nest-pas-consommer"/></navPoint><navPoint id="navPoint-18" playOrder="18"><navLabel><text>L&apos;eau n&apos;est pas un risque unique</text></navLabel><content src="text/ch003.xhtml#c2-leau-nest-pas-un-risque-unique"/></navPoint><navPoint id="navPoint-19" playOrder="19"><navLabel><text>Il existe quatre hydroélectricités différentes</text></navLabel><content src="text/ch003.xhtml#c2-il-existe-quatre-hydroélectricités-différentes"/></navPoint><navPoint id="navPoint-20" playOrder="20"><navLabel><text>Le seuil transforme la dépendance en perte réelle</text></navLabel><content src="text/ch003.xhtml#c2-le-seuil-transforme-la-dépendance-en-perte-réelle"/></navPoint><navPoint id="navPoint-21" playOrder="21"><navLabel><text>Une base construite autour des preuves, pas autour d&apos;un score</text></navLabel><content src="text/ch003.xhtml#c2-une-base-construite-autour-des-preuves-pas-autour-dun-score"/></navPoint><navPoint id="navPoint-22" playOrder="22"><navLabel><text>Quatre indicateurs, quatre questions</text></navLabel><content src="text/ch003.xhtml#c2-quatre-indicateurs-quatre-questions"/></navPoint><navPoint id="navPoint-23" playOrder="23"><navLabel><text>Le premier chiffre ne doit jamais devenir une prophétie</text></navLabel><content src="text/ch003.xhtml#c2-le-premier-chiffre-ne-doit-jamais-devenir-une-prophétie"/></navPoint></navPoint><navPoint id="navPoint-24" playOrder="24"><navLabel><text>Le degré de trop</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="navPoint-25" playOrder="25"><navLabel><text>Trois marches pour le même Rhône</text></navLabel><content src="text/ch004.xhtml#c3-trois-marches-pour-le-même-rhône"/></navPoint><navPoint id="navPoint-26" playOrder="26"><navLabel><text>Le degré du fleuve n&apos;est pas un degré de sûreté nucléaire</text></navLabel><content src="text/ch004.xhtml#c3-le-degré-du-fleuve-nest-pas-un-degré-de-sûreté-nucléaire"/></navPoint><navPoint id="navPoint-27" playOrder="27"><navLabel><text>Un même site, deux signatures thermiques</text></navLabel><content src="text/ch004.xhtml#c3-un-même-site-deux-signatures-thermiques"/></navPoint><navPoint id="navPoint-28" playOrder="28"><navLabel><text>RTE demande, le ministère confirme, l&apos;ASNR décide</text></navLabel><content src="text/ch004.xhtml#c3-rte-demande-le-ministère-confirme-lasnr-décide"/></navPoint><navPoint id="navPoint-29" playOrder="29"><navLabel><text>Une sécurité nationale confortable peut coexister avec une requête locale</text></navLabel><content src="text/ch004.xhtml#c3-une-sécurité-nationale-confortable-peut-coexister-avec-une-requête-locale"/></navPoint><navPoint id="navPoint-30" playOrder="30"><navLabel><text>L&apos;été 2026 n&apos;a pas appliqué une règle unique</text></navLabel><content src="text/ch004.xhtml#c3-lété-2026-na-pas-appliqué-une-règle-unique"/></navPoint><navPoint id="navPoint-31" playOrder="31"><navLabel><text>Testez la règle publiée</text></navLabel><content src="text/ch004.xhtml#c3-testez-la-règle-publiée"/></navPoint><navPoint id="navPoint-32" playOrder="32"><navLabel><text>Le réseau choisit vite, l&apos;écosystème répond lentement</text></navLabel><content src="text/ch004.xhtml#c3-le-réseau-choisit-vite-lécosystème-répond-lentement"/></navPoint><navPoint id="navPoint-33" playOrder="33"><navLabel><text>Le retour de 2022 rassure sans fermer la question</text></navLabel><content src="text/ch004.xhtml#c3-le-retour-de-2022-rassure-sans-fermer-la-question"/></navPoint><navPoint id="navPoint-34" playOrder="34"><navLabel><text>Une décision rare, mais une gouvernance à rendre plus lisible</text></navLabel><content src="text/ch004.xhtml#c3-une-décision-rare-mais-une-gouvernance-à-rendre-plus-lisible"/></navPoint></navPoint><navPoint id="navPoint-35" playOrder="35"><navLabel><text>Le barrage qui choisit de ne pas produire</text></navLabel><content src="text/ch005.xhtml"/><navPoint id="navPoint-36" playOrder="36"><navLabel><text>La Suisse achète une absence de production</text></navLabel><content src="text/ch005.xhtml#c4-la-suisse-achète-une-absence-de-production"/></navPoint><navPoint id="navPoint-37" playOrder="37"><navLabel><text>Une technologie, trois horloges</text></navLabel><content src="text/ch005.xhtml#c4-une-technologie-trois-horloges"/></navPoint><navPoint id="navPoint-38" playOrder="38"><navLabel><text>Le prix minimum auquel une goutte accepte de tomber</text></navLabel><content src="text/ch005.xhtml#c4-le-prix-minimum-auquel-une-goutte-accepte-de-tomber"/></navPoint><navPoint id="navPoint-39" playOrder="39"><navLabel><text>Importer du vent pour conserver de la pluie</text></navLabel><content src="text/ch005.xhtml#c4-importer-du-vent-pour-conserver-de-la-pluie"/></navPoint><navPoint id="navPoint-40" playOrder="40"><navLabel><text>Le solaire ne remplit pas un barrage</text></navLabel><content src="text/ch005.xhtml#c4-le-solaire-ne-remplit-pas-un-barrage"/></navPoint><navPoint id="navPoint-41" playOrder="41"><navLabel><text>Un TWh n&apos;est pas toujours le même TWh</text></navLabel><content src="text/ch005.xhtml#c4-un-twh-nest-pas-toujours-le-même-twh"/></navPoint><navPoint id="navPoint-42" playOrder="42"><navLabel><text>Le marché n&apos;est pas seul devant la vanne</text></navLabel><content src="text/ch005.xhtml#c4-le-marché-nest-pas-seul-devant-la-vanne"/></navPoint><navPoint id="navPoint-43" playOrder="43"><navLabel><text>Huit champs qui manquent aux stocks européens</text></navLabel><content src="text/ch005.xhtml#c4-huit-champs-qui-manquent-aux-stocks-européens"/></navPoint><navPoint id="navPoint-44" playOrder="44"><navLabel><text>Le service le plus précieux peut être le mégawattheure absent</text></navLabel><content src="text/ch005.xhtml#c4-le-service-le-plus-précieux-peut-être-le-mégawattheure-absent"/></navPoint></navPoint><navPoint id="navPoint-45" playOrder="45"><navLabel><text>Le modèle, la pompe et le prix de l&apos;adéquation</text></navLabel><content src="text/ch006.xhtml"/><navPoint id="navPoint-46" playOrder="46"><navLabel><text>Le modèle n&apos;avait pas promis le fonctionnement de chaque centrale</text></navLabel><content src="text/ch006.xhtml#c5-le-modèle-navait-pas-promis-le-fonctionnement-de-chaque-centrale"/></navPoint><navPoint id="navPoint-47" playOrder="47"><navLabel><text>Le modèle voit déjà la chaleur et la sécheresse</text></navLabel><content src="text/ch006.xhtml#c5-le-modèle-voit-déjà-la-chaleur-et-la-sécheresse"/></navPoint><navPoint id="navPoint-48" playOrder="48"><navLabel><text>Le Danube a produit un choc composé</text></navLabel><content src="text/ch006.xhtml#c5-le-danube-a-produit-un-choc-composé"/></navPoint><navPoint id="navPoint-49" playOrder="49"><navLabel><text>Les commentaires nationaux savaient davantage que le résumé continental</text></navLabel><content src="text/ch006.xhtml#c5-les-commentaires-nationaux-savaient-davantage-que-le-résumé-continental"/></navPoint><navPoint id="navPoint-50" playOrder="50"><navLabel><text>Le verdict de mai a survécu au mois d&apos;août</text></navLabel><content src="text/ch006.xhtml#c5-le-verdict-de-mai-a-survécu-au-mois-daoût"/></navPoint><navPoint id="navPoint-51" playOrder="51"><navLabel><text>Testez la différence entre une zone et une sous-région</text></navLabel><content src="text/ch006.xhtml#c5-testez-la-différence-entre-une-zone-et-une-sous-région"/></navPoint><navPoint id="navPoint-52" playOrder="52"><navLabel><text>Avoir raison peut coûter cher</text></navLabel><content src="text/ch006.xhtml#c5-avoir-raison-peut-coûter-cher"/></navPoint><navPoint id="navPoint-53" playOrder="53"><navLabel><text>Le filet à sept jours fonctionne, mais sa méthode reste inachevée</text></navLabel><content src="text/ch006.xhtml#c5-le-filet-à-sept-jours-fonctionne-mais-sa-méthode-reste-inachevée"/></navPoint><navPoint id="navPoint-54" playOrder="54"><navLabel><text>Un modèle peut être juste et sous-informatif</text></navLabel><content src="text/ch006.xhtml#c5-un-modèle-peut-être-juste-et-sous-informatif"/></navPoint></navPoint><navPoint id="navPoint-55" playOrder="55"><navLabel><text>Le prix du refroidissement</text></navLabel><content src="text/ch007.xhtml"/><navPoint id="navPoint-56" playOrder="56"><navLabel><text>Six milliards de forints pour quelques centimètres</text></navLabel><content src="text/ch007.xhtml#c6-six-milliards-de-forints-pour-quelques-centimètres"/></navPoint><navPoint id="navPoint-57" playOrder="57"><navLabel><text>Quatre horizons, quatre factures</text></navLabel><content src="text/ch007.xhtml#c6-quatre-horizons-quatre-factures"/></navPoint><navPoint id="navPoint-58" playOrder="58"><navLabel><text>La tour échange le débit contre l&apos;évaporation</text></navLabel><content src="text/ch007.xhtml#c6-la-tour-échange-le-débit-contre-lévaporation"/></navPoint><navPoint id="navPoint-59" playOrder="59"><navLabel><text>L&apos;air rachète l&apos;eau au prix du rendement</text></navLabel><content src="text/ch007.xhtml#c6-lair-rachète-leau-au-prix-du-rendement"/></navPoint><navPoint id="navPoint-60" playOrder="60"><navLabel><text>L&apos;eau usée construit une seconde usine</text></navLabel><content src="text/ch007.xhtml#c6-leau-usée-construit-une-seconde-usine"/></navPoint><navPoint id="navPoint-61" playOrder="61"><navLabel><text>La mer déplace la contrainte vers le littoral</text></navLabel><content src="text/ch007.xhtml#c6-la-mer-déplace-la-contrainte-vers-le-littoral"/></navPoint><navPoint id="navPoint-62" playOrder="62"><navLabel><text>Le neuf choisit, l&apos;existant négocie</text></navLabel><content src="text/ch007.xhtml#c6-le-neuf-choisit-lexistant-négocie"/></navPoint><navPoint id="navPoint-63" playOrder="63"><navLabel><text>Testez un devis d&apos;adaptation</text></navLabel><content src="text/ch007.xhtml#c6-testez-un-devis-dadaptation"/></navPoint><navPoint id="navPoint-64" playOrder="64"><navLabel><text>Le mégawatt sécurisé comme dénominateur</text></navLabel><content src="text/ch007.xhtml#c6-le-mégawatt-sécurisé-comme-dénominateur"/></navPoint><navPoint id="navPoint-65" playOrder="65"><navLabel><text>Le portefeuille d&apos;adaptation</text></navLabel><content src="text/ch007.xhtml#c6-le-portefeuille-dadaptation"/></navPoint></navPoint><navPoint id="navPoint-66" playOrder="66"><navLabel><text>Conclusion</text></navLabel><content src="text/ch008.xhtml"/></navPoint><navPoint id="navPoint-67" playOrder="67"><navLabel><text>À propos de cette édition</text></navLabel><content src="text/ch009.xhtml"/></navPoint></navMap></ncx>
