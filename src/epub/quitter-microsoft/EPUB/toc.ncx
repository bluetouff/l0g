<?xml version="1.0" encoding="UTF-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="fr"><head><meta name="dtb:uid" content="urn:uuid:80217509-e61a-495d-9f95-1c27b4a5ae41"/><meta name="dtb:depth" content="2"/><meta name="dtb:totalPageCount" content="0"/><meta name="dtb:maxPageNumber" content="0"/></head><docTitle><text>Quitter Microsoft</text></docTitle><navMap><navPoint id="nav-1" playOrder="1"><navLabel><text>Lire les documents avec leur date</text></navLabel><content src="text/method.xhtml"/></navPoint><navPoint id="nav-2" playOrder="2"><navLabel><text>Introduction : Un service public doit pouvoir changer de mains</text></navLabel><content src="text/ch001.xhtml"/></navPoint><navPoint id="nav-3" playOrder="3"><navLabel><text>1. Les dépendances du service public</text></navLabel><content src="text/ch002.xhtml"/><navPoint id="nav-4" playOrder="4"><navLabel><text>Cinq licences au bout d’un chantier de grande ampleur</text></navLabel><content src="text/ch002.xhtml#c1-cinq-licences-au-bout-dun-chantier-de-grande-ampleur"/></navPoint><navPoint id="nav-5" playOrder="5"><navLabel><text>Le document voyage avec des relations invisibles</text></navLabel><content src="text/ch002.xhtml#c1-le-document-voyage-avec-des-relations-invisibles"/></navPoint><navPoint id="nav-6" playOrder="6"><navLabel><text>Les derniers postes ont leur propre calendrier</text></navLabel><content src="text/ch002.xhtml#c1-les-derniers-postes-ont-leur-propre-calendrier"/></navPoint><navPoint id="nav-7" playOrder="7"><navLabel><text>Une colonne triée, 790 comptes affectés</text></navLabel><content src="text/ch002.xhtml#c1-une-colonne-triée-790-comptes-affectés"/></navPoint><navPoint id="nav-8" playOrder="8"><navLabel><text>Au CNRS, la messagerie ouvre un chantier plus vaste</text></navLabel><content src="text/ch002.xhtml#c1-au-cnrs-la-messagerie-ouvre-un-chantier-plus-vaste"/></navPoint><navPoint id="nav-9" playOrder="9"><navLabel><text>La souveraineté se joue aussi dans le contrat et l’équipe</text></navLabel><content src="text/ch002.xhtml#c1-la-souveraineté-se-joue-aussi-dans-le-contrat-et-léquipe"/></navPoint><navPoint id="nav-10" playOrder="10"><navLabel><text>Préparer le départ dès l’arrivée</text></navLabel><content src="text/ch002.xhtml#c1-préparer-le-départ-dès-larrivée"/></navPoint><navPoint id="nav-11" playOrder="11"><navLabel><text>Sources et limites de l’enquête</text></navLabel><content src="text/ch002.xhtml#c1-sources-et-limites-de-lenquête"/></navPoint></navPoint><navPoint id="nav-12" playOrder="12"><navLabel><text>2. Le contrat prépare le suivant</text></navLabel><content src="text/ch003.xhtml"/><navPoint id="nav-13" playOrder="13"><navLabel><text>Quatre offres dans un périmètre déjà dessiné</text></navLabel><content src="text/ch003.xhtml#c2-quatre-offres-dans-un-périmètre-déjà-dessiné"/></navPoint><navPoint id="nav-14" playOrder="14"><navLabel><text>À la Défense, le parc précède l’accord global</text></navLabel><content src="text/ch003.xhtml#c2-à-la-défense-le-parc-précède-laccord-global"/></navPoint><navPoint id="nav-15" playOrder="15"><navLabel><text>Le contrat donne un chemin facile à l’extension</text></navLabel><content src="text/ch003.xhtml#c2-le-contrat-donne-un-chemin-facile-à-lextension"/></navPoint><navPoint id="nav-16" playOrder="16"><navLabel><text>Un groupe d’agents devient une règle d’accès</text></navLabel><content src="text/ch003.xhtml#c2-un-groupe-dagents-devient-une-règle-daccès"/></navPoint><navPoint id="nav-17" playOrder="17"><navLabel><text>Le juge regarde aussi les années entre deux contrats</text></navLabel><content src="text/ch003.xhtml#c2-le-juge-regarde-aussi-les-années-entre-deux-contrats"/></navPoint><navPoint id="nav-18" playOrder="18"><navLabel><text>Donner une place au choix suivant</text></navLabel><content src="text/ch003.xhtml#c2-donner-une-place-au-choix-suivant"/></navPoint><navPoint id="nav-19" playOrder="19"><navLabel><text>Sources et limites de l’enquête</text></navLabel><content src="text/ch003.xhtml#c2-sources-et-limites-de-lenquête"/></navPoint></navPoint><navPoint id="nav-20" playOrder="20"><navLabel><text>3. Les licences orientent le cloud</text></navLabel><content src="text/ch004.xhtml"/><navPoint id="nav-21" playOrder="21"><navLabel><text>Le logiciel voyage avec des conditions</text></navLabel><content src="text/ch004.xhtml#c3-le-logiciel-voyage-avec-des-conditions"/></navPoint><navPoint id="nav-22" playOrder="22"><navLabel><text>Trois destinations pour la même application</text></navLabel><content src="text/ch004.xhtml#c3-trois-destinations-pour-la-même-application"/></navPoint><navPoint id="nav-23" playOrder="23"><navLabel><text>Le concurrent achète une partie de son offre à Microsoft</text></navLabel><content src="text/ch004.xhtml#c3-le-concurrent-achète-une-partie-de-son-offre-à-microsoft"/></navPoint><navPoint id="nav-24" playOrder="24"><navLabel><text>L’accord CISPE élargit les droits des hébergeurs éligibles</text></navLabel><content src="text/ch004.xhtml#c3-laccord-cispe-élargit-les-droits-des-hébergeurs-éligibles"/></navPoint><navPoint id="nav-25" playOrder="25"><navLabel><text>Une mise à jour de sécurité change de régime</text></navLabel><content src="text/ch004.xhtml#c3-une-mise-à-jour-de-sécurité-change-de-régime"/></navPoint><navPoint id="nav-26" playOrder="26"><navLabel><text>Deux procédures encore ouvertes</text></navLabel><content src="text/ch004.xhtml#c3-deux-procédures-encore-ouvertes"/></navPoint><navPoint id="nav-27" playOrder="27"><navLabel><text>Choisir qui pourra faire fonctionner le service demain</text></navLabel><content src="text/ch004.xhtml#c3-choisir-qui-pourra-faire-fonctionner-le-service-demain"/></navPoint><navPoint id="nav-28" playOrder="28"><navLabel><text>Sources et limites de l’enquête</text></navLabel><content src="text/ch004.xhtml#c3-sources-et-limites-de-lenquête"/></navPoint></navPoint><navPoint id="nav-29" playOrder="29"><navLabel><text>4. Les procédures choisissent le logiciel</text></navLabel>