007.xhtml#c6-la-version-suivante-fait-partie-du-voyage"/></navPoint><navPoint id="nav-50" playOrder="50"><navLabel><text>À Échirolles, apprendre à administrer autrement</text></navLabel><content src="text/ch007.xhtml#c6-à-échirolles-apprendre-à-administrer-autrement"/></navPoint><navPoint id="nav-51" playOrder="51"><navLabel><text>À Aarhus, le travail change de mains</text></navLabel><content src="text/ch007.xhtml#c6-à-aarhus-le-travail-change-de-mains"/></navPoint><navPoint id="nav-52" playOrder="52"><navLabel><text>Faire circuler les corrections</text></navLabel><content src="text/ch007.xhtml#c6-faire-circuler-les-corrections"/></navPoint><navPoint id="nav-53" playOrder="53"><navLabel><text>Une alternative doit pouvoir vieillir</text></navLabel><content src="text/ch007.xhtml#c6-une-alternative-doit-pouvoir-vieillir"/></navPoint><navPoint id="nav-54" playOrder="54"><navLabel><text>Sources et limites de l’enquête</text></navLabel><content src="text/ch007.xhtml#c6-sources-et-limites-de-lenquête"/></navPoint></navPoint><navPoint id="nav-55" playOrder="55"><navLabel><text>7. Garder la liberté de choisir</text></navLabel><content src="text/ch008.xhtml"/><navPoint id="nav-56" playOrder="56"><navLabel><text>Évaluer la souveraineté d’une offre</text></navLabel><content src="text/ch008.xhtml#c7-évaluer-la-souveraineté-dune-offre"/></navPoint><navPoint id="nav-57" playOrder="57"><navLabel><text>Protéger les données et préparer leur voyage</text></navLabel><content src="text/ch008.xhtml#c7-protéger-les-données-et-préparer-leur-voyage"/></navPoint><navPoint id="nav-58" playOrder="58"><navLabel><text>Le contrat doit transmettre de quoi travailler</text></navLabel><content src="text/ch008.xhtml#c7-le-contrat-doit-transmettre-de-quoi-travailler"/></navPoint><navPoint id="nav-59" playOrder="59"><navLabel><text>Les trente jours ont une place précise</text></navLabel><content src="text/ch008.xhtml#c7-les-trente-jours-ont-une-place-précise"/></navPoint><navPoint id="nav-60" playOrder="60"><navLabel><text>Répéter le départ pendant que tout fonctionne</text></navLabel><content src="text/ch008.xhtml#c7-répéter-le-départ-pendant-que-tout-fonctionne"/></navPoint><navPoint id="nav-61" playOrder="61"><navLabel><text>Une responsabilité qui reste quand le mandat change</text></navLabel><content src="text/ch008.xhtml#c7-une-responsabilité-qui-reste-quand-le-mandat-change"/></navPoint><navPoint id="nav-62" playOrder="62"><navLabel><text>Sources et limites de l’enquête</text></navLabel><content src="text/ch008.xhtml#c7-sources-et-limites-de-lenquête"/></navPoint></navPoint><navPoint id="nav-63" playOrder="63"><navLabel><text>Conclusion : Transmettre les moyens de décider</text></navLabel><content src="text/ch009.xhtml"/></navPoint><navPoint id="nav-64" playOrder="64"><navLabel><text>Repères visuels</text></navLabel><content src="text/figures.xhtml"/></navPoint><navPoint id="nav-65" playOrder="65"><navLabel><text>Colophon et provenance</text></navLabel><content src="text/ch010.xhtml"/></navPoint></navMap></ncx>