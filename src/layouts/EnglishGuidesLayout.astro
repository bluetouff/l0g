---
import '../styles/global.css';
import CspMeta from '../components/CspMeta.astro';
import EnglishNavigation from '../components/EnglishNavigation.astro';
import EnglishFooter from '../components/EnglishFooter.astro';
import { authorEntity, organizationEntity, websiteEntity } from '../config/entities.ts';
import { buildRobotsMetadata, buildSeoMetadata } from '../lib/seo.ts';
import { serializeInlineScriptData } from '../lib/security.ts';
import { getPublicationSocial } from '../config/publication-social.mjs';
import { defaultEnglishPageSocial, getEnglishPageSocial } from '../config/english-page-social.mjs';

type AlternateLink = { hreflang: string; href: string };

interface Props {
  title?: string;
  description?: string;
  seoTitle?: string;
  ogTitle?: string;
  seoDescription?: string;
  robots?: 'index,follow' | 'noindex,follow';
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  alternateLinks?: AlternateLink[];
  compactNavigation?: boolean;
}

const {
  title = 'l0g in English',
  description = 'English entry points from l0g.fr: reference guides, methodology, API, MCP and machine-readable risk intelligence.',
  seoTitle,
  ogTitle,
  seoDescription,
  robots = 'index,follow',
  ogType = 'website',
  ogImage,
  ogImageAlt,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  alternateLinks = [],
  compactNavigation = false,
} = Astro.props;

const publicationSocial = getPublicationSocial(Astro.url.pathname);
const pageSocial = getEnglishPageSocial(Astro.url.pathname) ?? defaultEnglishPageSocial;
const ogImageUrl = new URL(publicationSocial?.image ?? ogImage ?? pageSocial.image, Astro.site).toString();
const seo = buildSeoMetadata(title, seoDescription || description, { seoTitle });
const fullTitle = seo.fullTitle;
const socialTitle = (ogTitle ?? '').trim() || fullTitle;
const metaDescription = seo.description;
const socialImageAlt = publicationSocial?.alt ?? ogImageAlt ?? (ogImage ? `${socialTitle}: l0g.fr social card` : pageSocial.alt);
const year = new Date().getFullYear();

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationEntity,
    authorEntity,
    websiteEntity,
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    {ogType === 'article' && <link rel="stylesheet" href="/styles/article-sources-v1.css" />}
    <link rel="stylesheet" href="/styles/english-footer-v1.css" />
    <meta charset="utf-8" />
    <CspMeta />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="alternate" type="application/rss+xml" title="l0g.fr in English" href="/en/rss.xml" />

    <script>
      // @ts-nocheck -- exécuté avant le rendu ; aucune API Astro côté client.
      (function () {
        try {
          var k = 'l0g-theme';
          var s = localStorage.getItem(k);
          var t = (s === 'light' || s === 'dark') ? s : 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={buildRobotsMetadata(robots)} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="l0g" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bluetouff" />
    <meta name="twitter:creator" content="@bluetouff" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(siteJsonLd)} />
  </head>

  <body class="en-shell">
    <div class="topbar" aria-hidden="true"></div>
    <div class="en-backdrop" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-5 py-7 sm:py-9">
      <EnglishNavigation path={Astro.url.pathname} compact={compactNavigation} />

      <main id="main-content" tabindex="-1" class="min-w-0 py-8">
        <slot />
      </main>
    </div>

    <EnglishFooter path={Astro.url.pathname} year={year} />
  </body>
</html>

<style>
  .en-shell { position: relative; }
  .en-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(circle at 16% 6%, color-mix(in srgb, var(--color-signal) 18%, transparent), transparent 29rem),
      radial-gradient(circle at 88% 4%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 28rem),
      radial-gradient(circle at 60% 92%, color-mix(in srgb, var(--color-amber) 8%, transparent), transparent 24rem),
      linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 31%, transparent), transparent 34rem);
  }
</style>
