    "ledger": {
      "desktop": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" style=\"height:auto\" viewBox=\"0 0 1000 700\" role=\"img\" aria-labelledby=\"dubai-ledger-en-d-title dubai-ledger-en-d-desc\" xml:lang=\"en\" data-kind=\"ledger\" data-variant=\"desktop\">\n<title id=\"dubai-ledger-en-d-title\">A fictitious expense: cash transferred and tax calculated</title>\n<desc id=\"dubai-ledger-en-d-desc\">Entirely hypothetical example, in euros. A 100000 euro fictitious expense is assumed booked and paid; the artificial declared base moves from 400000 to 300000. At the chosen 25% rate, calculated tax moves from 100000 to 75000, a 25000 difference. The fictitious expense is legally non-deductible. Adding it back restores the 400000 base and 100000 tax under these assumptions. The 100000 cash transfer is separate. VAT, fees, personal taxes, losses and penalties are excluded.</desc>\n<rect x=\"0\" y=\"0\" width=\"1000\" height=\"700\" fill=\"var(--color-surface)\" stroke=\"none\" rx=\"0\"/>\n<rect x=\"8\" y=\"12.0\" width=\"984\" height=\"43.2\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"dubai-ledger-en-d-region-1\" data-label-region=\"true\"/>\n<text x=\"32\" y=\"42\" fill=\"var(--color-signal)\" font-family=\"l0g Dubai Papers Investigation\" font-size=\"24\" font-weight=\"400\" text-anchor=\"start\" data-panel=\"dubai-ledger-en-d-region-1\">FICTITIOUS EXPENSE: TWO DISTINCT EFFECTS</text>\n<rect x=\"8\" y=\"54.5\" width=\"984\" height=\"39.6\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"dubai-ledger-en-d-region-2\" data-label-region=\"true\"/>\n<text x=\"32\" y=\"82\" fill=\"var(--color-muted)\" font-family=\"l0g Dubai Papers Investigation\" font-size=\"22\" font-weight=\"400\" text-anchor=\"start\" data-panel=\"dubai-ledger-en-d-region-2\">Hypothetical example · euros · chosen rate 25%</text>\n<rect x=\"8\" y=\"102.5\" width=\"984\" height=\"39.6\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"dubai-ledger-en-d-region-3\" data-label-region=\"true\"/>\n<text x=\"32\" y=\