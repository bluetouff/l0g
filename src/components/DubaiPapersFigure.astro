const info={
 circuits:{number:'01',sources:['s03','s10','s11'],fr:'Deux origines de fonds et des relations à établir',en:'Two sources of funds and relationships to establish'},
 ledger:{number:'02',sources:['s13'],fr:'Une charge fictive, du cash transféré à l’impôt calculé',en:'A fictitious expense, from cash transferred to calculated tax'},
 information:{number:'03',sources:['s11','s12','s16'],fr:'Renseignements de compte et renseignement financier',en:'Account information and financial intelligence'},
}as const;
if((lang!=='fr'&&lang!=='en')||!Object.prototype.hasOwnProperty.call(info,kind))throw new TypeError('Unknown DubaiPapersFigure variant');
const entry=info[kind],scene=art[lang][kind],figureNumber=number??entry.number,sourceIds=sources??entry.sources;
if(!/^\d{2}$/.test(figureNumber)||!sourceIds.every(id=>/^(?:s03|s10|s11|s12|s13|s16)$/.test(id)))throw new TypeError('Invalid figure metadata');
const captions={
 circuits:{fr:'Fonctions rapportées par Radio France en avril 2019 : avoirs hérités non déclarés ou fonds d’entreprise issus d’une facturation contestée, administration de structures et accès aux fonds. Les entrées sont alternatives. Les lignes sont qualitatives et ne reconstituent aucun trajet bancaire individuel. Les faits et responsabilités du procès restent à apprécier par le tribunal.',en:'Functions reported by Radio France in April 2019: undeclared inherited wealth or business funds arising from disputed invoices, administration of entities and access to funds. The entries are alternatives. Lines are qualitative and reconstruct no individual banking route. Facts and individual responsibility in the trial remain for the court to determine.'},
 ledger:{fr:'Exemple entièrement hypothétique, en euros, sur un exercice fictif. Une charge fictive de 100 000 est supposée comptabilisée et payée. La base artificiellement déclarée passe de 400 000 à 300 000 ; au taux choisi de 25 %, l’impôt calculé passe de 100 000 à 75 000. L’écart de 25 000 est distinct des 100 000 de trésorerie transférés. La charge fictive est juridiquement non déductible : sa réintégration rétablit la base de 400 000 et l’impôt de 100 000 dans ces hypothèses.',en:'Entirely hypothetical example, in euros, over a fictional accounting period. A fictitious 100,000 expense is assumed booked and paid. The artificial declared base moves from 400,000 to 300,000; at the chosen 25% rate, calculated tax moves from 100,000 to 75,000. The 25,000 difference is distinct from 100,000 of cash transferred. The fictitious expense is legally non-deductible: adding it back restores the 400,000 base and 100,000 tax under these assumptions.'},
 information:{fr:'Schéma institutionnel général, distinct des circuits d’argent. Selon le CRS, les informations déclarables passent de l’établissement financier à l’autorité de la juridiction du compte, puis à la juridiction de résidence fiscale concernée, selon les conditions applicables. Tracfin relève d’un circuit séparé. Aucune transmission ni alerte concernant Helin n’est établie par cette figure.',en:'General institutional diagram, separate from money flows. Under the CRS, reportable information moves from the financial institution to the account jurisdiction’s authority, then to the relevant tax-residence jurisdiction, subject to the applicable conditions. Tracfin operates through a separate channel. This figure establishes no Helin transmission or alert.'},
}as const;
const methods={
 circuits:{fr:'Reconstruction de fonctions à partir d’une enquête de presse, pas inventaire exhaustif, relevé bancaire ou authentification d’une fuite détenue par l0g. Radio France décrit des profils distincts et des modalités variables ; aucune personne n’est présumée avoir utilisé toutes les voies. Le titulaire affiché, le pouvoir d’instruction et l’usage privé doivent être rapprochés par des pièces distinctes. Les montants, banques et comptes individuels ne sont pas inventés. Les recherches de l’OCDE sur les facilitateurs professionnels et sur les personnes détenant le contrôle complètent le cadre général sans constituer une preuve individuelle. Les rémunérations rapportées dans certains cas ne forment aucun barème universel et ne sont pas extrapolées aux actifs.',en:'Reconstruction of functions from original press reporting, not an exhaustive inventory, bank statement or authentication of a leak held by l0g. Radio France describes different customer profiles and varying arrangements; no person is assumed to have used every route. Legal title, instruction rights and private use require separate documentary links. Individual amounts, banks and accounts are not invented. OECD work on professional enablers and controlling persons adds a general framework without supplying individual proof. Remuneration reported in particular cases is not a universal tariff and is not extrapolated to assets.'},
 ledger:{fr:'Calcul reproductible : 400 000 − 100 000 = 300 000 ; 400 000 × 25 % = 100 000 ; 300 000 × 25 % = 75 000 ; écart 25 000. La sortie de trésorerie supposée payée est de 100 000. Il s’agit de la base déclarée artificiellement, pas d’une déduction admise : la dépense fictive doit être réintégrée, soit 300 000 + 100 000 = 400 000 de base et 100 000 d’impôt au taux choisi. Les segments en contour matérialisent cette réintégration. Les barres de base et d’impôt partagent une même échelle en euros dans chaque variante. Aucun chiffre Helin n’est représenté. Le calcul exclut TVA, frais et commissions, impôts personnels, pénalités, intérêts, déficits et reports. Le taux de 25 % est un paramètre fictif, pas un taux historique attribué à toute la période 2007–2018. Le principe général de charges réelles, justifiées et engagées dans l’intérêt de l’entreprise est documenté par Service Public.',en:'Reproducible calculation: 400,000 − 100,000 = 300,000; 400,000 × 25% = 100,000; 300,000 × 25% = 75,000; difference 25,000. Assumed cash actually paid is 100,000. The figure depicts an artificially declared base, rather than an allowable deduction: the fictitious expense must be added back, restoring 300,000 + 100,000 = 400,000 of taxable base and 100,000 tax at the chosen rate. Outlined segments show that add-back. Base and tax bars share one euro scale within each variant. No Helin figure is represented. The calculation excludes VAT, fees and commissions, personal taxes, penalties, interest, deficits and loss relief. The 25% rate is a fictional parameter, rather than a historical rate assigned to the whole 2007–2018 period. Service Public documents the general principle of genuine, substantiated expenses incurred for the business.'},
 information:{fr:'Le CRS impose des diligences et déclarations selon le titulaire, la résidence fiscale et les classifications applicables ; certaines entités passives conduisent à identifier les personnes physiques détenant le contrôle. Le schéma ne généralise pas la déclaration à tous les actionnaires ni à tous les comptes. S11 est une consolidation OCDE 2025 non officielle : la mise en œuvre dépend des règles nationales et des relations d’échange activées. Aucun cadre actuel n’est appliqué rétroactivement à tous les faits 2007–2018. La revue OCDE de 2022 situe les premiers envois émiratis en 2018 et décrit alors une situation non réciproque, envoi sans réception ; elle ne démontre aucune transmission française ou Helin particulière. Tracfin reçoit et analyse des informations dans un autre cadre, puis peut transmettre aux autorités compétentes. La ligne générique des assujettis ne représente aucune déclaration directe d’avocat : les voies propres aux avocats passent par le bâtonnier dans le cadre légal applicable, avec les protections du conseil et de la défense. Aucun signalement, journal de contrôle ni fichier individuel Helin n’a été obtenu.',en:'The CRS requires due diligence and reporting according to the account holder, tax residence and applicable classifications; some passive entities require identification of their individual controlling persons. The diagram does not generalise reporting to every shareholder or account. S11 is an unofficial 2025 OECD consolidation: implementation depends on national rules and activated exchange relationships. No current framework is retroactively assigned to all 2007–2018 conduct. The OECD’s 2022 review dates the UAE’s first outgoing exchanges to 2018 and then describes a non-reciprocal position, sending without receiving; it establishes no specific French or Helin transmission. Tracfin receives and analyses information under another framework and may transmit it to competent authorities. The generic obliged-professionals line depicts no direct lawyer report: lawyers’ specific channels pass through the bar president under the applicable legal framework, with protections for legal advice and defence. No Helin report, control log or individual file has been obtained.'},
}as const;
---
<figure class="dubai-papers-figure" id={`figure-${figureNumber}`} data-kind={kind}>
 <div class="desktop-art" set:html={scene.desktop}></div>
 <div class="mobile-art" set:html={scene.mobile}></div>
 <figcaption><span class="figure-number">FIGURE {figureNumber}</span><strong>{entry[lang]}</strong>{caption??captions[kind][lang]} {sourceIds.map(id=><a href={`#source-${id}`} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}</figcaption>
 <details><summary>{lang==='fr'?'Méthode et périmètre':'Method and scope'}</summary><div class="method">{methods[kind][lang]}<slot/></div></details>
</figure>
<style>
 @font-face{font-family:'l0g Dubai Papers Investigation';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
 .dubai-papers-figure{width:100%;max-width:800px;margin:2.8rem auto;padding-bottom:1rem;container-type:inline-size;overflow:visible}
 .desktop-art,.mobile-art{width:100%;line-height:0}.mobile-art{display:none;max-width:340px;margin-inline:auto}
 .dubai-papers-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
 figcaption{padding:.85rem 0 .45rem;font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted)}
 figcaption strong{display:block;margin:.25rem 0;font-size:1rem;font-weight:400;color:var(--color-paper)}
 .figure-number{font-size:.75rem;letter-spacing:.12em;color:var(--color-signal)}a{margin-right:.45rem}
 details{margin-top:.35rem;font-family:var(--font-read);font-size:.875rem;line-height:1.7}summary{cursor:pointer;padding:.35rem 0}summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.method{margin-top:.5rem;color:var(--color-muted)}
 @container (max-width:660px){.desktop-art{display:none}.mobile-art{display:block}}
 @media print{.desktop-art{display:block}.mobile-art{display:none}.dubai-papers-figure{break-inside:avoid}}
</style>
