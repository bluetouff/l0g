---
interface Props {
  lang: 'fr' | 'en';
  kind: 'resolution' | 'timeline' | 'arcom';
}

const { lang, kind } = Astro.props;
const captions = {
  fr: {
    resolution: 'Trajet simplifié d’une requête. Un refus DNS intervient avant la connexion au site.',
    timeline: 'Dates des jugements et des annonces. Le 14 novembre est le terme indiqué dans le jugement d’octobre.',
    arcom: 'Services sportifs notifiés pour blocage en France, par année. La série mesure les notifications.',
  },
  en: {
    resolution: 'Simplified path of a query. A DNS refusal occurs before the device connects to the site.',
    timeline: 'Dates of the orders and announcements. The October judgment lists 14 November as the expected end date.',
    arcom: 'Sports services notified for blocking in France, by year. The series measures notifications.',
  },
} as const;
const sourceRefs = {
  resolution: ['S04', 'S06'],
  timeline: ['S01', 'S02', 'S03', 'S05'],
  arcom: ['S08'],
} as const;

const figures = import.meta.glob('../figures/quad9/*.svg', { query: '?raw', import: 'default', eager: true });
const base = `../figures/quad9/${lang}-${kind}`;
const wide = figures[`${base}.svg`];
const narrow = figures[`${base}.mobile.svg`];
if (typeof wide !== 'string' || typeof narrow !== 'string') throw new TypeError('Missing Quad9 figure layout.');
---
<figure class="quad9-figure" data-kind={kind}>
  <div class="scene-wide" set:html={wide} />
  <div class="scene-narrow" set:html={narrow} />
  <figcaption>
    {captions[lang][kind]}
    {sourceRefs[kind].map(ref => <a href={`#source-${ref}`}>{ref}</a>)}
  </figcaption>
</figure>
<style>
  .quad9-figure {
    width: 100%;
    max-width: 560px;
    margin: 1.7rem auto;
    padding-bottom: .6rem;
    container-type: inline-size;
  }

  .quad9-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-read);
    font-weight: 400;
    letter-spacing: normal;
    font-variant-numeric: tabular-nums;
  }

  .scene-wide { display: block; }
  .scene-narrow { display: none; max-width: 352px; margin-inline: auto; }

  figcaption {
    margin-top: .6rem;
    color: var(--color-muted);
    font-family: var(--font-read);
    font-size: .79rem;
    font-weight: 400;
    line-height: 1.55;
  }

  figcaption a { margin-inline-start: .35rem; }

  @container (max-width: 500px) {
    .scene-wide { display: none; }
    .scene-narrow { display: block; }
  }

  @media print {
    .quad9-figure { break-inside: avoid; }
    .scene-wide { display: block; }
    .scene-narrow { display: none; }
  }
</style>
