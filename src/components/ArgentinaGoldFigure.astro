---
interface Props {
  lang: 'fr' | 'en';
  kind: 'custody' | 'collar' | 'payments';
}

const { lang, kind } = Astro.props;
const captions = {
  fr: {
    custody: 'Part en onces troy fines de l’or de la BCRA inscrite à la Banque des règlements internationaux (BRI), avant le premier envoi de juin 2024 et au 31 décembre 2025. Les parts sont calculées d’après les soldes relevés par l’AGN.',
    collar: 'Exemple fictif pour une unité d’or, en indice. Le détenteur achète le droit de vendre à 90 et cède le droit d’acheter à 110. Le graphique représente la valeur à l’échéance hors primes et frais.',
    payments: 'En millions de dollars américains. La barre décompose les décaissements sur les options relevés par l’AGN en 2025. La BCRA annonce séparément le résultat net de la position en or, couverture comprise.',
  },
  en: {
    custody: 'Share of BCRA gold held through the Bank for International Settlements (BIS), measured in fine troy ounces before the first June 2024 shipment and on 31 December 2025. Shares are calculated from the balances recorded by Argentina’s auditor general.',
    collar: 'Illustrative example for one unit of gold, expressed as an index. The holder buys the right to sell at 90 and grants the right to buy at 110. The chart shows the value at expiry before premiums and fees.',
    payments: 'In millions of US dollars. The bar breaks down the 2025 cash outflows on options recorded by Argentina’s auditor general. The BCRA separately reported the net result for its gold position including hedges.',
  },
} as const;
const sourceRefs = {
  custody: ['S01'],
  collar: ['S01', 'S06'],
  payments: ['S01', 'S03', 'S05'],
} as const;

const figures = import.meta.glob('../figures/argentina-gold/*.svg', { query: '?raw', import: 'default', eager: true });
const base = `../figures/argentina-gold/${lang}-${kind}`;
const wide = figures[`${base}.svg`];
const narrow = figures[`${base}.mobile.svg`];
if (typeof wide !== 'string' || typeof narrow !== 'string') throw new TypeError('Missing Argentine gold figure layout.');
---
<figure class="argentina-gold-figure" data-kind={kind}>
  <div class="scene-wide" set:html={wide} />
  <div class="scene-narrow" set:html={narrow} />
  <figcaption>
    {captions[lang][kind]}
    {sourceRefs[kind].map(ref => <a href={`#source-${ref}`}>{ref}</a>)}
  </figcaption>
</figure>
<style>
  .argentina-gold-figure {
    width: 100%;
    max-width: 560px;
    margin: 1.7rem auto;
    padding-bottom: .6rem;
    container-type: inline-size;
  }

  .argentina-gold-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-read);
    font-weight: 400;
    letter-spacing: normal;
    font-variant-numeric: tabular-nums;
  }

  .scene-wide { display: block; }
  .scene-narrow { display: none; max-width: 352px; margin-inline: auto; }

  figcaption {
    margin-top: .6rem;
    color: var(--color-muted);
    font-family: var(--font-read);
    font-size: .79rem;
    font-weight: 400;
    line-height: 1.55;
  }

  figcaption a { margin-inline-start: .35rem; }

  @container (max-width: 500px) {
    .scene-wide { display: none; }
    .scene-narrow { display: block; }
  }

  @media print {
    .argentina-gold-figure { break-inside: avoid; }
    .scene-wide { display: block; }
    .scene-narrow { display: none; }
  }
</style>
