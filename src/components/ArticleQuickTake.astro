---
import L0gGlyph from './L0gGlyph.astro';

interface Props {
  fact: string;
  importance?: string;
  uncertainty?: string;
  readingTime: number;
  lang?: 'fr' | 'en';
  mode?: 'summary' | 'presentation';
}

const { fact, importance, uncertainty, readingTime, lang = 'fr', mode = 'summary' } = Astro.props;
const en = lang === 'en';
const hasSummary = mode === 'summary' && Boolean(importance?.trim() && uncertainty?.trim());
const rows: Array<{ label: string; value: string }> = [
  { label: en ? 'The finding' : 'Le fait', value: fact },
  { label: en ? 'Why it matters' : 'Pourquoi cela compte', value: importance ?? '' },
  { label: en ? 'Remaining uncertainty' : 'Points encore incertains', value: uncertainty ?? '' },
];
---

<aside class="quick-take instrument-plate" aria-labelledby="quick-take-title" data-pagefind-ignore>
  <div class="quick-head">
    <div>
      <L0gGlyph name="read" size="sm" />
      <p id="quick-take-title">// {hasSummary ? (en ? 'in 30 seconds' : 'en 30 secondes') : (en ? 'overview' : 'présentation')}</p>
    </div>
    <span>{en ? `${readingTime} min read` : `${readingTime} min d’analyse`}</span>
  </div>
  {hasSummary ? <dl>
    {rows.map((row) => (
      <div>
        <dt>
          <span>{row.label}</span>
        </dt>
        <dd>{row.value}</dd>
      </div>
    ))}
  </dl> : <div class="quick-presentation">
    <p>{fact}</p>
  </div>}
</aside>

<style>
  .quick-take {
    --plate-accent: var(--color-signal);
    margin: 0 0 2.1rem;
    border: 1px solid color-mix(in srgb, var(--color-signal) 32%, var(--color-line));
  }
  .quick-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    border-bottom: 1px solid var(--color-line);
    padding: 0.85rem 1rem;
  }
  .quick-head > div {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .quick-head p {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .quick-head span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .quick-take dl { display: grid; margin: 0; }
  .quick-take dl > div {
    display: grid;
    grid-template-columns: minmax(11rem, 0.42fr) 1fr;
    align-items: start;
    gap: 0.7rem 1rem;
    padding: 0.85rem 1rem;
  }
  .quick-take dl > div + div { border-top: 1px solid var(--color-line); }
  .quick-take dt {
    color: var(--color-muted);
    font-family: var(--font-read);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.55;
  }
  .quick-take dd {
    margin: 0;
    color: var(--color-paper);
    font-family: var(--font-read);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .quick-presentation { padding: 1rem; }
  .quick-presentation p { color: var(--color-paper); font-family: var(--font-read); font-size: .95rem; line-height: 1.65; }
  @media (max-width: 560px) {
    .quick-take dl > div {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
  }
</style>
