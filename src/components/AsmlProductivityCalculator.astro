---
import { ASML_PRODUCTIVITY_FIELDS, ASML_PRODUCTIVITY_DEFAULTS, ASML_PRODUCTIVITY_LIMITS, ASML_PRODUCTIVITY_RESULTS, calculateAsmlProductivity, asmlProductivityDisplay, asmlProductivityPlot } from '../lib/asmlProductivityModel.mjs';
import { asmlProductivityCopy, asmlProductivityNotes } from '../lib/asmlProductivityUi.mjs';
interface Props { lang: 'fr' | 'en'; id?: string; }
const { lang, id = `asml-productivity-${lang}` } = Astro.props;
if (!/^[a-z][a-z0-9-]{0,63}$/.test(id)) throw new RangeError('Controlled calculator id required');
const copy = asmlProductivityCopy(lang), initial = calculateAsmlProductivity(ASML_PRODUCTIVITY_DEFAULTS), notes = asmlProductivityNotes(initial, lang);
const modes = ['desktop', 'mobile'] as const;
const fields = ASML_PRODUCTIVITY_FIELDS as readonly (keyof typeof ASML_PRODUCTIVITY_DEFAULTS)[];
const source = 'https://www.sec.gov/Archives/edgar/data/937966/000119312521287742/d133133dex997.htm';
---
<section class="asml-productivity-calculator" data-asml-productivity-root data-asml-productivity-lang={lang} data-valid="true" aria-labelledby={`${id}-title`}>
  <header><p class="asml-productivity-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="asml-productivity-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-error`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="asml-productivity-inputs">{fields.map((field, index) => <label for={`${id}-${field}`}><span>{copy.labels[index]}</span><input id={`${id}-${field}`} name={field} type="number" min={ASML_PRODUCTIVITY_LIMITS[field][0]} max={ASML_PRODUCTIVITY_LIMITS[field][1]} step="0.001" value={ASML_PRODUCTIVITY_DEFAULTS[field]} inputmode="decimal" required autocomplete="off" aria-describedby={`${id}-${field}-bounds ${id}-error`} /><small id={`${id}-${field}-bounds`}>{copy.bounds[index]}</small></label>)}</div>
      <div class="asml-productivity-buttons"><button type="button" data-asml-full-use>{copy.preset}</button><button type="reset">{copy.reset}</button></div>
    </fieldset><p class="asml-productivity-error" id={`${id}-error`} data-error role="alert" hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
  </details>
  <p class="asml-productivity-scenario" data-scenario>{copy.initial}</p>
  <dl class="asml-productivity-results">{ASML_PRODUCTIVITY_RESULTS.map((field, index) => <div><dt>{copy.resultLabels[index]}</dt><dd><output data-asml-productivity-result={field} aria-live="off">{asmlProductivityDisplay(initial, field, lang)}</output> <small data-asml-result-unit={field}>{copy.units[index]}</small></dd></div>)}</dl>
  <p class="asml-productivity-comparison" data-asml-delta-note>{notes.delta}</p><p data-asml-catchup-note>{notes.catchup}</p>
  <figure class="asml-productivity-chart" data-asml-chart-wrap>
    <figcaption>{copy.chartTitle}</figcaption><p class="asml-productivity-chart-unit" data-asml-chart-unit>{asmlProductivityPlot(initial, 'mobile', lang).unit}</p>
    {modes.map(mode => {
      const plot = asmlProductivityPlot(initial, mode, lang), mobile = mode === 'mobile', width = mobile ? 280 : 640, height = mobile ? 245 : 320;
      return <svg class={`asml-productivity-plot asml-productivity-plot-${mode}`} data-asml-plot={mode} xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${width} ${height}`} style="width:100%;height:auto;" role="img" aria-labelledby={`${id}-${mode}-chart-title ${id}-${mode}-chart-desc`}>
        <title id={`${id}-${mode}-chart-title`}>{copy.chartTitle}</title><desc id={`${id}-${mode}-chart-desc`}>{notes.description}</desc>
        <rect class="asml-productivity-downtime" data-asml-downtime x={plot.left} y={plot.top} width={plot.downtimeWidth} height={plot.bottom - plot.top} />
        {plot.yTicks.map(tick => <g><line class="asml-productivity-grid" data-asml-grid x1={plot.left} x2={plot.right} y1={tick.y} y2={tick.y} /><text data-asml-y-tick x={plot.left - 8} y={Number(tick.y) + 5} text-anchor="end">{tick.label}</text></g>)}
        <path class="asml-productivity-baseline" data-asml-baseline d={plot.baseline} /><path class="asml-productivity-upgraded" data-asml-upgraded d={plot.upgraded} />
        <circle class="asml-productivity-catchup" data-asml-catchup cx={plot.catchupX} cy={plot.catchupY} r={mobile ? 4 : 5} visibility={plot.catchupVisible ? 'visible' : 'hidden'} />
        {plot.xTicks.map((tick, index) => <text data-asml-x-tick x={tick.x} y={plot.bottom + (mobile ? 23 : 25)} text-anchor={index === 0 ? 'start' : index === plot.xTicks.length - 1 ? 'end' : 'middle'}>{tick.label}</text>)}
        <text x={plot.left} y={height - 12}>{copy.dayAxis}</text>
      </svg>;
    })}
    <div class="asml-productivity-legend"><span class="asml-productivity-key-baseline">{copy.baseline}</span><span class="asml-productivity-key-upgraded">{copy.upgraded}</span><span class="asml-productivity-key-downtime">{copy.down}</span></div>
  </figure>
  <p class="asml-productivity-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="asml-productivity-method"><summary>{copy.method}</summary><p>{copy.methodText}</p><p class="asml-productivity-formula">{copy.formula}</p><p>{copy.historical}</p><p><a href={source}>{copy.source}</a></p><p>{copy.privacy}</p></details>
</section>
<script>import '../lib/asmlProductivityUi.mjs';</script>
<style>
  .asml-productivity-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:clamp(.875rem,3vw,1.25rem);border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.asml-productivity-calculator *{box-sizing:border-box}.asml-productivity-calculator header,.asml-productivity-calculator details,.asml-productivity-calculator form,.asml-productivity-calculator fieldset{min-width:0}.asml-productivity-calculator .asml-productivity-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.asml-productivity-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.asml-productivity-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.asml-productivity-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.asml-productivity-calculator details{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.asml-productivity-calculator fieldset{margin:1rem 0;border:0;padding:0}.asml-productivity-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.asml-productivity-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.asml-productivity-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.asml-productivity-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;margin-top:.4rem;padding:.5rem .6rem;border:1px solid var(--color-line-strong);border-radius:.3rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-variant-numeric:tabular-nums}.asml-productivity-inputs small{display:block;color:var(--color-muted);font-size:.8125rem;line-height:1.6;margin-top:.3rem}.asml-productivity-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.asml-productivity-buttons{display:flex;flex-wrap:wrap;gap:.6rem}.asml-productivity-calculator button{max-width:100%;min-height:2.75rem;margin-top:1rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.asml-productivity-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.asml-productivity-calculator .asml-productivity-error{color:var(--color-accent)}.asml-productivity-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.asml-productivity-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.asml-productivity-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.asml-productivity-results dd{margin:.25rem 0 0;font:700 1.125rem/1.5 var(--font-mono);color:var(--color-signal);overflow-wrap:anywhere}.asml-productivity-results small{font-size:.8125rem;font-weight:400;color:var(--color-muted)}.asml-productivity-calculator .asml-productivity-comparison{color:var(--color-paper);font-weight:700}.asml-productivity-chart{margin:1.5rem 0;padding:0;min-width:0}.asml-productivity-chart figcaption{font-size:.9375rem;line-height:1.6;color:var(--color-paper);font-weight:700}.asml-productivity-calculator .asml-productivity-chart-unit{margin:.3rem 0;font-size:.8125rem}.asml-productivity-plot{display:block;margin:.5rem auto;color:var(--color-muted);font:15px var(--font-mono)}.asml-productivity-plot-mobile{display:none;max-width:22rem;font-size:16px}.asml-productivity-plot text{fill:currentColor}.asml-productivity-grid{stroke:var(--color-line-strong);stroke-width:1}.asml-productivity-baseline{fill:none;stroke:var(--color-muted);stroke-width:3;stroke-dasharray:7 4}.asml-productivity-upgraded{fill:none;stroke:var(--color-signal);stroke-width:3}.asml-productivity-downtime{fill:var(--color-amber);opacity:.15}.asml-productivity-catchup{fill:var(--color-signal);stroke:var(--color-surface);stroke-width:2}.asml-productivity-legend{display:flex;gap:.6rem 1rem;flex-wrap:wrap;font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.asml-productivity-legend span{display:flex;align-items:center;gap:.4rem}.asml-productivity-legend span:before{content:'';width:1.2rem;border-top:3px solid var(--color-muted)}.asml-productivity-key-baseline:before{border-top-style:dashed!important}.asml-productivity-key-upgraded:before{border-top-color:var(--color-signal)!important}.asml-productivity-key-downtime:before{border-top-color:var(--color-amber)!important}.asml-productivity-calculator .asml-productivity-formula{font-family:var(--font-mono);font-variant-numeric:tabular-nums;color:var(--color-paper);overflow-wrap:anywhere}.asml-productivity-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:540px){.asml-productivity-plot-desktop{display:none}.asml-productivity-plot-mobile{display:block}}@container(max-width:420px){.asml-productivity-inputs,.asml-productivity-results{grid-template-columns:minmax(0,1fr)}.asml-productivity-calculator h3{font-size:1.2rem}}
</style>
