<text x="330" y="287" font-size="21" fill="#b8c8db" font-weight="400" text-anchor="middle">30</text>
<line x1="410" y1="96" x2="410" y2="262" stroke="#344352" stroke-width="1.5"/>
<text x="410" y="287" font-size="21" fill="#b8c8db" font-weight="400" text-anchor="middle">40</text>
