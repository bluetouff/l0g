---
import FreshnessBadge from './FreshnessBadge.astro';
import PublicationDates from './PublicationDates.astro';
import { keepFrenchPunctuation } from '../lib/typography.ts';

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: number;
  accent?: string;
  accentLabel?: string;
  imageSrc?: string;
  lang?: 'fr' | 'en';
  headingLevel?: 'h2' | 'h3';
}
const {
  url, title, description, pubDate, updatedDate, imageSrc,
  readingTime, accent = 'var(--color-signal)', accentLabel,
  lang = 'fr', headingLevel = 'h2',
} = Astro.props;
const refDate = updatedDate ?? pubDate;
const en = lang === 'en';
const Heading = headingLevel;
const headline = en ? title : keepFrenchPunctuation(title);
const summary = en ? description : keepFrenchPunctuation(description);
---

<a href={url} class="post-hero" style={`--a:${accent}`}>
  <article class="post-hero-inner">
    <div class="hero-top">
      <span class="hero-mark">{en ? 'Featured investigation' : 'À la une'}</span>
      {accentLabel && <span class="topic-chip">{accentLabel}</span>}
    </div>

    <Heading class="hero-title">{headline}</Heading>

    <div class:list={['hero-summary', { 'has-image': Boolean(imageSrc) }]}>
      {imageSrc && <img class="hero-image" src={imageSrc} alt="" width="1200" height="630" loading="lazy" decoding="async" />}
      <p class="hero-desc">{summary}</p>
    </div>

    <div class="hero-meta">
      <span class="hero-date"><PublicationDates pubDate={pubDate} updatedDate={updatedDate} lang={lang} month={en ? 'short' : 'long'} /></span>
      {readingTime && <span class="hero-reading-time">{readingTime} min</span>}
      {!en && <FreshnessBadge date={refDate} compact />}
      <span class="hero-cta">{en ? 'Read the investigation' : 'Lire l’analyse'} <span class="hero-arrow" aria-hidden="true">&rsaquo;</span></span>
    </div>
  </article>
</a>

<style>
  .post-hero { display: block; color: inherit; text-decoration: none; }
  .post-hero-inner {
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.3rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--surface-elevated);
    box-shadow: var(--shadow-card);
    transition: border-color .18s;
  }
  .post-hero:hover .post-hero-inner { border-color: color-mix(in srgb, var(--a) 55%, var(--color-line)); }
  .post-hero:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; border-radius: var(--radius-panel); }
  .hero-top { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem .8rem; }
  .hero-mark, .topic-chip { font: 600 .62rem/1.5 var(--font-mono); letter-spacing: .065em; text-transform: uppercase; }
  .hero-mark { color: var(--a); }
  .topic-chip { border-left: 1px solid var(--color-line); padding-left: .8rem; color: var(--color-muted); }
  .hero-title {
    margin: .65rem 0 0;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: var(--section-title-size);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -.025em;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    transition: color .18s;
  }
  .post-hero:hover .hero-title { color: var(--a); }
  .hero-summary { display: grid; align-items: center; gap: .75rem; margin-top: .85rem; }
  .hero-summary.has-image { grid-template-columns: 5.25rem minmax(0, 1fr); }
  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 40 / 21;
    object-fit: cover;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-panel) / 2);
  }
  .hero-desc {
    min-width: 0;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-paper);
    font: .91rem/1.6 var(--font-read);
  }
  .hero-meta { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem .85rem; margin-top: .95rem; border-top: 1px solid var(--color-line); padding-top: .7rem; }
  .hero-date, .hero-reading-time, .hero-cta { font: 500 .65rem/1.6 var(--font-mono); }
  .hero-date { color: var(--color-muted); }
  .hero-reading-time { color: var(--color-muted); }
  .hero-cta { display: inline-flex; align-items: center; gap: .4rem; margin-left: auto; color: var(--a); }
  .hero-arrow { font-size: 1rem; line-height: 1; }
  @media (min-width: 640px) {
    .hero-summary.has-image { grid-template-columns: min(35%, 13.75rem) minmax(0, 1fr); gap: 1.15rem; }
    .hero-desc { -webkit-line-clamp: 3; font-size: .95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-hero-inner, .hero-title { transition: none; }
  }
</style>
