---
import L0gGlyph, { type GlyphName } from './L0gGlyph.astro';

interface Props {
  path?: string;
}

interface SidebarLink {
  href: string;
  label: string;
  detail: string;
}

interface Context {
  eyebrow: string;
  title: string;
  description: string;
  glyph: GlyphName;
  accent: string;
  links: SidebarLink[];
}

const { path = '/' } = Astro.props;

const contexts: Record<string, Context> = {
  understand: {
    eyebrow: 'carte de lecture',
    title: 'Construire ses repères.',
    description: 'Un dossier pour suivre un fil, un guide pour apprendre, une définition pour débloquer un mot.',
    glyph: 'understand',
    accent: 'var(--color-signal)',
    links: [
      { href: '/sujets/', label: 'Sujets suivis', detail: 'Les fils longs du journal' },
      { href: '/guides/', label: 'Guides de référence', detail: 'Les notions qui durent' },
      { href: '/glossaire/', label: 'Atlas du glossaire', detail: 'Définitions et concepts voisins' },
    ],
  },
  verify: {
    eyebrow: 'chaîne de preuve',
    title: 'Vérifier avant de conclure.',
    description: 'Revenir à la source, comprendre le calcul et lire les limites avant d’utiliser un signal.',
    glyph: 'verify',
    accent: 'var(--color-accent)',
    links: [
      { href: '/methodologie/', label: 'Méthodologie', detail: 'Formules, seuils et limites' },
      { href: '/sources/', label: 'Sources primaires', detail: 'Institutions et cadences' },
      { href: '/preuves/', label: 'Preuves publiques', detail: 'Artefacts et traçabilité' },
    ],
  },
  data: {
    eyebrow: 'surface publique',
    title: 'Passer du récit aux données.',
    description: 'Inventaires, séries et contrats machine restent accessibles, citables et rejouables.',
    glyph: 'source',
    accent: 'var(--color-topic-blue)',
    links: [
      { href: '/donnees/', label: 'Jeux de données', detail: 'Formats, licences et fraîcheur' },
      { href: '/series/', label: 'Séries de risque', detail: 'Historique nommé et daté' },
      { href: '/api/', label: 'API publique', detail: 'Contrats et points d’accès' },
    ],
  },
  read: {
    eyebrow: 'navigation éditoriale',
    title: 'Trouver le bon point d’entrée.',
    description: 'Lire l’analyse récente, reprendre un sujet dans la durée ou décoder une notion.',
    glyph: 'read',
    accent: 'var(--color-amber)',
    links: [
      { href: '/maintenant/', label: 'Maintenant', detail: 'Mouvements récents, importance et preuves' },
      { href: '/', label: 'Dernières analyses', detail: 'Le journal, du plus récent au plus ancien' },
      { href: '/sujets/', label: 'Sujets suivis', detail: 'Les dossiers dans la durée' },
    ],
  },
};

const contextKey =
  path.startsWith('/sujet') || path.startsWith('/guides') || path.startsWith('/glossaire') || path.startsWith('/demarrer')
    ? 'understand'
    : path.startsWith('/methodologie') || path.startsWith('/sources') || path.startsWith('/preuves') ||
        path.startsWith('/status') || path.startsWith('/black-box') || path.startsWith('/protocole')
      ? 'verify'
      : path.startsWith('/donnees') || path.startsWith('/api') || path.startsWith('/mcp') ||
          path.startsWith('/agents') || path.startsWith('/series') || path.startsWith('/backtests')
        ? 'data'
        : 'read';

const context = contexts[contextKey];
const pageSections: Record<string, SidebarLink[]> = {
  '/glossaire/': [{href:'#definitions',label:'Les définitions',detail:'Chercher un mot'}, {href:'#reference-list-title',label:'Fiches de référence',detail:'Mécanismes documentés'}, {href:'#atlas-title',label:'Concepts reliés',detail:'Explorer les relations'}],
  '/sujets/': [{href:'#dossiers',label:'Tous les dossiers',detail:'Choisir un sujet'}],
  '/methodologie/': [{href:'#chaine-du-signal',label:'Du document au signal',detail:'Comprendre les étapes'}, {href:'#fiches-instrument',label:'Les instruments',detail:'Formules et limites'}, {href:'#historique-backtests',label:'Historique et backtests',detail:'Lire les observations'}],
  '/about/': [{href:'#bluetouff',label:'L’auteur',detail:'Olivier Laurelli / bluetouff'}, {href:'#identite-editoriale',label:'Identité éditoriale',detail:'Publication et indépendance'}, {href:'#philosophie',label:'Principes',detail:'La ligne du journal'}],
};
const inPage = pageSections[path] ?? [];
const associated = context.links.filter(link => link.href !== path).slice(0, 2);
---

<div class="context-sidebar">
  {inPage.length > 0 && <nav class="context-links in-page" aria-label="Dans cette page">
    <h2>Dans cette page</h2>
    {inPage.map(link => <a href={link.href}><strong>{link.label}</strong><small>{link.detail}</small></a>)}
  </nav>}
  <nav class="context-links" aria-label="Accès associés">
    <div class="context-head"><L0gGlyph name={context.glyph} size="sm" /><h2>Pour poursuivre</h2></div>
    {associated.map(link => <a href={link.href}><strong>{link.label}</strong><small>{link.detail}</small><span aria-hidden="true">↗</span></a>)}
  </nav>
  <p class="context-note">Sources citées · limites visibles<br />aucun cookie · aucun tracker</p>
</div>
<style>
  .context-sidebar { display:grid; gap:1.65rem; padding-left:1rem; border-left:1px solid var(--color-line); }
  .context-head { display:flex; align-items:center; gap:.55rem; margin-bottom:.5rem; }
  .context-head :global(.l0g-glyph) { --glyph-size:1.6rem; }
  .context-links h2 { color:var(--color-muted); font:400 .65rem/1.5 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
  .in-page h2 { margin-bottom:.5rem; color:var(--color-signal); }
  .context-links a { position:relative; display:grid; gap:.2rem; padding:.7rem 1rem .7rem 0; min-height:44px; border-bottom:1px solid var(--color-line); }
  .context-links strong { color:var(--color-paper); font:450 .83rem/1.5 var(--font-read); }
  .context-links small { color:var(--color-muted); font:400 .73rem/1.6 var(--font-read); }
  .context-links a > span { position:absolute; right:0; top:.75rem; color:var(--color-signal); font-size:.75rem; }
  .context-links a:hover strong { color:var(--color-signal); }
  .context-links a:focus-visible { outline:2px solid var(--color-signal); outline-offset:4px; }
  .context-note { color:var(--color-muted); font:400 .65rem/1.7 var(--font-read); }
</style>
