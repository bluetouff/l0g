---
import { LEARNING_TIME_FIELDS, LEARNING_TIME_DEFAULTS, calculateLearningTime, formatLearningTime, formatLearningTimeCount } from '../lib/learningTimeCalculator.mjs';
import { learningTimeCopy } from '../lib/learningTimeCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = learningTimeCopy(lang), initial = calculateLearningTime(LEARNING_TIME_DEFAULTS), id = `learning-time-${lang}`;
const outputs = ['net', 'baseline', 'assisted', 'learning', 'other', 'sessions', 'remainder'] as const;
---
<section class="learning-time-calculator" data-learning-time-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="learning-time-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="learning-time-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="learning-time-fields">{LEARNING_TIME_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode={key === 'cases' ? 'numeric' : 'decimal'} maxlength="10" value={LEARNING_TIME_DEFAULTS[key as keyof typeof LEARNING_TIME_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div>
      <div class="learning-time-presets" role="group" aria-label={copy.presets}>{['0', '50', '100'].map((value, i) => <button type="button" data-learning-share={value} aria-pressed={value === '50'}>{copy.presetLabels[i]}</button>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p id={`${id}-bounds`}>{copy.bounds}</p><p class="learning-time-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <dl class="learning-time-results">{outputs.map((key, index) => <div><dt>{copy.labels[index]}</dt><dd><output data-learning-time-output={key}>{key === 'sessions' ? formatLearningTimeCount(initial[key], lang) : formatLearningTime(initial[key], lang)}</output></dd></div>)}</dl>
    <p class="learning-time-balance" data-time-balance data-extra-load="false">{copy.positive}</p>
    <p class="learning-time-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="learning-time-method"><summary>{copy.method}</summary><p>{copy.formula}</p><p>{copy.scope}</p><p>{copy.mentor}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/learningTimeCalculatorUi.mjs';</script>
<style>
.learning-time-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.learning-time-calculator *{box-sizing:border-box}.learning-time-calculator header,.learning-time-calculator details,.learning-time-calculator form,.learning-time-calculator fieldset{min-width:0}.learning-time-calculator .learning-time-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.learning-time-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.learning-time-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.learning-time-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.learning-time-controls,.learning-time-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.learning-time-calculator fieldset{margin:1rem 0;border:0;padding:0}.learning-time-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.learning-time-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.learning-time-fields label{display:flex;flex-direction:column;min-width:0;font-size:.9375rem;line-height:1.5}.learning-time-fields span{display:block;margin-bottom:.35rem}.learning-time-fields input{margin-top:auto;width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.learning-time-fields [aria-invalid=true]{border-color:var(--color-accent)}.learning-time-calculator button{min-width:0;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.learning-time-calculator button[aria-pressed=true]{border-color:var(--color-signal);color:var(--color-signal)}.learning-time-presets{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}.learning-time-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.learning-time-calculator .learning-time-error{color:var(--color-accent)}.learning-time-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.learning-time-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.learning-time-results>div:first-child{grid-column:1/-1;border-color:var(--color-signal)}.learning-time-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.learning-time-results dd{margin:.25rem 0 0;font:700 1rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.learning-time-results>div:first-child output{color:var(--color-signal)}.learning-time-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.learning-time-fields,.learning-time-results{grid-template-columns:minmax(0,1fr)}.learning-time-calculator h3{font-size:1.2rem}}

.learning-time-calculator .learning-time-balance[data-extra-load=true]{color:var(--color-accent)}
</style>
