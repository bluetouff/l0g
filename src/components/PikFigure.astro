---
import { pikFigureMeta } from '../lib/pik-financing-figures.mjs';
interface Props { id: '01' | '02' | '03' | '04' | '05' | '06'; lang: 'fr' | 'en'; }
const { id, lang } = Astro.props;
const { caption, method, sources: refs } = pikFigureMeta(lang, id);
const modules = import.meta.glob('../figures/pik-financing/*.svg', { query: '?raw', import: 'default', eager: true });
const key = `../figures/pik-financing/${lang}-${id}`;
const desktop = modules[`${key}.svg`], mobile = modules[`${key}-mobile.svg`];
if (typeof desktop !== 'string' || typeof mobile !== 'string') throw new TypeError('Missing reviewed PIK figure');
const labels = lang === 'fr' ? { method: 'Méthode et périmètre' } : { method: 'Method and scope' };
---
<figure class="pik-figure" id={`figure-${id}`} data-kind={id}>
  <div class="figure-wide" set:html={desktop} />
  <div class="figure-narrow" set:html={mobile} />
  <figcaption><strong>FIG. {id}</strong> {caption}
    <span class="figure-cites">{refs.map((ref, index) => <Fragment>{index > 0 ? ', ' : ''}<a href={`#source-${ref.toLowerCase()}`}>[{ref}]</a></Fragment>)}</span>
  </figcaption>
  <details><summary>{labels.method}</summary><p>{method}</p></details>
  <slot />
</figure>
<style>
  @font-face { font-family: 'l0g PIK'; src: url('/fonts/stablecoins/dejavu-sans-400.ttf') format('truetype'); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: 'l0g PIK'; src: url('/fonts/stablecoins/dejavu-sans-700.ttf') format('truetype'); font-style: normal; font-weight: 700; font-display: swap; }
  .pik-figure { max-width: 48rem; width: 100%; margin: 2.5rem auto; padding-bottom: 1rem; overflow: visible; container-type: inline-size; }
  .pik-figure :global(svg) { width: 100%; max-width: 100%; height: auto; display: block; letter-spacing: normal; overflow: visible; }
  .figure-wide { display: block; width: 100%; }
  .figure-narrow { display: none; width: 100%; max-width: 310px; margin-inline: auto; }
  figcaption { color: var(--color-muted); font-size: .9rem; line-height: 1.7; margin: 1rem 0 .65rem; }
  figcaption strong { margin-right: .6rem; }
  .figure-cites { display: block; margin: .4rem 0; }
  .figure-cites a { margin-right: .75rem; }
  .pik-figure :global(details) { font-size: .875rem; line-height: 1.7; }
  .pik-figure :global(summary) { cursor: pointer; padding: .35rem 0; }
  .pik-figure :global(details p) { margin: .7rem 0; }
  .pik-figure :global(summary:focus-visible) { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  @container (max-width: 500px) { .figure-wide { display: none; } .figure-narrow { display: block; } }
  @media print { .pik-figure { break-inside: avoid; } .figure-wide { display: block; } .figure-narrow { display: none; } }
  :global(article:has(.pik-figure) .post-title) { hyphens: none; word-break: normal; overflow-wrap: normal; }
</style>
