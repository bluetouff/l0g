---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  headingLevel?: 'h2' | 'h3';
  lang?: 'fr' | 'en';
  publication?: 'epstein' | 'auditer-opacite' | 'digital-euro' | 'water-electricity' | 'e-invoicing' | 'digital-identity';
}

const { headingLevel = 'h2', lang = 'fr', publication = 'epstein' } = Astro.props;
const Heading = headingLevel;
const isEnglish = lang === 'en';
const isAuditer = !isEnglish && publication === 'auditer-opacite';
const isDigitalIdentity = !isEnglish && publication === 'digital-identity';
const isDigitalEuro = publication === 'digital-euro';
const isWaterElectricity = publication === 'water-electricity';
const isEInvoicing = publication === 'e-invoicing';
const publicationUrl = isDigitalIdentity
  ? '/publications/votre-identite-dans-un-telephone/'
  : isEInvoicing
  ? isEnglish ? '/en/publications/great-e-invoicing-toll/' : '/publications/grand-peage-facture/'
  : isWaterElectricity
  ? isEnglish ? '/en/publications/water-electricity/' : '/publications/eau-electricite/'
  : isDigitalEuro
  ? isEnglish ? '/en/publications/digital-euro/' : '/publications/euro-numerique/'
  : isAuditer
  ? '/publications/auditer-l-opacite/'
  : isEnglish
    ? '/en/publications/epsteins-money/'
    : '/publications/l-argent-d-epstein/';
const epubFile = isDigitalIdentity
  ? 'votre-identite-dans-un-telephone-enquete-l0g.epub'
  : isEInvoicing
  ? isEnglish ? 'great-e-invoicing-toll-investigation-l0g.epub' : 'grand-peage-facture-enquete-l0g.epub'
  : isWaterElectricity
  ? isEnglish ? 'water-electricity-europe-l0g.epub' : 'eau-electricite-europe-l0g.epub'
  : isDigitalEuro
  ? isEnglish ? 'digital-euro-investigation-l0g.epub' : 'euro-numerique-enquete-l0g.epub'
  : isAuditer
  ? 'auditer-l-opacite-bluetouff.epub'
  : isEnglish
    ? 'epsteins-money-l0g.epub'
    : 'l-argent-d-epstein-l0g.epub';
const epubUrl = `/publications/${epubFile}`;
const coverUrl = isDigitalIdentity
  ? '/publications/votre-identite-dans-un-telephone-cover.jpg'
  : isEInvoicing
  ? isEnglish ? '/publications/great-e-invoicing-toll-cover.png' : '/publications/grand-peage-facture-cover.png'
  : isWaterElectricity
  ? isEnglish ? '/publications/water-electricity-cover.png' : '/publications/eau-electricite-cover.png'
  : isDigitalEuro
  ? isEnglish ? '/publications/digital-euro-cover.png' : '/publications/euro-numerique-cover.png'
  : isAuditer
  ? '/publications/auditer-l-opacite-cover.jpg'
  : isEnglish
    ? '/publications/epsteins-money-cover.png'
    : '/publications/l-argent-d-epstein-cover.png';
const epubPath = join(process.cwd(), 'public/publications', epubFile);
const epubBytes = readFileSync(epubPath).length;
const formattedSize = `${new Intl.NumberFormat(isEnglish ? 'en-US' : 'fr-FR', { maximumFractionDigits: 0 }).format(epubBytes / 1024)} ${isEnglish ? 'KB' : 'Ko'}`;
const copy = isDigitalIdentity
  ? {
      coverLabel: 'Découvrir Votre identité dans un téléphone',
      coverAlt: 'Couverture de Votre identité dans un téléphone',
      meta: '// enquête illustrée · août 2026',
      titleLead: 'Votre identité',
      titleAccent: 'dans un téléphone',
      deck: 'France Identité, portefeuille européen et preuves de souveraineté.',
      description: 'Huit enquêtes sur les données, les alternatives, les contrats, les coûts, les plateformes et les traces de l’identité numérique.',
      factsLabel: 'Contenu de l’édition',
      facts: [{ value: '8', label: 'enquêtes' }, { value: '23', label: 'infographies' }, { value: '6', label: 'outils' }, { value: formattedSize, label: 'téléchargement' }],
      discover: 'Découvrir l’enquête',
      downloadLabel: 'Télécharger l’EPUB',
      fileName: 'Votre-identite-dans-un-telephone-l0g.epub',
    }
  : isEInvoicing
  ? isEnglish
    ? {
        coverLabel: 'Discover The Great E-Invoicing Toll', coverAlt: 'Cover of The Great E-Invoicing Toll', meta: '// illustrated investigation · August 2026',
        titleLead: 'The Great', titleAccent: 'E-Invoicing Toll', deck: 'Public portal, platforms, prices, data and continuity.',
        description: 'Five investigations into France’s mandatory e-invoicing infrastructure, with ten infographics, clickable sources and links to three practical tools.',
        factsLabel: 'Edition contents', facts: [{ value: '5', label: 'investigations' }, { value: '10', label: 'infographics' }, { value: '3', label: 'linked tools' }, { value: formattedSize, label: 'download' }],
        discover: 'Explore the edition', downloadLabel: 'Download the EPUB', fileName: 'The-Great-E-Invoicing-Toll-l0g.epub',
      }
    : {
        coverLabel: 'Découvrir Le grand péage de la facture', coverAlt: 'Couverture du Grand péage de la facture', meta: '// enquête illustrée · août 2026',
        titleLead: 'Le grand péage', titleAccent: 'de la facture', deck: 'Portail public, plateformes, prix, données et continuité.',
        description: 'Cinq enquêtes sur l’infrastructure obligatoire de la facture électronique, avec dix infographies, des sources cliquables et trois outils pratiques.',
        factsLabel: 'Contenu de l’édition', facts: [{ value: '5', label: 'enquêtes' }, { value: '10', label: 'infographies' }, { value: '3', label: 'outils liés' }, { value: formattedSize, label: 'téléchargement' }],
        discover: 'Découvrir l’enquête', downloadLabel: 'Télécharger l’EPUB', fileName: 'Le-grand-peage-de-la-facture-l0g.epub',
      }
  : isWaterElectricity
  ? isEnglish
    ? {
        coverLabel: 'Discover The Water Behind Electricity', coverAlt: 'Cover of The Water Behind Electricity', meta: '// illustrated investigation · August 2026',
        titleLead: 'The water behind', titleAccent: 'electricity', deck: 'Danube, dams, power plants, grid and adaptation.',
        description: 'Six investigations following the physical water behind European electricity, with 20 infographics, primary sources and links to six educational tools.',
        factsLabel: 'Edition contents', facts: [{ value: '6', label: 'investigations' }, { value: '20', label: 'infographics' }, { value: '6', label: 'linked tools' }, { value: formattedSize, label: 'download' }],
        discover: 'Explore the edition', downloadLabel: 'Download the EPUB', fileName: 'The-Water-Behind-Electricity-l0g.epub',
      }
    : {
        coverLabel: 'Découvrir L’eau derrière l’électricité', coverAlt: 'Couverture de L’eau derrière l’électricité', meta: '// enquête illustrée · août 2026',
        titleLead: 'L’eau derrière', titleAccent: 'l’électricité', deck: 'Danube, barrages, centrales, réseau et adaptation.',
        description: 'Six enquêtes sur l’eau physique de l’électricité européenne, avec 20 infographies, des sources primaires et les liens vers six outils pédagogiques.',
        factsLabel: 'Contenu de l’édition', facts: [{ value: '6', label: 'enquêtes' }, { value: '20', label: 'infographies' }, { value: '6', label: 'outils liés' }, { value: formattedSize, label: 'téléchargement' }],
        discover: 'Découvrir l’enquête', downloadLabel: 'Télécharger l’EPUB', fileName: 'L-eau-derriere-l-electricite-l0g.epub',
      }
  : isDigitalEuro
  ? isEnglish
    ? {
        coverLabel: 'Discover The Digital Euro', coverAlt: 'Cover of The Digital Euro', meta: '// open-source investigation · August 2026',
        titleLead: 'The Digital', titleAccent: 'Euro', deck: 'Balance sheets, data, law, costs and infrastructure.',
        description: 'Six investigations into a currency that does not yet exist, with public records, test assumptions, unresolved choices and verification limits kept distinct.',
        factsLabel: 'Edition contents', facts: [{ value: '6', label: 'investigations' }, { value: '23', label: 'infographics' }, { value: formattedSize, label: 'download' }, { value: 'CC BY 4.0', label: 'license' }],
        discover: 'Explore the edition', downloadLabel: 'Download the EPUB', fileName: 'The-Digital-Euro-l0g.epub',
      }
    : {
        coverLabel: 'Découvrir L’euro numérique', coverAlt: 'Couverture de L’euro numérique', meta: '// enquête en sources ouvertes · août 2026',
        titleLead: 'L’euro', titleAccent: 'numérique', deck: 'Bilans, données, droit, coûts et infrastructure.',
        description: 'Six enquêtes sur une monnaie qui n’existe pas encore, en séparant pièces publiques, hypothèses de test, choix ouverts et limites de vérification.',
        factsLabel: 'Contenu de l’édition', facts: [{ value: '6', label: 'enquêtes' }, { value: '22', label: 'infographies' }, { value: formattedSize, label: 'téléchargement' }, { value: 'CC BY 4.0', label: 'licence' }],
        discover: 'Découvrir l’enquête', downloadLabel: 'Télécharger l’EPUB', fileName: 'Euro-numerique-l0g.epub',
      }
  : isAuditer
  ? {
      coverLabel: 'Découvrir l’essai Auditer l’Opacité',
      coverAlt: 'Couverture de l’essai Auditer l’Opacité de Bluetouff',
      meta: '// essai · édition l0g · mai 2026',
      titleLead: 'Auditer',
      titleAccent: 'l’opacité',
      deck: 'Anatomie d’une crise qu’on ne veut pas voir.',
      description: 'Un essai en treize chapitres pour lire les zones d’opacité et les canaux de transmission du risque dans la finance contemporaine, sans calendrier d’effondrement.',
      factsLabel: 'Contenu de l’essai',
      facts: [
        { value: '13', label: 'chapitres' },
        { value: '5', label: 'parties' },
        { value: formattedSize, label: 'téléchargement' },
        { value: 'Sources', label: 'bibliographie + lexique' },
      ],
      discover: 'Découvrir l’essai',
      downloadLabel: 'Télécharger l’EPUB',
      fileName: 'Auditer-l-opacite-Bluetouff.epub',
    }
  : isEnglish
  ? {
      coverLabel: "Discover the Epstein's Money edition",
      coverAlt: "Cover of Epstein's Money",
      meta: '// complete edition · August 2026',
      titleLead: "Epstein's",
      titleAccent: 'Money',
      deck: 'Fortune, banks, investments and the estate.',
      description: 'Seven investigations in one reading sequence, with their sources, calculations, limitations and unresolved questions.',
      factsLabel: 'Edition contents',
      facts: [
        { value: '7', label: 'investigations' },
        { value: '20', label: 'infographics' },
        { value: formattedSize, label: 'download' },
        { value: 'CC BY 4.0', label: 'license' },
      ],
      discover: 'Explore the edition',
      downloadLabel: 'Download the EPUB',
      fileName: 'Epsteins-Money-l0g.epub',
    }
  : {
      coverLabel: 'Découvrir l’édition L’argent d’Epstein',
      coverAlt: 'Couverture de L’argent d’Epstein',
      meta: '// édition complète · août 2026',
      titleLead: 'L’argent',
      titleAccent: 'd’Epstein',
      deck: 'Fortune, banques, investissements et succession.',
      description: 'Sept enquêtes dans un ordre de lecture continu, avec sources, calculs, limites et questions ouvertes.',
      factsLabel: 'Contenu de l’édition',
      facts: [
        { value: '7', label: 'enquêtes' },
        { value: '20', label: 'infographies' },
        { value: formattedSize, label: 'téléchargement' },
        { value: 'CC BY 4.0', label: 'licence' },
      ],
      discover: 'Découvrir l’édition',
      downloadLabel: 'Télécharger l’EPUB',
      fileName: 'L-argent-d-Epstein-l0g.epub',
    };
---

<article class:list={['publication-spotlight', { 'publication-spotlight--auditer': isAuditer, 'publication-spotlight--digital-euro': isDigitalEuro, 'publication-spotlight--water': isWaterElectricity, 'publication-spotlight--invoice': isEInvoicing, 'publication-spotlight--identity': isDigitalIdentity }]}>
  {isDigitalIdentity && (
    <a class="publication-teaser" href={publicationUrl} aria-label="Découvrir les quatre tableaux visuels de l’enquête">
      <img
        src="/illustrations/publications/identite-telephone-chaine.webp"
        width="1200"
        height="675"
        alt="Carte générique, téléphone, terminal, courrier et infrastructure reliés dans une chaîne de services"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  <a class="publication-cover" href={publicationUrl} aria-label={copy.coverLabel}>
    <img
      src={coverUrl}
      width="1024"
      height="1638"
      alt={copy.coverAlt}
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="publication-copy">
    <div class="publication-meta">
      <p class="mono-label">{copy.meta}</p>
      <span>EPUB 3</span>
    </div>
    <Heading><a class="publication-title-link" href={publicationUrl}>{copy.titleLead}{' '}<em>{copy.titleAccent}</em></a></Heading>
    <p class="publication-deck">{copy.deck}</p>
    <p class="publication-description">{copy.description}</p>

    <ul class="publication-facts" aria-label={copy.factsLabel}>
      {copy.facts.map((fact) => <li><strong>{fact.value}</strong><span>{fact.label}</span></li>)}
    </ul>

    <div class="publication-actions">
      <a class="publication-primary" href={publicationUrl}>{copy.discover} <span aria-hidden="true">›</span></a>
      <a class="publication-secondary" href={epubUrl} download={copy.fileName}>
        {copy.downloadLabel}
      </a>
    </div>
  </div>
</article>

<style>
  .publication-spotlight {
    --publication-card-accent: var(--color-amber);
    display: grid;
    grid-template-columns: minmax(10rem, 13.5rem) minmax(0, 1fr);
    gap: clamp(1.2rem, 4vw, 2.4rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--publication-card-accent) 34%, var(--color-line));
    border-radius: 18px;
    padding: clamp(1rem, 3vw, 1.65rem);
    background: var(--color-surface);
  }
  .publication-spotlight--auditer { --publication-card-accent: var(--color-signal); }
  .publication-spotlight--digital-euro { --publication-card-accent: var(--color-signal); }
  .publication-spotlight--water { --publication-card-accent: var(--color-signal); }
  .publication-spotlight--invoice { --publication-card-accent: var(--color-accent); }
  .publication-spotlight--identity { --publication-card-accent: var(--color-signal); }
  .publication-teaser {
    display: block;
    grid-column: 1 / -1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--publication-card-accent) 34%, var(--color-line));
    border-radius: 13px;
    aspect-ratio: 16 / 7;
    background: #071017;
  }
  .publication-teaser img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .publication-teaser:hover img { transform: scale(1.015); }
  .publication-cover {
    display: block;
    align-self: center;
    width: 100%;
    max-width: 13.5rem;
    margin-inline: auto;
  }
  .publication-cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--color-paper) 18%, transparent);
    border-radius: 3px 8px 8px 3px;
    box-shadow: -8px 12px 28px rgba(0, 0, 0, 0.42);
  }
  .publication-copy { align-self: center; min-width: 0; }
  .publication-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem 1rem;
  }
  .publication-meta p { color: var(--publication-card-accent); }
  .publication-meta > span {
    border: 1px solid color-mix(in srgb, var(--publication-card-accent) 45%, var(--color-line));
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    color: var(--publication-card-accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .publication-copy h2,
  .publication-copy h3 {
    margin-top: 0.65rem;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.2vw, 3rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .publication-copy h2 em,
  .publication-copy h3 em { color: var(--color-accent); font-style: normal; }
  .publication-title-link { color: inherit; text-decoration: none; }
  .publication-title-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--publication-card-accent);
    text-underline-offset: 0.14em;
  }
  .publication-deck {
    margin-top: 0.65rem;
    color: var(--color-paper);
    font-family: var(--font-read);
    font-size: clamp(0.98rem, 2vw, 1.16rem);
    line-height: 1.45;
  }
  .publication-description {
    max-width: 43rem;
    margin-top: 0.55rem;
    color: var(--color-muted);
    font-family: var(--font-read);
    font-size: 0.88rem;
    line-height: 1.62;
  }
  .publication-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: 1.1rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 0.7rem 0;
  }
  .publication-facts li {
    min-width: 0;
    border-left: 1px solid var(--color-line);
    padding: 0 0.65rem;
  }
  .publication-facts li:first-child { border-left: 0; padding-left: 0; }
  .publication-facts strong,
  .publication-facts span { display: block; }
  .publication-facts strong {
    overflow-wrap: anywhere;
    color: var(--color-bright);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .publication-facts span {
    margin-top: 0.18rem;
    color: var(--color-muted);
    font-size: 0.67rem;
  }
  .publication-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .publication-actions a {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .publication-primary { color: var(--color-ink); background: var(--publication-card-accent); }
  .publication-primary span { font-size: 1rem; line-height: 0; }
  .publication-secondary { border: 1px solid var(--color-line-strong); color: var(--color-paper); }
  :root[data-theme='light'] .publication-primary { color: #1a1509; }
  @media (max-width: 680px) {
    .publication-spotlight { grid-template-columns: 1fr; gap: 1.35rem; padding: 1rem; }
    .publication-cover { align-self: start; max-width: 10.5rem; }
    .publication-copy { width: 100%; }
    .publication-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .publication-facts li { border-left: 0; padding: 0.35rem 0; }
    .publication-facts li:nth-child(even) { border-left: 1px solid var(--color-line); padding-left: 0.65rem; }
    .publication-actions { display: grid; grid-template-columns: 1fr; }
    .publication-actions a { width: 100%; }
    .publication-teaser { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 430px) {
    .publication-spotlight { align-items: start; padding: 0.85rem; }
    .publication-cover { max-width: 8.7rem; }
    .publication-copy h2,
    .publication-copy h3 { font-size: clamp(1.45rem, 8vw, 1.9rem); }
    .publication-meta { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .publication-teaser img { transition: none; } }
</style>
