---
import { getLatestEnglishEpub } from '../lib/latest-english-epub.mjs';

const book = await getLatestEnglishEpub();
const date = book && new Date(`${book.date}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
});
const size = book && `${new Intl.NumberFormat('en-GB', { maximumFractionDigits: 1 }).format(book.bytes / 1024 / 1024)} MB`;
---

{book && (
  <article class="latest-epub" aria-labelledby="latest-epub-title" data-latest-english-epub>
    <div class="epub-edition-line"><p>Latest English EPUB</p><time datetime={book.date}>{date}</time></div>
    <div class="epub-book">
      <a class="epub-cover" href={book.path} tabindex="-1" aria-hidden="true">
        <img src={book.cover} srcset={book.srcset || undefined} sizes={book.srcset ? '(max-width: 360px) 88px, (max-width: 580px) 96px, 120px' : undefined}
          width={book.width} height={book.height} alt="" loading="lazy" decoding="async" />
      </a>
      <div class="epub-copy">
        <h2 id="latest-epub-title"><a href={book.path}>{book.title}</a></h2>
        <p>{book.description}</p>
        <a class="epub-explore" href={book.path}>Explore the book <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="epub-footer">
      <a href={book.epub} download>Download EPUB <span aria-hidden="true">↓</span><span class="epub-file-size">Free · {size}</span></a>
      <a href="/en/publications/" class="epub-all">All books <span aria-hidden="true">↗</span></a>
    </div>
  </article>
)}

<style>
  .latest-epub { padding: 1.2rem; border: 1px solid var(--color-line-strong); border-radius: 12px; background: var(--color-surface); box-shadow: inset 0 1px 0 var(--edge-highlight); }
  .epub-edition-line { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .4rem 1rem; margin-bottom: 1.15rem; font-family: var(--font-mono); font-size: .63rem; line-height: 1.5; }
  .epub-edition-line p { color: var(--color-signal); text-transform: uppercase; letter-spacing: .08em; }
  .epub-edition-line time { color: var(--color-muted); }
  .epub-book { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 1.2rem; align-items: start; }
  .epub-cover { display: block; border: 1px solid var(--color-line); border-radius: 2px 5px 5px 2px; overflow: hidden; box-shadow: 6px 7px 0 var(--surface-inset); }
  .epub-cover img { display: block; width: 100%; height: auto; }
  .epub-copy h2 { margin: 0; color: var(--color-bright); font-family: var(--font-display); font-size: clamp(1.1rem, 1.6vw, 1.35rem); line-height: 1.3; letter-spacing: -.035em; text-wrap: balance; overflow-wrap: anywhere; }
  .epub-copy > p { margin-top: .7rem; color: var(--color-muted); font-family: var(--font-read); font-size: .83rem; line-height: 1.65; }
  .epub-explore { display: inline-flex; align-items: center; gap: .8rem; min-height: 44px; margin-top: .65rem; color: var(--color-signal); font-family: var(--font-mono); font-size: .72rem; }
  .epub-explore:hover { text-decoration: underline; text-underline-offset: 4px; }
  .epub-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem 1rem; margin-top: 1.2rem; padding-top: .75rem; border-top: 1px solid var(--color-line); font-family: var(--font-mono); font-size: .67rem; }
  .epub-footer > a { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .4rem .65rem; min-height: 44px; color: var(--color-paper); }
  .epub-footer > a:hover { color: var(--color-signal); }
  .epub-footer > a > span[aria-hidden] { color: var(--color-signal); }
  .epub-footer .epub-file-size { color: var(--color-muted); font-size: .62rem; }
  .epub-footer .epub-all { color: var(--color-muted); }
  .latest-epub a:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  @media (max-width: 580px) {
    .epub-book { grid-template-columns: 96px minmax(0, 1fr); gap: .75rem 1rem; }
    .epub-cover { grid-column: 1; grid-row: 1 / 3; }
    .epub-copy { display: contents; }
    .epub-copy h2 { grid-column: 2; grid-row: 1; align-self: end; }
    .epub-explore { grid-column: 2; grid-row: 2; align-self: start; margin: 0; }
    .epub-copy > p { grid-column: 1 / -1; grid-row: 3; margin-top: .35rem; }
    .epub-footer > a:first-child { display: grid; grid-template-columns: 1fr auto; gap: .2rem .65rem; }
    .epub-file-size { grid-column: 1 / -1; }
  }
  @media (max-width: 360px) {
    .latest-epub { padding: 1rem; }
    .epub-book { grid-template-columns: 88px minmax(0, 1fr); gap: .9rem; }
    .epub-copy h2 { font-size: 1rem; }
    .epub-copy > p { font-size: .78rem; }
  }
</style>
