---
import { atlases, englishAtlases } from '../config/atlases';
interface Props { current: string; language?: 'fr' | 'en' }
const { current, language = 'fr' } = Astro.props;
const isEnglish = language === 'en';
const entries = isEnglish ? englishAtlases : atlases;
const counterpart = (isEnglish ? atlases : englishAtlases).find(atlas => atlas.id === current);
---

<nav class="atlas-navigation" aria-label={isEnglish ? 'l0g atlases' : 'Les atlas l0g'}>
  <a class="atlas-home mono-label" href={isEnglish ? '/en/atlas/' : '/atlas/'}>← {isEnglish ? 'All atlases' : 'Tous les atlas'}</a>
  {entries.map(atlas => <a href={atlas.href} aria-current={atlas.id === current ? 'page' : undefined}>{atlas.label}</a>)}
  {counterpart && <a href={counterpart.href} hreflang={isEnglish ? 'fr' : 'en'} lang={isEnglish ? 'fr' : 'en'}>{isEnglish ? 'Français' : 'English'}</a>}
</nav>

<style>
  .atlas-navigation { display:flex; align-items:center; flex-wrap:wrap; gap:.65rem 1.2rem; padding:0 0 1rem; margin-bottom:1rem; border-bottom:1px solid var(--color-line); }
  .atlas-navigation .atlas-home { font-size:.7rem; color:var(--color-bright); }
  .atlas-navigation a { display:inline-flex; align-items:center; min-height:44px; font-size:.8rem; color:var(--color-muted); text-underline-offset:5px; }
  .atlas-navigation a[aria-current="page"] { color:var(--color-signal); text-decoration:underline; }
  .atlas-navigation a:focus-visible { outline:2px solid var(--color-signal); outline-offset:4px; }
</style>
