---
import { cumcumEditions } from '../config/cumcum-publication.mjs';

interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const isEn = lang === 'en';
const book = cumcumEditions[lang];
---

<aside class="cumcum-epub" data-pagefind-ignore aria-labelledby="cumcum-epub-title">
  <img src={book.cover}
    srcset={[320, 640].map(width => `${book.cover.replace('.jpg', `-${width}.webp`)} ${width}w`).join(', ')}
    sizes="(max-width: 480px) 72px, 112px" width="1024" height="1638"
    loading="lazy" decoding="async" alt={`${isEn ? 'Cover of' : 'Couverture de'} ${book.title}`} />
  <div>
    <p class="cumcum-epub-label">// {isEn ? 'the complete book' : 'le livre intégral'}</p>
    <h2 id="cumcum-epub-title">{book.title}</h2>
    <p>{isEn
      ? 'The six analyses and 26 infographics, with their sources, an original introduction and conclusion, and an offline glossary. Free EPUB with a dark background.'
      : 'Les six analyses et 26 infographies, avec leurs sources, une introduction et une conclusion originales, et un glossaire hors ligne. EPUB gratuit sur fond sombre.'}</p>
    <a href={book.path}>{isEn ? 'Explore the book' : 'Découvrir le livre'} <span aria-hidden="true">→</span></a>
  </div>
</aside>

<style>
  .cumcum-epub { display:grid; grid-template-columns:7rem minmax(0,1fr); align-items:center; gap:1.35rem; margin:3rem 0 2rem; padding:1.2rem; border:1px solid color-mix(in srgb,var(--color-signal) 38%,var(--color-line)); border-radius:12px; background:var(--color-surface); }
  .cumcum-epub img { display:block; width:100%; height:auto; border:1px solid var(--color-line-strong); border-radius:4px; }
  .cumcum-epub-label { margin:0; color:var(--color-amber); font-family:var(--font-mono); font-size:.62rem; letter-spacing:.08em; text-transform:uppercase; }
  .cumcum-epub h2 { margin:.45rem 0 0; color:var(--color-bright); font-family:var(--font-read); font-size:clamp(1.2rem,3vw,1.65rem); font-weight:650; letter-spacing:-.025em; line-height:1.25; }
  .cumcum-epub p:not(.cumcum-epub-label) { margin:.7rem 0 0; color:var(--color-prose); font-family:var(--font-read); font-size:.87rem; line-height:1.6; }
  .cumcum-epub a { display:inline-flex; align-items:center; gap:.55rem; margin-top:.9rem; color:var(--color-signal); font-family:var(--font-mono); font-size:.7rem; font-weight:700; letter-spacing:.035em; text-decoration:underline; text-underline-offset:4px; }
  .cumcum-epub a:focus-visible { outline:2px solid var(--color-signal); outline-offset:5px; }
  @media(max-width:480px) { .cumcum-epub { grid-template-columns:4.5rem minmax(0,1fr); align-items:start; gap:1rem; padding:1rem; } }
</style>
