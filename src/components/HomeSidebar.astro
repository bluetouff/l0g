---
import PaCheckCard from './PaCheckCard.astro';
import SupportCard from './SupportCard.astro';
import WatchCard from './WatchCard.astro';
---

<div class="home-sidebar">
  <SupportCard />

  <PaCheckCard />

  <WatchCard />

  <section class="side-shortcuts">
    <h2>// raccourcis</h2>
    <a href="/maintenant/">
      <strong>Maintenant</strong>
      <span>Les mouvements récents et les prochaines vérifications</span>
    </a>
    <a href="/demarrer/">
      <strong>Découvrir l0g</strong>
      <span>Comprendre, suivre un risque ou vérifier un chiffre</span>
    </a>
    <a href="/sujets/">
      <strong>Sujets suivis</strong>
      <span>Les dossiers dans la durée</span>
    </a>
    <a href="/hebdo/">
      <strong>La synthèse hebdo</strong>
      <span>Ce qu’il faut retenir</span>
    </a>
  </section>
</div>

<style>
  .home-sidebar { display: grid; gap: 1.5rem; }
  .home-sidebar > section > h2 {
    margin-bottom: 0.7rem;
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .side-shortcuts { display: grid; gap: 0.45rem; }
  .side-shortcuts > h2 { margin-bottom: 0.25rem !important; }
  .side-shortcuts a {
    display: block;
    border-bottom: 1px solid var(--color-line);
    padding: 0.6rem 0;
  }
  .side-shortcuts strong,
  .side-shortcuts span { display: block; }
  .side-shortcuts strong { color: var(--color-paper); font-size: 0.86rem; }
  .side-shortcuts span { margin-top: 0.12rem; color: var(--color-muted); font-size: 0.72rem; }
  .side-shortcuts a:hover strong { color: var(--color-signal); }
  .side-shortcuts a:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; }
</style>
