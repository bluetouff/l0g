---
import { PC_AI_PRICE_FIELDS, PC_AI_PRICE_DEFAULTS, calculatePcAiPrice, formatPcAiPriceMoney, formatPcAiPricePercent } from '../lib/pcAiPriceCalculator.mjs';
import { pcAiPriceCopy } from '../lib/pcAiPriceCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = pcAiPriceCopy(lang), initial = calculatePcAiPrice(PC_AI_PRICE_DEFAULTS), id = `pc-price-${lang}`;
const outputs = ['finalPrice', 'shock', 'passed', 'absorbed', 'relative'] as const;
---
<section class="pc-price-calculator" data-pc-ai-price-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="pc-price-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="pc-price-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="pc-price-fields">{PC_AI_PRICE_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode="decimal" maxlength="9" value={PC_AI_PRICE_DEFAULTS[key as keyof typeof PC_AI_PRICE_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div>
      <div class="pc-price-presets" role="group" aria-label={copy.presets}>{['0', '60', '100'].map((value, i) => <button type="button" data-pass-through={value} aria-pressed={value === '60'}>{copy.presetLabels[i]}</button>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p id={`${id}-bounds`}>{copy.bounds}</p><p class="pc-price-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <dl class="pc-price-results">{outputs.map((key, index) => <div><dt>{copy.labels[index]}</dt><dd><output data-pc-price-output={key}>{key === 'relative' ? formatPcAiPricePercent(initial.increaseNumerator, initial.increaseDenominator, lang) : formatPcAiPriceMoney(initial[key], lang)}</output></dd></div>)}</dl>
    <p class="pc-price-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="pc-price-method"><summary>{copy.method}</summary><p>{copy.formula}</p><p>{copy.scope}</p><p>{copy.absorbed}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/pcAiPriceCalculatorUi.mjs';</script>
<style>
.pc-price-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.pc-price-calculator *{box-sizing:border-box}.pc-price-calculator header,.pc-price-calculator details,.pc-price-calculator form,.pc-price-calculator fieldset{min-width:0}.pc-price-calculator .pc-price-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.pc-price-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.pc-price-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.pc-price-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.pc-price-controls,.pc-price-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.pc-price-calculator fieldset{margin:1rem 0;border:0;padding:0}.pc-price-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.pc-price-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.pc-price-fields label{display:flex;flex-direction:column;min-width:0;font-size:.9375rem;line-height:1.5}.pc-price-fields span{display:block;margin-bottom:.35rem}.pc-price-fields input{margin-top:auto;width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.pc-price-fields [aria-invalid=true]{border-color:var(--color-accent)}.pc-price-calculator button{min-width:0;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.pc-price-calculator button[aria-pressed=true]{border-color:var(--color-signal);color:var(--color-signal)}.pc-price-presets{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}.pc-price-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.pc-price-calculator .pc-price-error{color:var(--color-accent)}.pc-price-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.pc-price-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.pc-price-results>div:first-child{grid-column:1/-1;border-color:var(--color-signal)}.pc-price-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.pc-price-results dd{margin:.25rem 0 0;font:700 1rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.pc-price-results>div:first-child output{color:var(--color-signal)}.pc-price-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.pc-price-fields,.pc-price-results{grid-template-columns:minmax(0,1fr)}.pc-price-calculator h3{font-size:1.2rem}}
</style>
