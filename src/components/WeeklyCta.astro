---
import { latestWeeklyEdition } from '../config/weekly-editions.ts';
interface Props { variant?: 'home' | 'article' | 'now'; }
const { variant = 'article' } = Astro.props;
const edition = latestWeeklyEdition();
const published = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', timeZone: 'Europe/Paris' }).format(new Date(edition.publishedAt));
---
<aside class:list={['weekly-cta', `is-${variant}`]} data-pagefind-ignore aria-label="Lire l’hebdo l0g">
  <div class="weekly-label"><p class="mono-label">// l’hebdo l0g</p><span>N° {String(edition.issue).padStart(2, '0')} · {published}</span></div>
  <strong>{edition.title}</strong>
  <p>Les dossiers à retenir, leurs limites et les prochaines vérifications.</p>
  <a href="/hebdo/">Lire la revue <span aria-hidden="true">↗</span></a>
</aside>
<style>
  .weekly-cta { min-width: 0; border: 1px solid color-mix(in srgb, var(--color-signal) 32%, var(--color-line)); border-top: 2px solid var(--color-signal); border-radius: 4px; padding: 1.05rem; background: linear-gradient(135deg, color-mix(in srgb, var(--color-signal) 7%, transparent), transparent 65%), var(--surface-elevated); }
  .weekly-label { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .4rem .75rem; }
  .weekly-label .mono-label { font-size: .62rem; color: var(--color-signal); }
  .weekly-label > span { color: var(--color-muted); font-family: var(--font-mono); font-size: .55rem; }
  .weekly-cta > strong { display: block; margin-top: .8rem; color: var(--color-bright); font-family: var(--font-display); font-size: .95rem; line-height: 1.5; font-weight: 650; }
  .weekly-cta > p { max-width: 38rem; margin-top: .5rem; color: var(--color-muted); font-family: var(--font-read); font-size: .76rem; line-height: 1.7; }
  .weekly-cta > a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: .9rem; padding-top: .75rem; border-top: 1px solid var(--color-line); color: var(--color-signal); font-family: var(--font-mono); font-size: .65rem; }
  .weekly-cta > a:hover { color: var(--color-bright); }
  .weekly-cta a:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  .is-article { margin-top: 3rem; }
  .is-now { margin-top: 1rem; }
</style>
