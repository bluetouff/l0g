---
import { getCollection } from 'astro:content';
import { financingReadingPaths } from '../config/english-reading-paths.ts';
import { englishEditorialLinks } from '../config/english-editorial-links.ts';

interface Props { id: string; collection: 'postsEn' | 'guidesEn' }
const { id, collection } = Astro.props;
const route = `/en/${collection === 'postsEn' ? 'analysis' : 'guides'}/${id}/`;
const suggestions = englishEditorialLinks.filter((link) => link.from === route);
const path = financingReadingPaths.find((candidate) =>
  (collection === 'postsEn' ? candidate.analysisIds : candidate.guideIds).includes(id));
const analyses = path ? await getCollection('postsEn', ({ data }) => !data.draft) : [];
const neighbours = path?.analysisIds
  .filter((slug) => collection !== 'postsEn' || slug !== id)
  .map((slug) => analyses.find((entry) => entry.id === slug))
  .filter((entry) => entry !== undefined)
  .slice(0, 3) ?? [];
const suggestedResources = await Promise.all(suggestions.map(async (link) => {
  const targetCollection = link.to.startsWith('/en/analysis/') ? 'postsEn' : 'guidesEn';
  const targetId = link.to.split('/').filter(Boolean).at(-1);
  const entry = (await getCollection(targetCollection, ({ data }) => !data.draft))
    .find((candidate) => candidate.id === targetId);
  if (!entry) throw new Error(`Missing editorial reading suggestion: ${link.to}`);
  return { ...link, title: entry.data.title };
}));
const neighbourHrefs = new Set(neighbours.map((entry) => `/en/analysis/${entry.id}/`));
const additionalResources = suggestedResources.filter((link) => !neighbourHrefs.has(link.to));
---

{(path || additionalResources.length > 0) && (
  <nav class="related-reading" aria-labelledby="related-reading-title" data-pagefind-ignore>
    <h2 id="related-reading-title">{path?.title ?? 'Continue the analysis'}</h2>
    {path && <p>{path.description}</p>}
    <ul>
      {path && <li><a href={path.atlasHref}>{path.atlasLabel}</a></li>}
      {neighbours.map((entry) => <li><a href={`/en/analysis/${entry.id}/`}>{entry.data.title}</a></li>)}
      {additionalResources.map((link) => <li><a href={link.to}>{link.title}</a><p>{link.note}</p></li>)}
    </ul>
  </nav>
)}

<style>
  .related-reading { border-block: 1px solid var(--color-line); margin-top: 2.5rem; padding-block: 1.25rem; }
  h2 { color: var(--color-bright); font-family: var(--font-display); font-size: 1.25rem; line-height: 1.4; }
  p { color: var(--color-muted); line-height: 1.65; margin-top: .65rem; }
  ul { display: grid; gap: .65rem; list-style: none; margin-top: 1rem; padding: 0; }
  a { color: var(--color-signal); line-height: 1.5; text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
</style>
