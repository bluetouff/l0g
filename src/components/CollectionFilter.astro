---
interface Props { label: string; placeholder: string; lang?: 'fr' | 'en'; }
const { label, placeholder, lang = 'fr' } = Astro.props;
---
<form class="collection-filter" data-collection-filter data-lang={lang} data-pagefind-ignore role="search" hidden>
  <label><span>{label}</span><input type="search" placeholder={placeholder} maxlength="160" autocomplete="off" spellcheck="false" /></label>
  <button type="reset">{lang === 'en' ? 'Reset' : 'Réinitialiser'}</button>
  <p role="status" aria-live="polite"></p>
</form>
<script>import '../scripts/collection-filter.ts';</script>
<style>
  .collection-filter { display:flex; flex-wrap:wrap; align-items:end; gap:.7rem 1rem; margin:1.5rem 0; font-family:var(--font-read); }
  .collection-filter label { flex:1 1 14rem; min-width:0; color:var(--color-muted); font-size:.73rem; }
  .collection-filter input { display:block; width:100%; margin-top:.4rem; padding:.75rem .85rem; min-height:44px; border:1px solid var(--color-line-strong); border-radius:9px; background:var(--color-surface); color:var(--color-paper); font:400 .9rem var(--font-read); }
  .collection-filter button { min-height:44px; padding:.7rem; border-bottom:1px solid var(--color-line); color:var(--color-muted); cursor:pointer; font-size:.75rem; }
  .collection-filter p { flex-basis:100%; color:var(--color-muted); font-size:.73rem; }
  .collection-filter :is(input,button):focus-visible { outline:2px solid var(--color-signal); outline-offset:3px; }
  .collection-filter[hidden], :global([data-filter-card][hidden]), :global([data-filter-group][hidden]), :global([data-filter-target][hidden]) { display:none!important; }
</style>
