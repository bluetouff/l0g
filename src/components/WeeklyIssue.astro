---
import type { WeeklyEdition } from '../config/weekly-editions.ts';
import { buildWeeklyCitationText, buildWeeklyLinkedInText, buildWeeklyThreadText, weeklyChartDimensions } from '../lib/weekly-package.ts';
import { readingTime } from '../lib/reading-time.ts';
import { weeklyReadings, weeklyCoverTitle, weeklyCoverImage, weeklyDate } from '../lib/weekly-presentation.ts';

interface Props { edition: WeeklyEdition; headingLevel?: 'h1' | 'h2'; illustrations?: Map<string, string>; }
const { edition, headingLevel = 'h2', illustrations = new Map<string, string>() } = Astro.props;
const Heading = headingLevel;
const SectionHeading = headingLevel === 'h1' ? 'h2' : 'h3';
const ReadingHeading = headingLevel === 'h1' ? 'h3' : 'h4';
const root = `/hebdo/${edition.slug}`;
const editorial = edition.editorial;
const readings = weeklyReadings(edition);
const title = weeklyCoverTitle(edition);
const cover = weeklyCoverImage(edition, illustrations);
const dateLabel = weeklyDate;
const shortDate = (value: string) => weeklyDate(value, true);
const minutes = readingTime([
  ...(editorial?.opening ?? []),
  ...readings.flatMap((item) => [item.title, item.fact, item.importance, item.uncertainty]),
  ...(editorial?.watchlist.flatMap((item) => [item.title, item.detail]) ?? []),
].join(' '));
const citation = buildWeeklyCitationText(edition);
const linkedin = buildWeeklyLinkedInText(edition).trim();
const thread = buildWeeklyThreadText(edition).trim();
const chartDimensions = weeklyChartDimensions(edition);
---

<article class="weekly-issue" data-pagefind-body data-weekly-edition={edition.slug}>
  <header class="issue-head">
    <div class="issue-coordinate">
      <span class="issue-number">N° {String(edition.issue).padStart(2, '0')}</span>
      <time datetime={edition.publishedAt}>{dateLabel(edition.publishedAt)}</time>
      <span>Environ {minutes} min de lecture</span>
      {editorial && <span class="review-date">Revue le <time datetime={editorial.reviewedAt}>{shortDate(editorial.reviewedAt)}</time></span>}
    </div>
    <div class:list={['issue-cover', { 'has-cover': !!cover }]}>
      <div class="issue-opening">
        <p class="magazine-eyebrow">À la une <span aria-hidden="true">/</span> {readings[0].topic}</p>
        <Heading>{title}</Heading>
        <p class="issue-lead">{editorial?.opening[0] ?? edition.analysis.update}</p>
        <a class="cover-read" href={`#lecture-${edition.issue}-1`}>Entrer dans l’édition <span aria-hidden="true">↘</span></a>
      </div>
      {cover ? <figure class="cover-image">
        <img data-weekly-cover src={cover} alt={editorial?.cover.alt ?? `Illustration du dossier : ${readings[0].title}`} width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span>En couverture</span><a href={readings[0].href}>{readings[0].topic} <span aria-hidden="true">↗</span></a></figcaption>
      </figure> : <div class="cover-typography" aria-hidden="true"><span>l0g</span><span>{String(edition.issue).padStart(2, '0')}</span><span>La revue de la semaine</span></div>}
    </div>
    <nav class="issue-contents" aria-label="Sommaire de cette édition">
      <p>Dans ce numéro</p>
      {readings.map((item, index) => <a href={`#lecture-${edition.issue}-${index + 1}`}><span>{String(index + 1).padStart(2, '0')}</span><span>{item.topic}</span><b aria-hidden="true">↓</b></a>)}
    </nav>
  </header>

  {editorial && <section class="editor-note" aria-labelledby={`note-${edition.issue}`}>
    <SectionHeading id={`note-${edition.issue}`}>Le regard l0g</SectionHeading>
    <div>{editorial.opening.slice(1).map((paragraph) => <p>{paragraph}</p>)}</div>
  </section>}

  <div class:list={['issue-body', { 'with-watchlist': !!editorial }]}>
    <section class="issue-readings" aria-labelledby={`readings-${edition.issue}`}>
      <div class="section-line"><SectionHeading id={`readings-${edition.issue}`}>{editorial ? 'Les dossiers à retenir' : 'À lire cette semaine'}</SectionHeading><span>{String(readings.length).padStart(2, '0')} lecture{readings.length > 1 ? 's' : ''}</span></div>
      <div class="reading-grid">
      {readings.map((item, index) => <article class:list={['reading-note', { 'reading-feature': index === 0 }]} id={`lecture-${edition.issue}-${index + 1}`}>
        {illustrations.get(item.href) && <a class="reading-image" href={item.href} aria-label={`Lire : ${item.title}`} tabindex="-1" aria-hidden="true"><img src={illustrations.get(item.href)} alt="" width="1200" height="630" loading="lazy" decoding="async" /></a>}
        <div class="reading-copy">
          <div class="reading-meta"><span>{String(index + 1).padStart(2, '0')}</span><p>{item.topic}</p></div>
          <ReadingHeading><a href={item.href}>{item.title}</a></ReadingHeading>
          <p class="reading-fact">{item.fact}</p>
          <p class="reading-importance">{item.importance}</p>
          <p class="reading-limit"><strong>La limite</strong>{item.uncertainty}</p>
          <footer><a class="reading-link" href={item.href}>Lire l’analyse <span aria-hidden="true">↗</span></a>{item.source && <a class="reading-source" href={item.source.href}>{item.source.label} <span aria-hidden="true">↗</span></a>}</footer>
        </div>
      </article>)}
      </div>
    </section>
    {editorial && <aside class="issue-watch" aria-labelledby={`watch-${edition.issue}`}>
      <p class="mono-label">// garder le fil</p>
      <SectionHeading id={`watch-${edition.issue}`}>Les prochaines vérifications</SectionHeading>
      <p class="watch-intro">Les pièces à chercher pour prolonger cette lecture.</p>
      <ol>{editorial.watchlist.map((item) => <li><ReadingHeading><a href={item.href}>{item.title} <span aria-hidden="true">↗</span></a></ReadingHeading><p>{item.detail}</p></li>)}</ol>
      <a class="watch-more" href="/maintenant/">Le suivi sur Maintenant <span aria-hidden="true">→</span></a>
    </aside>}
  </div>

  {editorial && <aside class="issue-takeaway"><p class="mono-label">// une grille de lecture</p><p>{editorial.takeaway}</p></aside>}

  <details class="issue-documentation">
    <summary><span>Le périmètre de cette édition</span><small>{edition.includedAnalyses ? `${edition.includedAnalyses.length} analyses dans la semaine` : 'Sources et méthode'} <span aria-hidden="true">＋</span></small></summary>
    <div class="documentation-body">
      <p>{editorial ? 'Les dossiers à retenir font l’objet d’une sélection et d’une revue éditoriales datées. La liste ci-dessous conserve toutes les analyses de la fenêtre hebdomadaire. Le graphique et le CSV décrivent uniquement leur cadence de publication.' : edition.automation ? 'Cette édition reprend les faits, les mécanismes et les limites des analyses publiées dans sa fenêtre hebdomadaire. Le graphique et le CSV documentent la cadence de publication ; ils ne mesurent pas l’importance économique des sujets.' : 'Les données, les sources et les limites de cette édition sont conservées avec les formats téléchargeables.'}</p>
      <ol class="coverage-list">{edition.sources.map((source) => <li><a href={source.href}>{source.label}</a><span>{source.role}</span></li>)}</ol>
      <figure class="issue-chart"><img src={`${root}/graphique.svg`} alt={`${edition.chart.title}. ${edition.chart.subtitle} ${edition.chart.note}`} width={chartDimensions.width} height={chartDimensions.height} loading="lazy" decoding="async" /><figcaption>{edition.chart.note} <a href={`${root}/graphique.svg`} download>SVG</a> · <a href={`${root}/donnees.csv`} download>CSV</a> · <a href={edition.chart.sourceUrl}>Source du graphique</a></figcaption></figure>
      <ul class="method-limits">{(editorial ? ['Chaque dossier conserve ses dates et son périmètre ; cette revue ne constitue pas une actualisation quotidienne des données.', 'La synthèse ne remplace pas les hypothèses et les méthodes explicitées dans les analyses.'] : edition.limits).map((limit) => <li>{limit}</li>)}</ul>
    </div>
  </details>

  <details class="issue-formats">
    <summary><span>Citer et réutiliser l’édition</span><small>Référence · LinkedIn · X <span aria-hidden="true">＋</span></small></summary>
    <div class="formats-body">
      <p>Textes à adapter librement, avec attribution à l0g. <a href="/ressources-journalistes/">Ressources presse ↗</a></p>
      {[{ label: 'Référence bibliographique', text: citation, file: 'citation.txt' }, { label: 'Texte LinkedIn', text: linkedin, file: 'linkedin.txt' }, { label: 'Thread X', text: thread, file: 'thread-x.txt' }].map((format) => <details class="format-item"><summary>{format.label}</summary><pre>{format.text}</pre><div><button type="button" data-copy-value={format.text}><span data-copy-label aria-live="polite">Copier</span></button><a href={`${root}/${format.file}`}>Télécharger le texte</a></div></details>)}
    </div>
  </details>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const value = button.dataset.copyValue;
      if (!label || !value || !window.isSecureContext || !navigator.clipboard) {
        if (label) label.textContent = 'Indisponible';
        return;
      }
      const original = label.textContent;
      try { await navigator.clipboard.writeText(value); label.textContent = 'Copié'; }
      catch { label.textContent = 'Indisponible'; }
      window.setTimeout(() => { label.textContent = original; }, 1600);
    });
  });
</script>
