---
import { aigActors } from '../data/crisis-aig';
import type { ReplayLanguage } from '../data/crisis-replay';
interface Props { lang: ReplayLanguage; }
const { lang } = Astro.props;
const t = (fr: string, en: string) => lang === 'fr' ? fr : en;
const positions = [[50,12.5,25,13.33],[15.625,42.5,75,13.33],[50,42.5,25,49.33],[84.375,42.5,75,49.33],[15.625,82.5,25,85.33],[84.375,82.5,75,85.33]];
---
<div class="replay-map aig-map" data-replay-map>
  <svg class="replay-wires replay-wires-desktop" viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;width:100%;height:auto">
    <defs><marker id={`aig-arrow-${lang}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.1" /></marker></defs>
    <g fill="none" stroke-width="1.3" marker-end={`url(#aig-arrow-${lang})`}>
      <path data-wire="aig-credit" data-from="fed" data-to="aig" d="M320 86V132" />
      <path data-wire="aig-lending" data-from="aig" data-to="borrowers" d="M244 170H176" />
      <path data-wire="aig-cds" data-from="aig" data-to="counterparties" d="M396 170H464" />
      <path data-wire="aig-ml2-funding" data-from="fed" data-to="ml2" d="M244 50C90 12 12 18 12 114V260C12 289 54 294 100 294" />
      <path data-wire="aig-ml3-funding" data-from="fed" data-to="ml3" d="M396 50C550 12 628 18 628 114V260C628 289 586 294 540 294" />
      <path data-wire="aig-ml2-purchase" data-from="ml2" data-to="aig" d="M176 322C244 305 252 235 297 207" />
      <path data-wire="aig-ml3-purchase" data-from="ml3" data-to="counterparties" d="M540 294V207" />
    </g>
    <g class="replay-wire-labels aig-wire-labels" text-anchor="middle">
      <text x="355" y="116">{t('crédit', 'credit')}</text><text x="210" y="156">cash</text><text x="430" y="156">{t('garanties', 'collateral')}</text>
      <text x="100" y="225">{t('Prêt de titres', 'Securities lending')}</text><text x="540" y="225">CDS</text>
      <text x="66" y="270">{t('prêt Fed', 'Fed loan')}</text><text x="575" y="272">{t('prêt Fed', 'Fed loan')}</text>
      <text x="240" y="279">{t('achat RMBS', 'RMBS purchase')}</text><text x="572" y="250">{t('achat CDO', 'CDO purchase')}</text>
    </g>
    <g class="aig-map-note" text-anchor="middle"><text x="320" y="356">{t('Deux circuits de liquidité', 'Two liquidity channels')}</text><text x="320" y="376">{t('Schéma historique · flux non proportionnels', 'Historical map · flows not to scale')}</text></g>
  </svg>
  <svg class="replay-wires replay-wires-mobile" viewBox="0 0 360 450" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;width:100%;height:auto">
    <defs><marker id={`aig-mobile-arrow-${lang}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.1" /></marker></defs>
    <g fill="none" stroke-width="1.3" marker-end={`url(#aig-mobile-arrow-${lang})`}>
      <path data-wire="aig-credit" data-from="fed" data-to="aig" d="M90 96V186" />
      <path data-wire="aig-lending" data-from="aig" data-to="borrowers" d="M114 186L244 96" />
      <path data-wire="aig-cds" data-from="aig" data-to="counterparties" d="M164 222H196" />
      <path data-wire="aig-ml2-funding" data-from="fed" data-to="ml2" d="M18 60C5 130 5 305 18 384" />
      <path data-wire="aig-ml3-funding" data-from="fed" data-to="ml3" d="M110 24C200 5 354 6 354 62V360Q354 384 344 384" />
      <path data-wire="aig-ml2-purchase" data-from="ml2" data-to="aig" d="M90 348V258" />
      <path data-wire="aig-ml3-purchase" data-from="ml3" data-to="counterparties" d="M270 348V258" />
    </g>
    <g class="replay-wire-labels aig-wire-labels" text-anchor="middle">
      <text x="68" y="145">{t('crédit', 'credit')}</text><text x="190" y="143">{t('cash à rendre', 'cash returned')}</text><text x="180" y="207">{t('cash', 'cash')}</text>
      <text x="65" y="305">RMBS</text><text x="297" y="305">CDO</text><text x="180" y="441">{t('Schéma historique · flux non proportionnels', 'Historical map · flows not to scale')}</text>
    </g>
  </svg>
  {aigActors.map((actor,index) => <button type="button" class={`replay-actor aig-actor aig-actor-${actor.id}`} data-replay-actor={actor.id} aria-pressed="false" aria-controls="replay-actor-detail" style={`--x:${positions[index][0]}%;--y:${positions[index][1]}%;--mx:${positions[index][2]}%;--my:${positions[index][3]}%`} disabled>
    <span class="replay-actor-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="display:block;width:100%;height:auto">
      {actor.id === 'fed' && <><path d="M3 8l9-5 9 5zM3 21h18M5 18h14M6 10v6M10 10v6M14 10v6M18 10v6" /></>}
      {actor.id === 'aig' && <><path d="M12 2l8 3v6c0 5-4 8-8 11-4-3-8-6-8-11V5zM8 9h8M8 13h8M12 7v10" /></>}
      {actor.id === 'borrowers' && <><path d="M4 4h11v13H4zM8 8h4M8 11h4M9 20h11V7h-2M3 21l3-3M3 18v3h3" /></>}
      {actor.id === 'counterparties' && <><path d="M3 7h15M14 3l4 4-4 4M21 17H6M10 13l-4 4 4 4" /></>}
      {actor.id === 'ml2' && <><path d="M3 11l9-8 9 8M5 10v11h14V10M9 21v-6h6v6" /></>}
      {actor.id === 'ml3' && <><path d="M4 4h6v6H4zM14 4h6v6h-6zM9 15h6v6H9zM7 10v3h10v-3M12 13v2" /></>}
    </svg></span><span><small>{actor.role[lang]}</small><strong>{actor.label[lang]}</strong></span>
  </button>)}
</div>
