---
import type { AnalysisTool } from '../config/analysis-tools.ts';

interface Props { tool: AnalysisTool; lang?: 'fr' | 'en'; index?: number; featured?: boolean; }
const { tool, lang = 'fr', index = 0, featured = false } = Astro.props;
const copy = tool[lang];
const isFr = lang === 'fr';
const number = String(index + 1).padStart(2, '0');
---

<article class:list={['analysis-tool-card', { 'is-featured': featured }]} data-tool={tool.id}>
  <div class="analysis-tool-card__signal" aria-hidden="true"><span>{number}</span><i></i><i></i><i></i><i></i><i></i></div>
  <header><span>{copy.eyebrow}</span><b>v{tool.version} · {tool.status}</b></header>
  <h2>{copy.title}</h2>
  <p class="analysis-tool-question">{copy.question}</p>
  <p class="analysis-tool-description">{copy.description}</p>
  <footer>
    <a class="analysis-tool-open" href={copy.href}><span>{isFr ? 'Lancer l’outil' : 'Launch tool'}</span><strong aria-hidden="true">↗</strong></a>
    <a class="analysis-tool-article" href={copy.articleHref}><small>{isFr ? 'Enquête associée' : 'Related investigation'}</small><span>{copy.articleLabel}</span><strong aria-hidden="true">→</strong></a>
  </footer>
</article>

<style>
  .analysis-tool-card{--tool-accent:var(--color-signal);position:relative;display:grid;min-width:0;gap:.72rem;overflow:hidden;border:1px solid color-mix(in srgb,var(--tool-accent) 30%,var(--color-line));border-radius:20px 5px 20px 20px;padding:clamp(1rem,3vw,1.5rem);background:radial-gradient(100% 100% at 0 0,color-mix(in srgb,var(--tool-accent) 12%,transparent),transparent 62%),linear-gradient(145deg,color-mix(in srgb,var(--color-surface) 94%,transparent),color-mix(in srgb,var(--color-bg) 96%,transparent));box-shadow:0 18px 55px rgba(0,0,0,.2);isolation:isolate}
  .analysis-tool-card[data-tool="reservoir-arbitrator"],.analysis-tool-card[data-tool="danube-centimetre-value"]{--tool-accent:var(--color-amber)}
  .analysis-tool-card[data-tool="wet-megawatt-counter"]{--tool-accent:var(--color-accent)}
  .analysis-tool-card[data-tool="digital-euro-cost"]{--tool-accent:var(--color-down)}
  .analysis-tool-card::before{content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,var(--tool-accent),transparent 72%)}
  .analysis-tool-card__signal{position:absolute;top:1rem;right:1rem;display:flex;align-items:flex-end;gap:3px;height:25px;color:color-mix(in srgb,var(--tool-accent) 62%,var(--color-muted));font:700 .58rem/1 var(--font-mono);opacity:.7;z-index:-1}
  .analysis-tool-card__signal span{margin-right:.25rem;align-self:flex-start}.analysis-tool-card__signal i{display:block;width:3px;border-radius:3px;background:currentColor}.analysis-tool-card__signal i:nth-of-type(1){height:28%}.analysis-tool-card__signal i:nth-of-type(2){height:52%}.analysis-tool-card__signal i:nth-of-type(3){height:78%}.analysis-tool-card__signal i:nth-of-type(4){height:48%}.analysis-tool-card__signal i:nth-of-type(5){height:92%}
  header{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:1rem;padding-right:5rem}header span,header b{color:var(--tool-accent);font-family:var(--font-mono);font-size:.61rem;letter-spacing:.08em;text-transform:uppercase}header b{color:var(--color-muted);font-weight:550;white-space:nowrap}
  h2{max-width:34rem;color:var(--color-bright);font-family:var(--font-display);font-size:clamp(1.35rem,3vw,1.8rem);line-height:1.1}.analysis-tool-question{max-width:42rem;color:var(--color-paper);font-size:.94rem;font-weight:700;line-height:1.5}.analysis-tool-description{max-width:46rem;color:var(--color-muted);font-size:.82rem;line-height:1.6}
  footer{display:grid;grid-template-columns:minmax(9.5rem,.65fr) minmax(0,1.35fr);gap:.65rem;margin-top:.35rem}footer a{text-decoration:none}.analysis-tool-open{display:flex;align-items:center;justify-content:space-between;gap:.7rem;border:1px solid var(--tool-accent);border-radius:10px;padding:.78rem .88rem;background:var(--tool-accent);color:#07100f;font:800 .7rem/1.2 var(--font-mono);box-shadow:0 8px 25px color-mix(in srgb,var(--tool-accent) 18%,transparent)}.analysis-tool-open strong{font-size:1rem}.analysis-tool-open:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .analysis-tool-article{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.2rem .7rem;border:1px solid color-mix(in srgb,var(--tool-accent) 28%,var(--color-line));border-radius:10px;padding:.65rem .78rem;background:color-mix(in srgb,var(--tool-accent) 6%,transparent);color:var(--color-paper)}.analysis-tool-article small{grid-column:1/-1;color:var(--tool-accent);font:700 .55rem/1.1 var(--font-mono);letter-spacing:.07em;text-transform:uppercase}.analysis-tool-article span{min-width:0;font-size:.72rem;font-weight:700;line-height:1.25}.analysis-tool-article strong{color:var(--tool-accent)}.analysis-tool-article:hover{border-color:var(--tool-accent);background:color-mix(in srgb,var(--tool-accent) 11%,transparent)}
  .is-featured{min-height:24rem;align-content:end}.is-featured h2{font-size:clamp(1.65rem,4vw,2.35rem)}
  @media(max-width:620px){header{padding-right:0}.analysis-tool-card__signal{display:none}footer{grid-template-columns:1fr}.is-featured{min-height:0}}
</style>
