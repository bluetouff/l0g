---
import { ltcmActors } from '../data/crisis-ltcm';
import type { ReplayLanguage } from '../data/crisis-replay';
interface Props { lang: ReplayLanguage; }
const { lang }=Astro.props;
const t=(fr:string,en:string)=>lang==='fr'?fr:en;
const positions=[[50,12.5,25,13.33],[15.625,42.5,75,13.33],[50,42.5,25,49.33],[84.375,42.5,75,49.33],[15.625,82.5,25,85.33],[84.375,82.5,75,85.33]];
---
<div class="replay-map ltcm-map" data-replay-map>
  <svg class="replay-wires replay-wires-desktop" viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;width:100%;height:auto">
    <defs><marker id={`ltcm-arrow-${lang}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.1" /></marker></defs>
    <g fill="none" stroke-width="1.3" marker-end={`url(#ltcm-arrow-${lang})`}>
      <path data-wire="ltcm-model" data-from="markets" data-to="ltcm" d="M176 170H244" />
      <path data-wire="ltcm-funding" data-from="dealers" data-to="ltcm" d="M464 160H396" />
      <path data-wire="ltcm-funding" data-from="ltcm" data-to="dealers" d="M396 184H464" />
      <path data-wire="ltcm-risk" data-from="dealers" data-to="unwind" d="M552 207C580 252 210 237 126 294" />
      <path data-wire="ltcm-risk" data-from="unwind" data-to="markets" d="M100 294V207" />
      <path data-wire="ltcm-capital" data-from="consortium" data-to="ltcm" d="M464 330C400 326 366 244 341 207" />
      <path data-wire="ltcm-coordination" data-from="fed" data-to="consortium" d="M396 50C550 12 628 18 628 114V260C628 289 586 294 540 294" />
    </g>
    <g class="replay-wire-labels ltcm-wire-labels" text-anchor="middle">
      <text x="210" y="154">{t('pertes', 'losses')}</text><text x="430" y="146">{t('crédit', 'credit')}</text><text x="430" y="205">{t('garanties', 'collateral')}</text>
      <text x="72" y="256">{t('pression', 'pressure')}</text><text x="365" y="245">{t('si défaut', 'if default')}</text>
      <text x="428" y="295">{t('capital privé', 'private capital')}</text><text x="570" y="268">{t('médiation', 'facilitation')}</text>
    </g>
    <g class="ltcm-spread" transform="translate(320 303)" fill="none" stroke-width="1.4"><path d="M-49-19C-22-14 16-22 49-33" /><path d="M-49-14C-22-9 16 7 49 16" /><text x="0" y="40" text-anchor="middle" stroke="none">{t('Écarts en tension', 'Spreads under strain')}</text></g>
  </svg>
  <svg class="replay-wires replay-wires-mobile" viewBox="0 0 360 450" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;width:100%;height:auto">
    <defs><marker id={`ltcm-mobile-arrow-${lang}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.1" /></marker></defs>
    <g fill="none" stroke-width="1.3" marker-end={`url(#ltcm-mobile-arrow-${lang})`}>
      <path data-wire="ltcm-model" data-from="markets" data-to="ltcm" d="M246 96L116 186" />
      <path data-wire="ltcm-funding" data-from="dealers" data-to="ltcm" d="M196 213H164" />
      <path data-wire="ltcm-funding" data-from="ltcm" data-to="dealers" d="M164 236H196" />
      <path data-wire="ltcm-risk" data-from="dealers" data-to="unwind" d="M274 258C290 290 157 313 110 348" />
      <path data-wire="ltcm-risk" data-from="unwind" data-to="markets" d="M18 384C4 300 4 145 18 110C24 91 181 110 246 96" />
      <path data-wire="ltcm-capital" data-from="consortium" data-to="ltcm" d="M246 348L114 258" />
      <path data-wire="ltcm-coordination" data-from="fed" data-to="consortium" d="M110 24C200 5 354 6 354 62V360Q354 384 344 384" />
    </g>
    <g class="replay-wire-labels ltcm-wire-labels" text-anchor="middle">
      <text x="180" y="142">{t('pertes', 'losses')}</text><text x="247" y="311">{t('si défaut', 'if default')}</text><text x="121" y="325">{t('capital privé', 'private capital')}</text><text x="180" y="441" class="ltcm-mobile-note">{t('Schéma qualitatif', 'Qualitative map')}</text>
    </g>
    <g class="ltcm-spread" transform="translate(180 166)" fill="none" stroke-width="1.2"><path d="M-25-3C-8-1 11-6 25-12" /><path d="M-25 0C-8 1 11 8 25 12" /></g>
  </svg>
  {ltcmActors.map((actor,index)=><button type="button" class={`replay-actor ltcm-actor ltcm-actor-${actor.id}`} data-replay-actor={actor.id} aria-pressed="false" aria-controls="replay-actor-detail" style={`--x:${positions[index][0]}%;--y:${positions[index][1]}%;--mx:${positions[index][2]}%;--my:${positions[index][3]}%`} disabled>
    <span class="replay-actor-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="display:block;width:100%;height:auto">
      {actor.id==='fed'&&<><path d="M3 8l9-5 9 5zM3 21h18M5 18h14M6 10v6M10 10v6M14 10v6M18 10v6" /></>}
      {actor.id==='markets'&&<><path d="M4 5h5v13H4zM15 3h5v15h-5zM2 21h20M9 9h6M11 7l-2 2 2 2M13 14l2 2-2 2" /></>}
      {actor.id==='ltcm'&&<><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h3M16 14v4M14 16h4" /></>}
      {actor.id==='dealers'&&<><path d="M3 7h15M14 3l4 4-4 4M21 17H6M10 13l-4 4 4 4" /></>}
      {actor.id==='unwind'&&<><path d="M4 4v16h16M8 8l4 4 3-2 5 6M15 16h5v-5" /></>}
      {actor.id==='consortium'&&<><circle cx="12" cy="5" r="2" /><circle cx="5" cy="18" r="2" /><circle cx="19" cy="18" r="2" /><path d="M11 7l-5 9M13 7l5 9M7 18h10" /></>}
    </svg></span><span><small>{actor.role[lang]}</small><strong>{actor.label[lang]}</strong></span>
  </button>)}
</div>
