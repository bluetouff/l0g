const info={
 relations:{number:'01',sources:['s01','s02','s05'],fr:'Trois relations, trois contrats',en:'Three relationships, three contracts'},
 reserves:{number:'02',sources:['s11','s12'],fr:'L’excédent d’actifs de Tether International',en:'Tether International’s asset surplus'},
 denominator:{number:'03',sources:['s15','s16'],fr:'USDT dans un échantillon d’adresses ciblées',en:'USDT in a targeted address sample'},
}as const;
if((lang!=='fr'&&lang!=='en')||!Object.prototype.hasOwnProperty.call(info,kind))throw new TypeError('Unknown TetherLutnickFigure variant');
const entry=info[kind],scene=art[lang][kind],figureNumber=number??entry.number,sourceIds=sources??entry.sources;
if(!/^\d{2}$/.test(figureNumber)||!sourceIds.every(id=>/^(?:s01|s02|s05|s11|s12|s15|s16)$/.test(id)))throw new TypeError('Invalid figure metadata');
const captions={
 relations:{fr:'La garde d’actifs et l’investissement en dette convertible sont distingués du prêt familial rapporté par Bloomberg. Les traits n’expriment ni montant ni contrepartie politique. Le contrat de crédit n’a pas été obtenu.',en:'Asset custody and the convertible-debt investment are distinguished from the family loan reported by Bloomberg. Lines represent neither amounts nor a political quid pro quo. The credit contract was not obtained.'},
 reserves:{fr:'Stocks nominaux de Tether International au 30 septembre 2026. Les actifs de 191,451 milliards de dollars se décomposent en 183,496 milliards de passifs et 7,955 milliards d’excédent. Le ratio 4,34% rapporte l’excédent aux passifs, et non aux actifs.',en:'Nominal stocks of Tether International on September 30, 2026. Assets of 191.451 billion dollars split into 183.496 billion of liabilities and 7.955 billion of surplus. The 4.34% ratio divides surplus by liabilities, rather than assets.'},
 denominator:{fr:'Résultat attribué au rapport de la minorité démocrate PSI :84% des 846 adresses uniques sélectionnées utilisent USDT exclusivement ou de façon prédominante. Un point représente un point de pourcentage ; la grille ne représente pas 846 adresses ni l’ensemble des usages d’USDT.',en:'Result attributed to the PSI Democratic minority report: 84% of 846 selected unique addresses use USDT exclusively or predominantly. Each dot represents one percentage point; the grid depicts neither 846 addresses nor all USDT activity.'},
}as const;
const methods={
 relations:{fr:'Les trois pistes restent indépendantes. La première représente la garde d’actifs chez Cantor. La seconde représente la dette convertible décrite par Lutnick comme acquise en avril 2024 : la figure n’établit aucune conversion ultérieure en actions. La dernière représente le prêt et la sûreté rapportés par Bloomberg, puis repris par les sénateurs. Ces reprises partagent la même source de presse. L’identité légale du prêteur, les conditions et l’affectation des fonds restent à établir. Aucune flèche ne relie les réserves de Tether International au crédit familial.',en:'The three tracks remain separate. The first represents asset custody at Cantor. The second represents convertible debt described by Lutnick as acquired in April 2024; the figure establishes no later conversion into equity. The third represents the loan and security interest reported by Bloomberg and subsequently cited by senators. Those repetitions share the same press source. The legal lender, terms and use of proceeds remain to be established. No arrow links Tether International’s reserves to the family credit.'},
 reserves:{fr:'Calcul sur les valeurs avant arrondi : actifs 191451091374 dollars, passifs 183496460904 dollars, différence 7954630470 dollars. L’excédent divisé par les passifs donne 4,335032...%, affiché 4,34%. La seconde barre couvre le même total d’actifs et distingue passifs et excédent à proportion des valeurs exactes. Le périmètre est celui de Tether International, pas celui du groupe entier. La catégorie de prêts garantis ne permet pas d’identifier le prêt familial ou la société qui l’aurait consenti.',en:'Calculated before rounding: assets 191451091374 dollars, liabilities 183496460904 dollars and difference 7954630470 dollars. Surplus divided by liabilities is 4.335032...%, displayed as 4.34%. The second bar covers the same asset total and separates liabilities from surplus in proportion to the exact values. The perimeter is Tether International, not the entire group. The secured-loan category does not identify the family loan or its legal lender.'},
 denominator:{fr:'Le dénominateur est constitué de 846 adresses uniques sélectionnées à partir de désignations ou mesures de saisie OFAC/NBCTF de juin 2021 à août 2026. Les adresses additionnelles qualifiées de suspectes dans le rapport restent hors de cet agrégat. Le critère d’usage exclusif ou prédominant retient plus de 80% de la valeur en dollars des transactions en USDT. La grille de 100 points matérialise le pourcentage arrondi annoncé, avec 84 points colorés. Elle ne permet pas de calculer un nombre exact d’adresses à partir de ce pourcentage arrondi. L’analyse du rapport n’a pas été répliquée par l0g ; ce résultat ne mesure pas la part illicite de tous les utilisateurs ou transactions USDT.',en:'The denominator is 846 unique addresses selected through OFAC/NBCTF designations or seizure actions from June 2021 to August 2026. Additional addresses labelled suspicious in the report are outside this aggregate. Exclusive or predominant use means more than 80% of dollar-denominated transaction value in USDT. The 100-dot grid depicts the reported rounded percentage, with 84 filled dots. It cannot yield an exact address count from that rounded share. The report’s analysis was not replicated by l0g; the result does not measure illicit activity across all USDT users or transactions.'},
}as const;
---
<figure class="tether-lutnick-figure" id={`figure-${figureNumber}`} data-kind={kind}>
 <div class="desktop-art" set:html={scene.desktop}></div>
 <div class="mobile-art" set:html={scene.mobile}></div>
 <figcaption><span class="figure-number">FIGURE {figureNumber}</span><strong>{entry[lang]}</strong>{caption??captions[kind][lang]} {sourceIds.map(id=><a href={`#source-${id}`} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}</figcaption>
 <details><summary>{lang==='fr'?'Méthode et périmètre':'Method and scope'}</summary><div class="method">{methods[kind][lang]}<slot/></div></details>
</figure>
<style>
 @font-face{font-family:'l0g Tether Investigation';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
 .tether-lutnick-figure{width:100%;max-width:800px;margin:2.8rem auto;padding-bottom:1rem;container-type:inline-size;overflow:visible}
 .desktop-art,.mobile-art{width:100%;line-height:0}.mobile-art{display:none;max-width:340px;margin-inline:auto}
 .tether-lutnick-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
 figcaption{padding:.85rem 0 .45rem;font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted)}
 figcaption strong{display:block;margin:.25rem 0;font-size:1rem;font-weight:400;color:var(--color-paper)}
 .figure-number{font-size:.75rem;letter-spacing:.12em;color:var(--color-signal)}a{margin-right:.45rem}
 details{margin-top:.35rem;font-family:var(--font-read);font-size:.875rem;line-height:1.7}summary{cursor:pointer;padding:.35rem 0}summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.method{margin-top:.5rem;color:var(--color-muted)}
 @container (max-width:660px){.desktop-art{display:none}.mobile-art{display:block}}
 @media print{.desktop-art{display:block}.mobile-art{display:none}.tether-lutnick-figure{break-inside:avoid}}
</style>
