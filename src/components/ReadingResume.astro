---
import { createHash } from 'node:crypto';

interface Props { body: string | undefined; lang?: 'fr' | 'en'; }
const { body, lang = 'fr' } = Astro.props;
const revision = createHash('sha256').update(body ?? '').digest('hex').slice(0, 16);
const en = lang === 'en';
---

<div class="read-progress" aria-hidden="true"><span data-reading-progress></span></div>
<aside class="reading-resume" data-reading-resume data-revision={revision} data-lang={lang}
  aria-label={en ? 'Reading position' : 'Reprise de lecture'} data-pagefind-ignore hidden>
  <div>
    <button type="button" data-reading-continue>{en ? 'Resume reading' : 'Reprendre ma lecture'} <span aria-hidden="true">↓</span></button>
    <p data-reading-description></p>
  </div>
  <button class="reading-forget" type="button" data-reading-forget>{en ? 'Forget this position' : 'Effacer cette position'}</button>
  <span class="sr-only" role="status" data-reading-status></span>
</aside>

<script>
  import '../scripts/reading-resume.ts';
</script>

<style>
  .reading-resume[hidden] { display: none; }
  .reading-resume {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.65rem 1.25rem; margin-top: 1.2rem; padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-line); border-left: 2px solid var(--color-signal);
    border-radius: 8px; background: var(--color-surface);
  }
  .reading-resume button {
    min-height: 44px; text-align: left; cursor: pointer;
    color: var(--color-signal); font-size: 0.85rem; font-weight: 600;
  }
  .reading-resume button:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; border-radius: 2px; }
  .reading-resume button:hover { text-decoration: underline; text-underline-offset: 3px; }
  .reading-resume p { color: var(--color-muted); font-size: 0.72rem; line-height: 1.5; }
  .reading-resume .reading-forget { color: var(--color-muted); font-size: 0.72rem; font-weight: 400; }
  .read-progress { position: fixed; inset: 0 0 auto; height: 2px; z-index: 60; pointer-events: none; }
  .read-progress > span {
    display: block; width: 100%; height: 100%; transform: scaleX(0); transform-origin: 0 50%;
    background: var(--color-signal);
  }
  @media print { .reading-resume, .read-progress { display: none; } }
</style>
