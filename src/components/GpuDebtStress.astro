---
import { GPU_DEBT_DEFAULTS, calculateGpuDebt, formatGpuDebtMoney, formatGpuDebtNumber, parseGpuDebtInput } from '../lib/gpuDebtStress.mjs';
import { gpuDebtCopy, gpuDebtDisplay } from '../lib/gpuDebtStressUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = gpuDebtCopy(lang), initial = calculateGpuDebt(GPU_DEBT_DEFAULTS), id = `gpu-debt-${lang}`;
const initialInputs = { price: parseGpuDebtInput(GPU_DEBT_DEFAULTS.price, 'price'), utilization: parseGpuDebtInput(GPU_DEBT_DEFAULTS.utilization, 'utilization'), costs: parseGpuDebtInput(GPU_DEBT_DEFAULTS.costs, 'costs') };
const inputs = [{key:'price', min:1, max:8, step:0.05}, {key:'utilization', min:20, max:100, step:1}, {key:'costs', min:30000, max:150000, step:1000}] as const;
const outputs = ['revenue', 'available', 'surplus', 'threshold', 'threshold135'] as const;
---
<section class="gpu-debt-stress" data-gpu-debt-stress data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="gpu-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="gpu-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="gpu-inputs">{inputs.map((input, index) => <label for={`${id}-${input.key}`}><span>{copy.labels[index]}<output for={`${id}-${input.key}`} data-gpu-debt-readout={input.key} aria-live="off">{input.key === 'utilization' ? `${formatGpuDebtNumber(initialInputs[input.key], lang, 0)} %` : formatGpuDebtMoney(initialInputs[input.key], lang, input.key === 'price' ? 2 : 0)}</output></span><input id={`${id}-${input.key}`} name={input.key} type="range" min={input.min} max={input.max} step={input.step} value={GPU_DEBT_DEFAULTS[input.key]} aria-describedby={`${id}-bounds ${id}-error`} /></label>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p id={`${id}-bounds`}>{copy.bounds}</p><p class="gpu-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <div class="gpu-coverage"><p>{copy.coverage}</p><strong><output data-gpu-debt-output="coverage" aria-live="off">{gpuDebtDisplay(initial, 'coverage', lang)}</output></strong><p data-funding="covered">{copy.covered}</p><meter min="0" max="2.5" low="1" high="1.35" optimum="2.5" value={initial.coverage} aria-label={copy.coverage} aria-valuetext={gpuDebtDisplay(initial, 'coverage', lang)}>{gpuDebtDisplay(initial, 'coverage', lang)}</meter></div>
    <dl class="gpu-results">{outputs.map((field, index) => <div><dt>{copy.resultLabels[index]}</dt><dd><output data-gpu-debt-output={field} aria-live="off">{gpuDebtDisplay(initial, field, lang)}</output></dd></div>)}</dl>
    <p class="gpu-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="gpu-method"><summary>{copy.method}</summary><p>{copy.assumptions}</p><p>{lang === 'fr' ? 'Annuité théorique :' : 'Theoretical annual payment:'} {formatGpuDebtMoney(initial.annualPayment, lang)}.</p><p>{copy.formula}</p><p>{copy.limits}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/gpuDebtStressUi.mjs';</script>
<style>
.gpu-debt-stress{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.gpu-debt-stress *{box-sizing:border-box}.gpu-debt-stress header,.gpu-debt-stress details,.gpu-debt-stress form,.gpu-debt-stress fieldset{min-width:0}.gpu-debt-stress .gpu-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.gpu-debt-stress h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.gpu-debt-stress p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.gpu-debt-stress summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.gpu-controls,.gpu-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.gpu-debt-stress fieldset{margin:1rem 0;border:0;padding:0}.gpu-debt-stress legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.gpu-inputs{display:grid;gap:1.1rem}.gpu-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.gpu-inputs label>span{display:flex;justify-content:space-between;align-items:start;gap:.5rem;flex-wrap:wrap}.gpu-inputs output{font:700 .9375rem/1.6 var(--font-mono);color:var(--color-signal);white-space:nowrap}.gpu-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;accent-color:var(--color-signal)}.gpu-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.gpu-debt-stress button{min-height:2.75rem;margin-top:1rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer}.gpu-debt-stress :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.gpu-debt-stress .gpu-error{color:var(--color-accent)}.gpu-coverage{margin:1rem 0;padding:.9rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.gpu-coverage strong{display:block;font:700 2rem/1.4 var(--font-mono);color:var(--color-paper)}.gpu-coverage meter{display:block;width:100%;height:1rem;accent-color:var(--color-signal)}.gpu-coverage [data-funding=covered]{color:var(--color-signal)}.gpu-coverage [data-funding=shortfall],.gpu-coverage [data-funding=unavailable]{color:var(--color-accent)}.gpu-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.gpu-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.gpu-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.gpu-results dd{margin:.25rem 0 0;font:700 1rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.gpu-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.gpu-results{grid-template-columns:minmax(0,1fr)}.gpu-debt-stress h3{font-size:1.2rem}}
</style>
