const methods={
 mechanism:{fr:'Le schéma représente l’architecture web documentée par rrweb : un état initial puis des événements et des modifications horodatés reconstruisent la page. Le filtrage est illustré avant transmission. Les capacités et exclusions effectives dépendent du produit et de ses réglages. Les procédés mobiles peuvent différer.',en:'The diagram represents rrweb’s documented web architecture: an initial state plus timestamped events and changes reconstruct the page. Filtering is illustrated before transmission. Actual capabilities and exclusions depend on the product and its settings. Mobile implementations may differ.'},
 circuits:{fr:'Microsoft Learn décrit une collecte limitée sans cookies lorsque analytics_storage est refusé, et un partage avec Microsoft Ads conditionné à ad_storage. Une autre page précise le découpage des replays sans cookies en une page par session. Ces documents établissent le fonctionnement annoncé, sans attester le réglage ni la conformité d’un site donné.',en:'Microsoft Learn describes limited cookieless collection when analytics_storage is denied, and Microsoft Ads sharing conditional on ad_storage. Another page describes cookieless replay as one page per session. These documents establish the stated behaviour, without establishing any particular site’s settings or legal compliance.'},
 margin:{fr:'Gain net = N × marge par commande × (hausse absolue du taux en points / 100) − coût. Ici, 100 000 visites, 30 euros de marge et 3 000 euros de coût donnent un seuil de 100 commandes et 0,10 point. Un taux initial de 2 % atteint 2,10 %, soit +5 % en relatif. La période et le périmètre des coûts doivent rester constants ; les hypothèses supposent une marge compatible et un effet applicable au trafic exposé.',en:'Net gain = visits × contribution per order × (absolute purchase-rate increase in percentage points / 100) − cost. Here 100,000 visits, €30 contribution and €3,000 cost imply 100 extra orders and 0.10 percentage point at break-even. A 2% initial rate reaches 2.10%, a 5% relative rise. The period and cost scope must remain consistent; assumptions require compatible contribution and an effect applicable to exposed traffic.'},
}as const;
const figureCaption=caption??captions[kind][lang];
const sourceHref=(id:string)=>id==='m01'?'#methode-m01':`#source-${id}`;
---
<figure class="session-replay-figure" id={`figure-${figureNumber}`} data-kind={kind}>
 <div class="desktop-art"><Fragment set:html={scene.desktop}/></div>
 <div class="mobile-art"><Fragment set:html={scene.mobile}/></div>
 <figcaption><span class="figure-number">FIGURE {figureNumber}</span><strong>{entry[lang]}</strong>{figureCaption} {sourceIds.map(id=><a href={sourceHref(id)} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}</figcaption>
 <details><summary>{lang==='fr'?'Méthode et périmètre':'Method and scope'}</summary><div class="method">{Astro.slots.has('default')?<slot/>:<p>{methods[kind][lang]}</p>}</div></details>
</figure>
<style>
 @font-face{font-family:'l0g Session Replay';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
 .session-replay-figure{width:100%;max-width:800px;margin:2.8rem auto;padding-bottom:1rem;container-type:inline-size;overflow:visible}
 .desktop-art,.mobile-art{width:100%;line-height:0}.mobile-art{display:none;max-width:340px;margin-inline:auto}
 .session-replay-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
 figcaption{padding:.85rem 0 .45rem;font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted)}
 figcaption strong{display:block;margin:.25rem 0;font-size:1rem;font-weight:400;color:var(--color-paper)}
 .figure-number{font-size:.75rem;letter-spacing:.12em;color:var(--color-signal)}a{margin-right:.45rem}
 details{margin-top:.35rem;font-family:var(--font-read);font-size:.875rem;line-height:1.7}summary{cursor:pointer;padding:.35rem 0}summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.method{margin-top:.7rem}
 @container (max-width:660px){.desktop-art{display:none}.mobile-art{display:block}}
 @media print{.desktop-art{display:block}.mobile-art{display:none}.session-replay-figure{break-inside:avoid}}
</style>
