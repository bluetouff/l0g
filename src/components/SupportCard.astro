---
interface Props {
  compact?: boolean;
  lang?: 'fr' | 'en';
}

const { compact = false, lang = 'fr' } = Astro.props;
const copy = lang === 'en'
  ? {
      href: '/en/support/',
      eyebrow: '// support l0g',
      title: 'Keep independent analysis open.',
      description: 'Help sustain sourced investigations and public tools, accessible to everyone.',
      cta: 'Support l0g',
      note: 'One-time or monthly contribution',
    }
  : {
      href: '/soutenir/',
      eyebrow: '// soutenir l0g',
      title: 'Faire vivre l’analyse indépendante.',
      description: 'Des enquêtes sourcées et des outils publics, accessibles à tous.',
      cta: 'Je soutiens l0g',
      note: 'Contribution libre ou mensuelle',
    };
---

<a class:list={['support-card', { compact }]} href={copy.href} data-pagefind-ignore>
  <span class="support-card-top">
    <small>{copy.eyebrow}</small>
    <span class="support-mark" aria-hidden="true">♡</span>
  </span>
  <strong>{copy.title}</strong>
  <span class="support-description">{copy.description}</span>
  <span class="support-card-cta">
    {copy.cta}
    <i aria-hidden="true">↗</i>
  </span>
  <span class="support-note">{copy.note}</span>
</a>

<style is:global>
  .support-card {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid transparent;
    border-radius: 16px 4px 16px 16px;
    padding: 1.15rem;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--color-signal) 6%, var(--surface-elevated)), var(--surface-elevated) 65%) padding-box,
      linear-gradient(135deg, color-mix(in srgb, var(--color-signal) 48%, var(--color-line)), var(--color-line) 55%, color-mix(in srgb, var(--color-amber) 45%, var(--color-line))) border-box;
    box-shadow: inset 0 1px 0 var(--edge-highlight), var(--shadow-elevated);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .support-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 100% 0, color-mix(in srgb, var(--color-amber) 8%, transparent), transparent 11rem),
      repeating-linear-gradient(135deg, color-mix(in srgb, var(--color-line) 14%, transparent) 0 1px, transparent 1px 5px);
  }
  .support-card-top,
  .support-card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .support-mark {
    color: var(--color-amber);
    font-size: 1.7rem;
    line-height: 1;
  }
  .support-card small {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .support-card strong {
    display: block;
    margin-top: 0.65rem;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.3;
  }
  .support-description,
  .support-note {
    display: block;
    color: var(--color-muted);
    font-size: 0.73rem;
    line-height: 1.65;
  }
  .support-description { margin-top: 0.6rem; }
  .support-card-cta {
    min-height: 44px;
    margin-top: 1rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.7rem;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .support-note {
    margin-top: 0.55rem;
    font-size: 0.6rem;
  }
  .support-card-cta i {
    font-style: normal;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid color-mix(in srgb, var(--color-amber) 32%, var(--color-line));
    border-radius: 50%;
    color: var(--color-amber);
    font-size: 0.8rem;
  }
  .support-card:hover { border-color: var(--color-signal); }
  .support-card:hover .support-card-cta { color: var(--color-signal); }
  .support-card:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  .support-card.compact { padding: 1rem; }
  .support-card.compact strong { font-size: 1.08rem; }
  @media (prefers-reduced-motion: reduce) {
    .support-card { transition: none; }
  }
</style>
