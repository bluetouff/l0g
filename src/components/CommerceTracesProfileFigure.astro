</figure>
)}

{lang === "en" && figure === 2 && (
<figure class="commerce-profile-figure">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 464" style="width:100%;height:auto" role="img" aria-labelledby="traces03-en-fabrication-title traces03-en-fabrication-desc" font-family="Arial, Helvetica, sans-serif">
<title id="traces03-en-fabrication-title">From signal to product</title>
