<figure class="commerce-profile-figure">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 468" style="width:100%;height:auto" role="img" aria-labelledby="traces03-en-contrat-title traces03-en-contrat-desc" font-family="Arial, Helvetica, sans-serif">
