\"384\" height=\"32.4\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"xwell-sale-en-m-region-16\" data-label-region=\"true\"/>\n<text x=\"24\" y=\"663\" fill=\"var(--color-muted)\" font-family=\"l0g Xwell Investigation\" font-size=\"18\" font-weight=\"400\" text-anchor=\"start\" data-panel=\"xwell-sale-en-m-region-16\">Actual completion remains unconfirmed.</text>\n</svg>"
