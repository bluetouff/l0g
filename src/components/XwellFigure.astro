if(!/^\d{2}$/.test(figureNumber)||!sourceIds.every(id=>/^(?:s09|s10|s11|s12|s13|s14|s15|s16|s17|s18|s19|s28)$/.test(id)))throw new TypeError('Invalid figure metadata');
const captions={
 ownership:{fr:'Photographie Dominari au 20 octobre 2026, publiée dans le proxy du 6 novembre : Donald Trump Jr. et Eric Trump détiennent chacun 1 398 414 actions, soit 5,55 % sur 25 201 979 actions ordinaires. Dans son rapport au 30 juin 2026, Dominari détient 90 % de chacun des deux gestionnaires American Ventures Management LLC et American Ventures IM LLC. Les flèches représentent des relations qualitatives, sans échelle de montant.',en:'Dominari snapshot at October 20, 2026, published in the November 6 proxy: Donald Trump Jr. and Eric Trump each hold 1,398,414 shares, or 5.55% of 25,201,979 common shares. In its report at June 30, 2026, Dominari owns 90% of each of American Ventures Management LLC and American Ventures IM LLC. Arrows represent qualitative relationships, without a monetary scale.'},
 financing:{fr:'Dollars nominaux, placement de février–mars 2026 : 31,333 millions bruts, 3,064 millions de frais en trésorerie, puis 9 millions pour racheter des instruments antérieurs. Le solde de 19,269 millions précède les autres flux de la société. Le produit net après frais cash est de 28,269 millions.',en:'Nominal dollars, February–March 2026 placement: 31.333 million gross, 3.064 million of cash financing costs, then 9 million redeeming earlier instruments. The 19.269 million remainder precedes the company’s other cash flows. Net proceeds after cash costs are 28.269 million.'},
 sale:{fr:'Le modèle Roth utilise la trésorerie au 31 mars 2026 : 13 millions de prix de base + 15,6 millions de distribution supposée avant clôture + 1,5 million laissé dans les filiales = 30,1 millions de valeur. Les deux composantes de trésorerie totalisent 17,1 millions déjà détenus. Les séquestres de 2,65 millions sont prévus à la clôture, avec les ajustements contractuels. La réalisation de la vente reste à confirmer.',en:'The Roth model uses cash at March 31, 2026: 13 million base price + 15.6 million assumed pre-closing distribution + 1.5 million left in the subsidiaries = 30.1 million of value. The two cash components total 17.1 million already held. Escrows of 2.65 million are provided for at closing, together with contractual adjustments. Completion of the sale remains unconfirmed.'},
}as const;
const methods={
 ownership:{fr:'Les pourcentages personnels se calculent dans le capital de Dominari : 1 398 414 / 25 201 979 × 100 = 5,548826... %, arrondi à 5,55 %. Leur date est le 20 octobre 2026 ; le dépôt date du 6 novembre. Le 90 % concerne les deux sociétés de gestion citées dans le 10-Q de Dominari au 30 juin 2026, pas les droits des investisseurs de la Series XXIV. Cette série détient directement les titres XWELL ; les gestionnaires et Dominari déclarent des pouvoirs de vote et de disposition. Le groupe distingue ces fonctions de gestion de l’intermédiation de Dominari Securities, agent de placement rémunéré. Le registre complet des investisseurs, la répartition des revenus de la série et les gains personnels des frères restent à établir. Le graphe ne permet aucune multiplication des pourcentages jusqu’à XWELL et ne trace aucun versement de fonds publics à la famille.',en:'The personal percentages are measured within Dominari’s common equity: 1,398,414 / 25,201,979 × 100 = 5.548826...%, rounded to 5.55%. The snapshot is October 20, 2026; the filing is November 6. The 90% applies to the two management companies identified in Dominari’s June 30, 2026 10-Q, rather than investors’ economic rights in Series XXIV. That series directly holds XWELL securities; the managers and Dominari report voting and dispositive powers. The group distinguishes management functions from the paid placement role of Dominari Securities. The complete investor register, series distributions and the brothers’ personal gains remain to be established. The graph does not support multiplying the percentages through to XWELL and traces no public-funds payment to the family.'},
 financing:{fr:'Calcul de trésorerie : 31 333 000 − 3 064 000 = 28 269 000 dollars ; 28 269 000 − 9 000 000 = 19 269 000 dollars avant les autres flux. Les frais en trésorerie sont la différence entre le brut clôturé et le produit net du tableau de flux. Ils ne doivent pas être assimilés aux 10 216 000 dollars de coûts de transaction comptables de la note 10 du 10-Q : cette somme inclut 7 152 000 dollars de juste valeur de warrants, sans sortie de trésorerie immédiate. La réconciliation est 3 064 000 + 7 152 000 = 10 216 000 ; déduire 10 216 000 du brut de trésorerie ferait un double compte. Les commissions de 8 % et l’allocation de frais de 1 % ne s’ajoutent pas une deuxième fois à ce pont. Exploitation, investissement et autres mouvements interviennent dans le solde final ; les 19,269 millions ne représentent pas une trésorerie de clôture. Les dimensions des barres sont proportionnelles aux dollars, à échelle commune dans chaque variante.',en:'Cash calculation: 31,333,000 − 3,064,000 = 28,269,000 dollars; 28,269,000 − 9,000,000 = 19,269,000 dollars before other cash flows. Cash financing costs are the difference between closed gross proceeds and net issuance proceeds in the cash-flow statement. They differ from the 10,216,000 dollars of accounting transaction costs in note 10 of the 10-Q: that amount includes 7,152,000 dollars of warrant fair value without an immediate cash outflow. The reconciliation is 3,064,000 + 7,152,000 = 10,216,000; subtracting 10,216,000 from gross cash proceeds would double count. The 8% placement fee and 1% expense allowance are not deducted a second time in this bridge. Operations, investment and other movements enter the final cash balance; 19.269 million is not closing cash. Bar dimensions are proportional to dollars on a common scale within each variant.'},
 sale:{fr:'Montants nominaux du modèle présenté aux actionnaires, établis sur des hypothèses de direction. Calcul : 13 + 15,6 + 1,5 = 30,1 millions de dollars ; 15,6 + 1,5 = 17,1 millions de trésorerie existante au 31 mars. La proposition initiale de 13 millions était non contraignante au 11 mars ; l’accord définitif a été signé le 6 juillet et l’approbation actionnariale date du 28 octobre. Ces étapes ne prouvent pas la clôture. Les 2,65 millions de séquestres contractuels se décomposent en 750 000 dollars d’ajustements, 1 650 000 d’indemnisation et 250 000 liés à un arbitrage. Le prix final dépend notamment du cash, de la dette, des dépenses de vente encore impayées et du fonds de roulement. Le rachat RSA déclaré déjà payé en octobre est exclu des dépenses encore impayées, sans seconde déduction. La divergence du 5 octobre dans le proxy et du 8 octobre dans le 8-K reste non résolue. Le modèle arrondit les séquestres à 2,7 millions et sa valeur nette à 27,4 millions ; les chiffres affichés arrondis ne permettent pas de recalculer une valeur finale exacte. Les largeurs du graphique sont proportionnelles aux composantes du modèle, et non à des recettes effectivement encaissées.',en:'Nominal amounts in the shareholder model, based on management assumptions. Calculation: 13 + 15.6 + 1.5 = 30.1 million dollars; 15.6 + 1.5 = 17.1 million of existing cash at March 31. The initial 13 million proposal was non-binding on March 11; the definitive agreement was signed on July 6 and shareholders approved it on October 28. Those events do not establish completion. Contractual escrows of 2.65 million consist of 750,000 dollars for adjustments, 1,650,000 for indemnities and 250,000 for an arbitration matter. The final price depends on cash, debt, unpaid sale expenses and working capital. RSA repurchases reported as paid in October are excluded from unpaid expenses, without a second deduction. The discrepancy between October 5 in the proxy and October 8 in the 8-K remains unresolved. The model rounds escrow to 2.7 million and net value to 27.4 million; the displayed rounded inputs cannot yield an exact final value. Graph widths are proportional to model components, rather than cash actually received.'},
}as const;
---
<figure class="xwell-figure" id={`figure-${figureNumber}`} data-kind={kind}>
 <div class="desktop-art" set:html={scene.desktop}></div>
 <div class="mobile-art" set:html={scene.mobile}></div>
 <figcaption><span class="figure-number">FIGURE {figureNumber}</span><strong>{entry[lang]}</strong>{caption??captions[kind][lang]} {sourceIds.map(id=><a href={`#source-${id}`} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}</figcaption>
 <details><summary>{lang==='fr'?'Méthode et périmètre':'Method and scope'}</summary><div class="method">{methods[kind][lang]}<slot/></div></details>
</figure>
<style>
 @font-face{font-family:'l0g Xwell Investigation';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
 .xwell-figure{width:100%;max-width:800px;margin:2.8rem auto;padding-bottom:1rem;container-type:inline-size;overflow:visible}
 .desktop-art,.mobile-art{width:100%;line-height:0}.mobile-art{display:none;max-width:340px;margin-inline:auto}
 .xwell-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
 figcaption{padding:.85rem 0 .45rem;font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted)}
 figcaption strong{display:block;margin:.25rem 0;font-size:1rem;font-weight:400;color:var(--color-paper)}
 .figure-number{font-size:.75rem;letter-spacing:.12em;color:var(--color-signal)}a{margin-right:.45rem}
 details{margin-top:.35rem;font-family:var(--font-read);font-size:.875rem;line-height:1.7}summary{cursor:pointer;padding:.35rem 0}summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.method{margin-top:.5rem;color:var(--color-muted)}
 @container (max-width:660px){.desktop-art{display:none}.mobile-art{display:block}}
 @media print{.desktop-art{display:block}.mobile-art{display:none}.xwell-figure{break-inside:avoid}}
</style>
