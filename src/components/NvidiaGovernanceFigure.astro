} as const;
const captions = {
  "control": {
    "fr": "Enquête mandatée le 10 novembre. La flèche « Rapport » montre le circuit attendu ; les alertes suivent le canal de conformité.",
    "en": "Inquiry commissioned on 10 November. The Report arrow shows the reporting route; compliance reports follow their own channel."
  },
  "leverage": {
    "fr": "Intel, 22 août 2025 : participation passive, sans siège au conseil. La branche Nvidia illustre une hypothèse.",
    "en": "Intel, 22 August 2025: passive ownership without a board seat. The Nvidia branch is an analytical scenario."
  },
  "finance": {
    "fr": "CoreWeave : GPU, capital et achat conditionnel de capacité résiduelle. Les engagements signés suivent leurs clauses.",
    "en": "CoreWeave: GPUs, equity and conditional purchases of residual capacity. Signed commitments follow their terms."
  }
} as const;
if ((lang !== 'fr' && lang !== 'en') || !Object.prototype.hasOwnProperty.call(art[lang], kind)) throw new Error('Unknown Nvidia governance figure');
const scene = art[lang][kind];
const dimensions = {control: {desktop: '800 / 500', mobile: '400 / 540', desktopRatio: 1.6, mobileRatio: 400 / 540}, finance: {desktop: '800 / 480', mobile: '400 / 520', desktopRatio: 800 / 480, mobileRatio: 400 / 520}, leverage: {desktop: '800 / 480', mobile: '400 / 540', desktopRatio: 800 / 480, mobileRatio: 400 / 540}}[kind];
const number = {control: '01', finance: '02', leverage: '03'}[kind];
const sourceIds = {control: ['s03', 's04', 's05', 's08'], finance: ['s14', 's24', 's25'], leverage: ['s27', 's28', 's32']}[kind];
---
<figure class="nvidia-governance-figure" id={`nv3-figure-${kind}-${lang}`} data-kind={kind}>
  <div class="art desktop-art" style={`--nv3-ratio:${dimensions.desktopRatio};aspect-ratio:${dimensions.desktop}`} set:html={scene.desktop}></div>
  <div class="art mobile-art" style={`--nv3-ratio:${dimensions.mobileRatio};aspect-ratio:${dimensions.mobile}`} set:html={scene.mobile}></div>
  <figcaption>
    <span class="figure-number">FIGURE {number}</span>
    {captions[kind][lang]}
    <span class="sources">{sourceIds.map(id => <a href={`#source-${id}`} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}</span>
  </figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Investigation';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-governance-figure{width:100%;max-width:40rem;margin:1.6rem auto 1.8rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:min(100%,calc((100svh - 150px)*var(--nv3-ratio)));max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .nvidia-governance-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.75rem;color:var(--color-muted);font-family:var(--font-read);font-size:.875rem;line-height:1.55;font-weight:400}
  .figure-number{display:block;margin-bottom:.3rem;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.1em;color:var(--color-signal)}
  .sources{white-space:nowrap}.sources a{margin-left:.35rem;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:500px){.desktop-art{display:none}.mobile-art{display:block}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.nvidia-governance-figure{break-inside:avoid}}
</style>
