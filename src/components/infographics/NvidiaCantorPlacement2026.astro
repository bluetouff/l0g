one\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"gross-market-proceeds\"/><path d=\"M100 225L95 229L100 233\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"180\" y=\"222\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-signal)\">Gross proceeds</text><g transform=\"translate(60 229)\" data-icon=\"settlement\"><path d=\"M-13-17H13V17H-13Z M-7-10H7 M-7-3H7 M-7 4H-2 M3 4H7 M-7 10H-2 M3 10H7\" fill=\"none\" stroke=\"var(--color-muted)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"60\" y=\"267\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Settlement</text><path d=\"M60 195V150\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"net-issuer-proceeds\"/><path d=\"M56 155L60 150L64 155\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"75\" y=\"172\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-signal)\">Net proceeds</text><path d=\"M77 207H140V180H214\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"conditional-agent-commission\"/><path d=\"M209 176L214 180L209 184\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"130\" y=\"198\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"end\" fill=\"var(--color-amber)\">Commission</text><text x=\"160\" y=\"305\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Up to 3% of gross</text></svg>"
  }
} as const;
const captions = {
  "fr": "Une vente par agent sépare produit net et commission. Le contrat prévoit aussi un rôle de principal, dont l’exercice par Cantor reste à documenter.",
  "en": "An agency sale separates net proceeds from the commission. The agreement also allows a principal role, whose use by Cantor remains to be documented."
} as const;
if (!['fr', 'en'].includes(lang)) throw new Error('Unknown Nvidia infographic language');
const scene = art[lang];
---
<figure class="nvidia-cantor-placement" id={`nvidia-cantor-placement-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 01</span>{' '}{captions[lang]}{' '}<span class="sources"><a href="#source-S03" aria-label="Source S03">[S03]</a></span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Cantor Export';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  figure{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}figure{break-inside:avoid}}
</style>
