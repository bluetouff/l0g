const captions = {
  fr: 'Quantités de H200 Nvidia et MI325X AMD dans la synthèse partielle du BIS au 11 mai 2026, rendue publique le 19 novembre par les démocrates de la commission des Affaires étrangères. Le périmètre comprend des entreprises établies en Chine ou dont la maison mère ultime y siège. Barres sur une même échelle, en nombre de puces.',
  en: 'Nvidia H200 and AMD MI325X chip counts in the partial BIS snapshot dated May 11, 2026, disclosed on November 19 by House Foreign Affairs Committee Democrats. The scope includes companies located or headquartered in China, or whose ultimate parent is headquartered there. Both bars use the same chip-count scale.',
} as const;
if (!['fr', 'en'].includes(lang)) throw new Error('Unknown Nvidia BIS license snapshot language');
const scene = art[lang];
---
<figure class="nvidia-bis-license-snapshot" id={`nv21-bis-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 01</span>{' '}{captions[lang]}{' '}<span class="sources"><a href="#source-S01" aria-label="Source S01">[S01]</a>{' '}<a href="#source-S02" aria-label="Source S02">[S02]</a></span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia BIS License Snapshot';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-bis-license-snapshot{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  .nvidia-bis-license-snapshot :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}.nvidia-bis-license-snapshot{break-inside:avoid}}
</style>
