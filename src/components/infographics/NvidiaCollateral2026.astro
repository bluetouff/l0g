    "fr": "Procédure générale d’ajout à l’Entity List : vote majoritaire de l’ERC, présidé par Commerce, puis publication par BIS. Les autres agences sont State, Defense et Energy ; Treasury intervient lorsque cela est approprié. Les recours peuvent remonter à ACEP, EARB et au Président.",
    "en": "General Entity List addition procedure: a majority vote by the Commerce-chaired ERC, followed by BIS publication. Other agencies are State, Defense and Energy; Treasury participates when appropriate. Appeals may proceed to ACEP, EARB and the President."
  }
} as const;
const sources = { collateral: ['S01', 'S02', 'S03'], governance: ['S07'] } as const;
if (!['fr', 'en'].includes(lang) || !['collateral', 'governance'].includes(figure)) throw new Error('Unknown Nvidia collateral figure');
const scene = art[lang][figure];
---
<figure class="nvidia-collateral-figure" id={`nv8-${figure}-${lang}`} data-kind={figure}>
  <div class="art desktop-art" style="aspect-ratio:800 / 400" set:html={scene.desktop}></div>
  <div class="art mobile-art" style="aspect-ratio:320 / 400" set:html={scene.mobile}></div>
  <figcaption><span class="figure-number">FIG. {figure === 'collateral' ? '01' : '02'}</span>{captions[figure][lang]} <span class="sources">{sources[figure].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Collateral';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-collateral-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .nvidia-collateral-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  .figure-number{display:inline-block;margin-inline-end:.5rem}
  figcaption{margin-top:.6rem;padding-bottom:.35rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .figure-number{display:inline;margin-right:.45rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:18rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.nvidia-collateral-figure{break-inside:avoid}}
</style>
