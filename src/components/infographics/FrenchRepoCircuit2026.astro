text x=\"62\" y=\"164\" font-family=\"l0g French Debt Repo\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-paper)\" data-panel=\"actors\" text-anchor=\"middle\">Fund</text><text x=\"258\" y=\"164\" font-family=\"l0g French Debt Repo\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-paper)\" data-panel=\"actors\" text-anchor=\"middle\">Bank</text><path d=\"M90 101 L230 101\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"bond-collateral\"/><path d=\"M225 97 L230 101 L225 105\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"160\" y=\"88\" font-family=\"l0g French Debt Repo\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-paper)\" data-panel=\"collateral\" text-anchor=\"middle\">OAT</text><path d=\"M230 123 L90 123\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"repo-cash\"/><path d=\"M95 119 L90 123 L95 127\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"160\" y=\"145\" font-family=\"l0g French Debt Repo\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-paper)\" data-panel=\"collateral\" text-anchor=\"middle\">Repo cash</text><g transform=\"translate(241 221)\" data-icon=\"future\"><path d=\"M4 4 H30 V31 H4 Z M4 12 H30 M10 1 V8 M24 1 V8 M9 25 L15 19 L20 23 L26 17\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><path d=\"M62 183 L62 237 L230 237\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"futures-hedge\"/><path d=\"M225 233 L230 237 L225 241\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round