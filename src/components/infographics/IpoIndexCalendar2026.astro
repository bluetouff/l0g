const captions = {
  "fr": "Dates d’effet à l’ouverture, sous réserve d’une première séance le 19 novembre 2026 et des critères propres à chaque indice. MSCI : clôture du 30 novembre ; Russell US : 11 décembre ; FTSE mondial : 18 décembre. Nasdaq : J7 le 30 novembre, J15 le 10 décembre et priorité à la revue du même mois. Chaque inclusion reste conditionnelle. Avis et méthodes consultés le 18 novembre 2026.",
