01\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"nvidia-equity-payment\"/><path d=\"M196 68L201 72L196 76\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"151\" y=\"55\" font-family=\"l0g Nvidia Commitments\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">$1bn</text><text x=\"151\" y=\"92\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Paid 6 Nov</text><g transform=\"translate(58 159)\" data-icon=\"case\"><path d=\"M-14-7H14V12H-14Z M-5-7V-12H5V-7 M-14-1Q0 6 14-1 M-3 2H3\" fill=\"none\" stroke=\"var(--color-muted)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"58\" y=\"194\" font-family=\"l0g Nvidia Commitments\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Brookfield</text><g transform=\"translate(245 159)\" data-icon=\"racks\"><path d=\"M-18-15H-2V15H-18Z M2-15H18V15H2Z M-13-9H-7 M-13-3H-7 M-13 3H-7 M-13 9H-7 M7-9H13 M7-3H13 M7 3H13 M7 9H13\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"245\" y=\"194\" font-family=\"l0g Nvidia Commitments\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Asset Co.</text><text x=\"245\" y=\"212\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">GPU infrastructure</text><path d=\"M108 159H201\" fill=\"none\" stroke=\"var(--color-muted)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"brookfield-planned-investment\"/><path d=\"M196 155L201 159L196 163\" fill=\"none\" stroke=\"var(--color-muted)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"154\" y=\"141\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Up to $9bn</text><g transform=\"translate(58 252)\" data-icon=\"cloud\"><path d=\"M-16 10C-26 8-24-6-15-7C-13-20 5-23 11-9C25-11 28 9 16 10Z M-8 0L0-5L8 0 M0-5V9\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"58\" y=\"287\" font-family=\"l0g Nvidia Commitments\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Naver Cloud</text><path d=\"M221 216L106 248\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"compute-service\"/><path d=\"M110 242L106 248L113 249\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"164\" y=\"226\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Compute</text><path d=\"M90 278H245V220\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"cloud-usage-fees\"/><path d=\"M241 225L245 220L249 225\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"175\" y=\"299\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Usage fees</text><path d=\"M275 72H307V278H251\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-dasharray=\"3 4\" data-relationship=\"naver-fee-guarantee\"/><path d=\"M256 274L251 278L256 282\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"303\" y=\"236\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"end\" fill=\"var(--color-amber)\">Guarantee</text><text x=\"303\" y=\"252\" font-family=\"l0g Nvidia Commitments\" font-size=\"12\" font-weight=\"400\" text-anchor=\"end\" fill=\"var(--color-amber)\">≤ 8 years</text></svg>"
  }
} as const;
const captions = {
  "fr": "Le milliard Nvidia est versé le 6 novembre 2026. Le schéma distingue l’investissement prévu par Brookfield, le service de calcul et la garantie des redevances de Naver Cloud, décrits par Naver le 27 octobre.",
  "en": "Nvidia’s billion-dollar payment was made on 6 November 2026. The diagram separates Brookfield’s planned investment, compute services and the guarantee of Naver Cloud’s fees described by Naver on 27 October."
} as const;
if (!['fr', 'en'].includes(lang)) throw new Error('Unknown Nvidia infographic language');
const scene = art[lang];
---
<figure class="nvidia-naver-commitments" id={`nvidia-naver-commitments-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 01</span>{' '}{captions[lang]}{' '}<span class="sources"><a href="#source-S05" aria-label="Source S05">[S05]</a>{' '}<a href="#source-S06" aria-label="Source S06">[S06]</a></span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Commitments';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  figure{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}figure{break-inside:avoid}}
</style>
