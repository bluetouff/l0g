o\" data-horizon=\"month\" data-value=\"4.97\"/><text x=\"16\" y=\"137\" font-family=\"l0g IPO ETF\" font-size=\"13\" font-weight=\"400\" fill=\"var(--color-paper)\" text-anchor=\"start\" data-panel=\"canvas\">Market</text><text x=\"304\" y=\"137\" font-family=\"l0g IPO ETF\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-amber)\" text-anchor=\"end\" data-panel=\"canvas\">1.00 %</text><rect x=\"86\" y=\"142\" width=\"21.0\" height=\"5\" fill=\"var(--color-amber)\" rx=\"1\" data-series=\"market\" data-horizon=\"month\" data-value=\"1.00\"/><path d=\"M86 157 L296 157\" fill=\"none\" stroke=\"var(--color-line-strong)\" stroke-width=\"1\" stroke-linecap=\"round\" /><path d=\"M86.0 155 L86.0 159\" fill=\"none\" stroke=\"var(--color-line-strong)\" stroke-width=\"1\" stroke-linecap=\"round\" /><text x=\"86.0\" y=\"175\" font-family=\"l0g IPO ETF\" font-size=\"13\" font-weight=\"400\" fill=\"var(--color-muted)\" text-anchor=\"middle\" data-panel=\"canvas\">0</text><path d=\"M191.0 155 L191.0 159\" fill=\"none\" stroke=\"var(--color-line-strong)\" stroke-width=\"1\" stroke-linecap=\"round\" /><text x=\"191.0\" y=\"175\" font-family=\"l0g IPO ETF\" font-size=\"13\" font-weight=\"400\" fill=\"var(--color-muted)\" text-anchor=\"middle\" data-panel=\"canvas\">5</text><path d=\"M296.0 155 L296.0 159\" fill=\"none\" stroke=\"var(--color-line-strong)\" stroke-width=\"1\" stroke-linecap=\"round\" /><text x=\"296.0\" y=\"175\" font-family=\"l0g IPO ETF\" font-size=\"13\" font-weight=\"400\" fill=\"var(--color-muted)\" text-anchor=\"middle\" data-panel=\"canvas\">10</text><text x=\"16\" y=\"201\" font-family=\"l0g IPO ETF\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-signal)\" text-anchor=\"start\" data-panel=\"canvas\">Gap +3.97 pp</text><text x=\"16\" y=\"218\" font-family=\"l0g IPO ETF\" font-size=\"14\" font-weight=\"400\" fill=\"var(--color-paper)\" text-anchor=\"start\" data-panel=\"canvas\">One year</text><text x=\"16\" y=\"242\" font-family=\"l0g IPO ETF\"