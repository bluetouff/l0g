const captions = {
  "fr": "BCE, FSR du 18 novembre 2026, graphique C.4.b, arrêté documentaire au 10 novembre. Janvier 1995–juillet 2026 ; membres actuels ou passés du S&P 500 et de l’EURO STOXX 300, IPO primaires, secondaires et mixtes d’au moins 1 Md€. Rendements médians : IPO pondérées par montant offert, marché par capitalisation. Écarts calculés entre statistiques publiées ; leur point de départ boursier exact reste non précisé dans la notice. Ces rendements diffèrent de ceux d’un ETF entrant après l’IPO.",
  "en": "ECB FSR, November 18, 2026, Chart C.4.b, information cut-off November 10. January 1995–July 2026; former or current S&P 500 and EURO STOXX 300 constituents, primary, secondary and mixed IPOs of at least EUR 1bn. Reported median returns: IPOs weighted by issuance volume, market by capitalisation. Gaps subtract published statistics; the notes leave the precise stock-price starting point unspecified. These differ from an ETF return after index entry."
} as const;
const scene = art[lang];
---
<figure class="ipo-returns" id={`ipo-returns-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 03</span>{' '}{captions[lang]}{' '}<a href="#source-S18" aria-label="Source S18">[S18]</a></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g IPO ETF';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  figure{width:100%;max-width:42.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:628px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}figure{break-inside:avoid}}
</style>
