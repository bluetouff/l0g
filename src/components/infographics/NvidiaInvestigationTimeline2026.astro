95 95 H218\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"commerce-records\"/><path d=\"M213 91 L218 95 L213 99\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M277 95 H302 V199 H278\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"records-check\"/><path d=\"M283 195 L278 199 L283 203\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g transform=\"translate(231 184)\" data-icon=\"check\"><path d=\"M1 30 H33 M5 30 V8 L17 1 L29 8 V30 M10 12 H14 M20 12 H24 M10 18 H14 M20 18 H24 M12 30 V24 H22 V30\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><g transform=\"translate(53 184)\" data-icon=\"justice\"><path d=\"M17 0 V30 M5 30 H29 M4 8 H30 M6 8 L0 20 H12 Z M28 8 L22 20 H34 Z M12 4 H22\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><path d=\"M219 199 H99\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"check-doj\"/><path d=\"M104 195 L99 199 L104 203\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"69\" y=\"73\" font-family=\"l0g Nvidia Board Oversight\" font-size=\"13\" font-weight=\"400\" fill=\"var(--color-signal)\" text-anchor=\"middle\">2024</text><text x=\"249\" y=\"73\" font-family=\"l0g Nvidia Board Oversight\" font-size=\"13\" font-weight=\"400\" fill=\"var(--color-signal)\" text-anchor=\"middle\">May 2025</text><text x=\"69\" y=\"132\" font-family=\"l0g Nvidia Board Oversight\" font-size=\"13\" font-weight=\"400\" fi