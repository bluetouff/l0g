const captions = {
  "1": {
    "fr": "La comparaison porte sur les coûts nets actualisés, avec prix, recouvrements, frais et risques conservés. First Republic relevait du moindre coût. SVB et Signature étaient sous exception systémique, avec un cadre juridique distinct.",
    "en": "The comparison uses discounted net costs, including price, recoveries, expenses and retained risks. First Republic was subject to the least-cost requirement. SVB and Signature operated under the systemic-risk exception, within a different legal framework."
  },
  "2": {
    "fr": "Sur 355 dossiers First Republic sélectionnés pour la revue, 57 ont été reçus (16,1 %). La sélection non aléatoire ciblait les trois plus gros prêts par sous-catégorie. Les carrés comptent les dossiers à poids égal, indépendamment des encours.",
    "en": "The First Republic review received 57 of 355 selected files (16.1%). The non-random selection targeted the three largest loans in each subcategory. Each square counts one file, with equal weight regardless of its loan balance."
  },
  "3": {
    "fr": "Les écarts de 7 et 227 jours concernent la finalisation du mémo Signature et la création du mémo First Republic après les opérations de 2023. Ces dates de formalisation documentaire se distinguent du début des travaux d’analyse.",
    "en": "The two 2023 intervals run from operational transfer to Signature’s finalised memo and First Republic’s newly created memo, respectively 7 and 227 calendar days. They track documentary formalisation, distinct from when the valuation work began."
  }
} as const;
