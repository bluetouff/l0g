  "1": [
    "S01",
    "S03",
    "S08"
  ],
  "2": [
    "S01"
  ],
  "3": [
    "S01"
  ]
} as const;
if (![1, 2, 3].includes(figure) || !['fr', 'en'].includes(lang)) throw new Error('Unknown FDIC valuation figure');
const scene = art[lang][figure];
---
<figure class="fdic-valuation-figure" id={`fdic-valuation-${figure}-${lang}`} data-figure={figure}>
  <div class="art desktop-art" set:html={scene.desktop}></div>
  <div class="art mobile-art" set:html={scene.mobile}></div>
  <figcaption><span class="figure-number">FIG. 0{figure}</span>{' '}{captions[figure][lang]} <span class="sources">{references[figure].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g FDIC Valuation';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .fdic-valuation-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .fdic-valuation-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.6rem;padding-bottom:.35rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .figure-number{display:inline;margin-right:.45rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:21.25rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.fdic-valuation-figure{break-inside:avoid}}
</style>
