  .nvidia-taiwan-outreach-number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  .nvidia-taiwan-outreach a{display:inline-block;text-underline-offset:.18em}
  .nvidia-taiwan-outreach a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.nvidia-taiwan-outreach-desktop{display:none}.nvidia-taiwan-outreach-mobile{display:block;max-width:20rem;margin-inline:auto}}
