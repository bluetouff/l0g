<style>
  @font-face{font-family:'l0g Nvidia Taiwan Justice';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-taiwan-outreach{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .nvidia-taiwan-outreach-scene{width:100%;max-width:100%;line-height:0}
