---
<figure class="nvidia-credit-transmission" id={`nv20-credit-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 01</span>{' '}{captions[lang]}{' '}<span class="sources"><a href="#source-S01" aria-label="Source S01">[S01]</a>{' '}<a href="#source-S04" aria-label="Source S04">[S04]</a>{' '}<a href="#source-S06" aria-label="Source S06">[S06]</a>{' '}<a href="#source-S07" aria-label="Source S07">[S07]</a></span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Credit Transmission';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-credit-transmission{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  .nvidia-credit-transmission :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}.nvidia-credit-transmission{break-inside:avoid}}
