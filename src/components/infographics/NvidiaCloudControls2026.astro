=\"272\" y=\"146\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">customer</text><path d=\"M102 97V159H80V172\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"destination-check\"/><path d=\"M76 167L80 172L84 167\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M217 97V159H240V172\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"end-use-check\"/><path d=\"M236 167L240 172L244 167\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"80\" y=\"192\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-signal)\">Destination</text><text x=\"80\" y=\"210\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">§ 742.6</text><text x=\"80\" y=\"236\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Indonesia · Malaysia</text><text x=\"80\" y=\"254\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Singapore · Brazil</text><text x=\"80\" y=\"272\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Thailand</text><text x=\"80\" y=\"300\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Conditional</text><text x=\"80\" y=\"317\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">US exclusion</text><text x=\"240\" y=\"192\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Known end use</text><text x=\"240\" y=\"210\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">§ 744.24</text><text x=\"240\" y=\"236\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">D:5 / Macau</text><text x=\"240\" y=\"260\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"16\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">&gt; 12 M</text><text x=\"240\" y=\"279\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">aggregate TPP</text><text x=\"240\" y=\"300\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">One data center</text><text x=\"240\" y=\"317\" font-family=\"l0g Nvidia Cloud Controls\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">or linked sites</text></svg>"
  }
} as const;
const captions = {
  "fr": "Contrôles annoncés le 16 novembre 2026. La destination et l’usage peuvent conditionner l’autorisation des équipements. Le seuil TPP vise l’accès des entreprises au siège ou à la société mère ultime en D:5/Macao. Exclusion US sous conditions ; autres exclusions dans le texte.",
  "en": "Controls announced on 16 November 2026. Destination and end use can trigger equipment authorization. The TPP threshold concerns access for companies headquartered, or with an ultimate parent headquartered, in D:5/Macau. Conditional US exclusion; further exclusions in the text."
} as const;
if (!['fr', 'en'].includes(lang)) throw new Error('Unknown Nvidia infographic language');
const scene = art[lang];
---
<figure class="nvidia-cloud-controls" id={`nvidia-cloud-controls-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 01</span>{' '}{captions[lang]}{' '}<a href="#source-S01" aria-label="Source S01">[S01]</a>{' '}<a href="#source-S02" aria-label="Source S02">[S02]</a></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Cloud Controls';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  figure{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}figure{break-inside:avoid}}
</style>
