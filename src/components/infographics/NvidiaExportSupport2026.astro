const captions = {
  "fr": "Schéma général d’un crédit export garanti, dans le cadre antérieur à la crise. Chaque opération reste soumise aux critères du prêteur et de l’agence. Aucun bénéficiaire Nvidia ni montant engagé n’est représenté.",
  "en": "General mechanism for a guaranteed export credit, within a framework predating the crisis. Each transaction remains subject to lender and agency criteria. No named Nvidia beneficiary or committed amount is represented."
} as const;
if (!['fr', 'en'].includes(lang)) throw new Error('Unknown Nvidia infographic language');
const scene = art[lang];
---
<figure class="nvidia-export-support" id={`nvidia-export-support-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 02</span>{' '}{captions[lang]}{' '}<span class="sources"><a href="#source-S06" aria-label="Source S06">[S06]</a>{' '}<a href="#source-S07" aria-label="Source S07">[S07]</a>{' '}<a href="#source-S10" aria-label="Source S10">[S10]</a></span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Succession';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  figure{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
