249 250V267H185\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"third-party-use-reduces-commitment\"/><path d=\"M190 263L185 267L190 271\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g transform=\"translate(160 267)\" data-icon=\"reduction\"><path d=\"M-12-14H5L12-7V14H-12Z M5-14V-7H12 M-5-4H2 M-5 2H2 M0 5V12 M-4 8L0 12L4 8\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"160\" y=\"301\" font-family=\"l0g Nvidia Client Financing\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Remaining commitment reduced</text><text x=\"160\" y=\"319\" font-family=\"l0g Nvidia Client Financing\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">As capacity is used</text></svg>"
