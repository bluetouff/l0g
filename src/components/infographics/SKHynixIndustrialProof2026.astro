const captions = {
  "1": {
    "fr": "Mécanismes annoncés au 16 novembre 2026. Les essais peuvent préparer une qualification, puis une décision d’achat du client. L’accès au financement suit une recommandation de SK hynix et l’examen de K-SURE. Les modalités d’admission aux essais restent à documenter.",
    "en": "Mechanisms announced as of 16 November 2026. Testing may lead to qualification and then a customer purchasing decision. Financing involves a SK hynix recommendation and K-SURE review. Detailed testbed admission rules remain to be documented."
  },
  "2": {
    "fr": "Montants annoncés en wons nominaux. La part publique vaut (373,6 + 57,7) ÷ 874,6, soit 49,3 %. Le programme sur cinq ans, le budget 2025–2031 et la capacité de crédit ont des périmètres distincts. Les 2 000 milliards représentent une capacité potentielle, avant tirages.",
    "en": "Announced amounts in nominal won. Public funding is (373.6 + 57.7) ÷ 874.6, or 49.3%. The five-year programme, the 2025–2031 budget and the credit capacity have distinct scopes. KRW2,000 billion is potential capacity before drawdowns."
  },
  "3": {
    "fr": "Relevé du catalogue au 16 novembre 2026. Les 26 références d’opérations unitaires sont comptées à poids égal selon leur année de mise en place prévue. Ce décompte porte sur les fiches de service et ne mesure pas la capacité industrielle.",
    "en": "Catalogue accessed on 16 November 2026. The 26 unit-process entries receive equal weight and are grouped by planned installation year. This is a count of service entries, rather than a measure of industrial capacity."
  }
} as const;
const references = {
  "1": [
    "S02",
    "S04",
    "S06",
    "S16"
  ],
  "2": [
    "S02",
    "S04",
    "S16"
  ],
  "3": [
    "S07"
  ]
} as const;
const catalogueGroups = [
  {
    "year": 2027,
    "ids": "PH-01, PH-02, ET-01, ET-03, DI-01, DI-02, DI-03, DI-04, TF-01, TF-05, TF-06, CC-01, CC-02, CC-04, CM-01"
  },
  {
    "year": 2028,
    "ids": "TF-02, TF-04, CC-05"
  },
  {
    "year": 2029,
    "ids": "ET-04, CC-03, CC-06"
  },
  {
    "year": 2030,
    "ids": "ET-02"
  },
  {
    "year": 2031,
    "ids": "DI-05, TF-03, TF-07, CC-07"
  }
] as const;
if (![1, 2, 3].includes(figure) || !['fr', 'en'].includes(lang)) throw new Error('Unknown industrial proof figure');
const scene = art[lang][figure];
---
<figure class="industrial-proof-figure" id={`industrial-proof-${figure}-${lang}`} data-figure={figure}>
  <div class="art desktop-art" set:html={scene.desktop}></div>
  <div class="art mobile-art" set:html={scene.mobile}></div>
  <figcaption><span class="figure-number">FIG. 0{figure}</span>{' '}{captions[figure][lang]} <span class="sources">{references[figure].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span></figcaption>
  {figure === 3 && <details class="catalogue-scope"><summary>{lang === 'fr' ? 'Références du relevé' : 'Entries included in the count'}</summary><p>{catalogueGroups.map(group => <span class="catalogue-year">{group.year} : {group.ids}.</span>)}</p></details>}
</figure>
<style>
  @font-face{font-family:'l0g Industrial Proof';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .industrial-proof-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .industrial-proof-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption,.catalogue-scope{color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  figcaption{margin-top:.6rem;padding-bottom:.35rem}
  .figure-number{display:inline;margin-right:.45rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible,summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  .catalogue-scope{margin-top:.3rem;overflow-wrap:anywhere}
  .catalogue-scope summary{cursor:pointer}
  .catalogue-scope p{margin:.35rem 0 0;font:inherit}
  .catalogue-year{display:block}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:21.25rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.industrial-proof-figure{break-inside:avoid}}
</style>
