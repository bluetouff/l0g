const captions = {
  "1": {
    "fr": "Schéma du circuit, au 14 novembre 2026. Refinancement à un an renouvelable, après distribution du prêt éligible. Il couvre le principal éligible, avec un risque de crédit conservé par la banque. Le cash rémunère les vendeurs du marché secondaire.",
    "en": "Flow schematic, 14 November 2026. One-year renewable relending follows disbursement of the eligible loan. It covers eligible principal; the lending bank retains credit risk. Cash goes to secondary-market sellers."
  },
  "2": {
    "fr": "Les pointillés relient les étapes du mécanisme, sans rapprochement chiffré entre séries. > indique un minimum annoncé, ≈ une approximation. Les montants se lisent selon leur définition, et la capacité de 800 Md couvre deux outils.",
    "en": "Dotted arrows link stages of the mechanism, without reconciling the series numerically. > denotes an announced minimum, ≈ an approximation. Each amount has its own definition; the CNY 800bn capacity covers two facilities."
  },
  "3": {
    "fr": "Programme et engagement bancaire sont prospectifs. Achats du 12 novembre publiés le 13, hors frais ; la part financée par un tirage bancaire reste inconnue. Les bandes suivent la même échelle monétaire. Les titres non transférés dans les trois ans après la fin du rachat doivent être annulés.",
    "en": "The programme and bank pledge are prospective. Purchases on 12 November were disclosed on the 13th, excluding fees; the bank-funded portion remains unknown. Bands share one monetary scale. Shares remaining untransferred three years after the buyback ends must be cancelled."
  }
