---
<figure class="china-buyback-figure" id={`china-buyback-${figure}-${lang}`} data-figure={figure}>
  <div class="art desktop-art" set:html={scene.desktop}></div>
  <div class="art mobile-art" set:html={scene.mobile}></div>
  <figcaption><span class="figure-number">FIG. 0{figure}</span>{' '}{captions[figure][lang]} <span class="sources">{sources[figure].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g China Buyback';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .china-buyback-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
