const captions = {
  funding: {
    fr: 'Plan de financement Songyuan du 27 avril 2026. Budget : 2,2589309 Md CNY. Parts indicatives visées. Bandes proportionnelles 80/20. Le retour des recettes vers la dette illustre le mécanisme économique.',
    en: 'Songyuan financing plan, 27 April 2026. Budget: CNY 2.2589309bn. Target shares; proportional 80/20 bands. The revenue-to-debt return illustrates the economic mechanism.',
  },
  licensing: {
    fr: 'Cadre juridique schématique des H200 éligibles depuis les États-Unis. Règle BIS applicable le 15 janvier 2026 ; proclamation tarifaire du 14 janvier applicable le 15. Les exemptions dépendent des usages américains.',
    en: 'Legal schematic for qualifying H200 exports from the United States. BIS rule effective 15 January 2026; tariff proclamation of 14 January effective on the 15th. Exemptions depend on US uses.',
  },
} as const;
const sources = { funding: ['S01'], licensing: ['S06', 'S07'] } as const;
if (!['fr', 'en'].includes(lang) || !['funding', 'licensing'].includes(figure)) throw new Error('Unknown Nvidia China credit figure');
const scene = art[lang][figure];
---
<figure class="nvidia-china-credit-figure" id={`nv9-${figure}-${lang}`} data-kind={figure}>
  <div class="art desktop-art" style="aspect-ratio:800 / 400" set:html={scene.desktop}></div>
  <div class="art mobile-art" style="aspect-ratio:320 / 400" set:html={scene.mobile}></div>
  <figcaption><span class="figure-number">FIG. {figure === 'funding' ? '01' : '02'}</span>{' '}{captions[figure][lang]} <span class="sources">{sources[figure].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia China Credit';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-china-credit-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .nvidia-china-credit-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.6rem;padding-bottom:.35rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .figure-number{display:inline;margin-right:.45rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:18rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.nvidia-china-credit-figure{break-inside:avoid}}
</style>
