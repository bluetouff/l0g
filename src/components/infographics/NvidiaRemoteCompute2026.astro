"round\"/></g><text x=\"500\" y=\"137\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Data centre</text><text x=\"500\" y=\"155\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Malaysia</text><path d=\"M143 97H454\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"physical-equipment-supply\"/><path d=\"M449 93L454 97L449 101\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"299\" y=\"79\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Equipment shipment</text><g transform=\"translate(100 228)\" data-icon=\"laptop\"><path d=\"M-19-16H19V9H-19Z M-25 16L-19 9H19L25 16Z M-7 13H7\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"100\" y=\"268\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Remote user</text><path d=\"M143 228H500V179\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"remote-network-access\"/><path d=\"M496 184L500 179L504 184\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"305\" y=\"211\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-signal)\">Network access to compute</text></svg>",
    "mobile": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" style=\"height:auto\" viewBox=\"0 0 320 330\" role=\"img\" aria-labelledby=\"nv15-remote-en-mobile-title nv15-remote-en-mobile-desc\" xml:lang=\"en\" data-variant=\"mobile\"><title id=\"nv15-remote-en-mobile-title\">Hardware and access to compute</title><desc id=\"nv15-remote-en-mobile-desc\">Infrastructure-use diagram based on Bitdeer documents and the NYT report. A third-party supplier provides equipment to a data centre, with Malaysia shown as the site location. A separate network connection links a remote user to the servers. The arrows distinguish hardware shipments from remote compute access. Nvidia is not identified as the direct supplier and no remote customer is named. Regulatory proposals reported by the NYT are discussed in the article rather than represented as an authorization or restriction.</desc><rect x=\"0.6\" y=\"0.6\" width=\"318.8\" height=\"328.8\" rx=\"3\" fill=\"var(--color-surface)\" stroke=\"var(--color-line-strong)\" stroke-width=\"1.1\"/><text x=\"18\" y=\"28\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"16\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\">Hardware and access to compute</text><g transform=\"translate(65 99)\" data-icon=\"shipment\"><path d=\"M-20-11H20V17H-20Z M-20-11L-10-20H10L20-11 M-5-8H5V4H-5Z M-14-4H-10 M10-4H14 M-14 10H14\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"65\" y=\"138\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12.5\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Third-party</text><text x=\"65\" y=\"155\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">supplier</text><g transform=\"translate(250 99)\" data-icon=\"racks\"><path d=\"M-23-19H-5V19H-23Z M5-19H23V19H5Z M-18-12H-10 M-18-4H-10 M-18 4H-10 M-18 12H-10 M10-12H18 M10-4H18 M10 4H18 M10 12H18\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"250\" y=\"138\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12.5\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Data centre</text><text x=\"250\" y=\"155\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Malaysia</text><path d=\"M105 99H211\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"physical-equipment-supply\"/><path d=\"M206 95L211 99L206 103\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"158\" y=\"81\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Equipment</text><g transform=\"translate(65 250)\" data-icon=\"laptop\"><path d=\"M-19-16H19V9H-19Z M-25 16L-19 9H19L25 16Z M-7 13H7\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"65\" y=\"290\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Remote user</text><path d=\"M105 250H250V182\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"remote-network-access\"/><path d=\"M246 187L250 182L254 187\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"177\" y=\"233\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-signal)\">Network access</text></svg>"
  }
} as const;
const captions = {
  "fr": "Deux circuits distincts : l’acheminement des équipements vers un site et la connexion distante aux serveurs. Schéma d’usage tiré des documents Bitdeer et du reportage NYT.",
  "en": "Two distinct channels: hardware shipments to a site and a remote connection to its servers. An infrastructure-use diagram based on Bitdeer documents and the NYT report."
} as const;
if (!['fr', 'en'].includes(lang)) throw new Error('Unknown Nvidia infographic language');
const scene = art[lang];
---
<figure class="nvidia-remote-compute" id={`nvidia-remote-compute-${lang}`}>
  <div class="scene desktop" set:html={scene.desktop}></div>
  <div class="scene mobile" set:html={scene.mobile}></div>
  <figcaption><span class="number">FIG. 02</span>{' '}{captions[lang]}{' '}<span class="sources"><a href="#source-S01" aria-label="Source S01">[S01]</a>{' '}<a href="#source-S02" aria-label="Source S02">[S02]</a>{' '}<a href="#source-S04" aria-label="Source S04">[S04]</a></span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Cantor Export';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  figure{width:100%;max-width:37.5rem;margin:1.5rem auto 1.7rem;padding-bottom:1rem;container-type:inline-size}
  .scene{width:100%;max-width:100%;line-height:0}
  .mobile{display:none}
  figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .number{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal);margin-right:.4rem}
  a{display:inline-block;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:520px){.desktop{display:none}.mobile{display:block;max-width:20rem;margin-inline:auto}}
  @media print{.desktop{display:block}.mobile{display:none}figure{break-inside:avoid}}
</style>
