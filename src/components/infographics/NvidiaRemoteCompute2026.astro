---
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const art = {
  "fr": {
    "desktop": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100%\" style=\"height:auto\" viewBox=\"0 0 600 290\" role=\"img\" aria-labelledby=\"nv15-remote-fr-desktop-title nv15-remote-fr-desktop-desc\" xml:lang=\"fr\" data-variant=\"desktop\"><title id=\"nv15-remote-fr-desktop-title\">Le matériel et l’accès au calcul</title><desc id=\"nv15-remote-fr-desktop-desc\">Schéma d’usage d’infrastructure à partir des documents Bitdeer et du reportage NYT. Un fournisseur tiers apporte des équipements à un centre de données, situé ici en Malaisie. Une connexion réseau distincte relie un client distant aux serveurs. Les flèches distinguent l’acheminement du matériel de l’accès au calcul. Le fournisseur direct et le client distant restent génériques. Les propositions réglementaires rapportées par le NYT sont examinées dans l’article plutôt que dessinées comme une autorisation ou une restriction.</desc><rect x=\"0.6\" y=\"0.6\" width=\"598.8\" height=\"288.8\" rx=\"3\" fill=\"var(--color-surface)\" stroke=\"var(--color-line-strong)\" stroke-width=\"1.1\"/><text x=\"18\" y=\"28\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"16\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\">Le matériel et l’accès au calcul</text><g transform=\"translate(100 97)\" data-icon=\"shipment\"><path d=\"M-20-11H20V17H-20Z M-20-11L-10-20H10L20-11 M-5-8H5V4H-5Z M-14-4H-10 M10-4H14 M-14 10H14\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"100\" y=\"137\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Fournisseur tiers</text><g transform=\"translate(500 97)\" data-icon=\"racks\"><path d=\"M-23-19H-5V19H-23Z M5-19H23V19H5Z M-18-12H-10 M-18-4H-10 M-18 4H-10 M-18 12H-10 M10-12H18 M10-4H18 M10 4H18 M10 12H18\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"500\" y=\"137\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Centre de données</text><text x=\"500\" y=\"155\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Malaisie</text><path d=\"M143 97H454\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"physical-equipment-supply\"/><path d=\"M449 93L454 97L449 101\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"299\" y=\"79\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Transport d’équipements</text><g transform=\"translate(100 228)\" data-icon=\"laptop\"><path d=\"M-19-16H19V9H-19Z M-25 16L-19 9H19L25 16Z M-7 13H7\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"100\" y=\"268\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Client distant</text><path d=\"M143 228H500V179\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"remote-network-access\"/><path d=\"M496 184L500 179L504 184\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"305\" y=\"211\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-signal)\">Connexion au calcul</text></svg>",
