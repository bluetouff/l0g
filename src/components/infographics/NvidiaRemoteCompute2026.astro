 M-18 12H-10 M10-12H18 M10-4H18 M10 4H18 M10 12H18\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"250\" y=\"138\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12.5\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Centre de données</text><text x=\"250\" y=\"155\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-muted)\">Malaisie</text><path d=\"M105 99H211\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"physical-equipment-supply\"/><path d=\"M206 95L211 99L206 103\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"158\" y=\"81\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\">Équipements</text><g transform=\"translate(65 250)\" data-icon=\"laptop\"><path d=\"M-19-16H19V9H-19Z M-25 16L-19 9H19L25 16Z M-7 13H7\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><text x=\"65\" y=\"290\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"13\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\">Client distant</text><path d=\"M105 250H250V182\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"remote-network-access\"/><path d=\"M246 187L250 182L254 187\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"177\" y=\"233\" font-family=\"l0g Nvidia Cantor Export\" font-size=\"12\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-signal)\">Connexion réseau</text></svg>"
  },
