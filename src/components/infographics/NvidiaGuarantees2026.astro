(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"68\" y=\"341\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\" data-zone=\"imports\">Imported chips</text><text x=\"68\" y=\"362\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-amber)\" data-zone=\"review\">Re-exports</text><text x=\"68\" y=\"382\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-amber)\" data-zone=\"review\">under review</text><path d=\"M209 337H280V355\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-dasharray=\"3 5\" data-relationship=\"possible-reexport\"/><path d=\"M276 349L280 355L284 349\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"280\" cy=\"376\" r=\"12\" fill=\"none\" stroke=\"var(--color-amber)\" stroke-width=\"1.1\"/><text x=\"280\" y=\"382\" font-family=\"l0g Nvidia Guarantees\" font-size=\"17\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-amber)\" data-zone=\"destination\">?</text></svg>"
