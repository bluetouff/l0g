 stroke=\"var(--color-signal)\" stroke-width=\"1.1\"/><circle cx=\"25\" cy=\"133\" r=\"1.5\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\"/><path d=\"M32 117H43 M32 133H43 M23 150V154 M45 150V154\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"64\" y=\"123\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\" data-zone=\"seller\">Aperia</text><text x=\"64\" y=\"143\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\" data-zone=\"seller\">International</text><path d=\"M151 124H188\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"aperia-to-buyers\"/><path d=\"M182 120L188 124L182 128\" fill=\"none\" stroke=\"var(--color-signal)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"205\" y=\"122\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\" data-zone=\"buyers\">Superphi</text><text x=\"205\" y=\"142\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-paper)\" data-zone=\"buyers\">NJ Global</text><text x=\"16\" y=\"174\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14.5\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-signal)\" data-zone=\"purchase\">917 servers · 41 transactions</text><text x=\"16\" y=\"195\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-muted)\" data-zone=\"sg-period\">May 2024 → February 2025</text><text x=\"16\" y=\"217\" font-family=\"l0g Nvidia Guarantees\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\" fill=\"var(--color-accent)\" d