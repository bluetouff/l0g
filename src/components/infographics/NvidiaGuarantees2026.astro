} as const;
const captions = {
  "financing": {
    "fr": "Les loyers remboursent la dette. Le soutien de valeur résiduelle intervient selon les pertes, les conditions et le plafond du contrat. Schéma qualitatif.",
    "en": "Rent services debt. Residual-value support depends on losses, contractual conditions and a cap. Qualitative mechanism."
  },
  "asia": {
    "fr": "Dossier Aperia à Singapour ; examen des réexportations Speedmatrix en Malaisie. Circuits distincts, positions au 13 novembre 2026.",
    "en": "Singapore’s Aperia case and Malaysia’s Speedmatrix re-export review. Separate circuits, status as of 13 November 2026."
  }
} as const;
const sources = { financing: ['S01', 'S02', 'S03'], asia: ['S04', 'S05', 'S06'] } as const;
if (!['fr', 'en'].includes(lang) || !['financing', 'asia'].includes(figure)) throw new Error('Unknown Nvidia guarantee figure');
const scene = art[lang][figure];
---
<figure class="nvidia-guarantees-figure" id={`nv7-${figure}-${lang}`} data-kind={figure}>
  <div class="art desktop-art" style="aspect-ratio:800 / 400" set:html={scene.desktop}></div>
  <div class="art mobile-art" style="aspect-ratio:320 / 400" set:html={scene.mobile}></div>
  <figcaption><span class="figure-number">FIG. {figure === 'financing' ? '01' : '02'}</span>{captions[figure][lang]} <span class="sources">{sources[figure].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span></figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Guarantees';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-guarantees-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .nvidia-guarantees-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.6rem;padding-bottom:.35rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.5;font-weight:400}
  .figure-number{display:inline;margin-right:.45rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:18rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.nvidia-guarantees-figure{break-inside:avoid}}
</style>
