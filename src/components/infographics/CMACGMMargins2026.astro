const captions = {
  "1": {
    "fr": "Les marges d’EBITDA du T3 partagent une échelle de 0 à 40 %. Les contours représentent 2025 et les aplats 2026. La marge rapporte l’EBITDA au chiffre d’affaires, avec des évolutions opposées dans le maritime et la logistique.",
    "en": "Q3 EBITDA margins share a 0–40% scale. Outlined bars represent 2025 and solid bars 2026. Shipping gains 7.5 percentage points while logistics loses 2.6. The ratio expresses EBITDA as a share of revenue."
  },
  "2": {
    "fr": "À volumes et autres conditions identiques, la répercussion intégrale d’une hausse du coût préserve la marge brute en montant. Le schéma présente des scénarios contractuels conditionnels et n’estime pas la marge brute de CEVA.",
    "en": "With volumes and other conditions unchanged, full pass-through of a cost increase preserves gross profit in absolute terms. The diagram presents conditional contract scenarios and does not estimate CEVA’s gross profit."
  },
  "3": {
    "fr": "Chaque trimestre de 2026 est comparé au même trimestre de 2025, selon les variations annuelles publiées. Les montants d’EBITDA sont en dollars nominaux arrondis. Les revenus progressent sur les trois périodes, tandis que l’EBITDA recule.",
    "en": "Each 2026 quarter is compared with the same quarter of 2025, using reported year-on-year changes. EBITDA amounts are in rounded nominal US dollars. Revenue rises across all three periods while EBITDA falls."
  }
} as const;
