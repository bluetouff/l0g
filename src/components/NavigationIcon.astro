---
export type NavigationIconName = 'read' | 'understand' | 'observe' | 'verify' | 'support';

interface Props {
  name: NavigationIconName;
  compact?: boolean;
}

const { name, compact = false } = Astro.props;
---

<svg class:list={['navigation-icon', { 'is-compact': compact, 'is-support': name === 'support' }]} aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  <use href={`#l0g-nav-${name}`} />
</svg>

<style is:global>
  .navigation-icon {
    --icon-accent: var(--color-signal);
    --navigation-icon-tint: color-mix(in srgb, var(--icon-accent) 7%, transparent);
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--icon-accent) 16%, var(--color-line));
    border-radius: 11px;
    background: var(--color-surface);
    box-shadow: inset 0 1px 0 var(--edge-highlight);
    color: var(--color-nav-idle);
    transition: color 180ms, border-color 180ms;
  }
  .navigation-icon.is-support { --icon-accent: var(--color-accent); }
  .navigation-icon.is-compact { width: 2rem; height: 2rem; padding: 0.22rem; border-radius: 9px; }
  a:hover > .navigation-icon,
  a:focus-visible > .navigation-icon,
  a[aria-current='page'] > .navigation-icon {
    border-color: var(--icon-accent);
    color: var(--icon-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .navigation-icon { transition: none; }
  }
</style>
