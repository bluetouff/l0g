---
export type NavigationIconName = 'read' | 'understand' | 'observe' | 'verify' | 'support';

interface Props {
  name: NavigationIconName;
  compact?: boolean;
}

const { name, compact = false } = Astro.props;
---

<span class:list={['navigation-icon', { 'is-compact': compact, 'is-support': name === 'support' }]} aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {name === 'read' && (
      <>
        <path class="icon-tint" d="M16 9.5C12.8 7.5 8.7 7.3 5 8.5v15c3.7-1.2 7.8-1 11 1 3.2-2 7.3-2.2 11-1v-15c-3.7-1.2-7.8-1-11 1Z" />
        <path d="M16 9.5v15M9 12.5c1.3-.1 2.6.1 3.8.5M9 16.5c1.3-.1 2.6.1 3.8.5" />
        <path class="icon-accent" d="M20 8v7l2-1.5 2 1.5V7.8" />
      </>
    )}
    {name === 'understand' && (
      <>
        <path class="icon-detail" d="M16 7v5m0 8v5M7 16h5m8 0h5M9.6 9.6l3.1 3.1m6.6 6.6 3.1 3.1M9.6 22.4l3.1-3.1m6.6-6.6 3.1-3.1" />
        <rect class="icon-tint" x="11.5" y="11.5" width="9" height="9" rx="2.5" />
        <circle cx="16" cy="5.5" r="2" />
        <circle cx="5.5" cy="16" r="2" />
        <circle cx="16" cy="26.5" r="2" />
        <circle class="icon-accent" cx="26.5" cy="16" r="2" />
        <path class="icon-accent" d="M14.5 16h3" />
      </>
    )}
    {name === 'observe' && (
      <>
        <circle cx="16" cy="16" r="11" />
        <circle class="icon-detail" cx="16" cy="16" r="6.5" />
        <path class="icon-detail" d="M16 5v3m11 8h-3M16 27v-3M5 16h3" />
        <path class="icon-tint" d="m16 16 7.8-7.8A11 11 0 0 1 27 16Z" />
        <path class="icon-accent" d="m16 16 7.8-7.8" />
        <circle class="icon-dot" cx="16" cy="16" r="1.6" />
        <circle class="icon-dot" cx="10.5" cy="20.5" r="1.2" />
      </>
    )}
    {name === 'verify' && (
      <>
        <path class="icon-tint" d="m16 4.5 10 4v7c0 6-4.4 9.3-10 12-5.6-2.7-10-6-10-12v-7Z" />
        <path class="icon-detail" d="m16 8.5 6 2.4V16" />
        <path class="icon-accent" d="m11.5 16 3 3 6-6" />
      </>
    )}
    {name === 'support' && (
      <>
        <path class="icon-tint" d="M16 25.5 7.3 17A6.2 6.2 0 0 1 16 8.2 6.2 6.2 0 0 1 24.7 17Z" />
        <path class="icon-detail" d="M8.5 12a2.5 2.5 0 0 1 3-2.5" />
        <path class="icon-accent" d="M16 12.5v7m-3.5-3.5h7" />
      </>
    )}
  </svg>
</span>

<style>
  .navigation-icon {
    --icon-accent: var(--color-signal);
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--icon-accent) 16%, var(--color-line));
    border-radius: 11px;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--icon-accent) 6%, transparent), transparent 65%),
      var(--color-surface);
    box-shadow: inset 0 1px 0 var(--edge-highlight), 0 2px 4px rgb(0 0 0 / 8%);
    color: var(--color-nav-idle);
    transition: color 180ms, border-color 180ms, box-shadow 180ms, transform 180ms;
  }
  .is-support { --icon-accent: var(--color-accent); }
  .is-compact { width: 2rem; height: 2rem; padding: 0.22rem; border-radius: 9px; }
  svg { display: block; width: 100%; height: auto; }
  .icon-tint { fill: color-mix(in srgb, var(--icon-accent) 7%, transparent); }
  .icon-detail { opacity: 0.55; }
  .icon-accent { stroke: var(--icon-accent); }
  .icon-dot { fill: var(--icon-accent); stroke: none; }
  :global(a:hover) > .navigation-icon,
  :global(a:focus-visible) > .navigation-icon,
  :global(a[aria-current='page']) > .navigation-icon {
    border-color: color-mix(in srgb, var(--icon-accent) 52%, var(--color-line));
    color: var(--icon-accent);
    box-shadow: inset 0 1px 0 var(--edge-highlight), 0 0 16px color-mix(in srgb, var(--icon-accent) 8%, transparent);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .navigation-icon { transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .navigation-icon { transition: none; }
  }
</style>
