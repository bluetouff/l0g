---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import riskScriptUrl from '../scripts/risk.js?url';
import { isRiskSignalUnavailable } from '../config/risk-signals.ts';

/**
 * Tableau de bord consolidé de signaux : valeurs reprises des dashboards.
 * Le snapshot courant est injecté dans le HTML au build. Le script versionné
 * conserve ensuite un rôle d'actualisation progressive et de signalement des replis.
 */

type RiskSignal = {
  key: string;
  value?: number | null;
  scale?: number | null;
  level?: string | null;
  tone?: string | null;
  sourceStatus?: string | null;
  qualityStatus?: string | null;
  fallbackUsed?: boolean;
  fallbackLayer?: string | null;
  timelinessStatus?: string | null;
  sourceUpdatedAt?: string | null;
  sourcePublishedAt?: string | null;
  lastSuccessAt?: string | null;
  retrievedAt?: string | null;
  warnings?: string[];
  componentDates?: { brent?: string; wti?: string } | null;
};

type RiskSnapshot = {
  updated?: string | null;
  aggregateGeneratedAt?: string | null;
  generated?: string | null;
  status?: string | null;
  indices?: RiskSignal[];
};

type DebtSnapshot = {
  generated?: string | null;
  provenance?: { generatedAt?: string | null } | null;
  signal?: RiskSignal | null;
};

function readJson<T>(relativePath: string, fallback: T): T {
  try {
    return JSON.parse(readFileSync(join(process.cwd(), relativePath), 'utf8')) as T;
  } catch {
    return fallback;
  }
}

const snapshot = readJson<RiskSnapshot>('public/risk.json', {});
const debtSnapshot = readJson<DebtSnapshot>('public/debt-latest.json', {});
const signals = new Map((snapshot.indices ?? []).map((signal) => [signal.key, signal]));
if (!signals.has('debt') && debtSnapshot.signal?.key === 'debt') {
  signals.set('debt', debtSnapshot.signal);
}

const TONE: Record<string, string> = {
  calm: 'var(--color-signal)',
  moderate: 'var(--color-amber)',
  elevated: 'var(--color-elevated)',
  stress: 'var(--color-accent)',
  crisis: 'var(--color-accent)',
};

function clampPct(value?: number | null, scale?: number | null) {
  const percentage = (Number(value) / (Number(scale) || 100)) * 100;
  if (Number.isNaN(percentage)) return 0;
  return Math.max(0, Math.min(100, percentage));
}

function formatDate(value?: string | null, withTime = false) {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleString('fr-FR', {
    day: '2-digit',
    month: '2-digit',
    timeZone: 'Europe/Paris',
    ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
  });
}

function statusText(signal: RiskSignal) {
  const sourceDate = formatDate(signal.sourceUpdatedAt || signal.sourcePublishedAt, true);
  const brentDate = signal.componentDates?.brent;
  const wtiDate = signal.componentDates?.wti;
  const componentDate = brentDate === wtiDate ? formatDate(brentDate) : null;
  if (signal.sourceStatus === 'fallback' || signal.fallbackLayer === 'aggregator') {
    return `repli best effort · dernier succès ${formatDate(signal.lastSuccessAt, true) || 'inconnu'}`;
  }
  if (signal.qualityStatus === 'official-delayed') {
    return `officiel différé (EIA) · pétrole au ${componentDate || 'jour publié'}`;
  }
  if (signal.timelinessStatus === 'stale') {
    return `source ancienne · donnée ${sourceDate || 'non datée'}`;
  }
  if (signal.qualityStatus === 'degraded') {
    return `couverture dégradée · donnée ${sourceDate || 'non datée'}`;
  }
  if (signal.qualityStatus === 'unknown') {
    return 'provenance partielle · date source inconnue';
  }
  return `source ${sourceDate || 'non datée'}`;
}

function isDegraded(signal?: RiskSignal) {
  return Boolean(signal && (
    signal.sourceStatus === 'fallback'
    || signal.fallbackLayer === 'aggregator'
    || signal.timelinessStatus === 'stale'
    || signal.qualityStatus === 'degraded'
    || signal.qualityStatus === 'unknown'
    || (signal.fallbackUsed && signal.qualityStatus !== 'official-delayed')
  ));
}

const items = [
  { key: 'us', label: 'US Macro', href: 'https://us.l0g.fr' },
  { key: 'eu', label: 'EU Macro', href: 'https://euro.l0g.fr' },
  { key: 'yen', label: 'Yen Carry', href: 'https://yct.l0g.fr' },
  { key: 'energie', label: 'Énergie', href: 'https://energie.l0g.fr' },
  { key: 'debt', label: 'Dette US', href: 'https://debt.l0g.fr' },
].map((item) => {
  const signal = signals.get(item.key);
  const unavailable = isRiskSignalUnavailable(signal);
  return {
    ...item,
    signal,
    unavailable,
    color: unavailable ? 'var(--color-muted)' : TONE[signal?.tone ?? ''] || 'var(--color-muted)',
  };
});

const aggregateDate = formatDate(
  snapshot.aggregateGeneratedAt
  || snapshot.updated
  || snapshot.generated
  || debtSnapshot.generated
  || debtSnapshot.provenance?.generatedAt,
  true,
);
const degradedCount = items.filter((item) => isDegraded(item.signal)).length;
const officialDelayedCount = items.filter((item) => (
  item.signal?.qualityStatus === 'official-delayed' && !isDegraded(item.signal)
)).length;
const aggregateStatus = aggregateDate
  ? ` Assemblage ${aggregateDate}${snapshot.status === 'degraded'
      ? degradedCount
        ? ` · état dégradé visible (${degradedCount})`
        : officialDelayedCount
          ? ` · source officielle différée (${officialDelayedCount})`
          : ' · état dégradé déclaré'
      : ''}.`
  : '';
---

<section class="rise my-8" data-pagefind-ignore>
  <div class="risk-band-head">
    <h2 class="mono-label glow"><span>02</span>// signaux de risque</h2>
    <nav aria-label="Accès aux signaux de risque">
      <a class="mono-label risk-history-link" href="/maintenant/">lecture complète</a>
      <a class="mono-label risk-history-link" href="/series/">historique & provenance</a>
    </nav>
  </div>

  <div class="grid grid-cols-2 gap-3 lg:grid-cols-5">
    {
      items.map((it) => (
        <article
          class="risk-tile card group block p-4"
          data-risk={it.key}
          data-degraded={isDegraded(it.signal) ? 'true' : 'false'}
        >
          <a
            href={it.href}
            class="risk-tile-main risk-dashboard-link"
            target="_blank"
            rel="noopener"
            aria-label={`Ouvrir l’app ${it.label}`}
          >
            <div class="flex items-center justify-between">
              <span class="mono-label">{it.label}</span>
              <span class="risk-arrow text-muted transition-transform group-hover:translate-x-0.5">↗</span>
            </div>
            <div class="risk-reading mt-3 flex items-baseline gap-2">
              <span
                class="risk-value font-display leading-none glow"
                data-value
                style={`color:${it.color}`}
              >
                {!it.unavailable ? it.signal?.value ?? '—' : '—'}
              </span>
              <span
                class="risk-level mono-label"
                data-level
                style={`color:${it.color}`}
              >
                {it.unavailable ? 'INDISPONIBLE' : it.signal?.level ?? ''}
              </span>
            </div>
            <div class="risk-track mt-3">
              <div
                class="risk-fill"
                data-fill
                style={`width:${it.unavailable ? 0 : clampPct(it.signal?.value, it.signal?.scale)}%;background:${it.color}`}
              ></div>
            </div>
            <div class="risk-status" data-status>
              {it.signal ? statusText(it.signal) : 'source indisponible au build'}
            </div>
            <span class="risk-app-cta">
              Ouvrir l’app <span aria-hidden="true">↗</span>
            </span>
          </a>
          <a class="risk-proof-link" href={`/maintenant/#signal-${it.key}`}>
            <span aria-hidden="true">i</span> Vérifier ce chiffre
          </a>
        </article>
      ))
    }
  </div>
  <aside class="confluence-entry card" aria-labelledby="confluence-entry-title">
    <span class="confluence-entry-glyph" aria-hidden="true">∩</span>
    <div class="confluence-entry-copy">
      <p class="mono-label">13FLOW · signaux croisés</p>
      <h3 id="confluence-entry-title">Confluence 13F × Form 4</h3>
      <p>
        Repérer les titres où accumulation institutionnelle et achats d'initiés se recoupent.
      </p>
    </div>
    <nav aria-label="Accès aux confluences 13FLOW">
      <a class="confluence-entry-main" href="/confluence/">
        Voir toutes les confluences <span aria-hidden="true">›</span>
      </a>
      <a class="confluence-entry-method" href="/methodologie/13flow/">méthode</a>
    </nav>
  </aside>
  <p class="risk-caveat">
    Scores 0-100 normalisés par instrument : ils ne mesurent ni le même phénomène,
    ni le même horizon. À lire comme un tableau de bord consolidé de signaux, pas comme un
    indice unique de risque systémique. Collecte best effort : chaque carte date sa source et
    signale tout repli. <span id="risk-updated">{aggregateStatus}</span>
  </p>
</section>

<script src={riskScriptUrl} defer is:inline></script>

<style>
  .risk-band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.55rem 1rem;
    margin-bottom: 0.8rem;
  }
  .risk-band-head h2 {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-bright);
  }
  .risk-band-head h2 span {
    color: var(--color-signal);
    font-family: var(--font-display);
    font-size: 0.8rem;
  }
  .risk-band-head nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }
  .risk-track {
    height: 6px;
    border-radius: 999px;
    background: var(--color-line-strong);
    overflow: hidden;
  }
  .confluence-entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem 1rem;
    margin-top: 0.75rem;
    border-color: color-mix(in srgb, var(--color-signal) 36%, var(--color-line));
    padding: 0.85rem 1rem;
    background:
      linear-gradient(105deg, color-mix(in srgb, var(--color-signal) 7%, transparent), transparent 58%),
      var(--surface-elevated);
  }
  .confluence-entry-glyph {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-signal) 48%, var(--color-line));
    border-radius: 10px 3px 10px 10px;
    color: var(--color-signal);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .confluence-entry-copy .mono-label {
    color: var(--color-signal);
    font-size: 0.57rem;
  }
  .confluence-entry-copy h3 {
    margin-top: 0.18rem;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.25;
  }
  .confluence-entry-copy > p:last-child {
    margin-top: 0.18rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .confluence-entry nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem 0.9rem;
  }
  .confluence-entry-main,
  .confluence-entry-method {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .confluence-entry-main { color: var(--color-signal); }
  .confluence-entry-main:hover,
  .confluence-entry-method:hover { color: var(--color-bright); }
  .confluence-entry-method { color: var(--color-muted); }
  @media (max-width: 639px) {
    .confluence-entry {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .confluence-entry nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      border-top: 1px solid var(--color-line);
      padding-top: 0.65rem;
    }
  }
  .risk-tile-main { display: block; }
  .risk-app-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.7rem;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .risk-tile-main:hover .risk-app-cta { color: var(--color-signal); }
  .risk-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    margin-top: 0.58rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.58rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .risk-proof-link span {
    display: inline-grid;
    width: 0.95rem;
    height: 0.95rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.54rem;
  }
  .risk-proof-link:hover { color: var(--color-signal); }
  .risk-dashboard-link {
    border-radius: 8px;
    outline-offset: 4px;
  }
  .risk-dashboard-link:focus-visible { outline: 2px solid var(--color-signal); }
  .risk-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--color-muted);
    transition: width 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .risk-reading {
    min-height: 2.3rem;
  }
  .risk-value {
    color: var(--color-muted);
    font-size: 2rem;
  }
  .risk-level {
    font-size: 0.68rem;
    line-height: 1.35;
  }
  .risk-caveat {
    margin-top: 0.75rem;
    max-width: 48rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .risk-status {
    min-height: 1.9rem;
    margin-top: 0.55rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.45;
  }
  .risk-history-link {
    color: var(--color-signal);
    text-decoration: none;
  }
  .risk-tile[data-degraded='true'] {
    border-color: color-mix(in srgb, var(--color-amber) 50%, var(--color-line));
  }
</style>
