---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import riskScriptUrl from '../scripts/risk.js?url';
import { isRiskSignalUnavailable, riskSignalMeta } from '../config/risk-signals.ts';

interface Props { summary?: boolean; }
const { summary = false } = Astro.props;

/**
 * Tableau de bord consolidé de signaux : valeurs reprises des dashboards.
 * Le snapshot courant est injecté dans le HTML au build. Le script versionné
 * conserve ensuite un rôle d'actualisation progressive et de signalement des replis.
 */

type RiskSignal = {
  key: string;
  value?: number | null;
  scale?: number | null;
  level?: string | null;
  tone?: string | null;
  sourceStatus?: string | null;
  qualityStatus?: string | null;
  fallbackUsed?: boolean;
  fallbackLayer?: string | null;
  cacheUsed?: boolean;
  methodologyVersion?: string | null;
  validUntil?: string | null;
  timelinessStatus?: string | null;
  sourceUpdatedAt?: string | null;
  sourcePublishedAt?: string | null;
  lastSuccessAt?: string | null;
  retrievedAt?: string | null;
  observedAt?: string | null;
  observationTimePrecision?: string | null;
  warnings?: string[];
  componentDates?: { brent?: string; wti?: string } | null;
};

type RiskSnapshot = {
  updated?: string | null;
  aggregateGeneratedAt?: string | null;
  generated?: string | null;
  status?: string | null;
  indices?: RiskSignal[];
};

type DebtSnapshot = {
  generated?: string | null;
  provenance?: { generatedAt?: string | null } | null;
  signal?: RiskSignal | null;
};

function readJson<T>(relativePath: string, fallback: T): T {
  try {
    return JSON.parse(readFileSync(join(process.cwd(), relativePath), 'utf8')) as T;
  } catch {
    return fallback;
  }
}

const snapshot = readJson<RiskSnapshot>('public/risk.json', {});
const debtSnapshot = readJson<DebtSnapshot>('public/debt-latest.json', {});
const signals = new Map((Array.isArray(snapshot.indices) ? snapshot.indices : [])
  .filter((signal) => signal && typeof signal.key === 'string').map((signal) => [signal.key, signal]));
if (!signals.has('debt') && debtSnapshot.signal?.key === 'debt') {
  signals.set('debt', debtSnapshot.signal);
}

const TONE: Record<string, string> = {
  calm: 'var(--color-signal)',
  moderate: 'var(--color-amber)',
  elevated: 'var(--color-elevated)',
  stress: 'var(--color-accent)',
  crisis: 'var(--color-accent)',
};

function clampPct(value?: number | null, scale?: number | null) {
  const percentage = (Number(value) / (Number(scale) || 100)) * 100;
  if (Number.isNaN(percentage)) return 0;
  return Math.max(0, Math.min(100, percentage));
}

function formatDate(value?: string | null, withTime = false) {
  if (typeof value !== 'string' || !value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleString('fr-FR', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    timeZone: 'Europe/Paris',
    ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
  });
}

function statusText(signal: RiskSignal) {
  const sourceDate = formatDate(signal.sourceUpdatedAt || signal.sourcePublishedAt, true);
  const brentDate = signal.componentDates?.brent;
  const wtiDate = signal.componentDates?.wti;
  const componentDate = brentDate === wtiDate ? formatDate(brentDate) : null;
  if (signal.sourceStatus === 'fallback' || signal.fallbackLayer === 'aggregator') {
    return `repli best effort · dernier succès ${formatDate(signal.lastSuccessAt, true) || 'inconnu'}`;
  }
  if (signal.key === 'debt' && signal.methodologyVersion === '2.0'
    && !(Date.parse(signal.validUntil || '') > Date.now())) {
    return `publication expirée · calcul ${sourceDate || 'non daté'}`;
  }
  if (signal.cacheUsed === true) {
    return `cache source validé · calcul ${sourceDate || 'non daté'}`;
  }
  if (signal.qualityStatus === 'official-delayed') {
    if (signal.key === 'debt') return `publication trimestrielle différée · source ${sourceDate || 'non datée'}`;
    return `officiel différé (EIA) · pétrole au ${componentDate || 'jour publié'}`;
  }
  if (signal.timelinessStatus === 'stale') {
    return `source ancienne · donnée ${sourceDate || 'non datée'}`;
  }
  if (signal.qualityStatus === 'degraded') {
    return `couverture dégradée · donnée ${sourceDate || 'non datée'}`;
  }
  if (signal.qualityStatus === 'unknown') {
    return 'provenance partielle · date source inconnue';
  }
  return `source ${sourceDate || 'non datée'}`;
}

function isDegraded(signal?: RiskSignal) {
  return Boolean(signal && (
    signal.sourceStatus === 'fallback'
    || signal.fallbackLayer === 'aggregator'
    || signal.timelinessStatus === 'stale'
    || signal.qualityStatus === 'degraded'
    || signal.qualityStatus === 'unknown'
    || (signal.fallbackUsed && signal.qualityStatus !== 'official-delayed')
  ));
}

const items = [
  { key: 'us', short: 'US', label: 'US Macro', title: 'Stress macroéconomique US', href: 'https://us.l0g.fr' },
  { key: 'eu', short: 'EU', label: 'EU Macro', title: 'Conjoncture de la zone euro', href: 'https://euro.l0g.fr' },
  { key: 'yen', short: 'YEN', label: 'Yen Carry', title: 'Fragilité du portage en yen', href: 'https://yct.l0g.fr' },
  { key: 'energie', short: 'NRJ', label: 'Énergie', title: 'Tensions sur l’énergie', href: 'https://energie.l0g.fr' },
  { key: 'debt', short: 'DETTE', label: 'Dette US', title: 'Stress de la dette américaine', href: 'https://debt.l0g.fr' },
].map((item) => {
  const signal = signals.get(item.key);
  const nativeScale = signal?.scale ?? 100;
  const scale = Number.isFinite(nativeScale) && nativeScale > 0 ? nativeScale : 100;
  const unavailable = !signal || typeof signal.value !== 'number' || !Number.isFinite(signal.value)
    || !Number.isFinite(nativeScale) || nativeScale <= 0 || signal.value < 0 || signal.value > nativeScale
    || isRiskSignalUnavailable(signal);
  return {
    ...item,
    signal,
    unavailable,
    scale,
    meta: riskSignalMeta[item.key],
    color: unavailable ? 'var(--color-muted)' : Object.hasOwn(TONE, signal?.tone ?? '') ? TONE[signal!.tone!] : 'var(--color-muted)',
  };
});

const aggregateDate = formatDate(
  snapshot.aggregateGeneratedAt
  || snapshot.updated
  || snapshot.generated
  || debtSnapshot.generated
  || debtSnapshot.provenance?.generatedAt,
  true,
);
const degradedCount = items.filter((item) => isDegraded(item.signal)).length;
const officialDelayedCount = items.filter((item) => (
  item.signal?.qualityStatus === 'official-delayed' && !isDegraded(item.signal)
)).length;
const aggregateStatus = aggregateDate
  ? ` Assemblage ${aggregateDate}${snapshot.status === 'degraded'
      ? degradedCount
        ? ` · état dégradé visible (${degradedCount})`
        : officialDelayedCount
          ? ` · source officielle différée (${officialDelayedCount})`
          : ' · état dégradé déclaré'
      : ''}.`
  : '';
---

{summary ? <nav class="home-risk-overview" aria-label="Aperçu des cinq instruments">
  <div>{items.map(it => <a href={`/maintenant/#signal-${it.key}`} data-risk-select={it.key} data-risk-mini={it.key} data-label={it.label} aria-label={`${it.label} : ${it.unavailable ? 'indisponible' : it.signal?.value}`}>
    <span>{it.short}</span><span data-mini-value>{it.unavailable ? '—' : it.signal?.value}</span>
  </a>)}</div>
  <p>5 modèles distincts · <span data-risk-summary-date>assemblage {aggregateDate || 'non daté'}</span></p>
</nav> : <div class="risk-observatory" data-home-observatory data-pagefind-ignore>
  <h2 class="home-section-label"><span>02</span><i class="home-cut" aria-hidden="true"></i>L’observatoire</h2>
  <div class="risk-panel">
    <p class="risk-snapshot"><span>SNAPSHOT</span><span id="risk-updated">{aggregateStatus.trim() || 'Assemblage non daté'}</span></p>
    <fieldset class="risk-selectors"><legend class="sr-only">Choisir un instrument</legend>
      {items.map(it => <label class="risk-selector" data-risk-mini={it.key} data-label={it.label}>
        <input type="radio" name="home-risk" id={`risk-choice-${it.key}`} value={it.key} checked={it.key === 'debt'} aria-controls={`risk-reading-${it.key}`} />
        <span><span aria-hidden="true">{it.short}</span><span class="sr-only">{it.label}</span><span data-mini-value>{it.unavailable ? '—' : it.signal?.value}</span></span>
      </label>)}
    </fieldset>
    <div class="risk-readings">
      {items.map(it => <article class="risk-tile" id={`risk-reading-${it.key}`} data-risk={it.key} data-unavailable={String(it.unavailable)} data-degraded={String(isDegraded(it.signal))} data-methodology-version={it.signal?.methodologyVersion} data-valid-until={it.signal?.validUntil}>
        <a href={it.href} class="risk-tile-main risk-dashboard-link" target="_blank" rel="noopener noreferrer" aria-label={`Ouvrir l’app ${it.label}`}>
          <h3 class="risk-title">{it.title}</h3>
          <div class="risk-reading"><span class="risk-value" data-value style={`color:${it.color}`}>{it.unavailable ? '—' : it.signal?.value}</span><span class="risk-scale" data-scale>/{it.scale}</span><span class="risk-level" data-level style={`color:${it.color}`}>{it.unavailable ? 'INDISPONIBLE' : it.signal?.level ?? ''}</span></div>
          <div class="risk-track" data-meter role={it.unavailable ? 'img' : 'meter'} aria-label={`${it.label} : ${it.unavailable ? 'signal indisponible' : 'score normalisé'}`} aria-valuemin={it.unavailable ? undefined : 0} aria-valuemax={it.unavailable ? undefined : it.scale} aria-valuenow={it.unavailable ? undefined : it.signal?.value}>
            <span class="risk-fill" data-fill style={`width:${it.unavailable ? 0 : clampPct(it.signal?.value, it.scale)}%;background:${it.color}`}></span>
          </div>
          <div class="risk-axis" aria-hidden="true"><span>0</span><span data-axis-mid>{it.scale / 2}</span><span data-axis-max>{it.scale}</span></div>
          <p class="risk-caption">Score normalisé du modèle</p>
        </a>
        <dl class="risk-dates"><dt>Source publiée</dt><dd><time data-source-date datetime={it.signal?.sourcePublishedAt || it.signal?.sourceUpdatedAt || undefined}>{formatDate(it.signal?.sourcePublishedAt || it.signal?.sourceUpdatedAt, true) || 'Non datée'}</time></dd><dt>Observation la plus récente</dt><dd><time data-observed-date datetime={it.signal?.observedAt || undefined}>{formatDate(it.signal?.observedAt, it.signal?.observationTimePrecision === 'date-time') || 'Non datée'}</time></dd></dl>
        <p class="risk-status" data-status>{it.signal ? statusText(it.signal) : 'source indisponible au build'}</p>
        <details class="risk-proof"><summary>Source et méthode <span aria-hidden="true">+</span></summary><div>
          <a href={it.href} target="_blank" rel="noopener noreferrer">Source : {it.meta.label} ↗</a>
          <a href={new URL(it.meta.methodology).pathname}>Lire la méthode ↗</a>
          <a href={`/series/${it.meta.identity.slug}/`}>Historique et exports ↗</a>
          <a class="risk-proof-link" href={`/maintenant/#signal-${it.key}`}>Vérifier ce chiffre ↗</a>
        </div></details>
        <a class="risk-app-cta" href={it.href} target="_blank" rel="noopener noreferrer">Ouvrir l’instrument <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </div>
  <p class="risk-caveat">Chaque instrument possède son modèle, ses seuils et son horizon. Les scores 0-100 se lisent séparément. Les dates, la couverture et les éventuels replis sont signalés.</p>
  <nav class="risk-links" aria-label="Accès aux données"><a href="/maintenant/">Lecture complète ↗</a><a href="/series/">Historique et provenance ↗</a></nav>
  <script src={riskScriptUrl} defer is:inline></script>
</div>}
