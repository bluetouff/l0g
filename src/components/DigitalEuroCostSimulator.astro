---
import {
  DIGITAL_EURO_CARD_BASE,
  DIGITAL_EURO_COST_DEFAULTS,
  DIGITAL_EURO_COST_MODEL_VERSION,
  calculateDigitalEuroCost,
} from '../lib/digital-euro-cost-model.ts';

interface Props {
  lang?: 'fr' | 'en';
  mode?: 'embed' | 'full';
  fullPageHref?: string;
  articleHref?: string;
}

const {
  lang = 'fr',
  mode = 'embed',
  fullPageHref,
  articleHref,
} = Astro.props;
const isFr = lang === 'fr';
const isFull = mode === 'full';
const id = `digital-euro-cost-${lang}-${mode}`;
const resolvedFullPageHref = fullPageHref ?? (isFr
  ? '/outils/prix-euro-numerique/'
  : '/en/tools/digital-euro-cost/');
const resolvedArticleHref = articleHref ?? (isFr
  ? '/posts/euro-numerique-5-prix-souverainete/'
  : '/en/analysis/digital-euro-5-price-of-sovereignty/');

const copy = isFr
  ? {
      eyebrow: 'SIMULATEUR L0G',
      title: 'Qui paie la facture ?',
      intro: 'Déplacez les hypothèses pour suivre les économies des commerçants, la rémunération des PSP et le coût public par transaction.',
      badge: 'modèle de sensibilité',
      sourceLabel: 'Base statistique',
      sourceText: 'Zone euro 2025 : 91,7 Md de paiements par carte, pour 3 531 Md€.',
      controls: 'Hypothèses',
      merchantProfile: 'Profil du commerçant',
      small: 'Petit · 0,90 %',
      average: 'Moyen · 0,50 %',
      large: 'Grand · 0,25 %',
      adoption: 'Part des paiements carte transférée',
      cardFee: 'Commission carte actuelle',
      digitalFee: 'MSC euro numérique proposée',
      interPsp: 'Inter-PSP',
      interPspMode: 'Unité de l’inter-PSP',
      interPspRate: '% du montant',
      interPspFixed: '€ par transaction',
      interPspRateHint: 'Le scénario publié normalise 0,18 € sur 100 € en équivalent ad valorem de 0,18 %.',
      interPspFixedHint: 'Le mode fixe applique le même montant à chaque transaction, quel que soit le panier.',
      offline: 'Part hors ligne sans commission',
      noWorseOffControl: 'Appliquer la protection individuelle du compromis parlementaire',
      noWorseOffHint: 'Si elle est active, la MSC ne peut pas dépasser le tarif carte propre au commerçant. Ce point reste soumis au texte final.',
      publicAssumptions: 'Hypothèses de coût public',
      development: 'Développement Eurosystème',
      annualOpex: 'Exploitation annuelle',
      amortisation: 'Durée d’amortissement',
      years: 'ans',
      reset: 'Réinitialiser le scénario',
      results: 'Résultats du scénario',
      annualFlow: 'Flux annuel transféré',
      transactions: 'Transactions annuelles',
      merchantPanel: 'Commerçants',
      currentCost: 'Coût carte actuel',
      digitalCost: 'Nouvelle commission',
      savings: 'Économies annuelles',
      privatePanel: 'Chaîne privée',
      totalMsc: 'MSC collectée',
      distributor: 'PSP distributeur',
      acquirer: 'Reste acquéreur',
      publicPanel: 'Couche publique',
      opexPerTransaction: 'OPEX par transaction',
      fullPerTransaction: 'OPEX + développement amorti',
      onlineAllocation: 'Répartition de la MSC en ligne',
      acquirerShort: 'Acquéreur',
      distributorShort: 'Distributeur',
      noWorse: 'Le plafond individuel s’active : la MSC en ligne est ramenée au tarif carte de ce commerçant.',
      negative: 'Incohérence économique : le revenu inter-PSP dépasse la MSC collectée. Le reste brut de l’acquéreur devient négatif.',
      offlineShift: 'La part hors ligne est gratuite au point de paiement : son coût doit être financé ailleurs dans la chaîne.',
      fixedFeeWarning: 'Une commission fixe dépend du nombre de paiements, tandis qu’un taux dépend de leur valeur. À panier moyen identique, les deux unités peuvent produire des répartitions très différentes.',
      method: 'Formules et périmètre',
      observed: 'Données observées',
      assumptions: 'Hypothèses manipulables',
      equations: 'Calculs',
      boundaries: 'Ce que le modèle ne mesure pas',
      observedText: 'La base additionne les deux semestres 2025 de la BCE : 3 530 718 386 134,85 € et 91 708 654 727 paiements carte envoyés dans la zone euro. Le second semestre est encore signalé provisoire dans l’API BCE.',
      adoptionHelp: 'Adoption : part uniforme du nombre et de la valeur des paiements carte transférée vers l’euro numérique. Le panier moyen reste donc constant.',
      cardFeeHelp: 'Commission carte : contrefactuel marchand illustratif. Les profils ne sont ni des moyennes officielles ni des tarifs recommandés.',
      digitalFeeHelp: 'MSC : hypothèse de commission online payée par le commerçant. Son niveau final est inconnu.',
      interPspHelp: 'Inter-PSP : partage interne entre l’acquéreur et le PSP distributeur. Le modèle distingue un taux sur la valeur et un montant fixe par transaction pour éviter de confondre les unités.',
      offlineHelp: 'Hors ligne : part du volume et du nombre de transactions qui ne génère aucune recette privée dans le scénario parlementaire.',
      publicHelp: 'Coûts publics : 1,3 Md€ de développement et 320 M€ par an sont les estimations BCE. La durée d’amortissement reste une convention du scénario.',
      equationValue: 'Valeur transférée = valeur carte 2025 × adoption.',
      equationTransactions: 'Transactions transférées = nombre carte 2025 × adoption.',
      equationMsc: 'MSC applicable = minimum entre MSC proposée et commission carte lorsque la protection individuelle est active.',
      equationMerchant: 'Coût euro numérique = valeur transférée × part online × MSC applicable. Économie = coût carte contrefactuel − coût euro numérique.',
      equationPrivate: 'Revenu distributeur = valeur online × taux inter-PSP, ou transactions online × montant fixe. Reste acquéreur = MSC collectée − revenu distributeur.',
      equationPublic: 'Coût public complet par transaction = (OPEX annuel + développement ÷ amortissement) ÷ transactions transférées.',
      boundaryText: 'Le modèle n’est ni une prévision d’adoption, ni un coût social total, ni un compte de résultat. Il exclut notamment les coûts propres des banques, PSP et commerçants, la fraude, le support, la fiscalité, l’actualisation, les usages P2P et la valeur de résilience. Il affecte toute la couche publique aux seuls paiements marchands, ce qui constitue une convention volontairement conservatrice.',
      source: 'Sources primaires : séries PAY de la BCE, estimation de coûts BCE du 30 octobre 2025, positions de négociation du Parlement et du Conseil. Modèle v',
      openFull: 'Ouvrir l’outil en pleine largeur',
      backArticle: 'Revenir à l’article source',
      copyScenario: 'Copier le résumé',
      downloadCsv: 'Exporter le scénario en CSV',
      copied: 'Résumé copié',
      downloaded: 'CSV généré localement',
      copyUnavailable: 'Copie indisponible dans ce contexte',
      averageTicket: 'Panier carte moyen implicite',
      live: 'Scénario recalculé',
    }
  : {
      eyebrow: 'L0G SIMULATOR',
      title: 'Who pays the bill?',
      intro: 'Move the assumptions to track merchant savings, PSP compensation and the public cost per transaction.',
      badge: 'sensitivity model',
      sourceLabel: 'Statistical base',
      sourceText: 'Euro area 2025: 91.7bn card payments, worth €3.531tn.',
      controls: 'Assumptions',
      merchantProfile: 'Merchant profile',
      small: 'Small · 0.90%',
      average: 'Average · 0.50%',
      large: 'Large · 0.25%',
      adoption: 'Share of card payments migrated',
      cardFee: 'Current card merchant fee',
      digitalFee: 'Proposed digital euro MSC',
      interPsp: 'Inter-PSP',
      interPspMode: 'Inter-PSP unit',
      interPspRate: '% of payment value',
      interPspFixed: '€ per transaction',
      interPspRateHint: 'The published scenario normalises €0.18 on €100 as a 0.18% ad valorem equivalent.',
      interPspFixedHint: 'Fixed mode applies the same amount to each transaction, whatever the basket size.',
      offline: 'Fee-free offline share',
      noWorseOffControl: 'Apply Parliament’s individual merchant protection',
      noWorseOffHint: 'When enabled, the MSC cannot exceed this merchant’s own card fee. The final legislation may differ.',
      publicAssumptions: 'Public-cost assumptions',
      development: 'Eurosystem development',
      annualOpex: 'Annual operations',
      amortisation: 'Amortisation period',
      years: 'years',
      reset: 'Reset scenario',
      results: 'Scenario results',
      annualFlow: 'Annual value migrated',
      transactions: 'Annual transactions',
      merchantPanel: 'Merchants',
      currentCost: 'Current card cost',
      digitalCost: 'New merchant charge',
      savings: 'Annual savings',
      privatePanel: 'Private chain',
      totalMsc: 'MSC collected',
      distributor: 'Distributing PSP',
      acquirer: 'Acquirer remainder',
      publicPanel: 'Public layer',
      opexPerTransaction: 'OPEX per transaction',
      fullPerTransaction: 'OPEX + amortised development',
      onlineAllocation: 'Online MSC allocation',
      acquirerShort: 'Acquirer',
      distributorShort: 'Distributor',
      noWorse: 'The individual cap applies: the online MSC is reduced to this merchant’s existing card fee.',
      negative: 'Economic inconsistency: inter-PSP revenue exceeds the MSC collected. The acquirer’s gross remainder is negative.',
      offlineShift: 'The offline share is free at the point of payment, so its cost must be funded elsewhere in the chain.',
      fixedFeeWarning: 'A fixed fee follows the number of payments, whereas a rate follows their value. At the same average ticket, the two units can produce very different allocations.',
      method: 'Formulas and scope',
      observed: 'Observed data',
      assumptions: 'Adjustable assumptions',
      equations: 'Calculations',
      boundaries: 'What the model does not measure',
      observedText: 'The base adds both ECB 2025 half-years: €3,530,718,386,134.85 and 91,708,654,727 card payments sent in the euro area. The ECB API still marks the second half as provisional.',
      adoptionHelp: 'Adoption: the same share of card-payment value and count migrates to the digital euro, keeping the implied average ticket constant.',
      cardFeeHelp: 'Card fee: an illustrative merchant counterfactual. Presets are neither official averages nor recommendations.',
      digitalFeeHelp: 'MSC: assumed online merchant charge. Its final level is unknown.',
      interPspHelp: 'Inter-PSP: internal allocation between acquirer and distributing PSP. The model separates a value-based rate from a fixed amount per transaction so the units cannot be confused.',
      offlineHelp: 'Offline: share of value and count that generates no private fee revenue in Parliament’s scenario.',
      publicHelp: 'Public costs: €1.3bn development and €320m a year are ECB estimates. The amortisation period remains a scenario convention.',
      equationValue: 'Migrated value = 2025 card value × adoption.',
      equationTransactions: 'Migrated transactions = 2025 card count × adoption.',
      equationMsc: 'Applicable MSC = the lower of proposed MSC and card fee when individual protection is enabled.',
      equationMerchant: 'Digital-euro charge = migrated value × online share × applicable MSC. Savings = counterfactual card cost − digital-euro charge.',
      equationPrivate: 'Distributor revenue = online value × inter-PSP rate, or online transactions × fixed amount. Acquirer remainder = collected MSC − distributor revenue.',
      equationPublic: 'Full public cost per transaction = (annual OPEX + development ÷ amortisation) ÷ migrated transactions.',
      boundaryText: 'This is neither an adoption forecast, a total social-cost estimate nor a profit-and-loss account. It excludes bank, PSP and merchant implementation costs, fraud, support, tax, discounting, P2P uses and resilience value. It allocates the entire public layer to merchant payments, a deliberately conservative convention.',
      source: 'Primary sources: ECB PAY series, ECB cost estimate of 30 October 2025, and Parliament and Council negotiating positions. Model v',
      openFull: 'Open the full-width tool',
      backArticle: 'Return to the source article',
      copyScenario: 'Copy scenario summary',
      downloadCsv: 'Export scenario as CSV',
      copied: 'Summary copied',
      downloaded: 'CSV generated locally',
      copyUnavailable: 'Copy unavailable in this context',
      averageTicket: 'Implied average card ticket',
      live: 'Scenario recalculated',
    };

const baseline = DIGITAL_EURO_COST_DEFAULTS;
const initial = calculateDigitalEuroCost(baseline);
const volume = initial.volume;
const transactionCount = initial.transactions;
const currentCost = initial.currentCost;
const digitalCost = initial.digitalCost;
const distributorRevenue = initial.distributorRevenue;
const acquirerRemainder = initial.acquirerRemainder;
const opexPerTransaction = initial.opexPerTransaction;
const fullPerTransaction = initial.fullPerTransaction;

const decimal = new Intl.NumberFormat(isFr ? 'fr-FR' : 'en-GB', { maximumFractionDigits: 2 });
const money = (value: number) => {
  const absolute = Math.abs(value);
  if (absolute >= 1e9) return isFr ? `${decimal.format(value / 1e9)} Md€` : `€${decimal.format(value / 1e9)}bn`;
  return isFr ? `${decimal.format(value / 1e6)} M€` : `€${decimal.format(value / 1e6)}m`;
};
const moneyBillions = (value: number) => isFr ? `${decimal.format(value / 1e9)} Md€` : `€${decimal.format(value / 1e9)}bn`;
const countBillions = (value: number) => `${decimal.format(value / 1e9)} ${isFr ? 'Md' : 'bn'}`;
const cents = (value: number) => `${decimal.format(value)} ${isFr ? 'c€' : '¢'}`;
---

<section
  class:list={['de-sim', isFull && 'de-sim--full']}
  id={id}
  data-digital-euro-cost-simulator
  data-lang={lang}
  data-mode={mode}
  data-card-value={DIGITAL_EURO_CARD_BASE.value}
  data-card-transactions={DIGITAL_EURO_CARD_BASE.transactions}
  data-copy-copied={copy.copied}
  data-download-ready={copy.downloaded}
  data-copy-unavailable={copy.copyUnavailable}
  data-pagefind-ignore
  aria-labelledby={`${id}-title`}
>
  <header class="de-sim__header">
    <div>
      <p class="de-sim__eyebrow">{copy.eyebrow}</p>
      <h3 id={`${id}-title`}>{copy.title}</h3>
      <p class="de-sim__intro">{copy.intro}</p>
    </div>
    <span class="de-sim__badge">{copy.badge}</span>
  </header>

  <p class="de-sim__source-line">
    <strong>{copy.sourceLabel}</strong>
    <span>{copy.sourceText}</span>
  </p>

  <div class="de-sim__layout">
    <form class="de-sim__controls" data-controls>
      <div class="de-sim__section-heading">
        <span>01</span>
        <h4>{copy.controls}</h4>
      </div>

      <fieldset class="de-sim__presets">
        <legend>{copy.merchantProfile}</legend>
        <div>
          <button type="button" data-preset-fee="0.9" aria-pressed="false">{copy.small}</button>
          <button type="button" data-preset-fee="0.5" aria-pressed="true">{copy.average}</button>
          <button type="button" data-preset-fee="0.25" aria-pressed="false">{copy.large}</button>
        </div>
      </fieldset>

      <label class="de-sim__control" for={`${id}-adoption`}>
        <span><b>{copy.adoption}</b><output for={`${id}-adoption`} data-input-output="adoption">10 %</output></span>
        <input id={`${id}-adoption`} data-input="adoption" type="range" min="1" max="50" step="1" value="10" />
        <i><span>1 %</span><span>50 %</span></i>
      </label>

      <label class="de-sim__control" for={`${id}-card-fee`}>
        <span><b>{copy.cardFee}</b><output for={`${id}-card-fee`} data-input-output="cardFee">{isFr ? '0,50 %' : '0.50%'}</output></span>
        <input id={`${id}-card-fee`} data-input="cardFee" type="range" min="0.1" max="1.5" step="0.05" value="0.5" />
        <i><span>{isFr ? '0,10 %' : '0.10%'}</span><span>{isFr ? '1,50 %' : '1.50%'}</span></i>
      </label>

      <label class="de-sim__control" for={`${id}-digital-fee`}>
        <span><b>{copy.digitalFee}</b><output for={`${id}-digital-fee`} data-input-output="digitalFee">{isFr ? '0,30 %' : '0.30%'}</output></span>
        <input id={`${id}-digital-fee`} data-input="digitalFee" type="range" min="0" max="1" step="0.05" value="0.3" />
        <i><span>0 %</span><span>1 %</span></i>
      </label>

      <label class="de-sim__toggle" for={`${id}-no-worse-off`}>
        <input id={`${id}-no-worse-off`} data-input="noWorseOff" type="checkbox" checked />
        <span><b>{copy.noWorseOffControl}</b><small>{copy.noWorseOffHint}</small></span>
      </label>

      <fieldset class="de-sim__unit" data-inter-psp-unit>
        <legend>{copy.interPspMode}</legend>
        <div>
          <label for={`${id}-inter-rate`}>
            <input id={`${id}-inter-rate`} name={`${id}-inter-mode`} data-inter-mode="rate" type="radio" value="rate" checked />
            <span>{copy.interPspRate}</span>
          </label>
          <label for={`${id}-inter-fixed`}>
            <input id={`${id}-inter-fixed`} name={`${id}-inter-mode`} data-inter-mode="fixed" type="radio" value="fixed" />
            <span>{copy.interPspFixed}</span>
          </label>
        </div>
        <small data-inter-mode-hint="rate">{copy.interPspRateHint}</small>
        <small data-inter-mode-hint="fixed" hidden>{copy.interPspFixedHint}</small>
      </fieldset>

      <label class="de-sim__control" for={`${id}-inter-psp`}>
        <span><b>{copy.interPsp}</b><output for={`${id}-inter-psp`} data-input-output="interPsp">{isFr ? '0,18 %' : '0.18%'}</output></span>
        <input id={`${id}-inter-psp`} data-input="interPsp" type="range" min="0" max="0.6" step="0.01" value="0.18" />
        <i><span data-inter-min>0 %</span><span data-inter-max>{isFr ? '0,60 %' : '0.60%'}</span></i>
      </label>

      <label class="de-sim__control" for={`${id}-offline`}>
        <span><b>{copy.offline}</b><output for={`${id}-offline`} data-input-output="offline">10 %</output></span>
        <input id={`${id}-offline`} data-input="offline" type="range" min="0" max="50" step="5" value="10" />
        <i><span>0 %</span><span>50 %</span></i>
      </label>

      <details class="de-sim__advanced">
        <summary>{copy.publicAssumptions}</summary>
        <div>
          <label class="de-sim__control" for={`${id}-development`}>
            <span><b>{copy.development}</b><output for={`${id}-development`} data-input-output="development">{isFr ? '1,3 Md€' : '€1.3bn'}</output></span>
            <input id={`${id}-development`} data-input="development" type="range" min="0.5" max="3" step="0.1" value="1.3" />
            <i><span>{isFr ? '0,5 Md€' : '€0.5bn'}</span><span>{isFr ? '3 Md€' : '€3bn'}</span></i>
          </label>
          <label class="de-sim__control" for={`${id}-annual-opex`}>
            <span><b>{copy.annualOpex}</b><output for={`${id}-annual-opex`} data-input-output="annualOpex">{isFr ? '320 M€' : '€320m'}</output></span>
            <input id={`${id}-annual-opex`} data-input="annualOpex" type="range" min="100" max="800" step="10" value="320" />
            <i><span>{isFr ? '100 M€' : '€100m'}</span><span>{isFr ? '800 M€' : '€800m'}</span></i>
          </label>
          <label class="de-sim__control" for={`${id}-amortisation`}>
            <span><b>{copy.amortisation}</b><output for={`${id}-amortisation`} data-input-output="amortisation">10 {copy.years}</output></span>
            <input id={`${id}-amortisation`} data-input="amortisation" type="range" min="5" max="20" step="1" value="10" />
            <i><span>5 {copy.years}</span><span>20 {copy.years}</span></i>
          </label>
        </div>
      </details>

      <button class="de-sim__reset" type="reset" data-reset>{copy.reset}</button>
    </form>

    <section class="de-sim__results" aria-labelledby={`${id}-results`}>
      <div class="de-sim__section-heading">
        <span>02</span>
        <h4 id={`${id}-results`}>{copy.results}</h4>
      </div>

      <div class="de-sim__flow">
        <div><span>{copy.annualFlow}</span><strong data-result="volume">{moneyBillions(volume)}</strong></div>
        <div><span>{copy.transactions}</span><strong data-result="transactions">{countBillions(transactionCount)}</strong></div>
        <div><span>{copy.averageTicket}</span><strong data-result="averageTicket">{isFr ? `${decimal.format(initial.averageCardTicket)} €` : `€${decimal.format(initial.averageCardTicket)}`}</strong></div>
      </div>

      <article class="de-sim__panel de-sim__panel--merchant">
        <header><span>03</span><h5>{copy.merchantPanel}</h5></header>
        <dl>
          <div><dt>{copy.currentCost}</dt><dd data-result="currentCost">{money(currentCost)}</dd></div>
          <div><dt>{copy.digitalCost}</dt><dd data-result="digitalCost">{money(digitalCost)}</dd></div>
          <div class="de-sim__highlight"><dt>{copy.savings}</dt><dd data-result="savings">{money(currentCost - digitalCost)}</dd></div>
        </dl>
        <div class="de-sim__comparison" aria-hidden="true">
          <span style="--value:100%"></span>
          <span data-bar="digital" style={`--value:${digitalCost / currentCost * 100}%`}></span>
        </div>
      </article>

      <article class="de-sim__panel de-sim__panel--private">
        <header><span>04</span><h5>{copy.privatePanel}</h5></header>
        <dl>
          <div><dt>{copy.totalMsc}</dt><dd data-result="totalMsc">{money(digitalCost)}</dd></div>
          <div><dt>{copy.distributor}</dt><dd data-result="distributor">{money(distributorRevenue)}</dd></div>
          <div><dt>{copy.acquirer}</dt><dd data-result="acquirer">{money(acquirerRemainder)}</dd></div>
        </dl>
        <p class="de-sim__allocation-label">{copy.onlineAllocation}</p>
        <div class="de-sim__allocation" aria-hidden="true">
          <span data-allocation="acquirer" style={`--share:${Math.max(acquirerRemainder / digitalCost * 100, 0)}%`}></span>
          <span data-allocation="distributor" style={`--share:${Math.min(distributorRevenue / digitalCost * 100, 100)}%`}></span>
        </div>
        <div class="de-sim__legend"><span>{copy.acquirerShort}</span><span>{copy.distributorShort}</span></div>
      </article>

      <article class="de-sim__panel de-sim__panel--public">
        <header><span>05</span><h5>{copy.publicPanel}</h5></header>
        <dl>
          <div><dt>{copy.opexPerTransaction}</dt><dd data-result="opexPerTransaction">{cents(opexPerTransaction)}</dd></div>
          <div class="de-sim__highlight"><dt>{copy.fullPerTransaction}</dt><dd data-result="fullPerTransaction">{cents(fullPerTransaction)}</dd></div>
        </dl>
      </article>

      <div class="de-sim__warnings">
        <p data-warning="noWorse" hidden>{copy.noWorse}</p>
        <p data-warning="negative" hidden>{copy.negative}</p>
        <p data-warning="fixed" hidden>{copy.fixedFeeWarning}</p>
        <p data-warning="offline">{copy.offlineShift}</p>
      </div>

      <p class="sr-only" aria-live="polite" aria-atomic="true" data-live-summary>{copy.live}</p>
    </section>
  </div>

  <details class="de-sim__method" open={isFull}>
    <summary>{copy.method}</summary>
    <div class="de-sim__method-body">
      <section>
        <h4>{copy.observed}</h4>
        <p>{copy.observedText}</p>
      </section>
      <section>
        <h4>{copy.assumptions}</h4>
        <dl>
          <div><dt>{copy.adoption}</dt><dd>{copy.adoptionHelp}</dd></div>
          <div><dt>{copy.cardFee}</dt><dd>{copy.cardFeeHelp}</dd></div>
          <div><dt>{copy.digitalFee}</dt><dd>{copy.digitalFeeHelp}</dd></div>
          <div><dt>{copy.interPsp}</dt><dd>{copy.interPspHelp}</dd></div>
          <div><dt>{copy.offline}</dt><dd>{copy.offlineHelp}</dd></div>
          <div><dt>{copy.publicAssumptions}</dt><dd>{copy.publicHelp}</dd></div>
        </dl>
      </section>
      <section>
        <h4>{copy.equations}</h4>
        <ol>
          <li>{copy.equationValue}</li>
          <li>{copy.equationTransactions}</li>
          <li>{copy.equationMsc}</li>
          <li>{copy.equationMerchant}</li>
          <li>{copy.equationPrivate}</li>
          <li>{copy.equationPublic}</li>
        </ol>
      </section>
      <section>
        <h4>{copy.boundaries}</h4>
        <p>{copy.boundaryText}</p>
      </section>
      <small>{copy.source}{DIGITAL_EURO_COST_MODEL_VERSION}.</small>
    </div>
  </details>

  <footer class="de-sim__actions">
    {isFull ? (
      <>
        <button type="button" data-copy-scenario>{copy.copyScenario}</button>
        <button type="button" data-download-csv>{copy.downloadCsv}</button>
        <a href={resolvedArticleHref}>{copy.backArticle}</a>
      </>
    ) : (
      <a href={resolvedFullPageHref} data-full-page-link>{copy.openFull}<span aria-hidden="true"> →</span></a>
    )}
    <span role="status" aria-live="polite" data-action-status></span>
  </footer>
</section>

<script>
  import {
    DIGITAL_EURO_COST_DEFAULTS,
    DIGITAL_EURO_COST_MODEL_VERSION,
    DIGITAL_EURO_COST_QUERY_KEYS,
    calculateDigitalEuroCost,
    normalizeDigitalEuroCostInputs,
    type DigitalEuroCostInputs,
    type DigitalEuroCostResults,
  } from '../lib/digital-euro-cost-model.ts';

  const initialiseDigitalEuroCostSimulators = () => {
    document.querySelectorAll<HTMLElement>('[data-digital-euro-cost-simulator]:not([data-ready])').forEach((root) => {
      root.dataset.ready = 'true';

      const lang = root.dataset.lang === 'fr' ? 'fr' : 'en';
      const locale = lang === 'fr' ? 'fr-FR' : 'en-GB';
      const controls = Array.from(root.querySelectorAll<HTMLInputElement>('[data-input]'));
      const form = root.querySelector<HTMLFormElement>('[data-controls]');
      const liveSummary = root.querySelector<HTMLElement>('[data-live-summary]');
      const fullMode = root.dataset.mode === 'full';
      let currentInputs: DigitalEuroCostInputs = { ...DIGITAL_EURO_COST_DEFAULTS };
      let currentResults: DigitalEuroCostResults = calculateDigitalEuroCost(currentInputs);

      const number = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 });
      const integer = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });

      const input = (name: string) => root.querySelector<HTMLInputElement>(`[data-input="${name}"]`);
      const output = (name: string) => root.querySelector<HTMLOutputElement>(`[data-input-output="${name}"]`);
      const result = (name: string) => root.querySelector<HTMLElement>(`[data-result="${name}"]`);
      const read = (name: string, fallback: number) => {
        const value = Number(input(name)?.value);
        return Number.isFinite(value) ? value : fallback;
      };
      const write = (element: Element | null, value: string) => {
        if (element) element.textContent = value;
      };
      const money = (value: number) => {
        const absolute = Math.abs(value);
        if (absolute >= 1e9) return lang === 'fr' ? `${number.format(value / 1e9)} Md€` : `€${number.format(value / 1e9)}bn`;
        return lang === 'fr' ? `${number.format(value / 1e6)} M€` : `€${number.format(value / 1e6)}m`;
      };
      const moneyBillions = (value: number) => lang === 'fr' ? `${number.format(value / 1e9)} Md€` : `€${number.format(value / 1e9)}bn`;
      const countBillions = (value: number) => `${number.format(value / 1e9)} ${lang === 'fr' ? 'Md' : 'bn'}`;
      const cents = (value: number) => `${number.format(value)} ${lang === 'fr' ? 'c€' : '¢'}`;
      const percent = (value: number, digits = 2) => `${new Intl.NumberFormat(locale, { minimumFractionDigits: digits, maximumFractionDigits: digits }).format(value)} %`;
      const euros = (value: number) => lang === 'fr' ? `${number.format(value)} €` : `€${number.format(value)}`;

      const mode = () => root.querySelector<HTMLInputElement>('[data-inter-mode]:checked')?.value === 'fixed' ? 'fixed' : 'rate';
      const noWorseOff = () => input('noWorseOff')?.checked ?? true;
      const readInputs = () => normalizeDigitalEuroCostInputs({
        adoption: read('adoption', DIGITAL_EURO_COST_DEFAULTS.adoption),
        cardFee: read('cardFee', DIGITAL_EURO_COST_DEFAULTS.cardFee),
        digitalFee: read('digitalFee', DIGITAL_EURO_COST_DEFAULTS.digitalFee),
        interPsp: read('interPsp', DIGITAL_EURO_COST_DEFAULTS.interPsp),
        interPspMode: mode(),
        offline: read('offline', DIGITAL_EURO_COST_DEFAULTS.offline),
        development: read('development', DIGITAL_EURO_COST_DEFAULTS.development / 1e9) * 1e9,
        annualOpex: read('annualOpex', DIGITAL_EURO_COST_DEFAULTS.annualOpex / 1e6) * 1e6,
        amortisation: read('amortisation', DIGITAL_EURO_COST_DEFAULTS.amortisation),
        noWorseOff: noWorseOff(),
      });

      const scenarioParams = (inputs: DigitalEuroCostInputs) => {
        const params = new URLSearchParams();
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.adoption, String(inputs.adoption));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.cardFee, String(inputs.cardFee));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.digitalFee, String(inputs.digitalFee));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.interPsp, String(inputs.interPsp));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.interPspMode, inputs.interPspMode);
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.offline, String(inputs.offline));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.development, String(inputs.development / 1e9));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.annualOpex, String(inputs.annualOpex / 1e6));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.amortisation, String(inputs.amortisation));
        params.set(DIGITAL_EURO_COST_QUERY_KEYS.noWorseOff, inputs.noWorseOff ? '1' : '0');
        return params;
      };

      const applyInputs = (candidate: Partial<DigitalEuroCostInputs>) => {
        const values = normalizeDigitalEuroCostInputs(candidate);
        const set = (name: string, value: number) => {
          const control = input(name);
          if (control) control.value = String(value);
        };
        set('adoption', values.adoption);
        set('cardFee', values.cardFee);
        set('digitalFee', values.digitalFee);
        set('interPsp', values.interPsp);
        set('offline', values.offline);
        set('development', values.development / 1e9);
        set('annualOpex', values.annualOpex / 1e6);
        set('amortisation', values.amortisation);
        const nwo = input('noWorseOff');
        if (nwo) nwo.checked = values.noWorseOff;
        root.querySelectorAll<HTMLInputElement>('[data-inter-mode]').forEach((radio) => {
          radio.checked = radio.value === values.interPspMode;
        });
      };

      const readQuery = () => {
        const params = new URLSearchParams(window.location.search);
        const knownKeys = new Set<string>(Object.values(DIGITAL_EURO_COST_QUERY_KEYS));
        if (![...params.keys()].some((key) => knownKeys.has(key))) return;
        const numeric = (key: string) => {
          const value = Number(params.get(key));
          return Number.isFinite(value) ? value : undefined;
        };
        applyInputs({
          adoption: numeric(DIGITAL_EURO_COST_QUERY_KEYS.adoption),
          cardFee: numeric(DIGITAL_EURO_COST_QUERY_KEYS.cardFee),
          digitalFee: numeric(DIGITAL_EURO_COST_QUERY_KEYS.digitalFee),
          interPsp: numeric(DIGITAL_EURO_COST_QUERY_KEYS.interPsp),
          interPspMode: params.get(DIGITAL_EURO_COST_QUERY_KEYS.interPspMode) === 'fixed' ? 'fixed' : 'rate',
          offline: numeric(DIGITAL_EURO_COST_QUERY_KEYS.offline),
          development: numeric(DIGITAL_EURO_COST_QUERY_KEYS.development) == null ? undefined : Number(params.get(DIGITAL_EURO_COST_QUERY_KEYS.development)) * 1e9,
          annualOpex: numeric(DIGITAL_EURO_COST_QUERY_KEYS.annualOpex) == null ? undefined : Number(params.get(DIGITAL_EURO_COST_QUERY_KEYS.annualOpex)) * 1e6,
          amortisation: numeric(DIGITAL_EURO_COST_QUERY_KEYS.amortisation),
          noWorseOff: params.get(DIGITAL_EURO_COST_QUERY_KEYS.noWorseOff) !== '0',
        });
      };

      const render = (syncUrl = true) => {
        const inputs = readInputs();
        const results = calculateDigitalEuroCost(inputs);
        currentInputs = inputs;
        currentResults = results;

        write(output('adoption'), `${integer.format(inputs.adoption)} %`);
        write(output('cardFee'), percent(inputs.cardFee));
        write(output('digitalFee'), percent(inputs.digitalFee));
        write(output('interPsp'), inputs.interPspMode === 'fixed' ? euros(inputs.interPsp) : percent(inputs.interPsp));
        write(output('offline'), `${integer.format(inputs.offline)} %`);
        write(output('development'), lang === 'fr' ? `${number.format(inputs.development / 1e9)} Md€` : `€${number.format(inputs.development / 1e9)}bn`);
        write(output('annualOpex'), lang === 'fr' ? `${integer.format(inputs.annualOpex / 1e6)} M€` : `€${integer.format(inputs.annualOpex / 1e6)}m`);
        write(output('amortisation'), `${integer.format(inputs.amortisation)} ${lang === 'fr' ? 'ans' : 'years'}`);

        write(result('volume'), moneyBillions(results.volume));
        write(result('transactions'), countBillions(results.transactions));
        write(result('averageTicket'), euros(results.averageCardTicket));
        write(result('currentCost'), money(results.currentCost));
        write(result('digitalCost'), money(results.digitalCost));
        write(result('savings'), money(results.savings));
        write(result('totalMsc'), money(results.digitalCost));
        write(result('distributor'), money(results.distributorRevenue));
        write(result('acquirer'), money(results.acquirerRemainder));
        write(result('opexPerTransaction'), cents(results.opexPerTransaction));
        write(result('fullPerTransaction'), cents(results.fullPerTransaction));

        const digitalBar = root.querySelector<HTMLElement>('[data-bar="digital"]');
        digitalBar?.style.setProperty('--value', `${results.currentCost > 0 ? Math.min(results.digitalCost / results.currentCost * 100, 100) : 0}%`);

        const totalAllocation = Math.max(results.digitalCost, results.distributorRevenue, 1);
        root.querySelector<HTMLElement>('[data-allocation="acquirer"]')?.style.setProperty('--share', `${Math.max(results.acquirerRemainder, 0) / totalAllocation * 100}%`);
        root.querySelector<HTMLElement>('[data-allocation="distributor"]')?.style.setProperty('--share', `${Math.min(results.distributorRevenue / totalAllocation * 100, 100)}%`);

        const noWorse = root.querySelector<HTMLElement>('[data-warning="noWorse"]');
        const negative = root.querySelector<HTMLElement>('[data-warning="negative"]');
        const offlineWarning = root.querySelector<HTMLElement>('[data-warning="offline"]');
        const fixedWarning = root.querySelector<HTMLElement>('[data-warning="fixed"]');
        if (noWorse) noWorse.hidden = !results.capApplied;
        if (negative) negative.hidden = !results.negativeAcquirer;
        if (offlineWarning) offlineWarning.hidden = inputs.offline === 0;
        if (fixedWarning) fixedWarning.hidden = inputs.interPspMode !== 'fixed';
        root.dataset.economicState = results.negativeAcquirer ? 'negative-acquirer' : 'balanced';

        root.querySelectorAll<HTMLElement>('[data-inter-mode-hint]').forEach((hint) => {
          hint.hidden = hint.dataset.interModeHint !== inputs.interPspMode;
        });
        write(root.querySelector('[data-inter-min]'), inputs.interPspMode === 'fixed' ? euros(0) : '0 %');
        write(root.querySelector('[data-inter-max]'), inputs.interPspMode === 'fixed' ? euros(0.6) : percent(0.6));

        root.querySelectorAll<HTMLButtonElement>('[data-preset-fee]').forEach((button) => {
          button.setAttribute('aria-pressed', String(Math.abs(Number(button.dataset.presetFee) - inputs.cardFee) < 0.001));
        });

        if (liveSummary) {
          liveSummary.textContent = lang === 'fr'
            ? `Scénario recalculé : ${money(results.savings)} d’économies commerçants et ${cents(results.fullPerTransaction)} de coût public complet par transaction.`
            : `Scenario recalculated: ${money(results.savings)} in merchant savings and ${cents(results.fullPerTransaction)} in full public cost per transaction.`;
        }

        const params = scenarioParams(inputs);
        if (fullMode && syncUrl) {
          const next = `${window.location.pathname}?${params.toString()}${window.location.hash}`;
          window.history.replaceState(null, '', next);
        }
        const fullPageLink = root.querySelector<HTMLAnchorElement>('[data-full-page-link]');
        if (fullPageLink) {
          const target = new URL(fullPageLink.getAttribute('href') || '/', window.location.origin);
          target.search = params.toString();
          fullPageLink.href = `${target.pathname}${target.search}`;
        }
      };

      controls.forEach((control) => control.addEventListener('input', () => render()));
      root.querySelectorAll<HTMLInputElement>('[data-inter-mode]').forEach((control) => control.addEventListener('change', () => render()));
      root.querySelectorAll<HTMLButtonElement>('[data-preset-fee]').forEach((button) => {
        button.addEventListener('click', () => {
          const cardFee = input('cardFee');
          if (cardFee && button.dataset.presetFee) cardFee.value = button.dataset.presetFee;
          render();
        });
      });
      form?.addEventListener('reset', () => window.setTimeout(() => render(), 0));

      root.querySelector<HTMLButtonElement>('[data-copy-scenario]')?.addEventListener('click', async () => {
        const status = root.querySelector<HTMLElement>('[data-action-status]');
        if (!window.isSecureContext || !navigator.clipboard?.writeText) {
          write(status, root.dataset.copyUnavailable || 'Copy unavailable');
          return;
        }
        const unit = currentInputs.interPspMode === 'fixed' ? euros(currentInputs.interPsp) : percent(currentInputs.interPsp);
        const summary = lang === 'fr'
          ? `Euro numérique : adoption ${integer.format(currentInputs.adoption)} %, commission carte ${percent(currentInputs.cardFee)}, MSC ${percent(currentInputs.digitalFee)}, inter-PSP ${unit}, hors ligne ${integer.format(currentInputs.offline)} %. Résultats : ${money(currentResults.savings)} d’économies commerçants, ${money(currentResults.distributorRevenue)} pour le PSP distributeur, ${money(currentResults.acquirerRemainder)} de reste acquéreur et ${cents(currentResults.fullPerTransaction)} de coût public complet par transaction. ${window.location.href}`
          : `Digital euro: ${integer.format(currentInputs.adoption)}% adoption, ${percent(currentInputs.cardFee)} card fee, ${percent(currentInputs.digitalFee)} MSC, ${unit} inter-PSP, ${integer.format(currentInputs.offline)}% offline. Results: ${money(currentResults.savings)} merchant savings, ${money(currentResults.distributorRevenue)} distributor revenue, ${money(currentResults.acquirerRemainder)} acquirer remainder and ${cents(currentResults.fullPerTransaction)} full public cost per transaction. ${window.location.href}`;
        try {
          await navigator.clipboard.writeText(summary);
          write(status, root.dataset.copyCopied || 'Copied');
        } catch {
          write(status, root.dataset.copyUnavailable || 'Copy unavailable');
        }
      });

      root.querySelector<HTMLButtonElement>('[data-download-csv]')?.addEventListener('click', () => {
        const status = root.querySelector<HTMLElement>('[data-action-status]');
        const rows: Array<[string, string | number]> = [
          ['model_version', DIGITAL_EURO_COST_MODEL_VERSION],
          ['adoption_percent', currentInputs.adoption],
          ['card_fee_percent', currentInputs.cardFee],
          ['digital_euro_msc_percent', currentInputs.digitalFee],
          ['inter_psp_mode', currentInputs.interPspMode],
          ['inter_psp_value', currentInputs.interPsp],
          ['offline_percent', currentInputs.offline],
          ['development_eur', currentInputs.development],
          ['annual_opex_eur', currentInputs.annualOpex],
          ['amortisation_years', currentInputs.amortisation],
          ['no_worse_off', String(currentInputs.noWorseOff)],
          ['migrated_value_eur', currentResults.volume],
          ['migrated_transactions', currentResults.transactions],
          ['merchant_savings_eur', currentResults.savings],
          ['distributor_revenue_eur', currentResults.distributorRevenue],
          ['acquirer_remainder_eur', currentResults.acquirerRemainder],
          ['full_public_cost_cents_per_transaction', currentResults.fullPerTransaction],
        ];
        const escapeCsv = (value: string | number) => `"${String(value).replace(/"/g, '""')}"`;
        const csv = `metric,value\r\n${rows.map(([key, value]) => `${escapeCsv(key)},${escapeCsv(value)}`).join('\r\n')}\r\n`;
        const href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = href;
        link.download = lang === 'fr' ? 'scenario-prix-euro-numerique.csv' : 'digital-euro-cost-scenario.csv';
        link.hidden = true;
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(href), 1_000);
        write(status, root.dataset.downloadReady || 'CSV generated locally');
      });

      if (fullMode) readQuery();
      render(!fullMode);
    });
  };

  initialiseDigitalEuroCostSimulators();
</script>

