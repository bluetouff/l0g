---
import { CLOUDFLARE_REVENUE_DEFAULTS, CLOUDFLARE_REVENUE_LIMITS, CLOUDFLARE_REVENUE_PRESETS, calculateCloudflareRevenue, cloudflareRevenueDisplay } from '../lib/cloudflareRevenueModel.mjs';
import { cloudflareRevenueCopy } from '../lib/cloudflareRevenueUi.mjs';
interface Props { lang: 'fr' | 'en'; id?: string; }
const { lang, id = `cloudflare-revenue-${lang}` } = Astro.props;
if (!/^[a-z][a-z0-9-]{0,63}$/.test(id)) throw new RangeError('Controlled calculator id required');
const copy = cloudflareRevenueCopy(lang), initial = calculateCloudflareRevenue(CLOUDFLARE_REVENUE_DEFAULTS);
const fields = ['uses', 'coverage', 'price', 'deductions', 'cost', 'visits', 'visitValue'] as const;
const primary = ['net', 'benchmark', 'gap'] as const;
const secondary = ['billable', 'gross', 'after', 'priceThreshold', 'coverageThreshold'] as const;
const resultIndex = { billable: 0, gross: 1, after: 2, net: 3, benchmark: 4, gap: 5, priceThreshold: 6, coverageThreshold: 7 };
const source = 'https://blog.cloudflare.com/pay-per-use/';
---
<section class="cloudflare-revenue-calculator" data-cloudflare-revenue-root data-cloudflare-revenue-lang={lang} data-valid="true" aria-labelledby={`${id}-title`}>
  <header><p class="cloudflare-revenue-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="cloudflare-revenue-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-error`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="cloudflare-revenue-inputs">{fields.map((field, index) => <label for={`${id}-${field}`}><span>{copy.labels[index]}</span><input id={`${id}-${field}`} name={field} type="number" min={CLOUDFLARE_REVENUE_LIMITS[field].min} max={CLOUDFLARE_REVENUE_LIMITS[field].max} step={CLOUDFLARE_REVENUE_LIMITS[field].step} value={CLOUDFLARE_REVENUE_DEFAULTS[field]} inputmode="decimal" required autocomplete="off" aria-describedby={`${id}-${field}-bounds ${id}-error`} /><small id={`${id}-${field}-bounds`}>{copy.help[index]}</small></label>)}</div>
      <p>{copy.presetLabel}</p><div class="cloudflare-revenue-presets">{CLOUDFLARE_REVENUE_PRESETS.map((value, index) => <button type="button" data-cloudflare-revenue-preset={value}>{copy.presets[index]}</button>)}</div><button type="reset">{copy.reset}</button>
    </fieldset><p class="cloudflare-revenue-error" id={`${id}-error`} data-error role="alert" hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
  </details>
  <p class="cloudflare-revenue-scenario" data-scenario>{copy.initial}</p>
  <dl class="cloudflare-revenue-results">{primary.map(field => <div><dt>{copy.resultLabels[resultIndex[field]]}</dt><dd><output data-cloudflare-revenue-result={field} aria-live="off">{cloudflareRevenueDisplay(initial, field, lang)}</output></dd></div>)}</dl>
  <p class="cloudflare-revenue-classification" data-cloudflare-revenue-status>{copy.statuses[initial.status]}</p><p class="cloudflare-revenue-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="cloudflare-revenue-detail"><summary>{copy.results}</summary><dl class="cloudflare-revenue-results">{secondary.map(field => <div><dt>{copy.resultLabels[resultIndex[field]]}</dt><dd><output data-cloudflare-revenue-result={field} aria-live="off">{cloudflareRevenueDisplay(initial, field, lang)}</output></dd></div>)}</dl><p data-cloudflare-revenue-coverage>{copy.coverage[initial.coverageStatus]}</p></details>
  <details class="cloudflare-revenue-method"><summary>{copy.method}</summary><p>{copy.methodText}</p><div class="cloudflare-revenue-formulas">{copy.equations.map(equation => <p>{equation}</p>)}</div><p>{copy.limits}</p><p>{copy.privacy}</p><p><a href={source}>{copy.source}</a></p></details>
</section>
<script>import '../lib/cloudflareRevenueUi.mjs';</script>
<style>
  .cloudflare-revenue-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:clamp(.875rem,3vw,1.25rem);border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.cloudflare-revenue-calculator *{box-sizing:border-box}.cloudflare-revenue-calculator header,.cloudflare-revenue-calculator details,.cloudflare-revenue-calculator form,.cloudflare-revenue-calculator fieldset{min-width:0}.cloudflare-revenue-calculator .cloudflare-revenue-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.cloudflare-revenue-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.cloudflare-revenue-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.cloudflare-revenue-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.cloudflare-revenue-calculator details{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.cloudflare-revenue-calculator fieldset{margin:1rem 0;border:0;padding:0}.cloudflare-revenue-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.cloudflare-revenue-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.cloudflare-revenue-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.cloudflare-revenue-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;margin-top:.4rem;padding:.5rem .6rem;border:1px solid var(--color-line-strong);border-radius:.3rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-variant-numeric:tabular-nums}.cloudflare-revenue-inputs small{display:block;color:var(--color-muted);font-size:.8125rem;line-height:1.6;margin-top:.3rem}.cloudflare-revenue-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.cloudflare-revenue-calculator button{max-width:100%;min-height:2.75rem;margin-top:.5rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.cloudflare-revenue-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.cloudflare-revenue-calculator .cloudflare-revenue-error{color:var(--color-accent)}.cloudflare-revenue-results{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin:1rem 0}.cloudflare-revenue-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.cloudflare-revenue-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.cloudflare-revenue-results dd{margin:.25rem 0 0;font:700 1.125rem/1.5 var(--font-mono);color:var(--color-signal);overflow-wrap:anywhere}.cloudflare-revenue-detail .cloudflare-revenue-results{grid-template-columns:repeat(2,minmax(0,1fr))}.cloudflare-revenue-calculator .cloudflare-revenue-formulas p{font-family:var(--font-mono);font-variant-numeric:tabular-nums;color:var(--color-paper);overflow-wrap:anywhere}.cloudflare-revenue-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.cloudflare-revenue-presets{display:flex;flex-wrap:wrap;gap:.5rem}.cloudflare-revenue-calculator .cloudflare-revenue-classification{color:var(--color-paper);font-weight:700}@container(max-width:520px){.cloudflare-revenue-inputs,.cloudflare-revenue-results,.cloudflare-revenue-detail .cloudflare-revenue-results{grid-template-columns:minmax(0,1fr)}.cloudflare-revenue-calculator h3{font-size:1.2rem}}
</style>
