} as const;
const captions = {
  "justice": {
    "fr": "Schéma général. Trait plein : collecte ; pointillés : suites possibles. Chaque dossier conserve sa qualification et son état propres.",
    "en": "General framework. Solid: evidence gathering; dotted: possible next steps. Each case retains its own procedural status."
  },
  "project": {
    "fr": "Accord de juillet 2025. La période définie repose sur des conditions alternatives. Les consentements portent sur des opérations précisées au contrat.",
    "en": "July 2025 agreement. The specified period relies on alternative conditions. Consent rights cover transactions defined in the agreement."
  }
} as const;
const notes = {
  "fr": "La condition de détention applique le seuil du contrat aux instruments définis à la clôture. Les clauses visent certains actifs, opérations de contrôle et autres restrictions définies. Le prêt engagé concerne Mountain Pass ; l’offtake concerne 10X.",
  "en": "The holding condition applies the contractual threshold to securities defined at closing. The clauses cover specified assets, control transactions and other defined restrictions. The loan commitment concerns Mountain Pass; offtake concerns 10X."
} as const;
const sourceIds = {
  "justice": [
    "S13",
    "S14"
  ],
  "project": [
    "S06"
  ]
} as const;
if ((lang !== 'fr' && lang !== 'en') || !['justice', 'project'].includes(kind)) throw new Error('Unknown Nvidia state-leverage figure');
const scene = art[lang][kind];
const number = { justice: '01', project: '02' }[kind];
---
<figure class="nvidia-state-leverage-figure" id={`nv5-figure-${kind}-${lang}`} data-kind={kind}>
  <div class="art desktop-art" style="aspect-ratio:800 / 420" set:html={scene.desktop}></div>
  <div class="art mobile-art" style="aspect-ratio:400 / 460" set:html={scene.mobile}></div>
  <figcaption>
    <span class="figure-number">FIGURE {number}</span>
    {captions[kind][lang]}
    <span class="sources">{sourceIds[kind].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span>
    {kind === 'project' && <details><summary>{lang === 'fr' ? 'Périmètre du mécanisme' : 'Scope of the mechanism'}</summary><p>{notes[lang]}</p></details>}
  </figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia State Leverage';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-state-leverage-figure{width:100%;max-width:37.5rem;margin:1.6rem auto 1.8rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .nvidia-state-leverage-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.65rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.45;font-weight:400}
  .figure-number{display:block;margin-bottom:.25rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.1em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible,summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  details{margin:.3rem 0 0;font-size:.75rem;line-height:1.45}summary{cursor:pointer}details p{margin:.35rem 0 0}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:17.5rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.nvidia-state-leverage-figure{break-inside:avoid}}
</style>
