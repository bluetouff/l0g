oke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"condition-input\" data-from=\"loan\" data-to=\"or-gate\" data-status=\"alternative-condition\"/><path d=\"M226 335L220 339L226 343\" fill=\"none\" stroke=\"var(--color-paper)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"200\" cy=\"339\" r=\"18\" fill=\"var(--color-surface)\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\" data-gate=\"OR\"/><text x=\"200\" y=\"345\" font-family=\"l0g Nvidia State Leverage\" font-size=\"18\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-accent)\" data-zone=\"operator\">OR</text><path d=\"M200 364V383\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-relationship=\"specified-period\" data-from=\"or-gate\" data-to=\"defined-consents\" data-status=\"one-condition-suffices\"/><path d=\"M196 377L200 383L204 377\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M189 405V394L195 388H205L211 394V405\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"183\" y=\"405\" width=\"34\" height=\"27\" rx=\"3\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\"/><circle cx=\"200\" cy=\"416\" r=\"2\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\"/><line x1=\"200\" y1=\"418\" x2=\"200\" y2=\"424\" stroke=\"var(--color-accent)\" stroke-width=\"1.1\" stroke-linecap=\"round\"/><text x=\"200\" y=\"451\" font-family=\"l0g Nvidia State Leverage\" font-size=\"17.5\" font-weight=\"400\" text-anchor=\"middle\" fill=\"var(--color-paper)\" data-zone=\"consents\">Consent over specified assets</text></svg>"
