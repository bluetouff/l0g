---
import { dateFromIsoDate, formatDateFr, formatDateFrIsoDate } from '../lib/freshness.ts';

interface Props {
  date: Date | string;
  label?: string;
  compact?: boolean;
  locale?: 'fr' | 'en';
}

const { date, locale = 'fr', label = locale === 'en' ? 'freshness' : 'fraîcheur', compact = false } = Astro.props;
const freshnessDate = typeof date === 'string' ? dateFromIsoDate(date) : date;
const reviewed = locale === 'en' ? 'reviewed' : 'revu';
const reviewedAt = freshnessDate.toISOString();
const dateLabel = locale === 'en'
  ? freshnessDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : typeof date === 'string' ? formatDateFrIsoDate(date) : formatDateFr(date);
---

<span
  class={`freshness ${compact ? 'is-compact' : ''}`}
  data-freshness={reviewedAt}
  data-locale={locale}
  title={`${label} : ${dateLabel}`}
>
  <span class="fresh-dot" aria-hidden="true"></span>
  <span data-freshness-label>{reviewed}</span>
  {!compact && <time class="fresh-detail" datetime={reviewedAt}>{dateLabel}</time>}
</span>

<script>
  import { freshnessFor } from '../lib/freshness.ts';

  const now = new Date();
  const englishStatus = { fresh: 'fresh', current: 'current', watch: 'review due', archive: 'archive' };
  for (const badge of document.querySelectorAll<HTMLElement>('[data-freshness]')) {
    const status = badge.querySelector('[data-freshness-label]');
    if (!badge.dataset.freshness || !status) continue;
    const info = freshnessFor(new Date(badge.dataset.freshness), now);
    const english = badge.dataset.locale === 'en';
    const detail = english ? `reviewed ${info.days} day${info.days === 1 ? '' : 's'} ago` : info.detail;
    badge.classList.add(`fresh-${info.tone}`);
    status.textContent = english ? englishStatus[info.tone] : info.label;
    const date = badge.querySelector('.fresh-detail');
    if (date) date.textContent = detail;
    badge.title += ` · ${detail}`;
  }
</script>

<style>
  .freshness {
    --fresh-color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    border: 1px solid color-mix(in srgb, var(--fresh-color) 40%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--fresh-color) 8%, transparent);
    color: var(--fresh-color);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
    padding: 0.18rem 0.55rem;
    text-transform: uppercase;
  }
  .freshness.is-compact {
    padding-inline: 0.46rem;
  }
  .fresh-fresh { --fresh-color: var(--color-signal); }
  .fresh-current { --fresh-color: #7aa2f7; }
  .fresh-watch { --fresh-color: var(--color-amber); }
  .fresh-archive { --fresh-color: var(--color-muted); }
  .fresh-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 9px color-mix(in srgb, currentColor 55%, transparent);
  }
  .fresh-detail {
    color: color-mix(in srgb, currentColor 68%, var(--color-muted));
    letter-spacing: 0.02em;
    text-transform: none;
  }
</style>
