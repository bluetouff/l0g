---
import { terraActors } from '../data/crisis-terra';
import type { ReplayLanguage } from '../data/crisis-replay';
interface Props { lang: ReplayLanguage; }
const { lang } = Astro.props;
const t = (fr: string, en: string) => lang === 'fr' ? fr : en;
const positions = [[15.625,17.37,22.5,13.78],[50,17.37,77.5,13.78],[84.375,17.37,22.5,78.67],[15.625,63.16,22.5,46.22],[50,63.16,77.5,46.22],[84.375,63.16,77.5,78.67]];
---
<div class="replay-map terra-map" data-replay-map>
  <svg class="replay-wires replay-wires-desktop" viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;width:100%;height:auto">
    <defs><marker id={`terra-arrow-${lang}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.1" /></marker></defs>
    <g class="terra-loop-field" fill="none" stroke-width="1"><path d="M316 187C318 113 421 96 474 122C532 149 537 269 464 282C406 291 347 285 316 277" /></g>
    <g fill="none" stroke-width="1.4" marker-end={`url(#terra-arrow-${lang})`}>
      <path data-wire="anchor" data-from="anchor" data-to="ust" d="M100 102V202" />
      <path data-wire="support" data-from="reserve" data-to="ust" d="M244 76C189 90 160 149 120 202" />
      <path data-wire="conversion" data-from="ust" data-to="conversion" d="M176 240H244" />
      <path data-wire="issuance" data-from="conversion" data-to="luna" d="M396 240H464" />
      <path data-wire="sales" data-from="luna" data-to="market" d="M540 202V104" />
      <path data-wire="feedback" data-from="market" data-to="conversion" d="M464 66C395 66 402 163 344 202" />
    </g>
    <g class="replay-wire-labels terra-wire-labels" text-anchor="middle">
      <text x="132" y="154">{t('retraits', 'withdrawals')}</text><text x="211" y="141">{t('soutien', 'support')}</text>
      <text x="210" y="224">{t('UST détruits', 'UST burned')}</text><text x="430" y="224">{t('LUNA émis', 'LUNA minted')}</text>
      <text x="576" y="154">{t('ventes', 'sales')}</text><text x="342" y="141">{t('prix LUNA ↓', 'LUNA price ↓')}</text><text x="342" y="159">{t('émission ↑', 'issuance ↑')}</text>
    </g>
    <g class="terra-mechanism-note" text-anchor="middle"><path d="M244 312H396" /><text x="320" y="336">{t('Une baisse de LUNA amplifie l’émission', 'A lower LUNA price amplifies issuance')}</text><text x="320" y="355">{t('Boucle qualitative · aucune échelle de prix', 'Qualitative loop · no price scale')}</text></g>
  </svg>
  <svg class="replay-wires replay-wires-mobile" viewBox="0 0 360 450" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block;width:100%;height:auto">
    <defs><marker id={`terra-mobile-arrow-${lang}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M1 1L7 4L1 7" fill="none" stroke="context-stroke" stroke-width="1.1" /></marker></defs>
    <g fill="none" stroke-width="1.4" marker-end={`url(#terra-mobile-arrow-${lang})`}>
      <path data-wire="anchor" data-from="anchor" data-to="ust" d="M81 98V174" />
      <path data-wire="support" data-from="reserve" data-to="ust" d="M243 86C198 111 146 143 105 174" />
      <path data-wire="conversion" data-from="ust" data-to="conversion" d="M155 208H205" />
      <path data-wire="issuance" data-from="conversion" data-to="luna" d="M279 244V320" />
      <path data-wire="sales" data-from="luna" data-to="market" d="M205 354H155" />
      <path data-wire="feedback" data-from="market" data-to="conversion" d="M81 320C81 268 229 287 259 244" />
    </g>
    <g class="replay-wire-labels terra-wire-labels" text-anchor="middle">
      <text x="67" y="137">{t('retraits', 'withdrawals')}</text><text x="206" y="136">{t('soutien', 'support')}</text>
      <text x="180" y="193">{t('brûlés', 'burned')}</text><text x="314" y="283">{t('émission', 'issuance')}</text>
      <text x="180" y="340">{t('ventes', 'sales')}</text><text x="160" y="274">{t('prix LUNA ↓', 'LUNA price ↓')}</text><text x="160" y="292">{t('émission ↑', 'issuance ↑')}</text>
    </g>
    <g class="terra-mechanism-note" text-anchor="middle"><text x="180" y="425">{t('Boucle qualitative · aucune échelle de prix', 'Qualitative loop · no price scale')}</text></g>
  </svg>
  {terraActors.map((actor,index) => <button type="button" class={`replay-actor terra-actor terra-actor-${actor.id}`} data-replay-actor={actor.id} aria-pressed="false" aria-controls="replay-actor-detail" style={`--x:${positions[index][0]}%;--y:${positions[index][1]}%;--mx:${positions[index][2]}%;--my:${positions[index][3]}%`} disabled>
    <span class="replay-actor-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="display:block;width:100%;height:auto">
      {actor.id === 'anchor' && <><circle cx="12" cy="5" r="2.5" /><path d="M12 8v13M8 11h8M3 14c0 4 4 7 9 7s9-3 9-7M3 14l-1 3M3 14l3 1M21 14l1 3M21 14l-3 1" /></>}
      {actor.id === 'reserve' && <><path d="M3 7h18v14H3zM5 3h14v4M3 11h18M8 15h8M12 13v6" /></>}
      {actor.id === 'market' && <><path d="M3 20h18M5 16l4-5 4 3 7-10M15 4h5v5" /><path d="M5 18v-2M9 18v-3M13 18v-2M17 18v-5" /></>}
      {actor.id === 'ust' && <><circle cx="12" cy="12" r="9" /><path d="M15 8c-1-2-7-2-7 1s8 2 8 6-6 4-8 1M12 5v14" /></>}
      {actor.id === 'conversion' && <><path d="M4 7h15M15 3l4 4-4 4M20 17H5M9 13l-4 4 4 4" /></>}
      {actor.id === 'luna' && <><path d="M17 3a9 9 0 1 0 4 14A9 9 0 0 1 17 3z" /><path d="M6 11l4 4 5-5" /></>}
    </svg></span><span><small>{actor.role[lang]}</small><strong>{actor.label[lang]}</strong></span>
  </button>)}
  <p class="terra-halt" data-terra-halt><span aria-hidden="true">Ⅱ</span>{t('12 mai : arrêt de la chaîne annoncé', '12 May: chain halt announced')}</p>
</div>
