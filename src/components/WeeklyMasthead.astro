---
import { WEEKLY_SCHEDULE } from '../config/weekly-editions.ts';

interface Props { home?: boolean; }
const { home = false } = Astro.props;
---
<header class="magazine-masthead">
  <div class="magazine-kicker"><span>La revue de la semaine</span><span>Macro · Finance · Pouvoirs</span></div>
  <div class="magazine-brand-row">
    <div class="magazine-brand-lockup">
      <svg class="magazine-brand-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="4" y="3" width="16" height="18" rx="2" />
        <path d="M8 7h8M12 11h4m-4 3h4M8 18h8" />
        <path class="magazine-icon-accent" d="M8 11v3" />
      </svg>
      {home ? <h1 class="magazine-brand">L<span class="magazine-apostrophe">’</span>Hebdo<span class="magazine-stop">.</span></h1> : <a class="magazine-brand" href="/hebdo/" aria-label="L’Hebdo l0g, toutes les éditions">L<span class="magazine-apostrophe">’</span>Hebdo<span class="magazine-stop">.</span></a>}
    </div>
    <p>Prendre le temps.<br /><em>Lire les mécanismes.</em></p>
  </div>
  <nav class="magazine-toolbar" aria-label="Suivre l’Hebdo">
    <p>Par l0g <span aria-hidden="true">/</span> Chaque {WEEKLY_SCHEDULE.weekday}, {WEEKLY_SCHEDULE.time.replace(':', ' h ')} · Paris</p>
    <div><a href="/hebdo/#archives">La collection <span aria-hidden="true">↓</span></a><a href="/hebdo/rss.xml" type="application/rss+xml">S’abonner au flux <span aria-hidden="true">↗</span></a></div>
  </nav>
</header>
