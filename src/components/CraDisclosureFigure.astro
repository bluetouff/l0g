---
import { craDisclosureSvg, validateCraDisclosureFigure } from '../lib/craDisclosureFigures.mjs';

interface Props {
  lang?: 'fr' | 'en';
  kind: 'threshold' | 'clocks' | 'routing' | 'curl' | 'feedback';
  number: string;
  caption: string;
  sources: string;
}
const { lang, kind, number, caption, references } = validateCraDisclosureFigure(Astro.props);
---
<figure class="cra-disclosure-figure" id={`cra-disclosure-figure-${number}`} data-figure={number} data-kind={kind}>
  <div class="cra-disclosure-desktop" set:html={craDisclosureSvg(lang, kind, false)} />
  <div class="cra-disclosure-mobile" set:html={craDisclosureSvg(lang, kind, true)} />
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="cra-disclosure-refs">{references.map((id) => <a href={`#source-${id}`}>[{id}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .cra-disclosure-figure { margin: 2.6rem 0; width: 100%; padding-bottom: .85rem; container-type: inline-size; }
  .cra-disclosure-figure :global(svg) {
    display: block; width: 100%; height: auto; max-width: 100%;
    border-radius: .8rem; letter-spacing: normal;
  }
  .cra-disclosure-mobile { display: none; width: 100%; max-width: 25rem; margin-inline: auto; }
  figcaption { margin-top: .9rem; font-size: .875rem; line-height: 1.65; color: var(--color-muted); }
  figcaption strong { margin-right: .35em; }
  .cra-disclosure-refs { display: block; }
  .cra-disclosure-refs a { margin-right: .7em; }
  .cra-disclosure-figure :global(details) { margin-top: .65rem; font-size: .875rem; line-height: 1.65; }
  .cra-disclosure-figure :global(summary) { cursor: pointer; color: var(--color-muted); }
  @media (max-width: 640px) {
    .cra-disclosure-desktop { display: none; }
    .cra-disclosure-mobile { display: block; }
  }
  @container (max-width: 640px) {
    .cra-disclosure-desktop { display: none; }
    .cra-disclosure-mobile { display: block; }
  }
  @media print {
    .cra-disclosure-figure { break-inside: avoid; }
    .cra-disclosure-desktop { display: block; }
    .cra-disclosure-mobile { display: none; }
  }
</style>
