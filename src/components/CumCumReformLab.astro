---
import { CUMCUM_REFORM_DEFAULTS, CUMCUM_REFORM_FIELDS, calculateCumCumReform } from '../lib/cumCumReformLab.mjs';
import { CUMCUM_REFORM_OUTPUTS, cumCumReformCopy, cumCumLabOutputText } from '../lib/cumCumReformLabUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = cumCumReformCopy(lang), initial = calculateCumCumReform(CUMCUM_REFORM_DEFAULTS);
const id = `cumcum-reform-lab-${lang}`;
---
<section class="cumcum-reform-lab" data-cumcum-reform-lab data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="reform-lab-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p class="reform-lab-intro">{copy.intro}</p></header>
  <details class="reform-lab-controls"><summary>{copy.controlsTitle}</summary>
  <div class="reform-lab-presets" aria-label={copy.eyebrow}>{copy.presets.map((label, index) => <button type="button" data-preset={index} aria-pressed={index === 0 ? 'true' : 'false'} disabled>{label}</button>)}</div>
  <form aria-describedby={`${id}-bounds`}>
    <fieldset disabled><legend>{copy.legend}</legend><div class="reform-lab-fields">{CUMCUM_REFORM_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode="decimal" maxlength="10" value={CUMCUM_REFORM_DEFAULTS[key as keyof typeof CUMCUM_REFORM_DEFAULTS]} autocomplete="off" spellcheck="false" aria-invalid="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div><button type="reset" class="reform-lab-reset">{copy.reset}</button></fieldset>
    <p class="reform-lab-bounds" id={`${id}-bounds`}>{copy.bounds}</p>
    <p class="reform-lab-error" id={`${id}-error`} data-error hidden></p>
  </form>
  <noscript><p class="reform-lab-bounds">{copy.nojs}</p></noscript>
  <div class="reform-lab-results">{CUMCUM_REFORM_OUTPUTS.map((key, index) => <div><p>{copy.labels[index]}</p><output data-output={key}>{cumCumLabOutputText(key, initial[key as keyof typeof initial] as string | null, lang)}</output></div>)}</div>
  <p class="reform-lab-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="reform-lab-method"><summary>{copy.methodTitle}</summary><p>{copy.method}</p><p>{copy.rounding}</p></details>
  </details>
</section>
<script>import '../lib/cumCumReformLabUi.mjs';</script>
<style>
.cumcum-reform-lab{box-sizing:border-box;width:100%;max-width:48rem;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.cumcum-reform-lab *{box-sizing:border-box}.reform-lab-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.04em}.cumcum-reform-lab h3{margin:0 0 .8rem;color:var(--color-paper);font-size:1.35rem;line-height:1.4}.reform-lab-intro{margin:0 0 .9rem;color:var(--color-muted);font-size:.9375rem;line-height:1.65}.reform-lab-presets{margin-top:1rem;display:flex;gap:.5rem;flex-wrap:wrap}.cumcum-reform-lab button{font-family:var(--font-read);font-size:.875rem;line-height:1.4;padding:.65rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);cursor:pointer}.cumcum-reform-lab button[aria-pressed=true]{border-color:var(--color-signal);color:var(--color-signal)}.cumcum-reform-lab button:disabled{cursor:default;opacity:.65}.cumcum-reform-lab :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.cumcum-reform-lab fieldset{margin:1.3rem 0 .5rem;border:0;padding:0}.cumcum-reform-lab legend{font-size:.875rem;line-height:1.6;color:var(--color-muted);margin-bottom:.7rem}.reform-lab-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.reform-lab-fields label{display:block;font-size:.9375rem;line-height:1.5;color:var(--color-paper)}.reform-lab-fields span{display:block;margin-bottom:.4rem}.reform-lab-fields input{display:block;width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.reform-lab-fields input[aria-invalid=true]{border-color:var(--color-accent)}.cumcum-reform-lab .reform-lab-reset{margin-top:.9rem}.reform-lab-bounds,.reform-lab-error{font-size:.8125rem;line-height:1.7;margin:.7rem 0;color:var(--color-muted)}.reform-lab-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin:1.2rem 0}.reform-lab-results>div{min-width:0;border:1px solid var(--color-line-strong);border-radius:.4rem;padding:.8rem;background:var(--color-surface-2)}.reform-lab-results p{margin:0 0 .5rem;color:var(--color-muted);font-size:.8125rem;line-height:1.6}.reform-lab-results output{display:block;color:var(--color-paper);font:700 1.2rem/1.5 var(--font-mono);overflow-wrap:anywhere}.cumcum-reform-lab details{border-top:1px solid var(--color-line-strong);padding-top:.85rem}.cumcum-reform-lab .reform-lab-controls>summary{padding:.15rem 0;min-height:2.5rem}.cumcum-reform-lab summary{cursor:pointer;color:var(--color-paper);font-size:.875rem;line-height:1.6}.cumcum-reform-lab details p{font-size:.8125rem;line-height:1.7;color:var(--color-muted)}.cumcum-reform-lab .reform-lab-controls .reform-lab-error{color:var(--color-accent)}.reform-lab-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.reform-lab-fields,.reform-lab-results{grid-template-columns:minmax(0,1fr)}.reform-lab-results>div{padding:.75rem}.reform-lab-results output{font-size:1.15rem}}
</style>
