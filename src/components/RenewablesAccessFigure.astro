---
import { renewablesAccessSvg, validateRenewablesAccessFigure } from '../lib/renewablesAccessFigures.mjs';

interface Props {
  lang?: 'fr' | 'en';
  kind: 'exposure' | 'boundaries' | 'handoff' | 'coverage' | 'cash';
  number: string;
  caption: string;
  sources: string;
}
const { lang, kind, number, caption, references } = validateRenewablesAccessFigure(Astro.props);
---
<figure class="renewables-access-figure" id={`renewables-figure-${number}`} data-figure={number} data-kind={kind}>
  <div class="renewables-access-desktop" set:html={renewablesAccessSvg(lang, kind, false)} />
  <div class="renewables-access-mobile" set:html={renewablesAccessSvg(lang, kind, true)} />
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="renewables-access-refs">{references.map((id) => <a href={`#source-${id}`}>[{id}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .renewables-access-figure { margin: 2.6rem 0; width: 100%; padding-bottom: .85rem; container-type: inline-size; }
  .renewables-access-figure :global(svg) {
    display: block; width: 100%; height: auto; max-width: 100%;
    border-radius: .8rem; letter-spacing: normal;
  }
  .renewables-access-mobile { display: none; }
  figcaption { margin-top: .9rem; font-size: .875rem; line-height: 1.65; color: var(--color-muted); }
  figcaption strong { margin-right: .35em; }
  .renewables-access-refs { display: block; }
  .renewables-access-refs a { margin-right: .7em; }
  .renewables-access-figure :global(details) { margin-top: .65rem; font-size: .85rem; line-height: 1.65; }
  .renewables-access-figure :global(summary) { cursor: pointer; color: var(--color-muted); }
  @media (max-width: 640px) {
    .renewables-access-desktop { display: none; }
    .renewables-access-mobile { display: block; }
  }
  @container (max-width: 640px) {
    .renewables-access-desktop { display: none; }
    .renewables-access-mobile { display: block; }
  }
  @media print {
    .renewables-access-figure { break-inside: avoid; }
    .renewables-access-desktop { display: block; }
    .renewables-access-mobile { display: none; }
  }
</style>
