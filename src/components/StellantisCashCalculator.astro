---
import { STELLANTIS_CASH_DEFAULTS, STELLANTIS_CASH_LIMITS, STELLANTIS_CASH_PRESETS, calculateStellantisCash, stellantisCashDisplay, stellantisCashEquation } from '../lib/stellantisCashModel.mjs';
import { stellantisCashCopy } from '../lib/stellantisCashUi.mjs';
interface Props { lang: 'fr' | 'en'; id?: string; }
const { lang, id = `stellantis-cash-${lang}` } = Astro.props;
if (!/^[a-z][a-z0-9-]{0,63}$/.test(id)) throw new RangeError('Controlled calculator id required');
const copy = stellantisCashCopy(lang), initial = calculateStellantisCash(STELLANTIS_CASH_DEFAULTS);
const primary = ['annual', 'difference'] as const;
const sources = ['https://www.stellantis.com/en/news/press-releases/2026/october/third-quarter-2026-financial-results', 'https://www.stellantis.com/content/dam/stellantis-corporate/investors/events-and-presentations/other-documents/Financial-Fact-Sheet-Expanded-Quarterly-Reporting-for-2025-and-Segment-Reclassification-for-2025-and-2024.pdf', 'https://www.stellantis.com/content/dam/stellantis-corporate/investors/financial-reports/Stellantis-NV-20251231-Annual-Report-and-Form-20-F.pdf'];
---
<section class="stellantis-cash-calculator" data-stellantis-cash-root data-stellantis-cash-lang={lang} data-valid="true" aria-labelledby={`${id}-title`}>
  <header><p class="stellantis-cash-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="stellantis-cash-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-error`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="stellantis-cash-inputs"><label for={`${id}-q4`}><span>{copy.label}</span><input id={`${id}-q4`} name="q4" type="number" min={STELLANTIS_CASH_LIMITS.min} max={STELLANTIS_CASH_LIMITS.max} step={STELLANTIS_CASH_LIMITS.step} value={STELLANTIS_CASH_DEFAULTS.q4} inputmode="decimal" required autocomplete="off" aria-describedby={`${id}-bounds ${id}-error`} /><small id={`${id}-bounds`}>{copy.bounds}</small></label></div>
      <div class="stellantis-cash-presets">{STELLANTIS_CASH_PRESETS.map((value, index) => <button type="button" data-stellantis-preset={value}>{copy.presets[index]}</button>)}</div><button type="reset">{copy.reset}</button>
    </fieldset><p class="stellantis-cash-error" id={`${id}-error`} data-error role="alert" hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
  </details>
  <p class="stellantis-cash-scenario" data-scenario>{copy.initial}</p>
  <dl class="stellantis-cash-results">{primary.map((field, index) => <div><dt>{copy.resultLabels[index]}</dt><dd><output data-stellantis-cash-result={field} aria-live="off">{stellantisCashDisplay(initial, field, lang)}</output> <small>{copy.unit}</small></dd></div>)}</dl>
  <p class="stellantis-cash-classification" data-stellantis-cash-status>{copy.statuses[initial.status]}</p><p class="stellantis-cash-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="stellantis-cash-equations"><summary>{copy.equations}</summary><p>{copy.equationLabel}</p><p class="stellantis-cash-formula"><output data-stellantis-cash-equation>{stellantisCashEquation(initial, lang)}</output></p><p>{copy.prior}</p><p>{copy.historical}</p><p>{copy.balance}</p></details>
  <details class="stellantis-cash-method"><summary>{copy.method}</summary><p>{copy.scope}</p><p>{copy.privacy}</p><p>{sources.map((href, index) => <Fragment>{index > 0 ? ' · ' : ''}<a href={href}>{copy.sources[index]}</a></Fragment>)}</p></details>
</section>
<script>import '../lib/stellantisCashUi.mjs';</script>
<style>
  .stellantis-cash-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.stellantis-cash-calculator *{box-sizing:border-box}.stellantis-cash-calculator header,.stellantis-cash-calculator details,.stellantis-cash-calculator form,.stellantis-cash-calculator fieldset{min-width:0}.stellantis-cash-calculator .stellantis-cash-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.stellantis-cash-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.stellantis-cash-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.stellantis-cash-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.stellantis-cash-calculator details{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.stellantis-cash-calculator fieldset{margin:1rem 0;border:0;padding:0}.stellantis-cash-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.stellantis-cash-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.stellantis-cash-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.stellantis-cash-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;margin-top:.4rem;padding:.5rem .6rem;border:1px solid var(--color-line-strong);border-radius:.3rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-variant-numeric:tabular-nums}.stellantis-cash-inputs small{display:block;color:var(--color-muted);font-size:.8125rem;line-height:1.6;margin-top:.3rem}.stellantis-cash-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.stellantis-cash-calculator button{min-height:2.75rem;margin-top:1rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer}.stellantis-cash-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.stellantis-cash-calculator .stellantis-cash-error{color:var(--color-accent)}.stellantis-cash-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.stellantis-cash-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.stellantis-cash-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.stellantis-cash-results dd{margin:.25rem 0 0;font:700 1.125rem/1.5 var(--font-mono);color:var(--color-signal);overflow-wrap:anywhere}.stellantis-cash-results small{font-size:.8125rem;font-weight:400;color:var(--color-muted)}.stellantis-cash-example .stellantis-cash-results dd{color:var(--color-accent)}.stellantis-cash-calculator .stellantis-cash-formula{font-family:var(--font-mono);font-variant-numeric:tabular-nums;color:var(--color-paper);overflow-wrap:anywhere}.stellantis-cash-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:420px){.stellantis-cash-inputs,.stellantis-cash-results{grid-template-columns:minmax(0,1fr)}.stellantis-cash-calculator h3{font-size:1.2rem}}

.stellantis-cash-inputs{grid-template-columns:minmax(0,1fr)}.stellantis-cash-presets{display:flex;flex-wrap:wrap;gap:.5rem}.stellantis-cash-presets button{max-width:100%;overflow-wrap:anywhere}.stellantis-cash-calculator .stellantis-cash-classification{color:var(--color-paper);font-weight:700}
</style>
