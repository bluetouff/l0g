---
import { airfareStoryCopy } from '../lib/airfare-bot-copy';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
if (lang !== 'fr' && lang !== 'en') throw new Error('Unknown airfare story language');
const c = airfareStoryCopy(lang);
const scene = c.scenes[0];
const id = `airfare-bot-lab-${lang}`;
---
<section id={id} class="airfare-lab" data-airfare-lab data-lang={lang} data-stage="0" aria-labelledby={`${id}-title`}>
  <header class="story-heading">
    <p class="story-brand">l0g / {c.eyebrow}</p>
    <h2 id={`${id}-title`}>{c.title}</h2>
    <p class="story-intro">{c.intro}</p>
    <p class="story-assumption">{c.assumption}</p>
  </header>
  <div class="story-reality"><span class="person-mark" aria-hidden="true"></span><span>{c.always} <b>{c.traveller}</b></span><span class="reality-divider">·</span><span><b>{c.purchases}</b> {c.purchased}</span></div>
  <div class="story-scene" data-result>
    <section class="story-traveller" aria-label={c.traveller}>
      <div class="traveller-avatar"><span class="person-mark" aria-hidden="true"></span></div>
      <h3>{c.you}</h3><p class="traveller-request">{c.request}</p>
      <div class="story-assistant"><span class="assistant-symbol" aria-hidden="true">{lang === 'fr' ? 'IA' : 'AI'}</span><div><span class="assistant-name">{c.assistant}</span><p data-bot-speech>{scene.bot}</p></div></div>
    </section>
    <section class="story-requests" aria-label={c.sent}>
      <p class="request-title">{c.sent}</p><div class="request-number" data-requests>1</div>
      <div class="request-cloud" aria-hidden="true">{Array.from({length:100}, (_, i) => <span class="request-dot" data-dot hidden={i > 0}></span>)}</div>
      <span class="request-group" data-group hidden>{c.group}</span>
      <p class="request-caption" data-request-caption>{scene.caption}</p><span class="request-arrow" aria-hidden="true">→</span>
    </section>
    <section class="story-seller" aria-labelledby={`${id}-seller`}>
      <div class="seller-top"><h3 id={`${id}-seller`}>{c.sellerTitle}</h3><span class="seller-signal" data-signal>{scene.signal}</span></div>
      <p class="seller-thought" data-seller-speech>{scene.seller}</p>
      <div class="seller-offers" aria-label={c.offers}>
        <div class="offer-row offer-low"><span>{lang === 'fr' ? '180 €' : '€180'}</span><span class="offer-state" data-low-status>{scene.low}</span></div>
        <div class="offer-row offer-high"><span>{lang === 'fr' ? '240 €' : '€240'}</span><span class="offer-state" data-high-status>{scene.high}</span></div>
      </div>
      <div class="your-ticket"><span>{c.priceLabel}</span><output data-price aria-live="off">{scene.price}</output><span class="ticket-difference" data-difference>{scene.difference}</span></div>
    </section>
  </div>
  <div class="story-bottom">
    <p class="story-explanation" data-explanation role="status" aria-live="polite" aria-atomic="true">{scene.explanation}</p>
    <div class="story-actions"><span class="story-step" data-step>1 / 3</span><button type="button" class="story-main" data-next disabled>{scene.button}</button></div>
  </div>
  <p class="story-limit">{c.limit}</p><p data-error role="alert" hidden></p>
  <noscript><p class="story-limit">{c.nojs}</p></noscript>
  <a class="story-tools" href={lang === 'fr' ? '/outils/' : '/en/tools/'}>{c.tools} →</a>
</section>
<script>import '../lib/airfare-bot-client';</script>

<style>

.airfare-lab {
  --story-bg:var(--color-surface);--story-soft:var(--color-surface-2);
  --story-fg:var(--color-paper);--story-dim:var(--color-muted);
  --story-line:var(--color-line-strong);
  --story-teal:var(--color-signal);--story-rose:var(--color-accent);
  --story-amber:var(--color-amber);
  container-type:inline-size;margin:2.5rem 0;padding-bottom:1rem;
  color:var(--story-fg);background:var(--story-bg);border:1px solid var(--story-line);border-radius:14px;
  padding:24px;font-family:var(--font-read);font-size:14px;font-weight:400;line-height:1.55;
}
.airfare-lab * { box-sizing:border-box; }
.airfare-lab [hidden] { display:none!important; }
.airfare-lab p,.airfare-lab h2,.airfare-lab h3 { margin:0; }
.airfare-lab .story-brand { color:var(--story-teal);font-size:11px;letter-spacing:.08em;text-transform:uppercase; }
.airfare-lab h2 { border:0;padding:0;color:var(--story-fg);font-family:var(--font-read);font-size:clamp(23px,4vw,30px);font-weight:450;letter-spacing:-.035em;line-height:1.2;margin:9px 0 10px; }
.airfare-lab .story-intro { color:var(--story-dim);max-width:570px;font-size:14px; }
.airfare-lab .story-assumption { color:var(--story-amber);font-size:12px;margin-top:12px; }
.airfare-lab b { font-weight:500; }
.airfare-lab .story-reality { display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:22px 0;padding:12px 0;border-block:1px solid var(--story-line);font-size:13px; }
.airfare-lab .story-reality .person-mark { width:18px;height:18px;margin-right:2px; }
.airfare-lab .reality-divider { color:var(--story-dim);margin-inline:4px; }
.airfare-lab .story-scene { display:grid;grid-template-columns:1fr .9fr 1.3fr;gap:20px;align-items:start; }
.airfare-lab .story-traveller { padding-top:10px; }
.airfare-lab .traveller-avatar { width:54px;height:54px;border:1px solid var(--story-line);border-radius:50%;display:grid;place-items:center;margin-bottom:9px;background:var(--story-soft); }
.airfare-lab .person-mark { position:relative;display:inline-block;width:28px;height:28px;color:var(--story-teal);flex-shrink:0; }
.airfare-lab .person-mark::before { content:"";position:absolute;width:30%;height:30%;left:35%;top:10%;border:1.3px solid currentColor;border-radius:50%; }
.airfare-lab .person-mark::after { content:"";position:absolute;width:65%;height:32%;left:17.5%;top:55%;border:1.3px solid currentColor;border-bottom:0;border-radius:12px 12px 0 0; }
.airfare-lab h3 { color:var(--story-fg);font-family:var(--font-read);font-size:14px;font-weight:500; }
.airfare-lab .traveller-request { margin:7px 0 18px;color:var(--story-dim);font-size:14px; }
.airfare-lab .story-assistant { position:relative;display:flex;align-items:flex-start;gap:9px;padding-top:14px;border-top:1px solid var(--story-line); }
.airfare-lab .story-assistant::after { content:'→';position:absolute;right:-18px;top:16px;color:var(--story-rose);font-size:18px; }
.airfare-lab .assistant-symbol { display:grid;place-items:center;flex:0 0 29px;height:29px;border-radius:7px;background:var(--story-soft);color:var(--story-dim);font-size:11px; }
.airfare-lab .assistant-name { font-size:12px;color:var(--story-dim); }
.airfare-lab [data-bot-speech] { font-size:12px;margin-top:4px; }
.airfare-lab[data-stage="1"] .assistant-symbol,.airfare-lab[data-stage="2"] .assistant-symbol { color:var(--story-rose);background:color-mix(in srgb,var(--story-rose) 9%,var(--story-bg)); }
.airfare-lab .story-requests { position:relative;text-align:center;padding-top:10px; }
.airfare-lab .request-title { font-size:12px;color:var(--story-dim); }
.airfare-lab .request-number { font-size:40px;letter-spacing:-.06em;font-weight:400;line-height:1.25;margin-top:3px;font-variant-numeric:tabular-nums; }
.airfare-lab .request-cloud { display:grid;grid-template-columns:repeat(10,1fr);gap:4px;width:100%;max-width:126px;min-height:126px;align-content:start;margin:13px auto 9px;padding:6px;transition:box-shadow .3s; }
.airfare-lab .request-dot { width:100%;aspect-ratio:1;border-radius:50%;background:var(--story-rose);opacity:.8; }
.airfare-lab .request-dot:first-child { background:var(--story-teal); }
.airfare-lab[data-stage="2"] .request-cloud { box-shadow:0 0 0 1px var(--story-teal);border-radius:9px; }
.airfare-lab .request-group { display:block;font-size:11px;color:var(--story-teal);margin:0 -8px 6px; }
.airfare-lab .request-caption { color:var(--story-dim);font-size:12px; }
.airfare-lab .request-arrow { position:absolute;right:-18px;top:135px;font-size:22px;color:var(--story-dim); }
.airfare-lab .story-seller { border:1px solid var(--story-line);border-radius:10px;padding:15px;background:var(--story-soft); }
.airfare-lab .seller-top { display:flex;align-items:baseline;justify-content:space-between;gap:6px;flex-wrap:wrap; }
.airfare-lab .seller-signal { font-size:11px;color:var(--story-teal); }
.airfare-lab[data-stage="1"] .seller-signal { color:var(--story-amber); }
.airfare-lab .seller-thought { min-height:67px;color:var(--story-dim);font-size:13px;margin:13px 0; }
.airfare-lab .seller-offers { border-block:1px solid var(--story-line); }
.airfare-lab .offer-row { display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 0;font-variant-numeric:tabular-nums; }
.airfare-lab .offer-row>span:first-child { white-space:nowrap;flex-shrink:0; }
.airfare-lab .offer-row+.offer-row { border-top:1px solid var(--story-line); }
.airfare-lab .offer-state { font-size:11px;color:var(--story-dim); }
.airfare-lab .offer-low { color:var(--story-teal); }
.airfare-lab .offer-high { color:var(--story-dim); }
.airfare-lab[data-stage="1"] .offer-low>span:first-child { text-decoration:line-through;color:var(--story-dim); }
.airfare-lab[data-stage="1"] .offer-low .offer-state { color:var(--story-rose); }
.airfare-lab[data-stage="1"] .offer-high { color:var(--story-rose); }
.airfare-lab .your-ticket { margin-top:14px; }
.airfare-lab .your-ticket>span { display:block;font-size:11px;color:var(--story-dim); }
.airfare-lab .your-ticket output { display:block;font-size:42px;line-height:1.3;font-weight:400;letter-spacing:-.05em;color:var(--story-teal);font-variant-numeric:tabular-nums; }
.airfare-lab[data-stage="1"] .your-ticket output { color:var(--story-rose); }
.airfare-lab .your-ticket .ticket-difference { font-size:12px; }
.airfare-lab .story-bottom { margin-top:23px;padding-top:16px;border-top:1px solid var(--story-line); }
.airfare-lab .story-explanation { min-height:44px;font-size:14px; }
.airfare-lab .story-actions { display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:13px; }
.airfare-lab .story-step { color:var(--story-dim);font-size:12px;white-space:nowrap; }
.airfare-lab .story-main { display:flex;gap:15px;align-items:center;justify-content:center;min-height:46px;border:1px solid var(--story-teal);border-radius:7px;background:color-mix(in srgb,var(--story-teal) 7%,var(--story-bg));color:var(--story-fg);padding:11px 16px;font:400 14px/1.4 var(--font-read);cursor:pointer; }
.airfare-lab .story-main:hover:enabled { background:color-mix(in srgb,var(--story-teal) 13%,var(--story-bg)); }
.airfare-lab .story-main:focus-visible { outline:2px solid var(--story-teal);outline-offset:4px; }
.airfare-lab .story-main:disabled { opacity:.7; }
.airfare-lab .story-limit { margin-top:15px;font-size:11px;color:var(--story-dim); }
@media(max-width:560px) { .airfare-lab { padding:17px; } }
@container(max-width:560px) {
  .airfare-lab .story-scene { grid-template-columns:1fr 1fr;gap:17px; }
  .airfare-lab .story-seller { grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px 18px; }
  .airfare-lab .seller-top,.airfare-lab .seller-thought { grid-column:1/-1; }
  .airfare-lab .seller-thought { min-height:0;margin:0 0 4px; }
  .airfare-lab .your-ticket { margin-top:0;align-self:center; }
  .airfare-lab .your-ticket output { font-size:36px; }
  .airfare-lab .request-arrow { right:calc(50% - 10px);top:auto;bottom:-22px;transform:rotate(90deg); }
  .airfare-lab .story-main { flex:1;font-size:13px;padding:11px; }
  .airfare-lab .story-limit { font-size:11px; }
}
@media(prefers-reduced-motion:reduce) { .airfare-lab * { transition:none!important;animation:none!important; } }
.airfare-lab .story-scene>section { min-width:0; }
.airfare-lab .story-tools { display:inline-block;font-size:12px;margin-top:10px; }
.airfare-lab [data-error] { color:var(--color-accent);margin-top:12px; }

</style>
