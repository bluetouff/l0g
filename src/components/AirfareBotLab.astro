---
import { AIRFARE_SEATS } from '../lib/airfare-bot-model';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const id = `airfare-bot-lab-${lang}`;
const c = fr ? {
  title: 'Les bots et le prix du billet',
  intro: 'Appuie sur « Bloquer 2 places » plusieurs fois et regarde le prix changer.',
  price: 'Billet le moins cher disponible',
  start: 'Les 4 places à 180 € sont libres. C’est le prix le plus bas.',
  available: '12 places disponibles',
  actions: 'Faire agir les bots', search: 'Chercher les prix', hold: 'Bloquer 2 places', release: 'Libérer les places', bots: 'Les bots peuvent…',
  caption: 'Une croix indique une place temporairement bloquée par un bot.',
  caution: 'Exemple inventé : ces places et leurs prix ne décrivent aucun vol réel.',
  method: 'Comprendre cet exemple',
  limits: 'Il y a 4 places à 180 €, puis 4 à 240 € et 4 à 300 €. Les bots bloquent les moins chères en premier, sans acheter de billet. Quand elles sont toutes retenues, le prix suivant devient le moins cher disponible. Libérer les places fait réapparaître le tarif de départ. Une simple recherche ne bloque aucune place.',
  scope: 'Ce petit jeu illustre uniquement les retenues de places. Les compagnies utilisent des règles plus complexes ; l’effet des recherches sur leurs prévisions est traité dans l’article.',
  source: 'Source sur les retenues : OWASP',
  real: 'Repère publié par Air Europa : à partir de 552 € aller-retour, Orly–JFK, du 6 au 17 novembre 2026, pour un adulte en économique. Page consultée le 5 novembre via une copie indexée ; prix non confirmé en direct. Taxes et suppléments inclus, bagages et services optionnels éventuellement en plus. Ce repère reste indépendant des prix inventés du jeu.',
  realLink: 'Page officielle Air Europa', tools: 'Tous les outils l0g',
  nojs: 'Activez JavaScript pour jouer. L’exemple de départ reste visible ci-dessus.',
} : {
  title: 'Bots and ticket prices',
  intro: 'Click “Hold 2 seats” a few times and watch the price change.',
  price: 'Cheapest available ticket', start: 'All 4 seats at €180 are available. This is the lowest price.', available: '12 seats available',
  actions: 'Let the bots act', search: 'Search prices', hold: 'Hold 2 seats', release: 'Release the seats', bots: 'The bots can…',
  caption: 'A cross marks a seat temporarily held by a bot.',
  caution: 'Fictional example: these seats and prices do not describe any real flight.',
  method: 'About this example',
  limits: 'There are 4 seats at €180, 4 at €240 and 4 at €300. Bots hold the cheapest seats first without buying tickets. When those seats are all held, the next fare becomes the cheapest available. Releasing seats restores the initial fare. Simply searching does not hold any seats.',
  scope: 'This small game illustrates temporary holds only. Airlines use more complex rules; the article discusses how search activity might affect forecasts.',
  source: 'Source on inventory holds: OWASP',
  real: 'Air Europa published reference: return flights from €552, Orly–JFK, 6–17 November 2026, one adult in economy. Page consulted on 5 November through an indexed copy; not confirmed live. Includes taxes and surcharges; baggage and optional services may cost extra. This reference is independent of the game’s fictional fares.',
  realLink: 'Official Air Europa page', tools: 'All l0g tools', nojs: 'Enable JavaScript to play. The starting example remains visible above.',
};
---
<section class="airfare-lab" id={id} data-airfare-lab data-lang={lang} aria-labelledby={`${id}-title`}>
  <header>
    <p class="airfare-lab__eyebrow">l0g / {fr ? 'à toi de jouer' : 'try it yourself'}</p>
    <h2 id={`${id}-title`}>{c.title}</h2>
    <p class="airfare-lab__intro">{c.intro}</p>
  </header>
  <div data-result>
    <div class="airfare-lab__scene">
      <div class="airfare-lab__ticket"><span>{c.price}</span><output data-price>{fr ? '180 €' : '€180'}</output><span data-available>{c.available}</span></div>
      <div class="airfare-lab__seats" role="img" data-seats-summary aria-label={fr ? '12 places libres : 4 à 180 euros, 4 à 240 euros, 4 à 300 euros.' : '12 available seats: 4 at €180, 4 at €240, 4 at €300.'}>
        {AIRFARE_SEATS.map(seat => <span class="airfare-lab__seat" data-seat data-state="free" data-tier={seat.price} aria-hidden="true"><span>{fr ? `${seat.price} €` : `€${seat.price}`}</span><i>×</i></span>)}
      </div>
    </div>
    <p class="airfare-lab__why" data-explanation role="status" aria-live="polite" aria-atomic="true">{c.start}</p>
  </div>
  <fieldset class="airfare-lab__controls" data-controls disabled>
    <legend>{c.bots}</legend>
    <div class="airfare-lab__buttons" role="group" aria-label={c.actions}>
      <button type="button" data-action="search">{c.search}</button>
      <button type="button" data-action="hold" class="airfare-lab__primary">{c.hold}</button>
      <button type="button" data-action="release" disabled>{c.release}</button>
    </div>
  </fieldset>
  <p class="airfare-lab__caption">{c.caption}</p><p class="airfare-lab__caution">{c.caution}</p>
  <p data-error role="alert" hidden></p>
  <noscript><p class="airfare-lab__caption">{c.nojs}</p></noscript>
  <details class="airfare-lab__details"><summary>{c.method}</summary><p>{c.limits}</p><p>{c.scope} <a href="#source-10">{c.source}</a>.</p><p>{c.real} <a href="https://www.aireuropa.com/fr-fr/offres-de-vols-de-paris-vers-new-york" target="_blank" rel="noopener noreferrer">{c.realLink} ↗</a></p></details>
  <a class="airfare-lab__all" href={fr ? '/outils/' : '/en/tools/'}>{c.tools} →</a>
</section>
<script>import '../lib/airfare-bot-client';</script>
<style>
  .airfare-lab { container-type:inline-size;margin:2.5rem 0 1.5rem;padding:clamp(1rem,3vw,1.7rem);border:1px solid var(--color-line-strong);border-radius:var(--radius-panel);background:var(--color-surface);color:var(--color-paper);font:400 .95rem/1.6 var(--font-read); }
  .airfare-lab [hidden] { display:none!important; }
  .airfare-lab p { margin:0; }
  .airfare-lab h2 { padding:0;border:0;margin:.4rem 0 .7rem;color:var(--color-paper);font:450 clamp(1.3rem,3cqi,1.7rem)/1.3 var(--font-read);letter-spacing:-.03em; }
  .airfare-lab__eyebrow { font:400 .7rem/1.5 var(--font-mono);color:var(--color-signal); }
  .airfare-lab__intro { color:var(--color-muted);font-size:.9rem; }
  .airfare-lab__scene { display:grid;grid-template-columns:1fr 1.2fr;align-items:center;gap:2rem;margin:1.5rem 0; }
  .airfare-lab__ticket>span { display:block;font-size:.8rem;color:var(--color-muted); }
  .airfare-lab__ticket output { display:block;margin:.15rem 0 .3rem;font:350 clamp(2.5rem,9cqi,4rem)/1.2 var(--font-read);letter-spacing:-.06em;color:var(--color-signal);font-variant-numeric:tabular-nums;overflow-wrap:anywhere; }
  .airfare-lab[data-price-state="higher"] .airfare-lab__ticket output { color:var(--color-accent); }
  .airfare-lab[data-price-state="unavailable"] .airfare-lab__ticket output { color:var(--color-muted);font-size:1.6rem;letter-spacing:-.02em; }
  .airfare-lab__seats { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px; }
  .airfare-lab__seat { position:relative;display:flex;align-items:center;justify-content:center;min-height:54px;border-radius:7px 7px 3px 3px;border:1px solid color-mix(in srgb,var(--color-signal) 40%,var(--color-line));background:color-mix(in srgb,var(--color-signal) 8%,var(--color-surface));font-size:.8rem;font-variant-numeric:tabular-nums;transition:background .2s; }
  .airfare-lab__seat[data-tier="240"] { border-color:color-mix(in srgb,var(--color-topic-blue) 40%,var(--color-line));background:color-mix(in srgb,var(--color-topic-blue) 8%,var(--color-surface)); }
  .airfare-lab__seat[data-tier="300"] { border-color:color-mix(in srgb,var(--color-amber) 40%,var(--color-line));background:color-mix(in srgb,var(--color-amber) 8%,var(--color-surface)); }
  .airfare-lab__seat i { display:none;position:absolute;right:4px;top:-2px;font-size:1.15rem;font-style:normal;color:var(--color-accent); }
  .airfare-lab__seat[data-state="held"] { border-color:var(--color-line);background:var(--color-surface-2); }
  .airfare-lab__seat[data-state="held"]>span { text-decoration:line-through;color:var(--color-muted); }
  .airfare-lab__seat[data-state="held"] i { display:block; }
  .airfare-lab .airfare-lab__why { min-height:3.2em;padding:.8rem 0;border-block:1px solid var(--color-line);font-size:.95rem;color:var(--color-paper); }
  .airfare-lab__controls { border:0;padding:0;margin:1rem 0 .8rem;min-width:0; }
  .airfare-lab__controls legend { font-size:.8rem;color:var(--color-muted);margin-bottom:.6rem; }
  .airfare-lab__buttons { display:flex;flex-wrap:wrap;gap:.5rem; }
  .airfare-lab button { flex:1;min-height:46px;padding:.7rem .8rem;border:1px solid var(--color-line-strong);border-radius:7px;background:transparent;color:var(--color-paper);font:400 .85rem/1.4 var(--font-read);cursor:pointer; }
  .airfare-lab button:hover:enabled { border-color:var(--color-signal); }
  .airfare-lab .airfare-lab__primary { border-color:var(--color-signal);background:color-mix(in srgb,var(--color-signal) 7%,transparent); }
  .airfare-lab button:disabled { opacity:.45;cursor:default; }
  .airfare-lab :focus-visible { outline:2px solid var(--color-signal);outline-offset:4px; }
  .airfare-lab .airfare-lab__caption { font-size:.75rem;color:var(--color-muted);margin:.5rem 0; }
  .airfare-lab .airfare-lab__caution { font-size:.75rem;color:var(--color-amber);margin:.7rem 0; }
  .airfare-lab__details { border-top:1px solid var(--color-line);padding-top:.5rem;margin-top:1rem; }
  .airfare-lab summary { cursor:pointer;font-size:.8rem;min-height:36px;padding:.4rem 0; }
  .airfare-lab__details p { font-size:.8rem;color:var(--color-muted);margin:.7rem 0; }
  .airfare-lab__all { display:inline-block;margin-top:.6rem;font-size:.75rem; }
  .airfare-lab [data-error] { color:var(--color-accent);margin:1rem 0; }
  @container(max-width:470px) { .airfare-lab__scene { grid-template-columns:1fr;gap:1rem;margin:1rem 0; }.airfare-lab__ticket output { font-size:3rem; }.airfare-lab__seats { max-width:340px;width:100%;margin-inline:auto; }.airfare-lab__buttons { flex-direction:column; } }
  @media(prefers-reduced-motion:reduce) { .airfare-lab * { transition:none!important;animation:none!important; } }
</style>
