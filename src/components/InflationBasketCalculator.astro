---
import { INFLATION_BASKET_CATEGORIES, INFLATION_BASKET_DEFAULTS, INFLATION_BASKET_SOURCE, calculateInflationBasket, formatInflationBasketMoney, formatInflationBasketPercent } from '../lib/inflationBasketCalculator.mjs';
import { inflationBasketCopy } from '../lib/inflationBasketCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = inflationBasketCopy(lang), initial = calculateInflationBasket(INFLATION_BASKET_DEFAULTS), id = `inflation-basket-${lang}`;
const totals = ['initial', 'comparative', 'difference', 'change'] as const;
const metrics = ['share', 'comparative', 'contribution'] as const;
---
<section class="inflation-basket-calculator" data-inflation-basket-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="inflation-basket-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="inflation-basket-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="inflation-basket-fields">{INFLATION_BASKET_CATEGORIES.map((row, index) => <label for={`${id}-${row.key}`}><span>{copy.categories[index]}</span><input id={`${id}-${row.key}`} name={row.key} type="text" inputmode="decimal" maxlength="10" value={INFLATION_BASKET_DEFAULTS[row.key as keyof typeof INFLATION_BASKET_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div>
      <div class="inflation-basket-presets" role="group" aria-label={copy.presets}>{['reference', 'energy', 'food'].map((key, i) => <button type="button" data-basket-preset={key} aria-pressed={key === 'reference'}>{copy.presetLabels[i]}</button>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p id={`${id}-bounds`}>{copy.bounds}</p><p class="inflation-basket-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <dl class="inflation-basket-totals">{totals.map((key, index) => <div><dt>{copy.totals[index]}</dt><dd><output data-basket-total={key}>{key === 'change' ? formatInflationBasketPercent(initial.change, lang) : formatInflationBasketMoney(initial[key], lang)}</output></dd></div>)}</dl>
    <p data-basket-note>{copy.ready}</p><p class="inflation-basket-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="inflation-basket-breakdown"><summary>{copy.detail}</summary><div class="inflation-basket-categories">{initial.rows.map((row, i) => <section aria-labelledby={`${id}-${row.key}-heading`}><h4 id={`${id}-${row.key}-heading`}>{copy.categories[i]}</h4><dl>{metrics.map((metric, index) => <div><dt>{copy.rowLabels[index]}</dt><dd><output data-basket-category={row.key} data-basket-metric={metric}>{metric === 'comparative' ? formatInflationBasketMoney(row.comparative, lang) : formatInflationBasketPercent(row[metric], lang, metric === 'contribution')}</output></dd></div>)}</dl></section>)}</div></details>
    <details class="inflation-basket-method"><summary>{copy.method}</summary><p>{copy.formula}</p><p>{copy.scope}</p><p><a href={INFLATION_BASKET_SOURCE}>{copy.source}</a></p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/inflationBasketCalculatorUi.mjs';</script>
<style>
.inflation-basket-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.inflation-basket-calculator *{box-sizing:border-box}.inflation-basket-calculator header,.inflation-basket-calculator details,.inflation-basket-calculator form,.inflation-basket-calculator fieldset{min-width:0}.inflation-basket-calculator .inflation-basket-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.inflation-basket-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.inflation-basket-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.inflation-basket-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.inflation-basket-controls,.inflation-basket-method,.inflation-basket-breakdown{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.inflation-basket-calculator fieldset{margin:1rem 0;border:0;padding:0}.inflation-basket-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.inflation-basket-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.inflation-basket-fields label{display:flex;flex-direction:column;min-width:0;font-size:.9375rem;line-height:1.5}.inflation-basket-fields span{display:block;margin-bottom:.35rem}.inflation-basket-fields input{margin-top:auto;width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.inflation-basket-fields [aria-invalid=true]{border-color:var(--color-accent)}.inflation-basket-calculator button{min-width:0;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.inflation-basket-calculator button[aria-pressed=true]{border-color:var(--color-signal);color:var(--color-signal)}.inflation-basket-presets{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}.inflation-basket-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.inflation-basket-calculator .inflation-basket-error{color:var(--color-accent)}.inflation-basket-totals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.inflation-basket-totals>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.inflation-basket-totals>div:nth-child(2){border-color:var(--color-signal)}.inflation-basket-totals dt,.inflation-basket-categories dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.inflation-basket-totals dd{margin:.25rem 0 0;font:700 1rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.inflation-basket-totals>div:nth-child(2) output{color:var(--color-signal)}.inflation-basket-categories{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:.75rem 0}.inflation-basket-categories>section{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.inflation-basket-categories h4{margin:0 0 .5rem;font-size:1rem;line-height:1.5;hyphens:none}.inflation-basket-categories dl{margin:0}.inflation-basket-categories dl>div{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.2rem .6rem;margin:.5rem 0;min-width:0}.inflation-basket-categories dd{margin:0;font:.875rem/1.6 var(--font-mono);overflow-wrap:anywhere;min-width:0}.inflation-basket-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.inflation-basket-fields,.inflation-basket-totals,.inflation-basket-categories{grid-template-columns:minmax(0,1fr)}.inflation-basket-calculator h3{font-size:1.2rem}}
</style>
