<figure class="pricing-figure">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 733" width="100%" style="width:100%;height:auto" role="img" aria-labelledby="l0g-pricing-en-2-title l0g-pricing-en-2-desc">
