---
import { topics } from '../config/topics.ts';
import DiscoveryCard from './DiscoveryCard.astro';
import type { DiscoveryEntry } from '../lib/reading-discovery-model.ts';
interface Props { entries: DiscoveryEntry[]; }
const { entries } = Astro.props;
---
<div class="reading-discovery" data-reading-discovery>
  <form class="discovery-filters" data-discovery-filters hidden aria-label="Filtrer toutes les analyses">
    <div class="discovery-fields">
      <label class="discovery-field">
        <span class="discovery-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 6h5m4 0h9M3 12h11m4 0h3M3 18h2m4 0h12M8 3v6m6 0v6M5 15v6" /></svg>Sujet</span>
        <span class="discovery-select"><select name="topic"><option value="">Tous les sujets</option>{topics.map(t => <option value={t.slug}>{t.label}</option>)}</select><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></span>
      </label>
      <label class="discovery-field">
        <span class="discovery-label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5h4" /></svg>Temps de lecture</span>
        <span class="discovery-select"><select name="duration"><option value="">Toutes les durées</option><option value="short">5 min ou moins</option><option value="medium">6 à 15 min</option><option value="long">Plus de 15 min</option></select><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></span>
      </label>
    </div>
    <div class="discovery-options">
      <label class="discovery-check"><input type="checkbox" name="tool" /> Avec simulateur</label>
      <label class="discovery-check"><input type="checkbox" name="unread" /> Masquer les articles lus</label>
      <button class="discovery-reset" type="reset"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 10a9 9 0 1 1 2.6 8.4M3 4v6h6" /></svg>Réinitialiser</button>
    </div>
  </form>
  <div class="discovery-visit" data-visit-panel hidden>
    <div><span class="discovery-eyebrow">Depuis votre dernier passage</span><p data-visit-copy></p></div>
    <button type="button" data-visit-filter hidden>Voir les nouveautés</button><button type="button" data-visit-mark>Actualiser mon repère</button>
  </div>
  <p class="discovery-status" data-discovery-status role="status" aria-live="polite"></p>
  <div data-discovery-results><slot /></div>
  <button class="discovery-more" type="button" data-discovery-more hidden>Afficher la suite</button>
  <template data-discovery-template>{entries[0] && <DiscoveryCard entry={entries[0]} template />}</template>
</div>
<script>import '../scripts/reading-discovery.ts';</script>
