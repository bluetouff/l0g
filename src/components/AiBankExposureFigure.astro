---
interface Props {
  lang: 'fr' | 'en';
  kind: 'loan' | 'portfolio' | 'power';
  sourceHref: string;
  number?: number;
  caption?: string;
}

const { lang, kind, sourceHref, number, caption } = Astro.props;
const copy = {
  fr: {
    loan: {
      caption: 'CoreWeave DDTL 5.5 : la capacité à la signature et l’encours brut à une autre date sont deux mesures distinctes. Leur différence ne mesure pas une capacité immédiatement disponible. Les participations actuelles par banque ne sont pas publiées.',
      source: 'CoreWeave, 8-K du 10 août et 10-Q du 12 novembre 2026, note 10',
      credit: 'Milliards de dollars. Échelle commune, dates distinctes. Graphique l0g.',
    },
    portfolio: {
      caption: 'Les quelque 7,2 Md€ des data centres résultent de 12 × 60 %, sur des valeurs arrondies. L’exposition en cas de défaut (EaD) couvre les expositions au bilan et hors bilan, dans une poche sectorielle plus large que l’IA.',
      source: 'Société Générale, résultats T3 2026, p. 41, et présentation investisseurs obligataires, p. 46',
      credit: 'Fin T3 2026, milliards d’euros. Calcul et graphique l0g.',
    },
    power: {
      caption: 'Le cadre non engagé de 3,5 Md$ annoncé par Switch concerne les lettres de crédit de performance. L’obligation bancaire porte sur une LC effectivement émise, selon ses termes et les conditions d’un appel conforme.',
      source: 'Switch et BBVA CIB, communiqués du 10 juin 2026',
      credit: 'Montants des LC émises et des appels payés non indiqués dans les communiqués. Schéma l0g sans échelle monétaire.',
    },
  },
  en: {
    loan: {
      caption: 'CoreWeave DDTL 5.5: capacity at signing and gross debt outstanding at a later date are different measures. The gap does not measure immediately available capacity. Current holdings by individual banks are not disclosed.',
      source: 'CoreWeave, 10 August 8-K and 12 November 2026 10-Q, note 10',
      credit: 'US dollars, billions. Common scale, different dates. Chart by l0g.',
    },
    portfolio: {
      caption: 'The approximate €7.2bn data-centre figure comes from 12 × 60%, using rounded inputs. Exposure at default (EAD) covers on- and off-balance-sheet exposures within a sector portfolio that extends beyond AI.',
      source: 'Société Générale, Q3 2026 results, p. 41, and debt investor presentation, p. 46',
      credit: 'End-Q3 2026, euros, billions. Calculation and chart by l0g.',
    },
    power: {
      caption: 'Switch’s announced $3.5bn uncommitted framework covers performance letters of credit. A bank’s obligation follows the terms of a letter actually issued, including the conditions for a complying demand.',
      source: 'Switch and BBVA CIB, releases of 10 June 2026',
      credit: 'Issued LC amounts and paid demands are not stated in the releases. Diagram by l0g, without a monetary scale.',
    },
  },
} as const;

const item = copy[lang][kind];
const figures = import.meta.glob('../figures/ai-bank-exposure/*.svg', {
  query: '?raw', import: 'default', eager: true,
});
const prefix = `../figures/ai-bank-exposure/${lang}-${kind}`;
const desktop = figures[`${prefix}.svg`];
const mobile = figures[`${prefix}-mobile.svg`];
if (typeof desktop !== 'string' || typeof mobile !== 'string') {
  throw new TypeError('Missing AI bank exposure figure.');
}
if (!sourceHref || !/^(?:#[A-Za-z0-9_-]+|https:\/\/[^\s]+)$/u.test(sourceHref)) {
  throw new TypeError('AI bank exposure figure requires a source anchor or an HTTPS source URL.');
}
const figureId = number === undefined ? `ai-bank-exposure-${lang}-${kind}` : `figure-${number}`;
---

<figure class="ai-bank-exposure" id={figureId} data-kind={kind}>
  <div class="figure-wide" set:html={desktop} />
  <div class="figure-narrow" set:html={mobile} />
  <figcaption>
    {number !== undefined && <span class="figure-number">FIG. {String(number).padStart(2, '0')}</span>}
    {caption ?? item.caption}
    <span class="figure-source">{lang === 'fr' ? 'Sources : ' : 'Sources: '}<a href={sourceHref}>{item.source}</a>.</span>
    <span class="figure-credit">{item.credit}</span>
  </figcaption>
</figure>

<style>
  .ai-bank-exposure {
    width: 100%;
    max-width: 600px;
    margin: 2rem auto;
    padding-bottom: 1rem;
    container-type: inline-size;
  }
  .ai-bank-exposure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-read);
    letter-spacing: normal;
    overflow: visible;
  }
  .figure-wide { display: block; }
  .figure-narrow { display: none; max-width: 380px; margin-inline: auto; }
  figcaption {
    margin-top: .6rem;
    color: var(--color-muted);
    font-family: var(--font-read);
    font-size: .75rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .figure-number { margin-right: .6rem; font-variant-numeric: tabular-nums; }
  .figure-source, .figure-credit { display: block; margin-top: .35rem; }
  .figure-source a { color: inherit; text-underline-offset: .2em; }
  .figure-source a:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; }
  @container (max-width: 568px) {
    .figure-wide { display: none; }
    .figure-narrow { display: block; }
  }
  @media print {
    .ai-bank-exposure { break-inside: avoid; }
    .figure-wide { display: block; }
    .figure-narrow { display: none; }
  }
</style>
