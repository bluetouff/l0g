  }
} as const;
const captions = {
  "agenda": {
    "fr": "Lutnick accepte de participer ; le 10 décembre reste demandé. Espacement éditorial.",
    "en": "Lutnick agreed to participate; 10 December remains requested. Editorial spacing."
  },
  "records": {
    "fr": "Turquoise : courriers officiels. Rose pointillé : contact rapporté. Gris : pièces à recouper.",
    "en": "Teal: official letters. Pink dots: reported contact. Grey: records to cross-check."
  }
} as const;
const notes = {
  "fr": "13 novembre à 20 h EST = 14 novembre à 01 h UTC et 02 h à Paris. Le délai et l’assignation annoncée visent Huang et Teter. Les rendez-vous de décembre sont les dates demandées.",
  "en": "13 November at 8 pm EST = 14 November at 1 am UTC and 2 am in Paris. The deadline and announced subpoena concern Huang and Teter. December appointments are requested dates."
} as const;
const sourceIds = {
  "agenda": [
    "S01",
    "S02",
    "S03",
    "S04",
    "S05",
    "S06"
  ],
  "records": [
    "S01",
    "S03",
    "S04",
    "S10"
  ]
} as const;
if ((lang !== 'fr' && lang !== 'en') || !['agenda', 'records'].includes(kind)) throw new Error('Unknown Nvidia Congress figure');
const scene = art[lang][kind];
const number = { agenda: '01', records: '02' }[kind];
const desktopHeight = kind === 'agenda' ? 420 : 400;
const mobileHeight = kind === 'agenda' ? 460 : 440;
---
<figure class="nvidia-congress-figure" id={`nv6-figure-${kind}-${lang}`} data-kind={kind}>
  <div class="art desktop-art" style={`aspect-ratio:800 / ${desktopHeight}`} set:html={scene.desktop}></div>
  <div class="art mobile-art" style={`aspect-ratio:400 / ${mobileHeight}`} set:html={scene.mobile}></div>
  <figcaption>
    <span class="figure-number">FIG. {number}</span>
    {captions[kind][lang]}
    <span class="sources">{sourceIds[kind].map(id => <a href={`#source-${id}`} aria-label={`Source ${id}`}>[{id}]</a>)}</span>
    {kind === 'agenda' && <details><summary>{lang === 'fr' ? 'Délais et fuseaux horaires' : 'Deadlines and time zones'}</summary><p>{notes[lang]}</p></details>}
  </figcaption>
</figure>
<style>
  @font-face{font-family:'l0g Nvidia Congress';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
  .nvidia-congress-figure{width:100%;max-width:37.5rem;margin:1.4rem auto 1.6rem;padding-bottom:1rem;container-type:inline-size}
  .art{width:100%;max-width:100%;margin-inline:auto;line-height:0}
  .mobile-art{display:none}
  .nvidia-congress-figure :global(svg){display:block;width:100%;height:auto;max-width:100%;letter-spacing:normal}
  figcaption{margin-top:.55rem;color:var(--color-muted);font-family:var(--font-read);font-size:.75rem;line-height:1.45;font-weight:400}
  .figure-number{display:inline;margin-right:.45rem;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;color:var(--color-signal)}
  .sources a{display:inline-block;margin-left:.3rem;text-underline-offset:.18em}
  a:focus-visible,summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:3px}
  details{margin:.2rem 0 0;font-size:.75rem;line-height:1.4}summary{cursor:pointer}details p{margin:.35rem 0 0}
  @container(max-width:568px){.desktop-art{display:none}.mobile-art{display:block;max-width:17.5rem}}
  @media print{.desktop-art{display:block;width:100%}.mobile-art{display:none}.nvidia-congress-figure{break-inside:avoid}}
</style>
