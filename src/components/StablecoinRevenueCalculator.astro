---
import { STABLECOIN_REVENUE_DEFAULTS, STABLECOIN_REVENUE_FIELDS, calculateStablecoinRevenue, formatStablecoinMoney } from '../lib/stablecoinRevenueCalculator.mjs';
import { STABLECOIN_REVENUE_OUTPUTS, stablecoinRevenueCopy, stablecoinRevenueOutputText } from '../lib/stablecoinRevenueCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = stablecoinRevenueCopy(lang), initial = calculateStablecoinRevenue(STABLECOIN_REVENUE_DEFAULTS), id = `stablecoin-revenue-${lang}`;
---
<section class="stablecoin-revenue-calculator" data-stablecoin-revenue-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="revenue-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p><p class="revenue-principal">{copy.principalLabel} : <strong data-principal>{formatStablecoinMoney(initial.principal, lang)}</strong></p></header>
  <details class="revenue-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="revenue-fields">{STABLECOIN_REVENUE_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode="decimal" maxlength="13" value={STABLECOIN_REVENUE_DEFAULTS[key as keyof typeof STABLECOIN_REVENUE_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p class="revenue-bounds" id={`${id}-bounds`}>{copy.bounds}</p><p class="revenue-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <dl class="revenue-results">{STABLECOIN_REVENUE_OUTPUTS.map((key, index) => <div><dt>{copy.labels[index]}</dt><dd><output data-output={key}>{stablecoinRevenueOutputText(key, initial[key as keyof typeof initial], lang)}</output></dd></div>)}</dl>
    <p class="revenue-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="revenue-method"><summary>{copy.method}</summary><p>{copy.scope}</p><p>{copy.threshold}</p><p>{copy.exclusions}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/stablecoinRevenueCalculatorUi.mjs';</script>
<style>
.stablecoin-revenue-calculator{box-sizing:border-box;width:100%;max-width:48rem;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.stablecoin-revenue-calculator *{box-sizing:border-box}.stablecoin-revenue-calculator .revenue-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em}.stablecoin-revenue-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.stablecoin-revenue-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted)}.stablecoin-revenue-calculator .revenue-principal{color:var(--color-paper)}.revenue-principal strong{color:var(--color-signal)}.stablecoin-revenue-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.revenue-controls,.revenue-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.stablecoin-revenue-calculator fieldset{margin:1rem 0;border:0;padding:0}.stablecoin-revenue-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.revenue-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.revenue-fields label{min-width:0;font-size:.9375rem;line-height:1.5}.revenue-fields span{display:block;margin-bottom:.35rem}.revenue-fields input{width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.revenue-fields [aria-invalid=true]{border-color:var(--color-accent)}.stablecoin-revenue-calculator button{margin-top:1rem;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;cursor:pointer}.stablecoin-revenue-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.stablecoin-revenue-calculator .revenue-error{color:var(--color-accent)}.revenue-results{margin:1.25rem 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.revenue-results>div{min-width:0;padding:.85rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.revenue-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.revenue-results dd{margin:.35rem 0 0;font:700 1.15rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.revenue-results>div:nth-child(6) output{color:var(--color-accent)}.revenue-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.revenue-fields,.revenue-results{grid-template-columns:minmax(0,1fr)}.stablecoin-revenue-calculator h3{font-size:1.2rem}}
</style>
