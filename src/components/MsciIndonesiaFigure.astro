---
import { msciIndonesiaSvg, MSCI_INDONESIA_KINDS } from '../lib/msciIndonesiaFigures.mjs';
interface Props {
  lang?: 'fr' | 'en';
  kind: 'ownership' | 'contraction' | 'selling' | 'transactions' | 'calendar';
  number: string;
  caption: string;
  sources: string;
}
const { lang = 'fr', kind, number, caption, sources } = Astro.props;
if (!/^(?:0[1-5])$/.test(number) || MSCI_INDONESIA_KINDS.indexOf(kind) + 1 !== Number(number) || !MSCI_INDONESIA_KINDS.includes(kind) || !['fr', 'en'].includes(lang)) {
  throw new TypeError('Invalid MSCI Indonesia figure variant');
}
const references = sources.trim() ? sources.trim().split(/\s+/) : [];
if (!references.length || new Set(references).size !== references.length || references.some(id => !/^(?:0[1-9]|1[0-9])$/.test(id))) {
  throw new TypeError('Invalid MSCI Indonesia source reference');
}
// Only these reviewed passive strings can reach set:html.
const responsiveSvg = (mobile: boolean) => msciIndonesiaSvg(lang, kind, mobile).replace(/^<svg /u, '<svg style="width:100%;height:auto" ');
---
<figure class="msci-indonesia-figure" id={`figure-${Number(number)}`} data-figure={number} data-kind={kind}>
  <div class="msci-indonesia-panel">
    <div class="msci-indonesia-desktop" set:html={responsiveSvg(false)} />
    <div class="msci-indonesia-mobile" set:html={responsiveSvg(true)} />
  </div>
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="msci-indonesia-references">{references.map(id => <a href={`#source-s${id}`}>[S{id}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  @font-face {
    font-family: 'l0g MSCI Indonesia';
    src: url('/fonts/stablecoins/dejavu-sans-400.ttf') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'l0g MSCI Indonesia';
    src: url('/fonts/stablecoins/dejavu-sans-700.ttf') format('truetype');
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }
  :global(article:has(.msci-indonesia-figure) > .post-head .post-title) {
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }
  .msci-indonesia-figure {
    margin: 2.5rem auto;
    width: 100%;
    max-width: 48rem;
    padding-bottom: 1rem;
    container-type: inline-size;
    overflow: visible;
  }
  .msci-indonesia-panel { width: 100%; }
  .msci-indonesia-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    letter-spacing: normal;
    overflow: visible;
  }
  .msci-indonesia-desktop { display: block; width: 100%; }
  .msci-indonesia-mobile { display: none; width: 100%; }
  figcaption { margin: 1rem 0 .65rem; color: var(--color-muted); font-size: .9rem; line-height: 1.7; }
  figcaption strong { margin-right: .45em; }
  .msci-indonesia-references { display: block; }
  .msci-indonesia-references a { margin-right: .75em; }
  .msci-indonesia-figure :global(details) { font-size: .875rem; line-height: 1.7; }
  .msci-indonesia-figure :global(summary) { cursor: pointer; padding: .35rem 0; }
  .msci-indonesia-figure :global(details p) { margin: .7rem 0; }
  .msci-indonesia-figure :global(summary:focus-visible) { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  @container (max-width: 480px) {
    .msci-indonesia-desktop { display: none; }
    .msci-indonesia-mobile { display: block; }
  }
  @media print {
    .msci-indonesia-figure { break-inside: avoid; }
    .msci-indonesia-desktop { display: block; }
    .msci-indonesia-mobile { display: none; }
  }
</style>
