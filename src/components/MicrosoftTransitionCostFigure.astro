---
import { microsoftTransitionCostSvg } from '../lib/microsoftTransitionCostFigures.mjs';

interface Props {
  lang?: 'fr' | 'en';
  kind: 'spending' | 'overlap';
  number: string;
  caption: string;
  sources: string;
}
const { lang = 'fr', kind, number, caption, sources } = Astro.props;
const references = sources.split(/\s+/).filter(Boolean);
if (!references.length || references.some((id) => !/^(?:[1-9]|[1-9]\d)$/.test(id))) {
  throw new Error('Invalid Microsoft-transition-cost figure source reference');
}
---
<figure class="microsoft-transition-cost-figure">
  <div class="microsoft-transition-cost-desktop" set:html={microsoftTransitionCostSvg(lang, kind, false)} />
  <div class="microsoft-transition-cost-mobile" set:html={microsoftTransitionCostSvg(lang, kind, true)} />
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="microsoft-transition-cost-refs">{references.map((id) => <a href={`#source-${id}`}>[{id}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .microsoft-transition-cost-figure { margin: 2.6rem 0; width: 100%; padding-bottom: .85rem; }
  .microsoft-transition-cost-figure :global(svg) {
    display: block; width: 100%; height: auto; max-width: 100%;
    border-radius: .8rem; letter-spacing: normal;
  }
  .microsoft-transition-cost-mobile { display: none; }
  figcaption { margin-top: .9rem; font-size: .875rem; line-height: 1.65; color: var(--color-muted); }
  figcaption strong { margin-right: .35em; }
  .microsoft-transition-cost-refs { display: block; }
  .microsoft-transition-cost-refs a { margin-right: .7em; }
  @media (max-width: 640px) {
    .microsoft-transition-cost-desktop { display: none; }
    .microsoft-transition-cost-mobile { display: block; }
  }
  @media print {
    .microsoft-transition-cost-figure { break-inside: avoid; }
    .microsoft-transition-cost-desktop { display: block; }
    .microsoft-transition-cost-mobile { display: none; }
  }
</style>
