---
import { BROADCOM_GUARANTEE_DEFAULTS, BROADCOM_GUARANTEE_LIMITS, BROADCOM_GUARANTEE_PRESETS, calculateBroadcomGuarantee, broadcomGuaranteeDisplay, broadcomGuaranteeEquation } from '../lib/broadcomGuaranteeModel.mjs';
import { broadcomGuaranteeCopy } from '../lib/broadcomGuaranteeUi.mjs';
interface Props { lang: 'fr' | 'en'; id?: string; }
const { lang, id = `broadcom-guarantee-${lang}` } = Astro.props;
if (!/^[a-z][a-z0-9-]{0,63}$/.test(id)) throw new RangeError('Controlled calculator id required');
const copy = broadcomGuaranteeCopy(lang), initial = calculateBroadcomGuarantee(BROADCOM_GUARANTEE_DEFAULTS);
const fields = ['lease', 'resale'] as const;
const primary = ['support', 'base'] as const;
const source = 'https://www.sec.gov/Archives/edgar/data/1730168/000119312526434271/d148323d8k.htm';
---
<section class="broadcom-guarantee-calculator" data-broadcom-guarantee-root data-broadcom-guarantee-lang={lang} data-valid="true" aria-labelledby={`${id}-title`}>
  <header><p class="broadcom-guarantee-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="broadcom-guarantee-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-error`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="broadcom-guarantee-inputs">{fields.map((field, index) => <label for={`${id}-${field}`}><span>{copy.labels[index]}</span><input id={`${id}-${field}`} name={field} type="number" min={BROADCOM_GUARANTEE_LIMITS.min} max={BROADCOM_GUARANTEE_LIMITS.max} step={BROADCOM_GUARANTEE_LIMITS.step} value={BROADCOM_GUARANTEE_DEFAULTS[field]} inputmode="decimal" required autocomplete="off" aria-describedby={`${id}-${field}-bounds ${id}-error`} /><small id={`${id}-${field}-bounds`}>{copy.bounds}</small></label>)}</div>
      <label class="broadcom-guarantee-check" for={`${id}-defaulted`}><input id={`${id}-defaulted`} name="defaulted" type="checkbox" checked={BROADCOM_GUARANTEE_DEFAULTS.defaulted} aria-describedby={`${id}-default-help`} /><span>{copy.defaultLabel}</span></label><p id={`${id}-default-help`}>{copy.defaultHelp}</p>
      <p>{copy.presetLabel}</p><div class="broadcom-guarantee-presets">{BROADCOM_GUARANTEE_PRESETS.map((value, index) => <button type="button" data-broadcom-guarantee-preset={value}>{copy.presets[index]}</button>)}</div><button type="reset">{copy.reset}</button>
    </fieldset><p class="broadcom-guarantee-error" id={`${id}-error`} data-error role="alert" hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
  </details>
  <p class="broadcom-guarantee-scenario" data-scenario>{copy.initial}</p>
  <dl class="broadcom-guarantee-results">{primary.map((field, index) => <div><dt>{copy.resultLabels[index]}</dt><dd><output data-broadcom-guarantee-result={field} aria-live="off">{broadcomGuaranteeDisplay(initial, field, lang)}</output> <small>{copy.unit}</small></dd></div>)}</dl>
  <p class="broadcom-guarantee-classification" data-broadcom-guarantee-status>{copy.statuses[initial.status]}</p><p class="broadcom-guarantee-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <p>{copy.equationLabel}</p><p class="broadcom-guarantee-formula"><output data-broadcom-guarantee-equation>{broadcomGuaranteeEquation(initial, lang)}</output></p>
  <details class="broadcom-guarantee-method"><summary>{copy.method}</summary><p>{copy.methodText}</p><p>{copy.limits}</p><p>{copy.privacy}</p><p><a href={source}>{copy.source}</a></p></details>
</section>
<script>import '../lib/broadcomGuaranteeUi.mjs';</script>
<style>
  .broadcom-guarantee-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:clamp(.875rem,3vw,1.25rem);border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.broadcom-guarantee-calculator *{box-sizing:border-box}.broadcom-guarantee-calculator header,.broadcom-guarantee-calculator details,.broadcom-guarantee-calculator form,.broadcom-guarantee-calculator fieldset{min-width:0}.broadcom-guarantee-calculator .broadcom-guarantee-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.broadcom-guarantee-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.broadcom-guarantee-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.broadcom-guarantee-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.broadcom-guarantee-calculator details{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.broadcom-guarantee-calculator fieldset{margin:1rem 0;border:0;padding:0}.broadcom-guarantee-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.broadcom-guarantee-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.broadcom-guarantee-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.broadcom-guarantee-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;margin-top:.4rem;padding:.5rem .6rem;border:1px solid var(--color-line-strong);border-radius:.3rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-variant-numeric:tabular-nums}.broadcom-guarantee-inputs small{display:block;color:var(--color-muted);font-size:.8125rem;line-height:1.6;margin-top:.3rem}.broadcom-guarantee-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.broadcom-guarantee-calculator button{max-width:100%;min-height:2.75rem;margin-top:.5rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.broadcom-guarantee-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.broadcom-guarantee-calculator .broadcom-guarantee-error{color:var(--color-accent)}.broadcom-guarantee-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.broadcom-guarantee-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.broadcom-guarantee-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.broadcom-guarantee-results dd{margin:.25rem 0 0;font:700 1.25rem/1.5 var(--font-mono);color:var(--color-signal);overflow-wrap:anywhere}.broadcom-guarantee-results small{font-size:.8125rem;font-weight:400;color:var(--color-muted)}.broadcom-guarantee-calculator .broadcom-guarantee-formula{font-family:var(--font-mono);font-variant-numeric:tabular-nums;color:var(--color-paper);overflow-wrap:anywhere}.broadcom-guarantee-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.broadcom-guarantee-presets{display:flex;flex-wrap:wrap;gap:.5rem}.broadcom-guarantee-check{display:flex;align-items:flex-start;gap:.7rem;min-height:2.75rem;margin-top:1.4rem;font-size:.9375rem;line-height:1.6}.broadcom-guarantee-check input{flex:none;width:1.25rem;height:1.25rem;margin:.2rem 0 0;accent-color:var(--color-signal)}.broadcom-guarantee-calculator .broadcom-guarantee-classification{color:var(--color-paper);font-weight:700}@container(max-width:420px){.broadcom-guarantee-inputs,.broadcom-guarantee-results{grid-template-columns:minmax(0,1fr)}.broadcom-guarantee-calculator h3{font-size:1.2rem}}
</style>
