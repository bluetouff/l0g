} as const;
const info={
 mint:{number:'01',sources:['b04','r03'],method:'#methode-bilans',fr:'Le dépôt passe du client à l’émetteur',en:'The deposit moves from customer to issuer'},
 funding:{number:'02',sources:[],method:'#methode-financement',fr:'La rétention rémunère tout l’encours',en:'Retention reprices the entire deposit stock'},
 counterparties:{number:'03',sources:['r03','m05'],method:'#methode-bilans',fr:'Trois contreparties, trois règlements',en:'Three counterparties, three settlements'},
}as const;
if((lang!=='fr'&&lang!=='en')||!Object.prototype.hasOwnProperty.call(info,kind))throw new TypeError('Unknown StablecoinDepositFigure variant');
const entry=info[kind],scene=art[lang][kind],figureNumber=number??entry.number,sourceIds=sources??entry.sources;
if(!/^\d{2}$/.test(figureNumber)||!sourceIds.every(id=>/^(?:b04|r03|m05)$/.test(id)))throw new TypeError('Invalid figure metadata');
const captions={
 mint:{fr:'Émission primaire fictive de 100 jetons à un dollar. Le règlement redistribue les dépôts et les réserves à la Fed entre deux banques du même système américain.',en:'Fictional primary issuance of 100 one-dollar tokens. Settlement redistributes deposits and Fed reserve balances between two banks in the same US system.'},
 funding:{fr:'Calcul entièrement fictif sur un an. Une hausse générale de 10 points de base sur 1 milliard coûte 1 million de dollars. Remplacer 100 millions coûte le même montant lorsque le surcoût atteint 100 points de base.',en:'Entirely fictional one-year calculation. A 10 basis-point general rise on 1 billion costs 1 million dollars. Replacing 100 million has the same cost at an incremental spread of 100 basis points.'},
 counterparties:{fr:'Trois circuits comptables fictifs de 100 dollars. Les variations sont celles du secteur bancaire américain par rapport au stock initial. Le versement public constitue une étape ultérieure hypothétique.',en:'Three fictional 100 dollar accounting paths. Changes refer to the US banking sector relative to the initial stock. The fiscal payment is a hypothetical later step.'},
}as const;
const methods={
 mint:{fr:'L’acheteur éligible paie 100 dollars depuis son compte à la banque A. L’émetteur non bancaire reçoit un dépôt à la banque B et crée 100 jetons àparité, sans frais. Les réserves de règlement à la Fed passent de A vers B. Au niveau du secteur, les deux mouvements se compensent. Les réserves du stablecoin désignent ici le dépôt détenu par l’émetteur ; elles diffèrent des réserves des banques à la Fed.',en:'An eligible buyer pays 100 dollars from a deposit at bank A. The nonbank issuer receives a deposit at bank B and creates 100 par-value tokens without fees. Fed settlement reserves move from A to B; the sector-wide movements offset. The stablecoin reserve here is the issuer’s deposit, a different claim from banks’ reserve balances at the Fed.'},
 funding:{fr:'Coût annuel de la hausse générale =1 milliard ×10/10000 =1 million de dollars. Surcoût annuel du remplacement =100 millions × surcoût en points de base /10000. La droite interpole cette identité arithmétique de 0 à 200 points de base ; la ligne de rétention fixe la hausse générale à 10 points de base. L’exemple suppose des encours constants, la rétention des 100 millions, un remplacement disponible et les autres coûts inchangés. L’efficacité commerciale reste une hypothèse, et aucune observation de taux ou de fuite n’est projetée.',en:'Annual cost of the general rise =1 billion ×10/10000 =1 million dollars. Annual incremental replacement cost =100 million × incremental spread in basis points /10000. The straight line interpolates this arithmetic identity from 0 to 200 basis points; the retention line holds the general rise at 10 basis points. Balances are constant, retention of the 100 million is assumed, replacement is available and other costs are unchanged. Commercial effectiveness remains an assumption; no observed rate or outflow is projected.'},
 counterparties:{fr:'L’émetteur emploie son dépôt de 100 dollars après l’émission de jetons. Un vendeur non bancaire reçoit un nouveau dépôt : le total est conservé. Une banque vendant ses propres titres réduit titres et dépôts de 100 au niveau du secteur, avec réserves agrégées et prêts inchangés à cet instant. Une souscription au Trésor crédite le TGA à la Fed et diminue dépôts et réserves de 100. Le versement ultérieur des mêmes 100 dollars vers un compte de bénéficiaire non bancaire rétablit le stock initial de l’exemple ; il ne démontre aucune égalité avec un contrefactuel où des banques auraient initialement financé la dette. Frais, valorisations et compensations de la Fed sont tenus constants.',en:'After token issuance, the issuer invests its 100 dollar deposit. A nonbank seller receives a deposit, preserving the aggregate. A bank selling its own security reduces sector securities and deposits by 100, leaving aggregate reserves and outstanding loans unchanged at that instant. A new Treasury purchase credits the TGA at the Fed and reduces deposits and reserves by 100. Paying the same 100 dollars later to a nonbank recipient’s account restores the example’s initial stock; it does not establish equality with a counterfactual in which banks initially financed the debt. Fees, valuation changes and offsetting Fed operations are held constant.'},
}as const;
---
<figure class="stablecoin-deposit-figure" id={`figure-${figureNumber}`} data-kind={kind}>
 <div class="desktop-art" set:html={scene.desktop}></div>
 <div class="mobile-art" set:html={scene.mobile}></div>
 <figcaption><span class="figure-number">FIGURE {figureNumber}</span><strong>{entry[lang]}</strong>{caption??captions[kind][lang]} {sourceIds.map(id=><a href={`#source-${id}`} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}<a href={entry.method}>{lang==='fr'?'Calculs et hypothèses':'Calculations and assumptions'}</a></figcaption>
 <details><summary>{lang==='fr'?'Méthode et périmètre':'Method and scope'}</summary><div class="method">{methods[kind][lang]}<slot/></div></details>
</figure>
<style>
 @font-face{font-family:'l0g Stablecoin Deposits';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
 .stablecoin-deposit-figure{width:100%;max-width:800px;margin:2.8rem auto;padding-bottom:1rem;container-type:inline-size;overflow:visible}
 .desktop-art,.mobile-art{width:100%;line-height:0}.mobile-art{display:none;max-width:340px;margin-inline:auto}
 .stablecoin-deposit-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
 figcaption{padding:.85rem 0 .45rem;font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted)}
 figcaption strong{display:block;margin:.25rem 0;font-size:1rem;font-weight:400;color:var(--color-paper)}
 .figure-number{font-size:.75rem;letter-spacing:.12em;color:var(--color-signal)}a{margin-right:.45rem}
 details{margin-top:.35rem;font-family:var(--font-read);font-size:.875rem;line-height:1.7}summary{cursor:pointer;padding:.35rem 0}summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.method{margin-top:.5rem;color:var(--color-muted)}
 @container (max-width:660px){.desktop-art{display:none}.mobile-art{display:block}}
 @media print{.desktop-art{display:block}.mobile-art{display:none}.stablecoin-deposit-figure{break-inside:avoid}}
</style>
