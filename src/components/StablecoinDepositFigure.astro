ignal)\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<rect x=\"157\" y=\"344\" width=\"78\" height=\"40\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"stablecoin-counterparties-en-m-region-16\" data-label-region=\"true\"/>\n<text x=\"196\" y=\"371\" fill=\"var(--color-signal)\" font-family=\"l0g Stablecoin Deposits\" font-size=\"18\" font-weight=\"400\" text-anchor=\"middle\" data-panel=\"stablecoin-counterparties-en-m-region-16\">$100</text>\n<line x1=\"226\" y1=\"438\" x2=\"166\" y2=\"438\" stroke=\"var(--color-amber)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n<path d=\"M173 433 L166 438 L173 443\" stroke=\"var(--color-amber)\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<rect x=\"153\" y=\"439\" width=\"86\" height=\"40\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"stablecoin-counterparties-en-m-region-17\" data-label-region=\"true\"/>\n<text x=\"196\" y=\"466\" fill=\"var(--color-amber)\" font-family=\"l0g Stablecoin Deposits\" font-size=\"18\" font-weight=\"400\" text-anchor=\"middle\" data-panel=\"stablecoin-counterparties-en-m-region-17\">Bond</text>\n<rect x=\"8\" y=\"475.5\" width=\"384\" height=\"32.4\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"stablecoin-counterparties-en-m-region-18\" data-label-region=\"true\"/>\n<text x=\"24\" y=\"498\" fill=\"var(--color-accent)\" font-family=\"l0g Stablecoin Deposits\" font-size=\"18\" font-weight=\"400\" text-anchor=\"start\" data-panel=\"stablecoin-counterparties-en-m-region-18\" data-metric=\"aggregate-outcome\" data-case=\"2\" data-deposits=\"-100\" data-reserves=\"0\">Δ deposits: −$100 · Δ reserves: $0</text>\n<line x1=\"24\" y1=\"519\" x2=\"376\" y2=\"519\" stroke=\"var(--color-line-strong)\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n<rect x=\"8\" y=\"524.5\" width=\"384\" height=\"39.6\" fill=\"none\" stroke=\"none\" rx=\"0\" id=\"stablecoin-counterparties-en-m-region-19\" data-label-region=\"true\"/>\n<te