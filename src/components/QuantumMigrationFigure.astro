---
import { quantumMigrationSvg } from '../lib/quantumMigrationFigures.mjs';

interface Props {
  lang?: 'fr' | 'en';
  kind: 'threat' | 'size' | 'migration';
  number: string;
  caption: string;
  sources: string;
}
const { lang = 'fr', kind, number, caption, sources } = Astro.props;
const references = sources.split(/\s+/).filter(Boolean);
if (!references.length || references.some((id) => !/^(?:[1-9]|[1-9]\d)$/.test(id))) {
  throw new Error('Invalid quantum-migration figure source reference');
}
---
<figure class="quantum-migration-figure">
  <div class="quantum-migration-desktop" set:html={quantumMigrationSvg(lang, kind, false)} />
  <div class="quantum-migration-mobile" set:html={quantumMigrationSvg(lang, kind, true)} />
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="quantum-migration-refs">{references.map((id) => <a href={`#source-${id}`}>[{id}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .quantum-migration-figure {
    margin: 2.6rem 0;
    width: 100%;
    padding-bottom: .85rem;
  }
  .quantum-migration-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    border-radius: .8rem;
    letter-spacing: normal;
  }
  .quantum-migration-mobile { display: none; }
  figcaption {
    margin-top: .9rem;
    font-size: .875rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  figcaption strong { margin-right: .35em; }
  .quantum-migration-refs { display: block; }
  .quantum-migration-refs a { margin-right: .7em; }
  @media (max-width: 640px) {
    .quantum-migration-desktop { display: none; }
    .quantum-migration-mobile { display: block; }
  }
  @media print {
    .quantum-migration-figure { break-inside: avoid; }
    .quantum-migration-desktop { display: block; }
    .quantum-migration-mobile { display: none; }
  }
</style>
