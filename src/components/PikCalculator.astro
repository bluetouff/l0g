---
import { PIK_DEFAULTS, PIK_LIMITS, calculatePik, formatPikNumber } from '../lib/pikModel.mjs';
import { pikCopy, pikDisplay } from '../lib/pikCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = pikCopy(lang), initial = calculatePik(PIK_DEFAULTS), id = `pik-${lang}`;
const fields = ['principal','rate','years','cashShare','ebitda','multiple'] as const;
const outputs = ['debt','cashTotal','gap','requiredEbitda'] as const;
---
<section class="pik-calculator" data-pik-root data-pik-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="pik-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="pik-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-error`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="pik-inputs">{fields.map((field,index) => <label for={`${id}-${field}`}><span>{copy.labels[index]}</span><input id={`${id}-${field}`} name={field} type="number" min={PIK_LIMITS[field][0]} max={PIK_LIMITS[field][1]} step={PIK_LIMITS[field][2] === 0 ? '1' : '0.1'} value={PIK_DEFAULTS[field]} inputmode={PIK_LIMITS[field][2] === 0 ? 'numeric' : 'decimal'} required autocomplete="off" aria-describedby={`${id}-${field}-bounds ${id}-error`} /><small id={`${id}-${field}-bounds`}>{copy.bounds[index]}</small></label>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p class="pik-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
  </details>
  <dl class="pik-results">{outputs.map((field,index) => <div><dt>{copy.resultLabels[index]}</dt><dd><output data-pik-result={field} aria-live="off">{pikDisplay(initial,field,lang)}</output> <small>{copy.unit}</small></dd></div>)}</dl>
  <p class="pik-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="pik-annual"><summary>{copy.table}</summary><div class="pik-table-scroll" tabindex="0" role="region" aria-label={copy.tableLabel}><table><caption>{copy.tableLabel}</caption><thead><tr>{copy.columns.map(label => <th scope="col">{label}</th>)}</tr></thead><tbody>{initial.annual.map(row => <tr><th scope="row">{row.year}</th><td>{formatPikNumber(row.opening,lang)}</td><td>{formatPikNumber(row.cash,lang)}</td><td>{formatPikNumber(row.pik,lang)}</td><td>{formatPikNumber(row.debt,lang)}</td></tr>)}</tbody></table></div></details>
  <details class="pik-method"><summary>{copy.method}</summary><p>{copy.formula}</p><p>{copy.limits}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
</section>
<script>import '../lib/pikCalculatorUi.mjs';</script>
<style>
  .pik-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.pik-calculator *{box-sizing:border-box}.pik-calculator header,.pik-calculator details,.pik-calculator form,.pik-calculator fieldset{min-width:0}.pik-calculator .pik-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.pik-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.pik-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.pik-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.pik-calculator details{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.pik-calculator fieldset{margin:1rem 0;border:0;padding:0}.pik-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.pik-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.pik-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.pik-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;margin-top:.4rem;padding:.5rem .6rem;border:1px solid var(--color-line-strong);border-radius:.3rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-variant-numeric:tabular-nums}.pik-inputs small{display:block;color:var(--color-muted);font-size:.8125rem;line-height:1.6;margin-top:.3rem}.pik-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.pik-calculator button{min-height:2.75rem;margin-top:1rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer}.pik-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.pik-calculator .pik-error{color:var(--color-accent)}.pik-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.pik-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.pik-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.pik-results dd{margin:.25rem 0 0;font:700 1.125rem/1.5 var(--font-mono);color:var(--color-signal);overflow-wrap:anywhere}.pik-results small{font-size:.8125rem;font-weight:400;color:var(--color-muted)}.pik-table-scroll{overflow-x:auto;max-width:100%;margin:.75rem 0;overscroll-behavior-inline:contain}.pik-calculator table{display:table;overflow:visible;width:100%;border-collapse:collapse;font:400 .8125rem/1.6 var(--font-mono);font-variant-numeric:tabular-nums}.pik-calculator caption{padding:.5rem 0;text-align:left;color:var(--color-muted)}.pik-calculator th,.pik-calculator td{padding:.55rem .65rem;border-bottom:1px solid var(--color-line-strong);text-align:right;white-space:nowrap}.pik-calculator th:first-child{text-align:left}.pik-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:420px){.pik-inputs,.pik-results{grid-template-columns:minmax(0,1fr)}.pik-calculator h3{font-size:1.2rem}}
</style>
