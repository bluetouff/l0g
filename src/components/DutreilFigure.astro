---
import { dutreilSvg, validateDutreilFigure } from '../lib/dutreilFigures.mjs';

interface Props {
  lang?: 'fr' | 'en';
  kind: 'concentration' | 'tax' | 'cost' | 'fbo' | 'timeline' | 'reform';
  number: string;
  caption: string;
  sources: string;
}
const { lang, kind, number, caption, references } = validateDutreilFigure(Astro.props);
---
<figure class="dutreil-figure" id={`dutreil-figure-${number}`} data-figure={number} data-kind={kind}>
  <div class="dutreil-desktop" set:html={dutreilSvg(lang, kind, false)} />
  <div class="dutreil-mobile" set:html={dutreilSvg(lang, kind, true)} />
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="dutreil-refs">{references.map((id) => <a href={`#source-${id}`}>[{id}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .dutreil-figure { margin: 2.6rem 0; width: 100%; padding-bottom: .85rem; container-type: inline-size; }
  .dutreil-figure :global(svg) {
    display: block; width: 100%; height: auto; max-width: 100%;
    border-radius: .8rem; letter-spacing: normal;
  }
  .dutreil-mobile { display: none; }
  figcaption { margin-top: .9rem; font-size: .875rem; line-height: 1.65; color: var(--color-muted); }
  figcaption strong { margin-right: .35em; }
  .dutreil-refs { display: block; }
  .dutreil-refs a { margin-right: .7em; }
  .dutreil-figure :global(details) { margin-top: .65rem; font-size: .85rem; line-height: 1.65; }
  .dutreil-figure :global(summary) { cursor: pointer; color: var(--color-muted); }
  @media (max-width: 640px) {
    .dutreil-desktop { display: none; }
    .dutreil-mobile { display: block; }
  }
  @container (max-width: 640px) {
    .dutreil-desktop { display: none; }
    .dutreil-mobile { display: block; }
  }
  @media print {
    .dutreil-figure { break-inside: avoid; }
    .dutreil-desktop { display: block; }
    .dutreil-mobile { display: none; }
  }
</style>
