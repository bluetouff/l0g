          marketLine2: 'Actifs et services exploités par le marché',
          euroTitle: 'REGISTRE EUROSYSTÈME',
          euroLine1: 'Finalité cash directement sur la DLT',
          euroLine2: 'Smart contracts et programmabilité',
          euroLine3: '24/7 · résilience renforcée · multidevise',
