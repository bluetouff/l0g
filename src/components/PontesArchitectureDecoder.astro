---

<section class="pontes-decoder" id={id} data-pontes-decoder data-lang={lang}>
  <header class="pontes-decoder__header">
    <p>{copy.eyebrow}</p>
    <h3>{copy.title}</h3>
    <span>{copy.intro}</span>
  </header>

  <div class="pontes-decoder__tabs" role="tablist" aria-label={copy.title}>
    <button
      type="button"
      role="tab"
      id={`${id}-tab-launch`}
      aria-controls={`${id}-panel-launch`}
      aria-selected="true"
      tabindex="0"
      data-stage="launch"
    >
      <span>{copy.labels.documented}</span>
      {copy.tabs.launch}
    </button>
    <button
      type="button"
      role="tab"
      id={`${id}-tab-target`}
      aria-controls={`${id}-panel-target`}
      aria-selected="false"
      tabindex="-1"
      data-stage="target"
