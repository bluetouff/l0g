          heading: 'PONTES AT INITIAL LAUNCH',
          marketTitle: 'MARKET DLT · ASSET LEG',
          marketLine1: 'Bond, tokenised deposit or another eligible asset',
          marketLine2: 'Ledger run by an eligible market operator',
          hashTitle: 'HASH-LINK · SYNCHRONISATION',
          hashLine1: 'The two ledgers remain separate',
