<script>
  const initialisePontesDecoders = () => {
    document.querySelectorAll<HTMLElement>('[data-pontes-decoder]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));

      const activate = (stage: string, focus = false) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.stage === stage;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && focus) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== stage;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab.dataset.stage ?? 'launch'));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let next = index;
          if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = tabs.length - 1;
          activate(tabs[next]?.dataset.stage ?? 'launch', true);
        });
      });
    });
  };

  initialisePontesDecoders();
