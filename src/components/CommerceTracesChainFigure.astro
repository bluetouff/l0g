<text x="52" y="302" font-size="25" fill="#b8c8db" font-weight="400" text-anchor="start">Rôle prévu, client non identifié</text>
<rect x="28" y="402" width="504" height="108" fill="#181d25"/>
<text x="52" y="445" font-size="28" fill="#f0f4fa" font-weight="700" text-anchor="start">Experian</text>
