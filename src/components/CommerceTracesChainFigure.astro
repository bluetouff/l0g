<rect x="0" y="0" width="560" height="1058" fill="#0c0e10"/>
<text x="28" y="49" font-size="34" fill="#f0f4fa" font-weight="700" text-anchor="start">Rendre une audience</text>
<text x="28" y="90" font-size="34" fill="#f0f4fa" font-weight="700" text-anchor="start">utilisable ailleurs</text>
<text x="28" y="135" font-size="26" fill="#b8c8db" font-weight="400" text-anchor="start">Offre Experian / LiveRamp</text>
<text x="28" y="171" font-size="25" fill="#b8c8db" font-weight="400" text-anchor="start">Conditions de décembre 2024</text>
