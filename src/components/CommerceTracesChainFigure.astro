<text x="52" y="617" font-size="28" fill="#f0f4fa" font-weight="700" text-anchor="start">LiveRamp UK</text>
<text x="52" y="656" font-size="25" fill="#b8c8db" font-weight="400" text-anchor="start">Distribue l’audience</text>
<rect x="28" y="752" width="504" height="135" fill="#181d25"/>
