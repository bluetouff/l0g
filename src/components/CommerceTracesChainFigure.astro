<text x="62" y="303" font-size="21" fill="#b8c8db" font-weight="400" text-anchor="start">Distributes the audience</text>
<line x1="32" y1="269" x2="32" y2="339" stroke="#72e5df" stroke-width="1.5" stroke-dasharray="4 4"/><polyline points="28,333 32,339 36,333" fill="none" stroke="#72e5df" stroke-width="1.5" stroke-linejoin="round"/>
