<text x="52" y="834" font-size="25" fill="#b8c8db" font-weight="400" text-anchor="start">Choisie par le client</text>
<text x="52" y="866" font-size="25" fill="#b8c8db" font-weight="400" text-anchor="start">Sous ses propres conditions</text>
<line x1="280" y1="335" x2="280" y2="390" stroke="#6ee7df" stroke-width="3" stroke-dasharray="8 6"/><polyline points="273,380 280,390 287,380" fill="none" stroke="#6ee7df" stroke-width="3" stroke-linejoin="round"/>
