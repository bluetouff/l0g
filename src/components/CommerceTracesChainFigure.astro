<text x="50" y="282" font-size="28" fill="#f0f4fa" font-weight="700" text-anchor="start">Experian</text>
<text x="355" y="282" font-size="28" fill="#f0f4fa" font-weight="700" text-anchor="start">LiveRamp</text>
<line x1="192" y1="273" x2="336" y2="273" stroke="#6ee7df" stroke-width="3" stroke-dasharray="8 6"/><polyline points="326,266 336,273 326,280" fill="none" stroke="#6ee7df" stroke-width="3" stroke-linejoin="round"/>
