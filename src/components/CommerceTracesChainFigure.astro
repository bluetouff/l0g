<line x1="280" y1="515" x2="280" y2="562" stroke="#6ee7df" stroke-width="3" stroke-dasharray="8 6"/><polyline points="273,552 280,562 287,552" fill="none" stroke="#6ee7df" stroke-width="3" stroke-linejoin="round"/>
<text x="302" y="545.0" font-size="24" fill="#6ee7df" font-weight="400" text-anchor="start">clause 11</text>
<line x1="280" y1="687" x2="280" y2="740" stroke="#b8c8db" stroke-width="3" stroke-dasharray="8 6"/><polyline points="273,730 280,740 287,730" fill="none" stroke="#b8c8db" stroke-width="3" stroke-linejoin="round"/>
<text x="302" y="720.0" font-size="24" fill="#b8c8db" font-weight="400" text-anchor="start">distribution</text>
