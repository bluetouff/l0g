---
import {
  configuredSupportPaymentLinkCount,
  supportPaymentLinks,
} from '../config/support-payment-links.mjs';

interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const en = lang === 'en';
const paymentLinksReady = configuredSupportPaymentLinkCount === 4;
const monthlyOptions = [
  { amount: en ? '€5' : '5 €', href: supportPaymentLinks.monthly5 },
  { amount: en ? '€10' : '10 €', href: supportPaymentLinks.monthly10 },
  { amount: en ? '€25' : '25 €', href: supportPaymentLinks.monthly25 },
];
const purposes = en ? [
  ['Time to investigate', 'Read original documents, cross-check claims and explain how systems work.'],
  ['Tools kept open', 'Maintain public data, visual explanations and analysis tools.'],
  ['Publications that last', 'Keep documented investigations available and easy to find.'],
] : [
  ['Le temps de l’enquête', 'Lire les documents d’origine, recouper les faits et expliquer les mécanismes.'],
  ['Les outils en accès libre', 'Entretenir les visualisations, les données publiques et les outils d’analyse.'],
  ['Des publications qui durent', 'Conserver des enquêtes documentées et les rendre faciles à retrouver.'],
];
const trust = en ? [
  ['Editorial independence', 'A contribution gives no control over topics, sources, methods or conclusions.'],
  ['Public access', 'No public article, dataset or analysis tool is reserved for contributors.'],
  ['Voluntary contribution', 'l0g is operated as a French sole proprietorship. The contribution is not presented as a charitable donation and no tax-deduction receipt is issued.'],
  ['Your privacy', 'Contributor names are not published, and no contributor list is sold or used for commercial targeting.'],
] : [
  ['Indépendance éditoriale', 'Une contribution ne donne aucun droit de regard sur les sujets, les sources ou les conclusions.'],
  ['Accès public', 'Aucun contenu, donnée ou outil public n’est réservé aux contributeurs.'],
  ['Cadre fiscal', 'l0g est exploité en entreprise individuelle. Le soutien n’ouvre droit à aucune réduction d’impôt.'],
  ['Votre vie privée', 'Aucun nom de contributeur n’est publié et aucune liste n’est cédée ou utilisée à des fins commerciales.'],
];
---

<div class="support-experience">
  <section class="support-stage" aria-labelledby="support-title">
    <div class="support-intro">
      <p class="support-eyebrow"><span aria-hidden="true">♡</span> {en ? 'reader supported' : 'porté par ses lecteurs'}</p>
      <h1 id="support-title">{en ? 'Keep independent' : 'Faites durer'} <span>{en ? 'analysis going.' : 'les enquêtes.'}</span></h1>
      <p class="support-lede">{en
        ? 'Behind every investigation are sources to read and claims to check. Your contribution helps make room for that work and keeps it open to everyone.'
        : 'Chaque enquête demande du temps pour lire les sources et vérifier les faits. Votre soutien aide à poursuivre ce travail en accès libre.'}</p>
      <div class="support-circuit" aria-hidden="true">
        <span>{en ? 'you' : 'vous'}</span><i></i><b>l<span class="brand-0">0</span>g<span class="brand-cursor">_</span></b><i></i><span>{en ? 'open access' : 'accès libre'}</span>
      </div>
      <p class="support-open">{en ? 'The analysis stays independent. Access stays public.' : 'L’analyse reste indépendante. L’accès reste public.'}</p>
    </div>

    <section class="support-ticket" aria-labelledby="support-choice">
      <header class="ticket-header">
        <div>
          <p class="support-eyebrow">{en ? 'support l0g' : 'soutenir l0g'}</p>
          <h2 id="support-choice">{en ? 'Your support. Your pace.' : 'À votre rythme.'}</h2>
        </div>
        <span class="ticket-heart" aria-hidden="true">♡</span>
      </header>

      {!paymentLinksReady && <p class="setup-note" role="status">{en
        ? 'The Stripe payment links are not active. No payment can be initiated from this page.'
        : 'Les liens de paiement Stripe ne sont pas encore activés. Aucun paiement ne peut être envoyé depuis cette page pour le moment.'}</p>}

      {paymentLinksReady && supportPaymentLinks.oneTime ? (
        <a class="payment-link payment-once" href={supportPaymentLinks.oneTime} rel="external nofollow" aria-describedby="payment-note">
          <span class="payment-caption">{en ? 'One-time contribution' : 'Un soutien ponctuel'}</span>
          <strong>{en ? 'Any amount' : 'Montant libre'}</strong>
          <span class="payment-action">{en ? 'Choose an amount' : 'Choisir mon montant'} <span aria-hidden="true">↗</span></span>
        </a>
      ) : (
        <span class="payment-link payment-once is-disabled" aria-disabled="true">{en ? 'One-time support: coming soon' : 'Soutien ponctuel : bientôt disponible'}</span>
      )}

      <div class="monthly-heading">
        <h3>{en ? 'Or every month' : 'Ou chaque mois'}</h3>
        <span>{en ? 'Cancel anytime' : 'Arrêt à tout moment'}</span>
      </div>
      <div class="monthly-choices">
        {monthlyOptions.map((option) => paymentLinksReady && option.href ? (
          <a class="payment-link payment-monthly" href={option.href} rel="external nofollow" aria-describedby="payment-note">
            <strong>{option.amount}</strong>
            <span>{en ? '/ month' : '/ mois'}</span>
            <span class="monthly-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="payment-link payment-monthly is-disabled" aria-disabled="true"><strong>{option.amount}</strong><span>{en ? 'Coming soon' : 'Bientôt'}</span></span>
        ))}
      </div>
      <p class="payment-note" id="payment-note"><span aria-hidden="true">↗</span> {en ? 'Secure payment on Stripe, after your click.' : 'Paiement sécurisé sur Stripe, après votre clic.'}</p>
      <div class="ticket-footer"><span>{en ? 'Voluntary contribution' : 'Contribution volontaire'}</span><span>{en ? 'No private access' : 'Sans contrepartie'}</span></div>
    </section>
  </section>

  <section class="support-purpose" aria-labelledby="support-purpose-title">
    <p class="support-eyebrow">{en ? 'behind the pages' : 'derrière les pages'}</p>
    <h2 id="support-purpose-title">{en ? 'Give the work room to continue.' : 'Donner du temps au travail de fond.'}</h2>
    <div class="purpose-items">
      {purposes.map(([heading, detail], index) => <article><span aria-hidden="true">0{index + 1}</span><h3>{heading}</h3><p>{detail}</p></article>)}
    </div>
  </section>

  <section class="support-trust" aria-labelledby="support-contract">
    <p class="support-eyebrow">{en ? 'our commitment' : 'notre engagement'}</p>
    <h2 id="support-contract">{en ? 'Independence, at every step.' : 'L’indépendance, à chaque étape.'}</h2>
    <div class="trust-grid">
      {trust.map(([heading, detail], index) => <article><span class="trust-index" aria-hidden="true">0{index + 1}</span><h3>{heading}</h3><p>{detail}</p></article>)}
    </div>
  </section>

  <section class="stripe-boundary" id="stripe-boundary" aria-labelledby="stripe-title">
    <div><p class="support-eyebrow">{en ? 'before leaving l0g' : 'avant de quitter l0g'}</p><h2 id="stripe-title">{en ? 'Your payment, in clear terms.' : 'Votre paiement, en toute clarté.'}</h2></div>
    <div class="boundary-copy">
      {en ? <>
        <p>Active buttons open an official Stripe payment domain: <strong>donate.stripe.com</strong> or <strong>buy.stripe.com</strong>. No Stripe script, pixel, form or cookie is loaded on l0g before you click.</p>
        <p>Stripe then processes the information required for payment under its own privacy policy. l0g receives only the transaction information needed to track the contribution and meet its accounting obligations.</p>
        <p>Monthly support can be stopped through Stripe’s management tools or by writing to <a href="mailto:olivier@l0g.fr">olivier@l0g.fr</a>.</p>
      </> : <>
        <p>Les boutons actifs ouvrent un domaine de paiement Stripe officiel : <strong>donate.stripe.com</strong> ou <strong>buy.stripe.com</strong>. Aucun script, pixel, formulaire ou cookie Stripe n’est chargé sur cette page avant votre clic.</p>
        <p>Stripe traite ensuite les informations nécessaires au paiement selon sa propre politique de confidentialité. l0g reçoit uniquement les informations de transaction nécessaires au suivi du soutien et à ses obligations comptables.</p>
        <p>Un soutien mensuel peut être arrêté depuis les outils de gestion Stripe ou en écrivant à <a href="mailto:olivier@l0g.fr">olivier@l0g.fr</a>.</p>
      </>}
      <div class="boundary-links">
        <a href="/rgpd/">{en ? 'l0g privacy notice in French' : 'Confidentialité l0g'}</a>
        <a href={en ? 'https://stripe.com/privacy' : 'https://stripe.com/fr/privacy'} rel="external nofollow noopener" target="_blank">{en ? 'Stripe privacy policy' : 'Confidentialité Stripe'} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</div>

<style>
  .support-experience { --page-title-size: clamp(2rem, 3.4vw, 2.75rem); width: min(100%, 66rem); margin-inline: auto; }
  .support-stage {
    position: relative; isolation: isolate; overflow: hidden; display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .98fr); align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem); padding: clamp(1.1rem, 3vw, 2.25rem);
    border: 1px solid transparent; border-radius: 24px 6px 24px 24px;
    background: linear-gradient(125deg, color-mix(in srgb, var(--color-signal) 5%, var(--surface-elevated)), var(--surface-elevated) 65%) padding-box,
      linear-gradient(135deg, color-mix(in srgb, var(--color-signal) 42%, var(--color-line)), var(--color-line) 55%, color-mix(in srgb, var(--color-amber) 38%, var(--color-line))) border-box;
    box-shadow: inset 0 1px 0 var(--edge-highlight), var(--shadow-elevated);
  }
  .support-stage::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse at 0 0, color-mix(in srgb, var(--color-signal) 8%, transparent), transparent 65%),
      repeating-linear-gradient(0deg, color-mix(in srgb, var(--color-line) 24%, transparent) 0 1px, transparent 1px 6px),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--color-line) 18%, transparent) 0 1px, transparent 1px 6px);
  }
  .support-intro { min-width: 0; }
  .support-eyebrow { display: flex; align-items: center; gap: .55rem; color: var(--color-signal); font: 650 .63rem/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .support-eyebrow > span { color: var(--color-amber); font-size: 1.1rem; }
  .support-intro h1 { margin-top: .9rem; color: var(--color-bright); font: 650 var(--page-title-size)/1.1 var(--font-display); letter-spacing: -.035em; text-wrap: balance; }
  .support-intro h1 > span { display: block; color: var(--color-signal); }
  .support-lede { max-width: 35ch; margin-top: 1.1rem; color: var(--color-paper); font: 400 .95rem/1.75 var(--font-read); }
  .support-circuit { display: flex; align-items: center; gap: .7rem; max-width: 23rem; margin-top: 1.8rem; color: var(--color-muted); font: 500 .6rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .support-circuit > span { white-space: nowrap; }
  .support-circuit b { display: inline-flex; align-items: baseline; justify-content: center; flex: none; padding: .65rem .7rem; border: 1px solid color-mix(in srgb, var(--color-signal) 28%, var(--color-line)); border-radius: 9px 3px 9px 9px; background: color-mix(in srgb, var(--color-signal) 4%, var(--surface-elevated)); color: var(--color-paper); font-size: 1.15rem; letter-spacing: -.04em; text-transform: none; box-shadow: inset 0 1px 0 var(--edge-highlight); }
  .support-circuit .brand-0 { color: var(--color-signal); }
  .support-circuit .brand-cursor { color: var(--color-accent); }
  .support-circuit i { position: relative; flex: 1; height: 1px; background: linear-gradient(90deg, color-mix(in srgb, var(--color-signal) 20%, transparent), var(--color-signal)); }
  .support-circuit i::after { content: ''; position: absolute; width: 4px; height: 4px; top: -1.5px; right: 0; border-radius: 50%; background: var(--color-signal); }
  .support-circuit i:last-of-type { background: linear-gradient(90deg, var(--color-signal), var(--color-amber)); }
  .support-circuit i:last-of-type::after { background: var(--color-amber); }
  .support-open { margin-top: .85rem; max-width: 36ch; color: var(--color-muted); font: 400 .75rem/1.65 var(--font-read); }
  .support-ticket {
    position: relative; isolation: isolate; min-width: 0; overflow: hidden; padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid transparent; border-radius: 6px 18px 18px 18px;
    background: linear-gradient(var(--surface-elevated), var(--surface-elevated)) padding-box,
      linear-gradient(140deg, color-mix(in srgb, var(--color-amber) 58%, var(--color-line)), var(--color-line) 52%, color-mix(in srgb, var(--color-accent) 35%, var(--color-line))) border-box;
    box-shadow: inset 0 1px 0 var(--edge-highlight), 0 18px 45px color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .support-ticket::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(circle at 100% 0, color-mix(in srgb, var(--color-amber) 8%, transparent), transparent 15rem), repeating-linear-gradient(135deg, color-mix(in srgb, var(--color-line) 24%, transparent) 0 1px, transparent 1px 5px); }
  .ticket-header { display: flex; align-items: center; justify-content: space-between; gap: .7rem; margin-bottom: 1rem; }
  .ticket-header > div { min-width: 0; }
  .ticket-header .support-eyebrow { color: var(--color-amber); font-size: .58rem; }
  .ticket-header h2 { margin-top: .3rem; color: var(--color-bright); font: 650 clamp(1.1rem, 1.8vw, 1.35rem)/1.3 var(--font-display); letter-spacing: -.025em; }
  .ticket-heart { display: grid; width: 2.2rem; height: 2.2rem; flex: none; place-items: center; border: 1px solid color-mix(in srgb, var(--color-amber) 30%, var(--color-line)); border-radius: 50%; color: var(--color-amber); font: 400 1.45rem/1 var(--font-body); }
  .payment-link { position: relative; display: flex; min-height: 44px; border: 1px solid var(--color-line-strong); border-radius: 10px 3px 10px 10px; color: var(--color-paper); text-decoration: none; transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease; }
  .payment-link:hover { border-color: var(--color-signal); box-shadow: inset 0 1px 0 var(--edge-highlight), 0 0 0 1px color-mix(in srgb, var(--color-signal) 10%, transparent); }
  .payment-link:focus-visible, .boundary-links a:focus-visible, .boundary-copy p a:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  .payment-once { flex-direction: column; gap: .25rem; padding: .9rem 1rem; border-color: color-mix(in srgb, var(--color-amber) 32%, var(--color-line)); background: linear-gradient(130deg, color-mix(in srgb, var(--color-amber) 5%, transparent), transparent 75%), var(--surface-elevated); }
  .payment-caption { color: var(--color-muted); font: 500 .68rem/1.4 var(--font-read); }
  .payment-once strong { color: var(--color-bright); font: 650 clamp(1.3rem, 2vw, 1.6rem)/1.25 var(--font-display); letter-spacing: -.035em; }
  .payment-action { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: .45rem; border-top: 1px solid var(--color-line); padding-top: .6rem; color: var(--color-amber); font: 650 .7rem/1.4 var(--font-mono); }
  .payment-action > span { display: grid; width: 1.55rem; height: 1.55rem; place-items: center; border: 1px solid color-mix(in srgb, var(--color-amber) 32%, var(--color-line)); border-radius: 50%; font-size: .8rem; }
  .monthly-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .25rem .6rem; margin: 1rem 0 .65rem; }
  .monthly-heading h3 { color: var(--color-paper); font: 600 .78rem/1.4 var(--font-read); }
  .monthly-heading > span { color: var(--color-muted); font: 400 .65rem/1.4 var(--font-read); }
  .monthly-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .payment-monthly { min-height: 5.25rem; flex-direction: column; align-items: flex-start; gap: .3rem; padding: .85rem .75rem; background: linear-gradient(145deg, color-mix(in srgb, var(--color-signal) 4%, transparent), transparent), var(--surface-elevated); }
  .payment-monthly:hover { background-color: color-mix(in srgb, var(--color-signal) 7%, var(--surface-elevated)); }
  .payment-monthly strong { color: var(--color-bright); font: 650 clamp(1.1rem, 1.9vw, 1.4rem)/1.2 var(--font-display); letter-spacing: -.035em; }
  .payment-monthly > span { color: var(--color-muted); font: 400 .65rem/1.4 var(--font-read); }
  .payment-monthly .monthly-arrow { position: absolute; right: .65rem; bottom: .65rem; color: var(--color-signal); font-size: .8rem; }
  .payment-note { display: flex; gap: .4rem; margin-top: .85rem; color: var(--color-muted); font: 400 .67rem/1.5 var(--font-read); }
  .payment-note > span { color: var(--color-signal); }
  .ticket-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .3rem .6rem; margin-top: .9rem; border-top: 1px solid var(--color-line); padding-top: .75rem; color: var(--color-muted); font: 400 .58rem/1.4 var(--font-mono); }
  .is-disabled { color: var(--color-muted); opacity: .65; }
  .setup-note { margin-bottom: .8rem; color: var(--color-amber); font: 400 .85rem/1.5 var(--font-read); }
  .support-purpose, .support-trust { margin-top: 2.5rem; }
  .support-purpose > h2, .support-trust > h2, .stripe-boundary h2 { margin-top: .55rem; color: var(--color-bright); font: 600 clamp(1.1rem, 2.2vw, 1.5rem)/1.35 var(--font-display); letter-spacing: -.025em; }
  .purpose-items { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; margin-top: 1.2rem; }
  .purpose-items article { min-width: 0; border: 1px solid var(--color-line); border-radius: 12px 3px 12px 12px; padding: 1.15rem; background: linear-gradient(145deg, color-mix(in srgb, var(--color-signal) 4%, transparent), transparent), var(--surface-elevated); box-shadow: inset 0 1px 0 var(--edge-highlight); }
  .purpose-items article > span { color: var(--color-signal); font: 500 .62rem/1 var(--font-mono); }
  .purpose-items h3 { margin-top: .8rem; color: var(--color-paper); font: 600 .9rem/1.4 var(--font-read); }
  .purpose-items p { margin-top: .5rem; color: var(--color-muted); font: 400 .8rem/1.65 var(--font-read); }
  .support-trust { padding: 1.4rem; border: 1px solid var(--color-line); border-radius: 16px 4px 16px 16px; background: linear-gradient(120deg, color-mix(in srgb, var(--color-amber) 4%, transparent), transparent), var(--surface-inset); }
  .support-trust > .support-eyebrow { color: var(--color-amber); }
  .trust-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.3rem; }
  .trust-grid article { border-top: 1px solid var(--color-line); padding-top: .85rem; }
  .trust-index { color: var(--color-amber); font: 500 .62rem/1.4 var(--font-mono); }
  .trust-grid h3 { margin-top: .5rem; color: var(--color-paper); font: 600 .85rem/1.4 var(--font-read); }
  .trust-grid p, .boundary-copy p { margin-top: .55rem; color: var(--color-muted); font: 400 .8rem/1.7 var(--font-read); }
  .stripe-boundary { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: 1.5rem 2.5rem; margin-top: 2.5rem; border-top: 1px solid var(--color-line); padding-top: 1.6rem; }
  .boundary-copy p:first-child { margin-top: 0; }
  .boundary-copy strong { color: var(--color-paper); font-weight: 500; overflow-wrap: anywhere; }
  .boundary-copy a { color: var(--color-signal); text-decoration: underline; text-underline-offset: 3px; }
  .boundary-links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-top: .8rem; font: 400 .73rem/1.5 var(--font-read); }
  .boundary-links a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 760px) {
    .support-experience { --page-title-size: clamp(1.65rem, 6.8vw, 2rem); }
    .support-stage { grid-template-columns: minmax(0, 1fr); gap: 1.15rem; padding: 1rem; border-radius: 18px 4px 18px 18px; }
    .support-intro h1 { margin-top: .65rem; }
    .support-lede { max-width: 50ch; margin-top: .7rem; font-size: .88rem; line-height: 1.55; }
    .support-circuit, .support-open { display: none; }
    .support-ticket { padding: 1rem; }
    .ticket-header { margin-bottom: .8rem; }
    .payment-once { padding: .8rem; }
    .monthly-heading { margin-top: .8rem; }
    .payment-monthly { padding: .75rem .6rem; }
    .ticket-footer { margin-top: .75rem; padding-top: .65rem; }
    .purpose-items { grid-template-columns: minmax(0, 1fr); gap: .65rem; }
    .purpose-items article { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .4rem .85rem; padding: 1rem; }
    .purpose-items h3 { margin-top: 0; }
    .purpose-items p { grid-column: 2; margin-top: 0; }
    .purpose-items article > span { padding-top: .3rem; }
    .trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stripe-boundary { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  }
  @media (max-width: 380px) {
    .support-stage, .support-ticket { padding: .85rem; }
    .support-eyebrow { font-size: .56rem; }
    .payment-monthly strong { font-size: 1.1rem; }
    .payment-action { font-size: .65rem; }
    .payment-note, .monthly-heading > span { font-size: .6rem; }
    .trust-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .payment-link { transition: none; } }
</style>
