---
import type { ArticleEvidence, EvidenceLink } from '../lib/article-evidence.ts';
import { primarySourceUrl } from '../config/primary-sources.ts';
import { articleEvidenceDocumentLabels, articleEvidenceLinkLabel } from '../lib/article-evidence-presentation.ts';

interface Props {
  evidence: ArticleEvidence;
  sourceBody?: string;
}

const { evidence, sourceBody = '' } = Astro.props;
const documentLabels = articleEvidenceDocumentLabels(sourceBody);
const linkLabel = (link: EvidenceLink) => articleEvidenceLinkLabel(link, documentLabels);
const primaryShown = evidence.primary.slice(0, 6);
const secondaryShown = evidence.secondary.slice(0, 8);
const dataShown = evidence.internalData.slice(0, 6);
const contextShown = evidence.context.slice(0, 10);
const claimsShown = evidence.claims.slice(0, 3);
const badges = evidence.badges;
const depth = evidence.depth;
const reviewedCount = evidence.claims.filter((claim) => claim.reviewStatus === 'reviewed').length;
const automatedCount = evidence.claims.length - reviewedCount;
const directDocuments = [...new Map(
  [
    ...evidence.primary.flatMap((item) => item.links.map((link) => ({ ...link, sourceName: item.source.shortName }))),
    ...evidence.secondary.map((link) => ({ ...link, sourceName: link.host ?? 'Source externe' })),
  ].map((link) => [link.href, link]),
).values()].slice(0, 3);
const depthMode = depth.automated ? 'Profondeur automatique' : 'Profondeur relue';
const claimTone: Record<string, string> = {
  fait: 'claim-fact',
  estimation: 'claim-estimate',
  inférence: 'claim-inference',
  scénario: 'claim-scenario',
};
---

<aside class="evidence-box" aria-labelledby="evidence-title" data-pagefind-ignore>
  <div class="evidence-head">
    <div>
      <h2 id="evidence-title">Sources et vérification</h2>
      <p class="evidence-note">
        Retrouvez les documents cités et les passages auxquels ils sont associés.
        Le repérage automatique d’un lien ne valide pas une affirmation.
      </p>
    </div>
    <div class="evidence-counts" aria-label="Résumé de traçabilité">
      <span>{reviewedCount} relation{reviewedCount > 1 ? 's' : ''} relue{reviewedCount > 1 ? 's' : ''} dans le registre éditorial</span>
      <span>{automatedCount} passage{automatedCount > 1 ? 's' : ''} repéré{automatedCount > 1 ? 's' : ''} automatiquement</span>
    </div>
  </div>

  {directDocuments.length > 0 ? <ul class="evidence-documents" aria-label="Quelques documents cités">
    {directDocuments.map((link) => <li>
      <a href={link.href} target="_blank" rel="noopener">
        <span>{linkLabel(link)}</span><small>{link.sourceName}</small>
      </a>
    </li>)}
  </ul> : <p class="evidence-empty">Aucun document externe repéré automatiquement. Les références présentes dans le texte restent à consulter.</p>}

  <details class="evidence-details">
    <summary class="evidence-toggle">
      Examiner les passages et les références repérées
      <span class="evidence-toggle-hint">{evidence.stats.claimRelations} passage{evidence.stats.claimRelations > 1 ? 's' : ''}</span>
    </summary>

    <div class="evidence-badges" aria-label="Niveaux de preuve détectés">
    <span class="depth-badge" title={depth.detail}>
      <span aria-hidden="true">{depth.score}</span>
      profondeur : {depth.label}
    </span>
    {badges.length > 0 && (
      <>
      {badges.map((badge) => (
        <span class={`proof-badge proof-${badge.tone}`} title={badge.detail}>
          <span aria-hidden="true"></span>
          {badge.label}
        </span>
      ))}
      </>
    )}
    </div>

    <p class="depth-note">
      {depthMode} : {depth.detail}. Les niveaux “preuve directe” et “reproduction”
      demandent une relation relue entre une affirmation précise et sa source.
    </p>

    <section class="claim-section">
      <h3 class="evidence-h">Passages et sources associées</h3>
      {claimsShown.length > 0 ? (
        <ol class="claim-list">
          {claimsShown.map((claim) => (
            <li class={`claim-item ${claimTone[claim.kind]}`}>
              <div class="claim-top">
                <span>{claim.kind}</span>
                <time datetime={claim.dateIso}>{claim.dateLabel}</time>
                <span class={`review-badge ${claim.reviewStatus === 'reviewed' ? 'reviewed' : 'unreviewed'}`}>
                  {claim.reviewStatus === 'reviewed' ? 'revue humaine' : 'classification heuristique'}
                </span>
              </div>
              <p class="claim-review-note">
                {claim.reviewStatus === 'reviewed'
                  ? claim.reviewNote ?? 'Relation relue dans le registre éditorial.'
                  : 'Association non relue : le type du passage et son lien avec la source sont repérés par heuristique lexicale, puis restent à vérifier dans le document cité.'}
              </p>
              <p>{claim.claim}</p>
              <div class="claim-refs">
                {claim.references.map((ref) => (
                  <a href={ref.href} target={ref.href.startsWith('http') ? '_blank' : undefined} rel={ref.href.startsWith('http') ? 'noopener' : undefined}>
                    <span>{ref.kind ?? ref.host ?? 'référence'}</span>
                    <strong>{linkLabel(ref)}</strong>
                    {ref.sourcePublicationDateIso || ref.dateIso ? (
                      <time datetime={ref.sourcePublicationDateIso ?? ref.dateIso}>{ref.sourcePublicationDateLabel ?? ref.dateLabel}</time>
                    ) : (
                      <span>{ref.sourcePublicationDateLabel ?? ref.dateLabel ?? 'date source non détectée'}</span>
                    )}
                  </a>
                ))}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="evidence-empty">Aucune relation affirmation-source détectée automatiquement.</p>
      )}
    </section>

    <div class="evidence-grid">
      <section class="evidence-panel">
        <h3 class="evidence-h">Sources primaires</h3>
        {primaryShown.length > 0 ? (
          <ul class="evidence-list">
            {primaryShown.map((item) => (
              <li>
                <a href={primarySourceUrl(item.source.slug)}>{item.source.shortName}</a>
                <span>source liée à au moins une référence cliquable</span>
                {item.links.length > 0 && (
                  <span class="primary-links">
                    {item.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener">
                        <span>{linkLabel(link)}</span>
                        {link.dateLabel && <time datetime={link.dateIso}>{link.dateLabel}</time>}
                      </a>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="evidence-empty">Aucune institution primaire du registre l0g détectée automatiquement.</p>
        )}
      </section>

      <section class="evidence-panel">
        <h3 class="evidence-h">Sources secondaires</h3>
        {secondaryShown.length > 0 ? (
          <ul class="evidence-list">
            {secondaryShown.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">{link.host ?? link.label}</a>
                <span>{linkLabel(link)}</span>
                {link.dateLabel && <time datetime={link.dateIso}>{link.dateLabel}</time>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="evidence-empty">Pas de source secondaire externe isolée.</p>
        )}
      </section>

      <section class="evidence-panel">
        <h3 class="evidence-h">Données internes</h3>
        {dataShown.length > 0 ? (
          <ul class="evidence-list">
            {dataShown.map((link) => (
              <li>
                <a href={link.href}>{linkLabel(link)}</a>
                <span>{link.kind}</span>
                {link.dateLabel && <time datetime={link.dateIso}>{link.dateLabel}</time>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="evidence-empty">Aucun dataset ou dashboard l0g lié explicitement.</p>
        )}
      </section>

      <section class="evidence-panel">
        <h3 class="evidence-h">Contexte l0g</h3>
        {contextShown.length > 0 ? (
          <ul class="evidence-list">
            {contextShown.map((link) => (
              <li>
                <a href={link.href}>{linkLabel(link)}</a>
                <span>{link.kind}</span>
                {link.dateLabel && <time datetime={link.dateIso}>{link.dateLabel}</time>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="evidence-empty">Aucun renvoi interne de contexte détecté.</p>
        )}
      </section>
    </div>
  </details>
</aside>

<style>
  .evidence-box {
    margin-top: 3rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 1.2rem 0;
  }
  .evidence-head {
    display: grid;
    gap: 0.9rem;
  }
  @media (min-width: 720px) {
    .evidence-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }
  .evidence-head h2 { color: var(--color-bright); font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; line-height: 1.4; }
  .evidence-note {
    margin-top: 0.45rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .evidence-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  @media (min-width: 720px) {
    .evidence-counts {
      justify-content: flex-end;
      max-width: 14rem;
    }
  }
  .evidence-counts span {
    color: var(--color-muted);
    font-family: var(--font-read);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .evidence-documents { display: grid; gap: .6rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .evidence-documents a { display: grid; gap: .15rem; border-left: 1px solid var(--color-line); padding: .3rem 0 .3rem .8rem; color: var(--color-signal); font-size: .88rem; line-height: 1.5; overflow-wrap: anywhere; }
  .evidence-documents a:hover span { text-decoration: underline; text-underline-offset: .2em; }
  .evidence-documents small { color: var(--color-muted); font-size: .75rem; }
  .evidence-box :is(a, summary):focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  .evidence-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }
  .depth-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--color-signal) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-signal) 9%, transparent);
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.35rem 0.58rem;
    text-transform: uppercase;
  }
  .depth-badge span {
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-signal) 18%, transparent);
    color: var(--color-bright);
    font-size: 0.58rem;
  }
  .depth-note {
    max-width: 48rem;
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .evidence-details {
    margin-top: 1rem;
  }
  .evidence-toggle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    list-style: none;
    border-top: 1px solid var(--color-line);
    color: var(--color-signal);
    font-family: var(--font-read);
    font-size: 0.84rem;
    line-height: 1.5;
    min-height: 44px;
    padding: 0.65rem 0;
    transition: background 0.16s, border-color 0.16s;
  }
  .evidence-toggle::-webkit-details-marker {
    display: none;
  }
  .evidence-toggle::marker {
    content: '';
  }
  .evidence-toggle::before {
    content: '+';
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-signal) 18%, transparent);
    color: var(--color-bright);
    font-size: 0.8rem;
    line-height: 1;
  }
  .evidence-details[open] .evidence-toggle::before {
    content: '−';
  }
  .evidence-toggle:hover {
    background: color-mix(in srgb, var(--color-signal) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-signal) 55%, transparent);
  }
  .evidence-toggle-hint {
    color: var(--color-muted);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }
  .evidence-details[open] .depth-note {
    margin-top: 1rem;
  }
  .proof-badge {
    --proof-color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--proof-color) 38%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--proof-color) 8%, transparent);
    color: var(--proof-color);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.35rem 0.58rem;
    text-transform: uppercase;
  }
  .proof-badge span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--proof-color);
    box-shadow: 0 0 9px color-mix(in srgb, var(--proof-color) 45%, transparent);
  }
  .proof-strong { --proof-color: var(--color-signal); }
  .proof-data { --proof-color: #7aa2f7; }
  .proof-secondary { --proof-color: var(--color-muted); }
  .proof-scenario { --proof-color: var(--color-amber); }
  .proof-context { --proof-color: var(--color-accent); }
  .claim-section {
    margin-top: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-surface) 42%, transparent);
    padding: 0.8rem;
  }
  .claim-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.7rem;
    padding: 0;
    list-style: none;
  }
  .claim-item {
    border-top: 1px solid var(--color-line);
    padding-top: 0.7rem;
  }
  .claim-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .claim-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .claim-top span,
  .claim-top time,
  .claim-refs span,
  .claim-refs time {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .claim-top span {
    color: var(--color-signal);
  }
  .claim-estimate .claim-top span { color: var(--color-amber); }
  .claim-inference .claim-top span { color: var(--color-accent); }
  .claim-scenario .claim-top span { color: #7aa2f7; }
  .claim-top .review-badge {
    border: 1px solid color-mix(in srgb, var(--color-amber) 42%, transparent);
    border-radius: 999px;
    color: var(--color-amber);
    padding: 0.18rem 0.42rem;
  }
  .claim-top .review-badge.reviewed {
    border-color: color-mix(in srgb, var(--color-signal) 48%, transparent);
    color: var(--color-signal);
  }
  .claim-top time {
    color: var(--color-muted);
  }
  .claim-review-note {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .claim-item p {
    margin-top: 0.4rem;
    color: var(--color-paper);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .claim-refs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
    margin-top: 0.65rem;
  }
  @media (min-width: 680px) {
    .claim-refs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .claim-refs a {
    display: grid;
    gap: 0.2rem;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 0.55rem 0.65rem;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-bg) 35%, transparent);
    transition: border-color 0.16s, background 0.16s;
  }
  .claim-refs a:hover {
    border-color: color-mix(in srgb, var(--color-signal) 45%, transparent);
    background: color-mix(in srgb, var(--color-signal) 5%, transparent);
  }
  .claim-refs span {
    color: var(--color-signal);
  }
  .claim-refs strong {
    color: var(--color-paper);
    font-size: 0.82rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .claim-refs time {
    color: var(--color-muted);
  }
  .evidence-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (min-width: 760px) {
    .evidence-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .evidence-panel {
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-surface) 42%, transparent);
    padding: 0.8rem;
  }
  .evidence-h {
    color: var(--color-bright);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .evidence-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.7rem;
    padding: 0;
    list-style: none;
  }
  .evidence-list li {
    display: grid;
    gap: 0.18rem;
  }
  .evidence-list a {
    color: var(--color-signal);
    font-size: 0.88rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .evidence-list span,
  .evidence-list time,
  .evidence-empty {
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .evidence-list time,
  .primary-links time {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .evidence-empty {
    margin-top: 0.7rem;
  }
  .primary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .primary-links a {
    display: inline-grid;
    gap: 0.1rem;
    color: var(--color-muted);
    font-size: 0.72rem;
  }
  .primary-links span {
    color: inherit;
    font-size: inherit;
  }
  .primary-links time {
    color: var(--color-muted);
  }
</style>
