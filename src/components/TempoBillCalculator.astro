---
import { TEMPO_DEFAULTS, TEMPO_VOLUME_FIELDS, TEMPO_RATES, calculateTempoBill, formatTempoMoney } from '../lib/tempoBillCalculator.mjs';
import { TEMPO_OUTPUT_FIELDS, tempoBillCopy, tempoOutputText } from '../lib/tempoBillCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = tempoBillCopy(lang), initial = calculateTempoBill(TEMPO_DEFAULTS), id = `tempo-bill-${lang}`;
const taxLabel = lang === 'en' ? 'incl. tax' : 'TTC';
const rateText = (rate: bigint) => `${lang === 'en' ? '€' : ''}${rate / 10000n}${lang === 'en' ? '.' : ','}${String(rate % 10000n).padStart(4, '0')}${lang === 'en' ? '' : ' €'}/kWh`;
---
<section class="tempo-bill-calculator" data-tempo-bill-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="tempo-bill-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p><p class="tempo-bill-default">{lang === 'en' ? 'Initial example' : 'Exemple initial'} : <strong>{formatTempoMoney(initial.tempoBefore, lang)}</strong> {taxLabel} / {lang === 'en' ? 'year' : 'an'} · 6 kVA</p></header>
  <details class="tempo-bill-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}>
      <fieldset disabled><legend>{copy.legend}</legend>
        <div class="tempo-bill-fields">{TEMPO_VOLUME_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode="decimal" maxlength="10" value={TEMPO_DEFAULTS[key as keyof typeof TEMPO_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error ${id}-${key}-rate`} required /><small id={`${id}-${key}-rate`}>{rateText(TEMPO_RATES[key as keyof typeof TEMPO_RATES])} {taxLabel}</small></label>)}</div>
        <div class="tempo-bill-fields tempo-bill-options"><label for={`${id}-capacity`}><span>{copy.capacity}</span><select id={`${id}-capacity`} name="capacity"><option value="6">6 kVA</option><option value="9">9 kVA</option></select></label><label for={`${id}-shift`}><span>{copy.shift}</span><input id={`${id}-shift`} name="shift" type="text" inputmode="decimal" maxlength="10" value="0" autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label></div>
        <button type="reset">{copy.reset}</button>
      </fieldset>
      <p class="tempo-bill-bounds" id={`${id}-bounds`}>{copy.bounds}</p><p class="tempo-bill-error" id={`${id}-error`} data-error hidden></p>
    </form>
    <noscript><p>{copy.nojs}</p></noscript>
    <dl class="tempo-bill-results">{TEMPO_OUTPUT_FIELDS.map((key, index) => <div><dt>{copy.labels[index]}</dt><dd><output data-output={key}>{tempoOutputText(key, initial[key as keyof typeof initial], lang)}</output></dd></div>)}</dl>
    <p>{copy.comparison}</p><p class="tempo-bill-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="tempo-bill-method"><summary>{copy.method}</summary><p>{copy.scope}</p><p>{copy.share}</p><p>{copy.privacy}</p><p><a href="https://particulier.edf.fr/content/dam/2-Actifs/Documents/Offres/Grille_prix_Tarif_Bleu.pdf">{copy.reference}</a></p></details>
  </details>
</section>
<script>import '../lib/tempoBillCalculatorUi.mjs';</script>
<style>
.tempo-bill-calculator{box-sizing:border-box;width:100%;max-width:48rem;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.tempo-bill-calculator *{box-sizing:border-box}.tempo-bill-calculator .tempo-bill-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em}.tempo-bill-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.tempo-bill-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted)}.tempo-bill-calculator .tempo-bill-default{color:var(--color-paper)}.tempo-bill-default strong{color:var(--color-signal)}.tempo-bill-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.tempo-bill-controls,.tempo-bill-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.tempo-bill-calculator fieldset{margin:1rem 0;border:0;padding:0}.tempo-bill-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.tempo-bill-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.tempo-bill-fields label{min-width:0;font-size:.9375rem;line-height:1.5}.tempo-bill-fields span{display:block;margin-bottom:.35rem}.tempo-bill-fields small{display:block;margin-top:.35rem;color:var(--color-muted);font-size:.8125rem}.tempo-bill-fields input,.tempo-bill-fields select{width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.tempo-bill-fields [aria-invalid=true]{border-color:var(--color-accent)}.tempo-bill-options{margin-top:1rem}.tempo-bill-calculator button{margin-top:1rem;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;cursor:pointer}.tempo-bill-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.tempo-bill-calculator .tempo-bill-error{color:var(--color-accent)}.tempo-bill-results{margin:1.25rem 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.tempo-bill-results>div{min-width:0;padding:.85rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.tempo-bill-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.tempo-bill-results dd{margin:.35rem 0 0;font:700 1.15rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.tempo-bill-results>div:nth-child(3) output{color:var(--color-signal)}.tempo-bill-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.tempo-bill-fields,.tempo-bill-results{grid-template-columns:minmax(0,1fr)}.tempo-bill-calculator h3{font-size:1.2rem}}
</style>
