---
import { ORACLE_CASH_DEFAULTS, ORACLE_CASH_LIMITS, calculateOracleCash, oracleCashDisplay, oracleCashEquation } from '../lib/oracleCashModel.mjs';
import { oracleCashCopy } from '../lib/oracleCashUi.mjs';
interface Props { lang: 'fr' | 'en'; id?: string; }
const { lang, id = `oracle-cash-${lang}` } = Astro.props;
if (!/^[a-z][a-z0-9-]{0,63}$/.test(id)) throw new RangeError('Controlled calculator id required');
const copy = oracleCashCopy(lang), initial = calculateOracleCash(ORACLE_CASH_DEFAULTS);
const fields = ['advance', 'capex'] as const;
const primary = ['operating', 'fcf', 'outlay', 'balance'] as const;
---
<section class="oracle-cash-calculator" data-oracle-cash-root data-oracle-cash-lang={lang} data-valid="true" aria-labelledby={`${id}-title`}>
  <header><p class="oracle-cash-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="oracle-cash-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-error`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="oracle-cash-inputs">{fields.map((field, index) => <label for={`${id}-${field}`}><span>{copy.labels[index]}</span><input id={`${id}-${field}`} name={field} type="number" min={ORACLE_CASH_LIMITS[field][0]} max={ORACLE_CASH_LIMITS[field][1]} step="1" value={ORACLE_CASH_DEFAULTS[field]} inputmode="numeric" required autocomplete="off" aria-describedby={`${id}-${field}-bounds ${id}-error`} /><small id={`${id}-${field}-bounds`}>{copy.bounds[index]}</small></label>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p class="oracle-cash-error" id={`${id}-error`} data-error role="alert" hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
  </details>
  <p class="oracle-cash-scenario" data-scenario>{copy.initial}</p>
  <dl class="oracle-cash-results">{primary.map((field, index) => <div><dt>{copy.resultLabels[index]}</dt><dd><output data-oracle-cash-result={field} aria-live="off">{oracleCashDisplay(initial, field, lang)}</output> <small>{copy.unit}</small></dd></div>)}</dl>
  <p class="oracle-cash-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <details class="oracle-cash-equations"><summary>{copy.equations}</summary><p>{copy.equationA}</p><p class="oracle-cash-formula"><output data-oracle-cash-equation="a">{oracleCashEquation(initial, 'a', lang)}</output></p><p>{copy.equationB}</p><p class="oracle-cash-formula"><output data-oracle-cash-equation="b">{oracleCashEquation(initial, 'b', lang)}</output></p></details>
  <details class="oracle-cash-example"><summary>{copy.errorExample}</summary><p>{copy.errorExplanation}</p><dl class="oracle-cash-results"><div><dt>{copy.mixedLabel}</dt><dd><output data-oracle-cash-result="mixed" aria-live="off">{oracleCashDisplay(initial, 'mixed', lang)}</output> <small>{copy.unit}</small></dd></div><div><dt>{copy.overcountLabel}</dt><dd><output data-oracle-cash-result="overcount" aria-live="off">{oracleCashDisplay(initial, 'overcount', lang)}</output> <small>{copy.unit}</small></dd></div></dl></details>
  <details class="oracle-cash-method"><summary>{copy.method}</summary><p>{copy.fixed}</p><p>{copy.definitions}</p><p>{copy.limits}</p><p>{copy.scope}</p><p>{copy.privacy}</p><p><a href="https://investor.oracle.com/investor-news/news-details/2026/Oracle-Announces-Q1-Results-Driven-by-Triple-Digit-Growth-in-Cloud-Infrastructure-Revenues/default.aspx">{copy.sourceLabel}</a> · <a href="https://www.sec.gov/Archives/edgar/data/1341439/000119312526389274/orcl-20260831.htm">{copy.filingLabel}</a></p></details>
</section>
<script>import '../lib/oracleCashUi.mjs';</script>
<style>
  .oracle-cash-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.oracle-cash-calculator *{box-sizing:border-box}.oracle-cash-calculator header,.oracle-cash-calculator details,.oracle-cash-calculator form,.oracle-cash-calculator fieldset{min-width:0}.oracle-cash-calculator .oracle-cash-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.oracle-cash-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.oracle-cash-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.oracle-cash-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.oracle-cash-calculator details{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.oracle-cash-calculator fieldset{margin:1rem 0;border:0;padding:0}.oracle-cash-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.oracle-cash-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.oracle-cash-inputs label{display:block;min-width:0;font-size:.9375rem;line-height:1.6}.oracle-cash-inputs input{display:block;width:100%;min-width:0;min-height:2.75rem;margin-top:.4rem;padding:.5rem .6rem;border:1px solid var(--color-line-strong);border-radius:.3rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-variant-numeric:tabular-nums}.oracle-cash-inputs small{display:block;color:var(--color-muted);font-size:.8125rem;line-height:1.6;margin-top:.3rem}.oracle-cash-inputs [aria-invalid=true]{outline:2px solid var(--color-accent)}.oracle-cash-calculator button{min-height:2.75rem;margin-top:1rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer}.oracle-cash-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.oracle-cash-calculator .oracle-cash-error{color:var(--color-accent)}.oracle-cash-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.oracle-cash-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.oracle-cash-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.oracle-cash-results dd{margin:.25rem 0 0;font:700 1.125rem/1.5 var(--font-mono);color:var(--color-signal);overflow-wrap:anywhere}.oracle-cash-results small{font-size:.8125rem;font-weight:400;color:var(--color-muted)}.oracle-cash-example .oracle-cash-results dd{color:var(--color-accent)}.oracle-cash-calculator .oracle-cash-formula{font-family:var(--font-mono);font-variant-numeric:tabular-nums;color:var(--color-paper);overflow-wrap:anywhere}.oracle-cash-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:420px){.oracle-cash-inputs,.oracle-cash-results{grid-template-columns:minmax(0,1fr)}.oracle-cash-calculator h3{font-size:1.2rem}}
</style>
