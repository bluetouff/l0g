---
import { AIRFARE_DEMO_CAPTIONS } from '../lib/airfare-demo-captions';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const id = `airfare-demo-${lang}`;
const asset = `/videos/airfare-bots-v2-${lang}`;
---
<section class="airfare-video" aria-labelledby={`${id}-title`}>
  <h3 id={`${id}-title`}>{fr ? 'La démo en 32 secondes' : 'The 32-second demo'}</h3>
  <video controls playsinline preload="none" width="720" height="720" poster={`${asset}.png`} aria-labelledby={`${id}-title`} aria-describedby={`${id}-caption`}>
    <source src={`${asset}.mp4`} type="video/mp4" />
    <p>{fr ? 'Votre navigateur ne peut pas lire cette vidéo.' : 'Your browser cannot play this video.'} <a href={`${asset}.mp4`}>{fr ? 'Ouvrir la vidéo' : 'Open the video'}</a></p>
  </video>
  <p id={`${id}-caption`}>{fr ? 'Démonstration de l’outil, avec sous-titres intégrés. Musique originale électro lounge aux rythmes inspirés de la bossa nova.' : 'A recording of the tool, with burned-in subtitles. Original electronic lounge music with bossa nova-inspired rhythms.'}</p>
  <details><summary>{fr ? 'Lire les explications de la vidéo' : 'Read the video transcript'}</summary><ol>{AIRFARE_DEMO_CAPTIONS.map(cue => <li>{cue[lang]}</li>)}</ol><a href={`${asset}.vtt`} download>{fr ? 'Télécharger les sous-titres' : 'Download the subtitles'}</a></details>
</section>
<style>
  .airfare-video { margin:1rem 0 2.5rem;font-family:var(--font-read);padding-bottom:.75rem; }
  .airfare-video h3 { margin:0 0 .8rem;padding:0;border:0;color:var(--color-paper);font:450 1.1rem/1.4 var(--font-read); }
  .airfare-video video { display:block;width:100%;height:auto;aspect-ratio:1;border:1px solid var(--color-line-strong);border-radius:var(--radius-control);background:var(--color-ink); }
  .airfare-video p,.airfare-video details { font-size:.8rem;color:var(--color-muted);line-height:1.7; }
  .airfare-video p { margin:.7rem 0; }
  .airfare-video summary { cursor:pointer;min-height:40px;padding:.4rem 0; }
  .airfare-video summary:focus-visible { outline:2px solid var(--color-signal);outline-offset:4px; }
  .airfare-video ol { padding-left:1.3rem; }
</style>
