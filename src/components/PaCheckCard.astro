---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a
  class:list={['pa-card', { compact }]}
  href="https://pa.l0g.fr/"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Ouvrir PA Check dans un nouvel onglet"
  data-pagefind-ignore
>
  <span class="pa-card-top">
    <span class="pa-wordmark"><b>l<span>0</span>g</b> PA Check</span>
    <span class="pa-new">new</span>
  </span>

  <span class="pa-path" aria-hidden="true">
    <i><b>01</b></i>
    <em></em>
    <i><b>02</b></i>
    <em></em>
    <i><b>03</b></i>
  </span>

  <small>// facturation électronique</small>
  <strong>Choisir sa plateforme agréée.</strong>
  <span class="pa-description">
    Vérifiez votre outil actuel ou trouvez une PA adaptée à votre activité.
  </span>
  <span class="pa-cta">Ouvrir PA Check <i aria-hidden="true">↗</i></span>
</a>

<style>
  .pa-card {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 4px 16px 16px 16px;
    padding: 1rem;
    color: var(--color-paper);
    background:
      linear-gradient(var(--surface-elevated), var(--surface-elevated)) padding-box,
      linear-gradient(135deg,
        color-mix(in srgb, #8ea1ff 82%, transparent),
        color-mix(in srgb, #7557d6 68%, var(--color-line)) 52%,
        color-mix(in srgb, #39c6a0 72%, transparent)
      ) border-box;
    box-shadow:
      inset 0 1px 0 var(--edge-highlight),
      0 18px 45px color-mix(in srgb, #000 17%, transparent);
    text-decoration: none;
    isolation: isolate;
  }
  .pa-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(circle at 0 0, color-mix(in srgb, #8ea1ff 19%, transparent), transparent 9rem),
      radial-gradient(circle at 100% 100%, color-mix(in srgb, #39c6a0 14%, transparent), transparent 10rem),
      linear-gradient(120deg, transparent 0 54%, color-mix(in srgb, #8ea1ff 4%, transparent) 54% 55%, transparent 55% 100%);
  }
  .pa-card::after {
    content: 'PA';
    position: absolute;
    right: -0.25rem;
    bottom: -1.25rem;
    z-index: -1;
    color: color-mix(in srgb, #8ea1ff 5%, transparent);
    font-family: var(--font-display);
    font-size: 6.4rem;
    font-weight: 800;
    letter-spacing: -0.1em;
    line-height: 1;
  }
  .pa-card-top,
  .pa-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .pa-wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    color: #9cabff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pa-wordmark b {
    color: var(--color-bright);
    font-size: 0.78rem;
    letter-spacing: -0.02em;
    text-transform: none;
  }
  .pa-wordmark b span { color: var(--color-signal); }
  .pa-new {
    border: 1px solid color-mix(in srgb, #39c6a0 68%, transparent);
    border-radius: 999px;
    padding: 0.17rem 0.44rem 0.14rem;
    color: #66dbba;
    background: color-mix(in srgb, #39c6a0 10%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, #39c6a0 20%, transparent);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }
  .pa-path {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center;
    gap: 0.4rem;
    margin: 0.9rem 0 0.75rem;
  }
  .pa-path i {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, #8ea1ff 55%, var(--color-line));
    border-radius: 50%;
    background: color-mix(in srgb, #8ea1ff 8%, var(--surface-elevated));
    box-shadow: 0 0 14px color-mix(in srgb, #8ea1ff 10%, transparent);
    font-style: normal;
  }
  .pa-path i:nth-of-type(2) {
    border-color: color-mix(in srgb, #8d75e8 62%, var(--color-line));
  }
  .pa-path i:nth-of-type(3) {
    border-color: color-mix(in srgb, #39c6a0 65%, var(--color-line));
    background: color-mix(in srgb, #39c6a0 9%, var(--surface-elevated));
  }
  .pa-path b {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.46rem;
    letter-spacing: 0.02em;
  }
  .pa-path em {
    height: 1px;
    background: linear-gradient(90deg,
      color-mix(in srgb, #8ea1ff 35%, transparent),
      color-mix(in srgb, #39c6a0 65%, transparent));
  }
  .pa-card > small {
    display: block;
    margin-bottom: 0.42rem;
    color: #66dbba;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .pa-card > strong {
    display: block;
    max-width: 16rem;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }
  .pa-description {
    display: block;
    max-width: 16rem;
    margin-top: 0.52rem;
    color: var(--color-muted);
    font-size: 0.73rem;
    line-height: 1.5;
  }
  .pa-cta {
    margin-top: 0.82rem;
    color: #9cabff;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 680;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }
  .pa-cta i {
    color: #66dbba;
    font-size: 0.82rem;
    font-style: normal;
    transition: transform 0.18s ease;
  }
  .pa-card:hover,
  .pa-card:focus-visible {
    background:
      linear-gradient(color-mix(in srgb, #8ea1ff 4%, var(--surface-elevated)), color-mix(in srgb, #39c6a0 3%, var(--surface-elevated))) padding-box,
      linear-gradient(135deg, #9cabff, #8067df 52%, #55d2af) border-box;
  }
  .pa-card:hover > strong,
  .pa-card:focus-visible > strong { color: #b8c2ff; }
  .pa-card:hover .pa-cta i,
  .pa-card:focus-visible .pa-cta i { transform: translate(2px, -2px); }
  .pa-card:focus-visible { outline: 2px solid #9cabff; outline-offset: 3px; }
  .pa-card.compact { padding: 0.88rem; }
  .pa-card.compact .pa-path { margin-top: 0.72rem; margin-bottom: 0.62rem; }
  .pa-card.compact > strong { font-size: 1rem; }
</style>
