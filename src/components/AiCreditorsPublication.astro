---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';
import BaseLayout from '../layouts/BaseLayout.astro';
import EnglishGuidesLayout from '../layouts/EnglishGuidesLayout.astro';
import { aiCreditorsEditions } from '../config/ai-creditors-publication.mjs';
import { atlases, englishAtlases } from '../config/atlases';
import { AUTHOR_ID, ORGANIZATION_ID, SITE_URL } from '../config/entities.ts';
import { serializeInlineScriptData } from '../lib/security.ts';

interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
if (lang !== 'fr' && lang !== 'en') throw new TypeError('Invalid AI creditors publication language');
const isEn = lang === 'en';
const Layout = isEn ? EnglishGuidesLayout : BaseLayout;
const shellProps = isEn ? {} : { lang: 'fr' as const, ogLocale: 'fr_FR' as const, sidebar: false };
const tr = (fr: string, en: string) => isEn ? en : fr;
const book = aiCreditorsEditions[lang];
const heroLede = tr('Les centres de données empruntent. Leurs créanciers peuvent eux-mêmes dépendre d’un crédit bancaire ou d’une garantie. Six enquêtes suivent les banques, les fonds et les assureurs dans les comptes et les contrats, jusqu’aux clauses qui organisent les paiements.', 'Data-centre debt can sit in a fund that borrows from banks, or carry protection from an insurer. Six investigations trace these links through accounts and contracts, then examine the clauses controlling cash and rights of recourse.');
const alternate = aiCreditorsEditions[isEn ? 'fr' : 'en'];
const chapters = await Promise.all(book.chapters.map(async chapter => {
  if (!/^\/illustrations\/news\/[a-z0-9-]+\.jpg$/u.test(chapter.image)) throw new Error('Unsafe AI creditors chapter image path');
  const { width, height } = await sharp(join(process.cwd(), 'public', chapter.image)).metadata();
  if (typeof width !== 'number' || typeof height !== 'number' || !Number.isInteger(width) || !Number.isInteger(height) || width <= 0 || height <= 0) throw new Error(`Missing AI creditors chapter image dimensions: ${chapter.image}`);
  return { ...chapter, imageWidth: width, imageHeight: height };
}));
if (book.theme !== 'dark') throw new Error('The AI creditors publication requires one dark EPUB');
const bytes = readFileSync(join(process.cwd(), 'public', book.epub));
if (!bytes.length) throw new Error('The AI creditors EPUB must not be empty');
const download = {
  epub: book.epub,
  bytes: bytes.length,
  sha256: createHash('sha256').update(bytes).digest('hex'),
  size: `${new Intl.NumberFormat(book.locale, { maximumFractionDigits: 1 }).format(bytes.length / 1024 / 1024)} ${tr('Mo', 'MB')}`,
};
const formatDate = (value: string) => new Intl.DateTimeFormat(book.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
const pageUrl = `${SITE_URL}${book.path}`;
const translation = { '@type': 'Book', '@id': `${SITE_URL}${alternate.path}#book`, inLanguage: alternate.lang };
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Book', '@id': `${pageUrl}#book`,
  name: book.title, alternativeHeadline: book.subtitle, description: book.description, inLanguage: lang,
  author: { '@id': AUTHOR_ID }, publisher: { '@id': ORGANIZATION_ID },
  datePublished: book.date, dateModified: book.modified,
  bookFormat: 'https://schema.org/EBook', isAccessibleForFree: true,
  url: pageUrl, image: `${SITE_URL}${book.cover}`, license: 'https://creativecommons.org/licenses/by/4.0/',
  ...(isEn ? { translationOfWork: translation } : { workTranslation: translation }),
  hasPart: book.chapters.map(chapter => ({ '@type': 'Article', name: chapter.title, url: `${SITE_URL}${chapter.route}` })),
  associatedMedia: [{
    '@type': 'MediaObject', name: `${book.title} · ${tr('EPUB sombre', 'Dark EPUB')}`, contentUrl: `${SITE_URL}${download.epub}`,
    encodingFormat: 'application/epub+zip', contentSize: `${download.bytes} bytes`, sha256: download.sha256,
  }],
};
const excerptParts = (paragraph: string) => paragraph.split(/(\[B\d{2}\])/u).filter(Boolean).map(part => {
  if (!/^\[B\d{2}\]$/u.test(part)) return { text: part };
  const source = book.synthesisSources.find(entry => entry.id === part.slice(1, -1));
  if (!source || !source.url.startsWith('https://')) throw new Error(`Unknown or unsafe book citation: ${part}`);
  return { text: part, href: source.url, title: source.title };
});
const atlas = (isEn ? englishAtlases : atlases).find(item => item.id === 'financement-ia')!;
const related = [
  { href: isEn ? '/en/topics/ai-financing/' : '/dossiers/financement-ia/', title: tr('Le dossier du financement de l’IA', 'The AI financing dossier'), description: tr('Les enquêtes sur les fournisseurs, les échéances, les actifs et les engagements électriques.', 'Reporting on suppliers, repayment dates, pledged assets and power commitments.') },
  { href: atlas.href, title: tr('L’atlas du financement de l’IA', 'The AI financing atlas'), description: atlas.description },
  { href: isEn ? '/en/publications/the-money-behind-the-promise/' : '/publications/l-argent-des-promesses/', title: tr('L’argent des promesses', 'The money behind the promise'), description: tr('Les liens entre assureurs, gestionnaires d’actifs et crédit privé.', 'The links between insurers, asset managers and private credit.') },
];
---

<Layout {...shellProps} title={book.title}
  seoTitle={`${book.title}, ${tr('EPUB gratuit', 'free EPUB')} | l0g`}
  ogTitle={book.title}
  description={book.description} searchDate={book.date} searchTags={tr('financement de l’IA, banques, crédit privé, assurance', 'AI financing, banks, private credit, insurance').split(', ')}
  ogImage={book.social} ogImageAlt={tr('Les créanciers de l’IA. Six analyses documentées sur les banques, les fonds, les assureurs et les contrats, réunies en EPUB gratuit.', 'AI’s creditors. Six documented analyses of banks, funds, insurers and contracts, collected in a free EPUB.')}
  alternateLinks={[
    { hreflang: 'fr', href: `${SITE_URL}${aiCreditorsEditions.fr.path}` },
    { hreflang: 'en', href: `${SITE_URL}${aiCreditorsEditions.en.path}` },
    { hreflang: 'x-default', href: `${SITE_URL}${aiCreditorsEditions.fr.path}` },
  ]}>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(jsonLd)} />
  <article class="ai-creditors-book rise" data-pagefind-body>
    <section class="book-hero" aria-labelledby="book-title">
      <div class="cover-stage">
        <div class="book-shell">
          <span class="book-spine" aria-hidden="true">l0g · {tr('novembre', 'November')} 2026</span>
          <img src={book.cover} srcset={[320, 640, 960].map(w => `${book.cover.replace('.jpg', `-${w}.webp`)} ${w}w`).join(', ')}
            sizes="(max-width: 780px) 240px, 360px" width={book.coverWidth} height={book.coverHeight}
            alt={`${tr('Couverture de', 'Cover of')} ${book.title}`} loading="lazy" decoding="async" />
        </div>
        <p class="cover-caption">{tr('Édition française', 'English edition')} · <time datetime={book.date}>{formatDate(book.date)}</time></p>
      </div>
      <div class="hero-copy">
        <p class="mono-label">// {tr('enquête l0g · banques, fonds et contrats', 'l0g investigation · banks, funds and contracts')}</p>
        <h1 id="book-title">{tr('Les créanciers', 'AI’s')} <span>{tr('de l’IA', 'creditors')}</span></h1>
        <p class="hero-deck">{book.subtitle}</p>
        <p class="hero-lede">{heroLede}</p>
        <div class="hero-actions">
          <a id="telecharger" class="download-action" href={download.epub} download>{tr('Télécharger le livre', 'Download the book')} <small>EPUB 3 · {download.size} · {tr('gratuit', 'free')}</small></a>
          <a class="contents-action" href="#sommaire">{tr('Explorer les chapitres', 'Explore the chapters')} <span aria-hidden="true">↓</span></a>
        </div>
        <dl class="edition-facts">
          <div><dt>{book.chapters.length}</dt><dd>{tr('analyses intégrales', 'complete analyses')}</dd></div>
          <div><dt>{book.figureCount}</dt><dd>{tr('infographies', 'infographics')}</dd></div>
          <div><dt>EPUB 3</dt><dd>{tr('lecture hors ligne', 'offline reading')}</dd></div>
        </dl>
        <p class="edition-language"><a href={alternate.path} lang={alternate.lang} hreflang={alternate.lang}>{tr('Read in English', 'Lire en français')} <span aria-hidden="true">↗</span></a></p>
      </div>
    </section>

    <figure class="panorama">
      <img src={book.panorama} srcset={[640, 960, 1600].map(w => `${book.panorama.replace('.jpg', `-${w}.webp`)} ${w}w`).join(', ')}
        sizes="(max-width: 780px) 100vw, 1120px" width="1600" height="840" loading="lazy" decoding="async"
        alt={tr('Illustration conceptuelle des centres de données et des circuits de crédit qui relient banques, fonds et assureurs.', 'Conceptual artwork of data centres and the credit pathways linking banks, funds and insurers.')} />
      <figcaption>{tr('Illustration conceptuelle. Les schémas du livre expliquent les mécanismes documentés et gardent leurs sources, leurs dates et leurs limites.', 'Conceptual artwork. The book’s diagrams explain documented mechanisms and retain their sources, dates and limitations.')}</figcaption>
    </figure>

    <section class="reading-section" aria-labelledby="intro-title">
      <div class="section-heading"><p class="mono-label">01 / introduction</p><h2 id="intro-title">{book.introductionTitle}</h2></div>
      <div class="prose-copy">{book.introduction.slice(0, 2).map(paragraph => <p>{excerptParts(paragraph).map(part => part.href ? <a class="synthesis-citation" href={part.href} title={part.title}>{part.text}</a> : part.text)}</p>)}
        <p class="excerpt-note">{tr('L’ouverture du livre revient sur ', 'The book opens with ')}<a href={book.chapters[0].route}>{tr('l’enquête sur Jupiter', 'the Jupiter investigation')}</a>{tr(', ses sources et les positions des parties. L’introduction complète relie ensuite les six analyses.', ', its sources and the parties’ positions. The complete introduction then connects the six analyses.')}</p>
        <p class="excerpt-note">{tr('Documents de la synthèse :', 'Sources for the synthesis:')} {book.synthesisSources.slice(0, 2).map((source, index) => <>{index > 0 && ' · '}<a href={source.url}>{source.title}</a></>)}.</p>
      </div>
    </section>

    <section id="sommaire" class="contents-section" aria-labelledby="contents-title">
      <div class="section-heading"><p class="mono-label">02 / {tr('parcours de lecture', 'reading journey')}</p><h2 id="contents-title">{tr('Six analyses, du prêteur à la trésorerie', 'Six analyses, from lenders to cash flow')}</h2><p>{tr('Le parcours suit les banques, les fonds et les assureurs, puis revient aux clauses qui conditionnent les paiements. Chaque analyse intégrale conserve ses sources et reste accessible en ligne.', 'Follow banks, funds and insurers, then examine the clauses governing payment. Each complete analysis retains its sources and remains available online.')}</p></div>
      <ol class="chapter-grid">{chapters.map(chapter => <li><a href={chapter.route}>
        <img src={chapter.image} width={chapter.imageWidth} height={chapter.imageHeight} alt={chapter.imageAlt} loading="lazy" decoding="async" />
        <div class="chapter-copy"><span class="chapter-number">{String(chapter.number).padStart(2, '0')}</span><div><h3>{chapter.title}</h3><p>{chapter.summary}</p></div><span class="chapter-arrow" aria-hidden="true">↗</span></div>
      </a></li>)}</ol>
    </section>

    <section class="reading-section glossary-section" aria-labelledby="glossary-title">
      <div class="section-heading"><p class="mono-label">03 / {tr('repères', 'reference')}</p><h2 id="glossary-title">{tr('Les mots du crédit et du risque', 'The language of credit and risk')}</h2><p>{tr('Un glossaire accompagne le livre. Ces fiches permettent aussi de poursuivre la lecture en ligne.', 'A glossary accompanies the book. These reference pages also support further reading online.')}</p></div>
      <div><dl class="glossary-list">{book.glossary.slice(0, 6).map(entry => <div><dt><a href={entry.path}>{entry.title} <span aria-hidden="true">↗</span></a></dt><dd>{entry.definition}</dd></div>)}</dl><a class="text-link" href={isEn ? '/en/glossary/' : '/glossaire/'}>{tr('Ouvrir le glossaire l0g', 'Open the l0g glossary')} <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="reading-section" aria-labelledby="conclusion-title">
      <div class="section-heading"><p class="mono-label">04 / conclusion</p><h2 id="conclusion-title">{book.conclusionTitle}</h2></div>
      <div class="prose-copy">{book.conclusion.slice(0, 2).map(paragraph => <p>{excerptParts(paragraph).map(part => part.href ? <a class="synthesis-citation" href={part.href} title={part.title}>{part.text}</a> : part.text)}</p>)}<p class="excerpt-note">{tr('Les six fonds et leurs relevés sont détaillés dans ', 'The six funds and their disclosures are documented in ')}<a href={book.chapters.at(-1)!.route}>{tr('la cartographie des créanciers', 'the creditor map')}</a>{tr('. La conclusion complète examine les documents à suivre pour évaluer les engagements et les recours.', '. The full conclusion identifies the documents needed to assess commitments and rights of recourse.')}</p></div>
    </section>

    <section class="reading-section edition-section" aria-labelledby="edition-title">
      <div class="section-heading"><p class="mono-label">05 / {tr('sources et édition', 'sources and edition')}</p><h2 id="edition-title">{book.methodTitle}</h2></div>
      <div class="prose-copy">
        <p>{tr('Édition du', 'Edition dated')} {formatDate(book.date)}. {tr('Documentation arrêtée au', 'Documentary cut-off:')} {formatDate(book.documentationDate)}.</p>
        <p>{book.readerGuide[0]}</p>
        {book.method.slice(0, 1).map(paragraph => <p>{excerptParts(paragraph).map(part => part.href ? <a class="synthesis-citation" href={part.href} title={part.title}>{part.text}</a> : part.text)}</p>)}
        <p>{tr('Le texte, le sommaire, le glossaire et les infographies restent lisibles hors ligne. Les sources externes demandent une connexion. L’agrandissement des figures et les couleurs affichées dépendent de votre liseuse.', 'Text, contents, glossary and infographics are available offline. External sources require a connection. Image enlargement and displayed colours depend on your reading app.')}</p>
        <p>{tr('Les couvertures et le panorama sont des illustrations conceptuelles créées avec une assistance d’intelligence artificielle. Les infographies gardent les dates, les unités, les sources et les limites des articles.', 'The covers and panorama are conceptual illustrations created with AI assistance. The infographics retain the articles’ dates, units, sources and limitations.')}</p>
        <p>{tr('Le livre est gratuit et disponible en téléchargement direct. Réutilisation des textes et infographies originaux :', 'The book is free and available as a direct download. Reuse of original text and infographics:')} <a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 International</a>.</p>
        <p class="support-note">{tr('Pour aider à poursuivre ces enquêtes en accès libre, la page de soutien accepte les soutiens ponctuels ou mensuels. Les contributions en Bitcoin y sont aussi proposées.', 'To help keep these investigations freely available, the support page accepts one-time or monthly contributions, with Bitcoin support also available.')} <a href={isEn ? '/en/support/' : '/soutenir/'}>{tr('Soutenir l0g', 'Support l0g')} <span aria-hidden="true">↗</span></a></p>
        <details class="integrity"><summary>{tr('Vérifier l’intégrité du fichier', 'Check file integrity')}</summary><div><p>EPUB 3 · {download.size} · SHA-256</p><code>{download.sha256}</code></div></details>
      </div>
    </section>

    <section class="related-section" aria-labelledby="related-title"><div class="section-heading"><p class="mono-label">06 / {tr('prolonger la lecture', 'further reading')}</p><h2 id="related-title">{tr('Poursuivre la lecture', 'Further reading')}</h2></div><div class="related-grid">{related.map(item => <a href={item.href}><h3>{item.title} <span aria-hidden="true">↗</span></h3><p>{item.description}</p></a>)}</div><p class="back-link"><a href={isEn ? '/en/publications/' : '/publications/'}>← {tr('Toutes les publications', 'All publications')}</a></p></section>
  </article>
</Layout>

<style>
  .ai-creditors-book { max-width: 1120px; margin: 2rem auto 0; }
  .book-hero { display: grid; grid-template-columns: minmax(280px,.85fr) minmax(0,1.25fr); align-items: center; gap: clamp(2rem,5vw,5rem); padding: 1rem 0 3.5rem; }
  .cover-stage { display:flex; flex-direction:column; align-items:center; padding:2rem 1.5rem; }
  .book-shell { position:relative; width:min(100%,360px); transform:perspective(1300px) rotateY(-9deg) rotateZ(-1deg); box-shadow:1rem 1.5rem 3rem color-mix(in srgb,var(--color-ink) 65%,transparent); border-radius:3px 7px 7px 3px; }
  .book-shell::after { content:''; position:absolute; inset:0; border:1px solid color-mix(in srgb,var(--color-paper) 25%,transparent); border-radius:inherit; box-shadow:inset 8px 0 12px #0006; pointer-events:none; }
  .book-shell > img { display:block; width:100%; height:auto; border-radius:inherit; }
  .book-spine { position:absolute; left:-15px; top:1px; bottom:1px; width:15px; writing-mode:vertical-rl; transform:rotate(180deg); background:var(--color-surface); color:var(--color-muted); font-family:var(--font-mono); font-size:.55rem; text-align:center; border:1px solid var(--color-line); }
  .cover-caption { margin-top:1.8rem; font-family:var(--font-mono); font-size:.72rem; color:var(--color-muted); }
  .hero-copy > .mono-label { color:var(--color-amber); font-size:.7rem; }
  .hero-copy h1 { color:var(--color-bright); font-family:var(--font-display); font-size:clamp(2.3rem,3.4vw,3.55rem); line-height:1.05; letter-spacing:-.045em; margin:1rem 0; }
  .hero-copy h1 span { display:block; text-wrap:balance; color:var(--color-signal); }
  .hero-deck { font-family:var(--font-read); color:var(--color-bright); font-size:1.25rem; line-height:1.5; margin:1.3rem 0; }
  .hero-lede { font-family:var(--font-read); color:var(--color-prose); font-size:1.04rem; line-height:1.8; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1.2rem; margin:1.8rem 0; }
  .download-action { overflow-wrap:anywhere; min-height:44px; max-width:100%; display:inline-flex; flex-direction:column; gap:.4rem; border:1px solid var(--color-signal); border-radius:7px; padding:1rem 1.4rem; color:var(--color-bright); background:color-mix(in srgb,var(--color-signal) 10%,var(--color-surface)); font-family:var(--font-mono); font-size:.94rem; font-weight:500; text-decoration:none; }
  .download-action small { color:var(--color-prose); font-size:.68rem; font-weight:400; }
  .download-action:hover { background:color-mix(in srgb,var(--color-signal) 18%,var(--color-surface)); }
  .contents-action,.edition-language a,.text-link { color:var(--color-signal); font-family:var(--font-mono); font-size:.77rem; text-decoration:none; }
  .contents-action span { margin-left:.35rem; }
  .edition-facts { display:grid; grid-template-columns:repeat(3,1fr); gap:.8rem; margin:1.7rem 0; padding:1.2rem 0; border-top:1px solid var(--color-line); border-bottom:1px solid var(--color-line); }
  .edition-facts dt { color:var(--color-bright); font-family:var(--font-mono); font-size:1.25rem; font-weight:700; }
  .edition-facts dd { color:var(--color-muted); font-family:var(--font-read); font-size:.75rem; margin:.4rem 0 0; }
  .panorama { margin:0 0 3.5rem; }
  .panorama img { display:block; width:100%; height:auto; border-radius:10px; border:1px solid var(--color-line); }
  figcaption { font-family:var(--font-read); color:var(--color-muted); font-size:.8rem; line-height:1.65; margin:.8rem 0 0; }
  .reading-section { display:grid; grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr); gap:clamp(1.5rem,4vw,4rem); margin:2.5rem 0; padding-top:2rem; border-top:1px solid var(--color-line); }
  .section-heading > .mono-label { color:var(--color-amber); font-size:.7rem; }
  .section-heading h2 { color:var(--color-bright); font-family:var(--font-display); font-size:var(--section-title-size); letter-spacing:-.035em; line-height:1.2; margin:.8rem 0 1rem; }
  .section-heading > p:last-child { max-width:46rem; color:var(--color-prose); font-family:var(--font-read); line-height:1.75; }
  .prose-copy { overflow-wrap:anywhere; font-family:var(--font-read); color:var(--color-prose); line-height:1.85; font-size:1.04rem; min-width:0; }
  .prose-copy > p { margin:0 0 1.3rem; }
  .prose-copy .support-note { font-size:.88rem; padding-top:1rem; border-top:1px solid var(--color-line); }
  .support-note a { color:var(--color-signal); text-underline-offset:4px; }
  .synthesis-citation { font-family:var(--font-mono); font-size:.75em; white-space:nowrap; color:var(--color-signal); text-underline-offset:3px; }
  .prose-copy .excerpt-note { color:var(--color-muted); font-size:.8rem; }
  .contents-section,.related-section { margin:2.5rem 0; scroll-margin-top:2rem; }
  .chapter-grid { list-style:none; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.1rem; padding:0; margin:1.8rem 0 0; }
  .chapter-grid li { min-width:0; }
  .chapter-grid a { height:100%; display:block; text-decoration:none; background:var(--color-surface); border:1px solid var(--color-line); border-radius:9px; overflow:hidden; transition:border-color .2s,transform .2s; }
  .chapter-grid a:hover { border-color:var(--color-signal); transform:translateY(-3px); }
  .chapter-grid img { width:100%; height:auto; display:block; }
  .chapter-copy { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:.8rem; padding:1.2rem; }
  .chapter-number { font-family:var(--font-mono); color:var(--color-amber); font-size:.7rem; padding-top:.2rem; }
  .chapter-copy h3 { color:var(--color-bright); font-family:var(--font-read); font-size:1.1rem; line-height:1.4; margin:0 0 .7rem; }
  .chapter-copy p { font-family:var(--font-read); color:var(--color-muted); font-size:.85rem; line-height:1.6; margin:0; }
  .chapter-arrow { color:var(--color-signal); }
  .glossary-list { margin:0 0 1.4rem; }
  .glossary-list > div { padding:1.1rem 0; border-bottom:1px solid var(--color-line); }
  .glossary-list > div:first-child { padding-top:0; }
  .glossary-list dt a { color:var(--color-signal); font-family:var(--font-read); font-size:1.04rem; font-weight:700; text-decoration:none; }
  .glossary-list dd { color:var(--color-prose); font-family:var(--font-read); line-height:1.7; font-size:.94rem; margin:.4rem 0 0; }
  .integrity { font-family:var(--font-mono); font-size:.75rem; border:1px solid var(--color-line); padding:1rem; border-radius:6px; margin:1.5rem 0; }
  .integrity summary { color:var(--color-signal); cursor:pointer; }
  .integrity > div { margin-top:1.2rem; }
  .integrity p { color:var(--color-paper); font-size:.7rem; }
  .integrity code { display:block; overflow-wrap:anywhere; color:var(--color-muted); margin-top:.5rem; font-size:.66rem; line-height:1.7; }
  .related-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.2rem; margin-top:1.4rem; }
  .related-grid a { border:1px solid var(--color-line); border-radius:8px; padding:1.2rem; text-decoration:none; }
  .related-grid h3 { color:var(--color-signal); font-family:var(--font-read); font-size:1.1rem; margin:0 0 .8rem; line-height:1.4; }
  .related-grid p { color:var(--color-muted); font-family:var(--font-read); font-size:.9rem; line-height:1.7; margin:0; }
  .back-link { margin-top:2rem; }
