---
import art_fr_0_desktop from '../figures/midterms-2026/calendar.fr.desktop.svg?raw';
import art_fr_0_mobile from '../figures/midterms-2026/calendar.fr.mobile.svg?raw';
import art_fr_1_desktop from '../figures/midterms-2026/powers.fr.desktop.svg?raw';
import art_fr_1_mobile from '../figures/midterms-2026/powers.fr.mobile.svg?raw';
import art_fr_2_desktop from '../figures/midterms-2026/treasury.fr.desktop.svg?raw';
import art_fr_2_mobile from '../figures/midterms-2026/treasury.fr.mobile.svg?raw';
import art_fr_3_desktop from '../figures/midterms-2026/regulation.fr.desktop.svg?raw';
import art_fr_3_mobile from '../figures/midterms-2026/regulation.fr.mobile.svg?raw';
import art_fr_4_desktop from '../figures/midterms-2026/power-contract.fr.desktop.svg?raw';
import art_fr_4_mobile from '../figures/midterms-2026/power-contract.fr.mobile.svg?raw';
import art_fr_5_desktop from '../figures/midterms-2026/finance.fr.desktop.svg?raw';
import art_fr_5_mobile from '../figures/midterms-2026/finance.fr.mobile.svg?raw';
import art_fr_6_desktop from '../figures/midterms-2026/delay.fr.desktop.svg?raw';
import art_fr_6_mobile from '../figures/midterms-2026/delay.fr.mobile.svg?raw';
import art_en_0_desktop from '../figures/midterms-2026/calendar.en.desktop.svg?raw';
import art_en_0_mobile from '../figures/midterms-2026/calendar.en.mobile.svg?raw';
import art_en_1_desktop from '../figures/midterms-2026/powers.en.desktop.svg?raw';
import art_en_1_mobile from '../figures/midterms-2026/powers.en.mobile.svg?raw';
import art_en_2_desktop from '../figures/midterms-2026/treasury.en.desktop.svg?raw';
import art_en_2_mobile from '../figures/midterms-2026/treasury.en.mobile.svg?raw';
import art_en_3_desktop from '../figures/midterms-2026/regulation.en.desktop.svg?raw';
import art_en_3_mobile from '../figures/midterms-2026/regulation.en.mobile.svg?raw';
import art_en_4_desktop from '../figures/midterms-2026/power-contract.en.desktop.svg?raw';
import art_en_4_mobile from '../figures/midterms-2026/power-contract.en.mobile.svg?raw';
import art_en_5_desktop from '../figures/midterms-2026/finance.en.desktop.svg?raw';
import art_en_5_mobile from '../figures/midterms-2026/finance.en.mobile.svg?raw';
import art_en_6_desktop from '../figures/midterms-2026/delay.en.desktop.svg?raw';
import art_en_6_mobile from '../figures/midterms-2026/delay.en.mobile.svg?raw';
interface Props { lang?: 'fr' | 'en'; kind: 'calendar' | 'powers' | 'treasury' | 'regulation' | 'power-contract' | 'finance' | 'delay' }
const {lang = 'fr', kind} = Astro.props;
const captions = {"calendar": {"fr": {"title": "Le vote et les décisions à venir", "description": "Cinq jalons distincts : la transition électorale croise des procédures électriques, budgétaires et réglementaires.", "method": "Calendrier de jalons, espacement graphique non proportionnel au temps. Les dates des dépôts FERC viennent d’une page pédagogique mise à jour le 19 octobre ; les ordonnances et reports éventuels priment. L’échéance du financement est générale et comporte des exceptions. Le 3 janvier commence le nouveau mandat, sans présumer un agenda législatif.", "sources": ["02", "04", "09", "20", "26"], "number": "01"}, "en": {"title": "The vote and the decisions ahead", "description": "Five distinct milestones: the political transition overlaps grid proceedings, government funding and regulatory implementation.", "method": "Milestone sequence, not a time-proportional scale. FERC filing dates come from an explanatory page updated October 19; docket orders and any extensions control. Funding has a general deadline with exceptions. January 3 marks new terms, not a guaranteed legislative agenda.", "sources": ["02", "04", "09", "20", "26"], "number": "01"}}, "powers": {"fr": {"title": "Qui peut changer quelle décision ?", "description": "Les pouvoirs sont différents selon que l’entreprise attend une loi, une règle, un responsable confirmé ou une autorisation de projet.", "method": "Schéma de compétences et de conséquences possibles. Les flèches ne décrivent aucune mesure postélectorale déjà prise. La clôture législative ordinaire et le veto comportent les procédures et exceptions précisées dans le texte. Aucun pouvoir unique n’est attribué au contrôle des deux chambres.", "sources": ["05", "06", "07", "08", "22", "24", "25"], "number": "02"}, "en": {"title": "Who can change which decision?", "description": "The relevant power depends on whether a business needs legislation, a rule, a confirmed official or a project approval.", "method": "Schematic of authority and possible effects. Arrows do not represent an observed post-election action. Ordinary legislative cloture and veto rules have the procedures and exceptions discussed in the text. Control of both chambers is not treated as a single universal power.", "sources": ["05", "06", "07", "08", "22", "24", "25"], "number": "02"}}, "treasury": {"fr": {"title": "Des besoins publiés avant le scrutin", "description": "Emprunts négociables nets auprès du secteur privé. Deux trimestres prévus et des hypothèses d’encaisse distinctes. Milliards de dollars.", "method": "Publication du Trésor du 2 novembre 2026. Barres de 618 et 800 Md$, axe commençant à zéro et échelle identique. Les encadrés 850 et 1 000 Md$ sont les hypothèses de trésorerie en fin de trimestre, des stocks, et ne s’ajoutent pas aux flux d’emprunt. Ni déficit ni émissions brutes.", "sources": ["12"], "number": "03"}, "en": {"title": "Funding estimates issued before the vote", "description": "Privately-held net marketable borrowing. Two forecast quarters with separate cash-balance assumptions. US$ billion.", "method": "Treasury release dated November 2, 2026. Bars of $618bn and $800bn have a zero baseline and common scale. $850bn and $1,000bn boxes are end-quarter cash-stock assumptions and must not be added to the borrowing flows. Neither deficit nor gross issuance.", "sources": ["12"], "number": "03"}}, "regulation": {"fr": {"title": "La règle a son propre calendrier", "description": "Adoption, effet juridique et application du mécanisme sont distincts. L’état d’un projet de loi exige une vérification séparée.", "method": "Schéma de séquences sans échelle de durée. La règle bancaire du 2 octobre prend effet au 1er décembre 2026 ; le lissage sur deux tests commence en 2028. L’OCC annonce le 18 janvier 2027. Pour H.R. 3633, seul l’échec procédural du 15 septembre est documenté ici, dans le relevé officiel du vote 234 du Sénat, consulté intégralement ; aucune promulgation ultérieure n’a été confirmée dans la collecte.", "sources": ["16", "17", "20", "21"], "number": "04"}, "en": {"title": "Each rule has its own timetable", "description": "Adoption, legal effectiveness and operational implementation are separate. A bill’s status requires a separate check.", "method": "Sequence diagram without a time scale. The October 2 banking rule takes effect on December 1, 2026; two-test averaging starts in 2028. OCC announces January 18, 2027. For H.R. 3633, this collection documents only the September 15 procedural failure in the complete official Senate roll-call record for vote 234; later enactment was not confirmed.", "sources": ["16", "17", "20", "21"], "number": "04"}}, "power-contract": {"fr": {"title": "Un engagement avant le courant", "description": "Les travaux de raccordement et la fourniture d’électricité engagent deux contrats distincts.", "method": "Reconstitution fonctionnelle de la documentation publique AEP Ohio, corroboration du cadre par le communiqué PUCO du 9 juillet 2025. La procédure décrite vise les demandes d’au moins 25 MW. Avant la mise sous tension cible, si le client annule ou reporte le projet de plus de douze mois, le descriptif prévoit le remboursement de 100 % des coûts d’aménagement. L’application à un retard administratif exige l’examen du contrat, des causes et des exceptions. Les contrats particuliers restent inconnus.", "sources": ["01", "27"], "number": "05"}, "en": {"title": "A commitment before power arrives", "description": "Grid buildout and electricity supply create obligations under two separate contracts.", "method": "Functional reconstruction of AEP Ohio public documentation; the PUCO July 9, 2025 release corroborates the framework. The described process covers requests of at least 25 MW. Before target energization, if the customer cancels or delays the project by more than twelve months, the description requires reimbursement of 100% of buildout costs. Applying this to an administrative delay requires the contract, causes and exceptions to be examined. Individual contracts remain unavailable.", "sources": ["01", "27"], "number": "05"}}, "finance": {"fr": {"title": "L’argent reçu laisse une obligation", "description": "Deux mécanismes indépendants : une avance finance des prestations futures ; une garantie conditionnelle peut faire revenir le risque au garant.", "method": "Oracle : ligne du tableau de flux des trois mois clos le 31 août 2026, en dollars nominaux convertis de millions à milliards. Meta : maximum de garanties au 30 septembre 2026, pas perte attendue ; paiements jugés non probables par l’entreprise. Les montants portent sur des périmètres et des natures différents et ne s’additionnent pas. Aucun lien établi avec une décision postélectorale ou avec les exemples Ohio/New York.", "sources": ["29", "30"], "number": "06"}, "en": {"title": "Received funding leaves an obligation", "description": "Two independent mechanisms: an advance funds future services; a conditional guarantee can return risk to the guarantor.", "method": "Oracle: cash-flow line for the three months ended August 31, 2026, nominal dollars converted from millions to billions. Meta: maximum guarantees as of September 30, 2026, not expected loss; the company deems payments not probable. Different scopes and measures; do not add the amounts. No established link to a post-election decision or the Ohio/New York examples.", "sources": ["29", "30"], "number": "06"}}, "delay": {"fr": {"title": "Le délai déplace le cash", "description": "Exemple entièrement fictif : 36 contributions mensuelles de 5 M$, retard de six mois et 0,5 M$ de frais d’attente mensuels.", "method": "Dollars nominaux, millions ; flux de fin de mois avant financement et impôt. L’investissement commun est omis des deux trajectoires. Après six mois, 30 M$ de contributions différées et 3 M$ de frais produisent un écart de 33 M$. À 42 mois, le cumul est 180 contre 177 M$. Taux annuel d’actualisation effectif fictif de 8 %, mensuel équivalent (1,08)^(1/12)−1 : valeurs 160,216657 et 151,234965 M$, différence 8,981692 M$. Ni probabilités ni recettes perdues ni taux de financement observé.", "sources": [], "number": "07"}, "en": {"title": "A delay shifts the cash path", "description": "Entirely hypothetical: 36 monthly $5m contributions, a six-month delay and $0.5m of monthly standby costs.", "method": "Nominal US$ million; end-month flows before financing and tax. Common investment is omitted from both paths. After six months, $30m of deferred contributions and $3m standby costs produce a $33m gap. At month 42, cumulative totals are $180m and $177m. Hypothetical 8% effective annual discount rate, equivalent monthly rate (1.08)^(1/12)−1: present values 160.216657 and 151.234965, difference 8.981692. No probabilities, cancelled receipts or observed funding rate.", "sources": [], "number": "07"}}} as const;
const art = {fr:{'calendar':{desktop:art_fr_0_desktop,mobile:art_fr_0_mobile},'powers':{desktop:art_fr_1_desktop,mobile:art_fr_1_mobile},'treasury':{desktop:art_fr_2_desktop,mobile:art_fr_2_mobile},'regulation':{desktop:art_fr_3_desktop,mobile:art_fr_3_mobile},'power-contract':{desktop:art_fr_4_desktop,mobile:art_fr_4_mobile},'finance':{desktop:art_fr_5_desktop,mobile:art_fr_5_mobile},'delay':{desktop:art_fr_6_desktop,mobile:art_fr_6_mobile}},en:{'calendar':{desktop:art_en_0_desktop,mobile:art_en_0_mobile},'powers':{desktop:art_en_1_desktop,mobile:art_en_1_mobile},'treasury':{desktop:art_en_2_desktop,mobile:art_en_2_mobile},'regulation':{desktop:art_en_3_desktop,mobile:art_en_3_mobile},'power-contract':{desktop:art_en_4_desktop,mobile:art_en_4_mobile},'finance':{desktop:art_en_5_desktop,mobile:art_en_5_mobile},'delay':{desktop:art_en_6_desktop,mobile:art_en_6_mobile}}} as const;
if ((lang !== 'fr' && lang !== 'en') || !Object.prototype.hasOwnProperty.call(captions, kind)) throw new Error('Unknown MidtermsFigure variant');
const f = captions[kind][lang]; const svg = art[lang][kind];
---
<figure class="midterms-figure" id={`figure-${f.number}`}>
 <div class="desktop-art"><Fragment set:html={svg.desktop} /></div>
 <div class="mobile-art"><Fragment set:html={svg.mobile} /></div>
 <figcaption><span class="fig-num">FIGURE {f.number}</span><strong>{f.title}</strong>{f.description} {f.sources.map((id) => <a href={`#source-${id}`} aria-label={`Source ${Number(id)}`}>[{Number(id)}]</a>)}</figcaption>
 <details><summary>{lang === 'fr' ? 'Méthode et limites' : 'Method and limitations'}</summary><p>{f.method}</p></details>
</figure>
<style>
@font-face {font-family:'l0g Midterms';src:url('/fonts/stablecoins/dejavu-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
@font-face {font-family:'l0g Midterms';src:url('/fonts/stablecoins/dejavu-sans-700.ttf') format('truetype');font-style:normal;font-weight:700;font-display:swap}
.midterms-figure{width:100%;max-width:800px;margin:2.5rem auto;padding-bottom:1rem;color:inherit;container-type:inline-size;overflow:visible}
.desktop-art,.mobile-art{line-height:0;width:100%}.mobile-art{display:none;max-width:310px;margin-inline:auto}
.midterms-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
.midterms-figure figcaption{font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted);padding:1rem 0 .5rem}
.midterms-figure figcaption strong{display:block;font-size:1rem;margin:.4rem 0;color:var(--color-paper)}
.fig-num{letter-spacing:.06em;font-size:.8rem;color:var(--color-signal);font-weight:700}
.midterms-figure a{margin-right:.45rem}.midterms-figure details{font-family:var(--font-read);font-size:.875rem;line-height:1.7;margin-top:.5rem}
.midterms-figure summary{cursor:pointer;padding:.35rem 0}.midterms-figure summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.midterms-figure p{margin-top:.7rem}
@container(max-width:500px){.desktop-art{display:none}.mobile-art{display:block}}
@media print{.desktop-art{display:block}.mobile-art{display:none}.midterms-figure{break-inside:avoid}}
</style>
