const entry=info[kind], scene=art[lang][kind], figureNumber=number??entry.number, sourceIds=sources??entry.sources;
if (!/^\d{2}$/.test(figureNumber)||!sourceIds.every(id=>/^[a-z]\d{2}$/i.test(id))) throw new TypeError('Invalid figure metadata');
---
<figure class="trump-portfolio-figure" id={`figure-${figureNumber}`} data-kind={kind}>
 <div class="desktop-art"><Fragment set:html={scene.desktop}/></div>
 <div class="mobile-art"><Fragment set:html={scene.mobile}/></div>
 <figcaption><span class="figure-number">FIGURE {figureNumber}</span><strong>{entry[lang]}</strong>{caption} {sourceIds.map(id=><a href={`#source-${id.toLowerCase()}`} aria-label={`Source ${id.toUpperCase()}`}>[{id.toUpperCase()}]</a>)}</figcaption>
 {Astro.slots.has('default')&&<details><summary>{lang==='fr'?'Méthode et périmètre':'Method and scope'}</summary><div class="method"><slot/></div></details>}
</figure>
<style>
 @font-face{font-family:'l0g Trump Portfolio';src:url('/fonts/ukraine-reparations/liberation-sans-400.ttf') format('truetype');font-style:normal;font-weight:400;font-display:swap}
 .trump-portfolio-figure{width:100%;max-width:800px;margin:2.8rem auto;padding-bottom:1rem;container-type:inline-size;overflow:visible}
 .desktop-art,.mobile-art{width:100%;line-height:0}.mobile-art{display:none;max-width:340px;margin-inline:auto}
 .trump-portfolio-figure :global(svg){display:block;width:100%;max-width:100%;height:auto;letter-spacing:normal;overflow:visible}
 figcaption{padding:.85rem 0 .45rem;font-family:var(--font-read);font-size:.9rem;line-height:1.7;color:var(--color-muted)}
 figcaption strong{display:block;margin:.25rem 0;font-size:1rem;font-weight:400;color:var(--color-paper)}
 .figure-number{font-size:.75rem;letter-spacing:.12em;color:var(--color-signal)}a{margin-right:.45rem}
 details{margin-top:.35rem;font-family:var(--font-read);font-size:.875rem;line-height:1.7}summary{cursor:pointer;padding:.35rem 0}summary:focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.method{margin-top:.7rem}
 @container (max-width:660px){.desktop-art{display:none}.mobile-art{display:block}}
 @media print{.desktop-art{display:block}.mobile-art{display:none}.trump-portfolio-figure{break-inside:avoid}}
</style>
