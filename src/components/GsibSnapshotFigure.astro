---
import { gsibSnapshotSvg, validateGsibSnapshotFigure } from '../lib/gsibSnapshotFigures.mjs';

interface Props {
  lang?: 'fr' | 'en';
  kind: 'figure1' | 'figure2' | 'figure3' | 'figure4' | 'figure5' | 'figure6' | 'figure7';
  number: string;
  caption: string;
  sources: string;
}
const { lang, kind, number, caption, references } = validateGsibSnapshotFigure(Astro.props);
---
<figure class="gsib-snapshot-figure" id={`figure-${Number(number)}`} data-figure={number} data-kind={kind}>
  <div class="gsib-snapshot-desktop" set:html={gsibSnapshotSvg(lang, kind, false)} />
  <div class="gsib-snapshot-mobile" set:html={gsibSnapshotSvg(lang, kind, true)} />
  <figcaption>
    <strong>FIG. {number}</strong> {caption}
    <span class="gsib-snapshot-refs">{references.map((id) => <a href={`#source-${id}`}>[{Number(id.slice(1))}]</a>)}</span>
  </figcaption>
  <slot />
</figure>
<style>
  .gsib-snapshot-figure { margin: 2.6rem 0; width: 100%; padding-bottom: .85rem; container-type: inline-size; }
  .gsib-snapshot-figure :global(svg) {
    display: block; width: 100%; height: auto; max-width: 100%;
    border-radius: .8rem; letter-spacing: normal;
  }
  .gsib-snapshot-mobile { display: none; width: 100%; max-width: 25rem; margin-inline: auto; }
  figcaption { margin-top: .9rem; font-size: .875rem; line-height: 1.65; color: var(--color-muted); }
  figcaption strong { margin-right: .35em; }
  .gsib-snapshot-refs { display: block; }
  .gsib-snapshot-refs a { margin-right: .7em; }
  .gsib-snapshot-figure :global(details) { margin-top: .65rem; font-size: .875rem; line-height: 1.65; }
  .gsib-snapshot-figure :global(summary) { cursor: pointer; color: var(--color-muted); }
  @media (max-width: 640px) {
    .gsib-snapshot-desktop { display: none; }
    .gsib-snapshot-mobile { display: block; }
  }
  @container (max-width: 640px) {
    .gsib-snapshot-desktop { display: none; }
    .gsib-snapshot-mobile { display: block; }
  }
  @media print {
    .gsib-snapshot-figure { break-inside: avoid; }
    .gsib-snapshot-desktop { display: block; }
    .gsib-snapshot-mobile { display: none; }
  }
</style>
