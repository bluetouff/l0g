---
import { buildPaginationItems } from '../lib/pagination.ts';

interface Props {
  currentPage: number;
  totalPages: number;
  pageHref: (page: number) => string;
  ariaLabel: string;
  previousLabel: string;
  nextLabel: string;
}

const {
  currentPage,
  totalPages,
  pageHref,
  ariaLabel,
  previousLabel,
  nextLabel,
} = Astro.props;

const items = buildPaginationItems(currentPage, totalPages);
---

{
  totalPages > 1 && (
    <nav class="pager rise" aria-label={ariaLabel}>
      {currentPage > 1 ? (
        <a class="pager-step" href={pageHref(currentPage - 1)} rel="prev">‹ {previousLabel}</a>
      ) : (
        <span class="pager-step is-disabled" aria-disabled="true">‹ {previousLabel}</span>
      )}
      <span class="pager-nums">
        {items.map((item) => item.type === 'gap' ? (
          <span class="pager-gap" aria-hidden="true">…</span>
        ) : item.page === currentPage ? (
          <span class="pager-num is-current" aria-current="page">{item.page}</span>
        ) : (
          <a class="pager-num" href={pageHref(item.page)} aria-label={`Page ${item.page}`}>{item.page}</a>
        ))}
      </span>
      {currentPage < totalPages ? (
        <a class="pager-step" href={pageHref(currentPage + 1)} rel="next">{nextLabel} ›</a>
      ) : (
        <span class="pager-step is-disabled" aria-disabled="true">{nextLabel} ›</span>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px dashed var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .pager-step {
    color: var(--color-signal);
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-signal) 35%, transparent);
    border-radius: 6px;
    transition: background 0.16s, color 0.16s;
    white-space: nowrap;
  }
  .pager-step:hover { background: color-mix(in srgb, var(--color-signal) 12%, transparent); }
  .pager-step.is-disabled {
    color: var(--color-line-strong);
    border-color: var(--color-line);
    pointer-events: none;
    opacity: 0.55;
  }
  .pager-nums { display: flex; align-items: center; justify-content: center; gap: 0.3rem; min-width: 0; }
  .pager-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.9rem;
    height: 1.9rem;
    padding: 0 0.4rem;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: 6px;
    font-variant-numeric: tabular-nums;
    transition: background 0.16s, color 0.16s;
  }
  .pager-num:hover { color: var(--color-bright); background: color-mix(in srgb, var(--color-signal) 10%, transparent); }
  .pager-num.is-current {
    color: var(--color-bg, #0c0d10);
    background: var(--color-signal);
    font-weight: 700;
  }
  .pager-gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.9rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 480px) {
    .pager { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .pager-step:last-child { justify-self: end; }
    .pager-nums { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
