---
/**
 * Charge le registre WebMCP seulement lorsqu'un navigateur expose réellement
 * navigator.modelContext. Le registre complet reste un chunk Vite séparé.
 */
---

<script>
  // @ts-nocheck -- WebMCP est encore un draft sans types DOM stables.
  if (
    typeof navigator !== 'undefined'
    && window.isSecureContext
    && 'modelContext' in navigator
  ) {
    import('../scripts/webmcp-tools.ts');
  }
</script>
