---
import { FIRST_LOSS_FIELDS, FIRST_LOSS_DEFAULTS, FIRST_LOSS_ACTORS, calculateFirstLoss, formatFirstLossMoney } from '../lib/transitionFirstLossCalculator.mjs';
import { firstLossCopy } from '../lib/transitionFirstLossCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = firstLossCopy(lang), initial = calculateFirstLoss(FIRST_LOSS_DEFAULTS), id = `first-loss-${lang}`;
const structures = ['publicFirst', 'equityFirst'] as const;
const columns = ['capital', 'loss', 'remaining'] as const;
---
<section class="first-loss-calculator" data-first-loss-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="loss-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="loss-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="loss-fields">{FIRST_LOSS_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode="decimal" maxlength="13" value={FIRST_LOSS_DEFAULTS[key as keyof typeof FIRST_LOSS_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p id={`${id}-bounds`}>{copy.bounds}</p><p class="loss-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <div class="loss-structures">{structures.map((structure, index) => <section aria-labelledby={`${id}-${structure}`}><h4 id={`${id}-${structure}`}>{copy.structures[index]}</h4><div class="loss-table-wrap" tabindex="0" role="region" aria-label={copy.structures[index]}><table><caption class="loss-sr">{copy.structures[index]}</caption><thead><tr><th scope="col">{copy.tranche}</th>{copy.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{FIRST_LOSS_ACTORS.map((actor, actorIndex) => <tr><th scope="row">{copy.actors[actorIndex]}</th>{columns.map(column => <td><output data-first-loss-output={`${structure}.${actor}.${column}`}>{formatFirstLossMoney(initial[structure][actor as keyof typeof initial.publicFirst][column], lang)}</output></td>)}</tr>)}</tbody></table></div></section>)}</div>
    <dl class="loss-results">{(['loss', 'remaining', 'publicDifference'] as const).map((key, index) => <div><dt>{[copy.totalLoss, copy.totalRemaining, copy.difference][index]}</dt><dd><output data-first-loss-output={key}>{formatFirstLossMoney(initial[key], lang)}</output></dd></div>)}</dl>
    <p class="loss-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="loss-method"><summary>{copy.method}</summary><p>{copy.scope}</p><p>{copy.limits}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/transitionFirstLossCalculatorUi.mjs';</script>
<style>
.first-loss-calculator{box-sizing:border-box;width:100%;max-width:48rem;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.first-loss-calculator *{box-sizing:border-box}.first-loss-calculator .loss-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em}.first-loss-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.first-loss-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted)}.first-loss-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.loss-controls,.loss-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.first-loss-calculator fieldset{margin:1rem 0;border:0;padding:0}.first-loss-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.loss-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.loss-fields label{min-width:0;font-size:.9375rem;line-height:1.5}.loss-fields span{display:block;margin-bottom:.35rem}.loss-fields input{width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.loss-fields [aria-invalid=true]{border-color:var(--color-accent)}.first-loss-calculator button{margin-top:1rem;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;cursor:pointer}.first-loss-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.first-loss-calculator .loss-error{color:var(--color-accent)}.loss-structures{display:grid;gap:1.25rem;margin:1.5rem 0}.loss-structures>section{min-width:0}.loss-structures h4{font-size:1rem;line-height:1.6;margin:0 0 .7rem;hyphens:none}.loss-table-wrap{max-width:100%;overflow-x:auto}.first-loss-calculator table{display:table;overflow:visible;border-collapse:collapse;width:100%;font:400 .8rem/1.6 var(--font-read)}.first-loss-calculator th,.first-loss-calculator td{border-bottom:1px solid var(--color-line-strong);padding:.55rem .35rem;vertical-align:top;text-align:right}.first-loss-calculator th:first-child{text-align:left;min-width:6rem}.first-loss-calculator td{font-family:var(--font-mono);font-variant-numeric:tabular-nums;white-space:nowrap}.loss-results{display:grid;gap:.5rem;margin:1rem 0}.loss-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.loss-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.loss-results dd{margin:.25rem 0 0;font:700 1rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.loss-results>div:last-child output{color:var(--color-signal)}.loss-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.loss-fields{grid-template-columns:minmax(0,1fr)}.first-loss-calculator h3{font-size:1.2rem}.first-loss-calculator table{font-size:.75rem}}
</style>
