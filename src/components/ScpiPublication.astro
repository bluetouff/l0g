---
import { scpiEditions } from '../config/scpi-publication.mjs';
interface Props { lang: 'fr' | 'en'; size: string; sha256: string; }
const { lang, size, sha256 } = Astro.props;
const book = scpiEditions[lang];
const other = scpiEditions[lang === 'fr' ? 'en' : 'fr'];
const tr = (fr: string, en: string) => lang === 'fr' ? fr : en;
---
<article class="oil-book rise" data-pagefind-body>
  <section class="book-hero" aria-labelledby="book-title">
    <div class="cover-stage">
      <div class="book-shell">
        <span class="book-spine" aria-hidden="true">l0g · {tr('septembre 2026', 'September 2026')}</span>
        <img src={book.cover} srcset={[320, 640, 960].map((w) => `${book.cover.replace('.jpg', `-${w}.webp`)} ${w}w`).join(', ')}
          sizes="(max-width: 360px) 80vw, (max-width: 780px) 304px, 360px" width="1024" height="1638"
          alt={tr('Couverture de ', 'Cover of ') + book.title} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <p class="cover-caption">{tr('Édition française', 'English edition')} · <time datetime={book.date}>{tr('13 septembre 2026', '13 September 2026')}</time></p>
    </div>
    <div class="hero-copy">
      <p class="mono-label">// {tr('publication l0g · immobilier et épargne', 'l0g publication · property and savings')}</p>
      <h1 id="book-title">{tr('La liquidité fantôme', 'The Phantom Liquidity')} <span>{tr('des SCPI', 'of SCPI Funds')}</span></h1>
      <p class="hero-deck">{book.subtitle}.</p>
      <p class="hero-lede">{tr('À quel prix peut-on récupérer son épargne ? Que produisent les immeubles, et qui porte les pertes ? Six analyses suivent les parts de SCPI, les loyers et la dette jusqu’aux contrats d’assurance-vie. Un chapitre inédit examine les points communs avec le crédit privé et les différences qui comptent.', 'What can an investor actually recover? What do the buildings earn, and who bears the losses? Six analyses follow French unlisted property funds, known as SCPIs, from rents and debt through to life insurance contracts. An additional chapter examines the parallels with private credit and the differences that matter.')}</p>
      <div class="hero-actions">
        <a class="download-action" href={book.epub} download>{tr('Télécharger l’EPUB', 'Download the EPUB')} <small>{tr('Gratuit', 'Free')} · {size}</small></a>
        <a class="contents-action" href="#sommaire">{tr('Parcourir le sommaire', 'Explore the contents')} <span aria-hidden="true">↓</span></a>
      </div>
      <ul class="edition-facts" aria-label={tr('Contenu de l’édition', 'Edition contents')}>
        <li>{tr('6 analyses', '6 analyses')}</li><li>{tr('1 chapitre inédit', '1 additional chapter')}</li><li>{tr('18 infographies', '18 infographics')}</li><li>{tr('Introduction et conclusion', 'Introduction and conclusion')}</li>
      </ul>
      <p class="edition-note">EPUB 3 · {tr('lecture hors ligne', 'offline reading')} · CC BY 4.0</p>
      <p class="edition-note"><a href={other.path} lang={other.lang} hreflang={other.lang}>{tr('Read the English edition', 'Lire l’édition française')}</a></p>
    </div>
  </section>
  <section class="reading-section" aria-labelledby="intro-title">
    <div class="section-heading"><p class="mono-label">01 / introduction</p><h2 id="intro-title">{book.introductionTitle}</h2></div>
    <div class="introduction">{book.introduction.map((paragraph) => <p>{paragraph}</p>)}<p>{tr('Pour les règles de fonctionnement : ', 'For the structure and exit rules: ')}<a href={book.introductionSource}>{tr('le guide SCPI de l’AMF', 'the AMF’s SCPI explainer (in French)')}</a>. {tr('Les règles de l’assurance-vie sont sourcées au chapitre six.', 'The insurance rules and their sources are detailed in chapter six.')}</p></div>
  </section>
  <section id="sommaire" class="reading-section" aria-labelledby="contents-title">
    <div class="section-heading"><p class="mono-label">02 / {tr('le parcours', 'the reading journey')}</p><h2 id="contents-title">{tr('De la demande de sortie au partage des pertes', 'From an exit request to the allocation of losses')}</h2><p>{tr('Les six analyses restent accessibles sur le site. Le livre ajoute un chapitre comparatif original, une introduction et une conclusion.', 'The six analyses remain available online. The book adds an original comparative chapter, an introduction and a conclusion.')}</p></div>
    <div>
      <ol class="chapter-list">{book.chapters.map((chapter) => <li><a href={chapter.route}><span class="chapter-number" aria-hidden="true">{String(chapter.number).padStart(2, '0')}</span><div><h3>{chapter.title}</h3><p>{chapter.summary}</p></div><span class="chapter-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
      <div class="edition-details" id="private-credit">
        <h3>{tr('07 / ', '07 / ')}{book.bonusTitle}</h3>
        <p>{tr('Le chapitre inédit compare les règles de sortie, la valorisation et les liens de financement. Il distingue les fonds fermés des véhicules semi-liquides, et la propriété immobilière des créances sur les entreprises. Il n’établit ni pertes équivalentes ni contagion observée entre les deux marchés.', 'The additional chapter compares exit rules, valuation and financing links. It distinguishes closed-end from semiliquid funds, and property ownership from claims on companies. It establishes neither equivalent losses nor observed contagion between the two markets.')}</p>
        <p>{tr('Il s’appuie notamment sur le ', 'Its sources include the ')}<a href="https://www.fsb.org/uploads/P060526.pdf">{tr('rapport FSB de mai 2026', 'May 2026 FSB report')}</a>, {tr('la ', 'the ')}<a href="https://www.fca.org.uk/publications/multi-firm-reviews/private-market-valuation-practices">{tr('revue de la FCA sur les valorisations', 'FCA valuation review')}</a> {tr('et les ', 'and ')}<a href="https://www.federalreserve.gov/econres/notes/feds-notes/the-price-of-bank-funding-behind-private-credit-evidence-from-business-development-companies-20260807.html">{tr('travaux de chercheurs de la Fed sur le financement des BDC', 'Fed staff research on bank funding of BDCs')}</a>.</p>
        <h3>{tr('Conclusion : ', 'Conclusion: ')}{book.conclusionTitle}</h3>
        <p>{tr('Revenir aux documents qui permettent de relier le placement à son propre calendrier : prix et volumes de sortie, origine des distributions, dépenses et échéances.', 'Return to the documents that connect an investment with a personal timetable: exit prices and volumes, sources of distributions, expenditure and maturities.')}</p>
      </div>
    </div>
  </section>
  <section class="reading-section" aria-labelledby="edition-title">
    <div class="section-heading"><p class="mono-label">03 / {tr('l’édition numérique', 'the digital edition')}</p><h2 id="edition-title">{tr('Emporter la série', 'Take the series with you')}</h2></div>
    <div class="edition-details">
      <h3>{tr('Une lecture continue', 'Continuous reading')}</h3>
      <p>{tr('Le texte se redistribue selon l’écran. Les encadrés et exercices sont ouverts dans le livre ; le sommaire mène aux chapitres et aux sections. Les 18 infographies conservent leur fond sombre et leurs descriptions alternatives. L’agrandissement dépend de la liseuse ; le mode paysage peut aider à lire les tableaux.', 'Text reflows to fit the screen. Boxes and exercises are expanded; the contents lead to chapters and sections. All 18 infographics retain their dark backgrounds and text alternatives. Enlargement depends on the reader; landscape orientation can help with tables.')}</p>
      <h3>{tr('Les sources restent avec les textes', 'Sources stay with the text')}</h3>
      <p>{tr('Les analyses sont arrêtées au 13 septembre 2026. Les notes, les limites et les exemples explicitement fictifs sont conservés. Les liens entre les six chapitres fonctionnent dans le livre. Les sources externes et le glossaire en ligne demandent une connexion.', 'The analyses are dated 13 September 2026. Notes, limitations and explicitly hypothetical examples are retained. Links between the six chapters work within the book. External sources and the online glossary require a connection.')}</p>
      <h3>{tr('Une édition librement partageable', 'An edition you can share')}</h3>
      <p>{tr('Aucun script, police distante ni outil de suivi dans l’EPUB. Le livre est proposé sous ', 'The EPUB contains no scripts, remote fonts or trackers. It is released under the ')}<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
      <p class="art-note">{tr('La couverture a été créée avec une assistance d’intelligence artificielle. Cette illustration conceptuelle ne représente aucun immeuble, fonds ou taux d’occupation réel.', 'The cover was created with AI assistance. This conceptual illustration depicts no real building, fund or occupancy rate.')}</p>
      <details><summary>{tr('Informations sur le fichier', 'File information')}</summary><dl><dt>Format</dt><dd>EPUB 3 · {book.lang} · {size}</dd><dt>{tr('Édition', 'Edition')}</dt><dd>{book.date}</dd><dt>SHA-256</dt><dd><code>{sha256}</code></dd></dl></details>
      <a class="download-action final-download" href={book.epub} download>{tr('Télécharger le livre', 'Download the book')} <small>{tr('EPUB gratuit', 'Free EPUB')} · {size}</small></a>
      <p><a href={tr('/publications/', '/en/publications/')}>{tr('Toutes les publications l0g', 'All l0g publications')} <span aria-hidden="true">›</span></a></p>
    </div>
  </section>
</article>
<style>
  .oil-book { max-width: 1120px; margin: 0 auto; min-width: 0; }
  .book-hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; padding: clamp(1.5rem, 4vw, 3.5rem) 0 4rem; }
  .cover-stage { display: grid; justify-items: center; min-width: 0; padding: 1rem; background: radial-gradient(ellipse, rgba(94,234,212,.13), transparent 70%); }
  .book-shell { position: relative; width: min(100%, 360px); border: 1px solid #365c58; border-radius: 2px 7px 7px 2px; box-shadow: 12px 20px 50px #0007; }
  .book-shell img { width: 100%; height: auto; display: block; border-radius: inherit; }
  .book-spine { position: absolute; inset: 0 auto 0 -11px; width: 11px; overflow: hidden; font: 7px var(--font-mono); writing-mode: vertical-rl; text-align: center; color: #d5bc84; background: #24221b; border-radius: 3px 0 0 3px; }
  .cover-caption { margin-top: 1.3rem; font: .7rem/1.6 var(--font-mono); color: var(--color-muted); text-align: center; }
  .mono-label { color: var(--color-amber); font: .72rem/1.6 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  h1 { margin: .7rem 0 1.2rem; font-size: clamp(2.1rem, 4.5vw, 3.8rem); line-height: 1.05; letter-spacing: -.045em; color: var(--color-bright); }
  h1 span { display: block; color: var(--color-amber); }
  .hero-deck { font-size: clamp(1.08rem, 2vw, 1.4rem); line-height: 1.4; color: var(--color-bright); }
  .hero-lede { color: var(--color-paper); font-size: 1rem; line-height: 1.8; margin: 1.3rem 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin: 1.7rem 0; }
  .download-action { display: inline-flex; flex-direction: column; padding: .95rem 1.3rem; border-radius: 7px; background: var(--color-amber); color: #111318; text-decoration: none; font-weight: 750; line-height: 1.5; text-align: center; }
  .download-action small { font: .72rem/1.6 var(--font-mono); font-weight: 500; }
  .contents-action { font-size: .84rem; color: var(--color-signal); }
  .edition-facts { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: 1.5rem 0 .7rem; }
  .edition-facts li { padding: .4rem .65rem; border: 1px solid var(--color-line); border-radius: 4px; font: .7rem/1.5 var(--font-mono); }
  .edition-note { font: .72rem/1.7 var(--font-mono); color: var(--color-muted); }
  .reading-section { border-top: 1px solid var(--color-line); padding: 3rem 0; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: clamp(1.5rem, 4vw, 4rem); scroll-margin-top: 6rem; }
  .section-heading h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.2; letter-spacing: -.025em; margin: .7rem 0 1rem; }
  .section-heading > p:last-child { color: var(--color-muted); font-size: .9rem; line-height: 1.7; }
  .introduction p, .edition-details p { line-height: 1.85; margin: 0 0 1.2rem; }
  .introduction p:first-child { color: var(--color-bright); font-size: 1.1rem; }
  .chapter-list { list-style: none; padding: 0; margin: 0; }
  .chapter-list li { border-bottom: 1px solid var(--color-line); }
  .chapter-list a { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 1rem; gap: .7rem; padding: 1.15rem 0; color: inherit; text-decoration: none; }
  .chapter-list li:first-child a { padding-top: 0; }
  .chapter-number { color: var(--color-amber); font: .9rem/1.6 var(--font-mono); }
  .chapter-list h3 { font-size: 1rem; line-height: 1.5; margin: 0; }
  .chapter-list p { margin: .45rem 0 0; color: var(--color-muted); font-size: .86rem; line-height: 1.65; }
  .chapter-arrow { color: var(--color-signal); }
  .chapter-list a:hover h3 { color: var(--color-amber); }
  .edition-details h3 { margin: 0 0 .6rem; font-size: 1.1rem; }
  #private-credit { margin-top: 2rem; }
  .edition-details h3:not(:first-child) { margin-top: 1.9rem; }
  .edition-details .art-note { font-size: .8rem; color: var(--color-muted); }
  details { padding: 1rem 0; border-block: 1px solid var(--color-line); font-size: .85rem; }
  summary { cursor: pointer; color: var(--color-signal); }
  dt { font-weight: 700; margin-top: .8rem; } dd { margin: .35rem 0 0; } code { overflow-wrap: anywhere; font-size: .75rem; }
  .final-download { margin: 1.6rem 0; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 5px; }
  @media (max-width: 780px) { .book-hero, .reading-section { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; } .book-shell { max-width: 304px; } .book-hero { padding-bottom: 2rem; } .reading-section { padding-block: 2rem; } }
</style>
