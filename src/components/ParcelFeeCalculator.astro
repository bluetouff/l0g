---
import { PARCEL_FEE_FIELDS, PARCEL_FEE_DEFAULTS, calculateParcelFee, formatParcelFeeMoney } from '../lib/parcelFeeCalculator.mjs';
import { parcelFeeCopy } from '../lib/parcelFeeCalculatorUi.mjs';
interface Props { lang: 'fr' | 'en'; }
const { lang } = Astro.props;
const copy = parcelFeeCopy(lang), initial = calculateParcelFee(PARCEL_FEE_DEFAULTS), id = `parcel-fee-${lang}`;
const outputs = ['finalInclVat', 'initialInclVat', 'fee', 'passed', 'absorbed', 'additionalVat', 'customerIncrease'] as const;
---
<section class="parcel-fee-calculator" data-parcel-fee-calculator data-lang={lang} aria-labelledby={`${id}-title`}>
  <header><p class="parcel-fee-eye">l0g / {copy.eyebrow}</p><h3 id={`${id}-title`}>{copy.title}</h3><p>{copy.intro}</p></header>
  <details class="parcel-fee-controls"><summary>{copy.controls}</summary>
    <form aria-describedby={`${id}-bounds`}><fieldset disabled><legend>{copy.legend}</legend>
      <div class="parcel-fee-fields">{PARCEL_FEE_FIELDS.map((key, index) => <label for={`${id}-${key}`}><span>{copy.fields[index]}</span><input id={`${id}-${key}`} name={key} type="text" inputmode="decimal" maxlength="9" value={PARCEL_FEE_DEFAULTS[key as keyof typeof PARCEL_FEE_DEFAULTS]} autocomplete="off" spellcheck="false" aria-describedby={`${id}-bounds ${id}-error`} required /></label>)}</div>
      <div class="parcel-fee-presets" role="group" aria-label={copy.presets}>{['0', '50', '100'].map((value, i) => <button type="button" data-pass-through={value} aria-pressed={value === '50'}>{copy.presetLabels[i]}</button>)}</div>
      <button type="reset">{copy.reset}</button>
    </fieldset><p id={`${id}-bounds`}>{copy.bounds}</p><p class="parcel-fee-error" id={`${id}-error`} data-error hidden></p></form>
    <noscript><p>{copy.nojs}</p></noscript>
    <dl class="parcel-fee-results">{outputs.map((key, index) => <div><dt>{copy.labels[index]}</dt><dd><output data-parcel-fee-output={key}>{formatParcelFeeMoney(initial[key], lang)}</output></dd></div>)}</dl>
    <p class="parcel-fee-sr" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <details class="parcel-fee-method"><summary>{copy.method}</summary><p>{copy.formula}</p><p>{copy.scope}</p><p>{copy.tax}</p><p>{copy.absorbed}</p><p>{copy.rounding}</p><p>{copy.privacy}</p></details>
  </details>
</section>
<script>import '../lib/parcelFeeCalculatorUi.mjs';</script>
<style>
.parcel-fee-calculator{box-sizing:border-box;width:100%;max-width:48rem;min-width:0;margin:2.75rem auto;padding:1.25rem;border:1px solid var(--color-line-strong);border-top:3px solid var(--color-signal);border-radius:.75rem;background:var(--color-surface);color:var(--color-paper);font-family:var(--font-read);container-type:inline-size}.parcel-fee-calculator *{box-sizing:border-box}.parcel-fee-calculator header,.parcel-fee-calculator details,.parcel-fee-calculator form,.parcel-fee-calculator fieldset{min-width:0}.parcel-fee-calculator .parcel-fee-eye{margin:0 0 .6rem;color:var(--color-signal);font:700 .8125rem/1.6 var(--font-mono);letter-spacing:.03em;overflow-wrap:anywhere}.parcel-fee-calculator h3{margin:0 0 .8rem;font-size:1.35rem;line-height:1.4;hyphens:none}.parcel-fee-calculator p{margin:.7rem 0;font-size:.875rem;line-height:1.7;color:var(--color-muted);overflow-wrap:anywhere}.parcel-fee-calculator summary{cursor:pointer;min-height:2.75rem;font-size:.9375rem;line-height:1.6;padding:.45rem 0;color:var(--color-paper)}.parcel-fee-controls,.parcel-fee-method{border-top:1px solid var(--color-line-strong);padding-top:.5rem}.parcel-fee-calculator fieldset{margin:1rem 0;border:0;padding:0}.parcel-fee-calculator legend{margin-bottom:.75rem;font-size:.875rem;color:var(--color-muted)}.parcel-fee-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.parcel-fee-fields label{display:flex;flex-direction:column;min-width:0;font-size:.9375rem;line-height:1.5}.parcel-fee-fields span{display:block;margin-bottom:.35rem}.parcel-fee-fields input{margin-top:auto;width:100%;min-width:0;min-height:2.75rem;padding:.55rem .65rem;border:1px solid var(--color-line-strong);border-radius:.35rem;background:var(--color-surface-2);color:var(--color-paper);font:1rem/1.5 var(--font-mono)}.parcel-fee-fields [aria-invalid=true]{border-color:var(--color-accent)}.parcel-fee-calculator button{min-width:0;min-height:2.75rem;padding:.6rem .8rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2);color:var(--color-paper);font:inherit;font-size:.875rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}.parcel-fee-calculator button[aria-pressed=true]{border-color:var(--color-signal);color:var(--color-signal)}.parcel-fee-presets{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}.parcel-fee-calculator :focus-visible{outline:2px solid var(--color-signal);outline-offset:4px}.parcel-fee-calculator .parcel-fee-error{color:var(--color-accent)}.parcel-fee-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:1rem 0}.parcel-fee-results>div{min-width:0;padding:.75rem;border:1px solid var(--color-line-strong);border-radius:.4rem;background:var(--color-surface-2)}.parcel-fee-results>div:first-child{grid-column:1/-1;border-color:var(--color-signal)}.parcel-fee-results dt{font-size:.8125rem;line-height:1.6;color:var(--color-muted)}.parcel-fee-results dd{margin:.25rem 0 0;font:700 1rem/1.5 var(--font-mono);color:var(--color-paper);overflow-wrap:anywhere}.parcel-fee-results>div:first-child output{color:var(--color-signal)}.parcel-fee-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@container(max-width:460px){.parcel-fee-fields,.parcel-fee-results{grid-template-columns:minmax(0,1fr)}.parcel-fee-calculator h3{font-size:1.2rem}}
</style>
