---
import { peageDossier as dossier } from '../data/peage-dossier.ts';
import { assertPeageDossier, layerLabels } from '../lib/peage.ts';
assertPeageDossier(dossier);

const date = (value: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
const sourceFor = (id: string) => dossier.sources.find(source => source.id === id)!;
const nodeFor = (id: string) => dossier.nodes.find(node => node.id === id)!;
const positions = [
  { id: 'investisseurs', x: 250, y: 15, w: 190, h: 51, relation: 'investisseurs-iris' },
  { id: 'reforme', x: 20, y: 110, w: 180, h: 65, relation: 'obligation' },
  { id: 'iris', x: 255, y: 110, w: 180, h: 65, relation: 'iris-dext' },
  { id: 'quadient', x: 535, y: 110, w: 195, h: 65, relation: 'quadient-serensia' },
  { id: 'entreprise', x: 20, y: 280, w: 180, h: 65, relation: 'designation' },
  { id: 'dext', x: 255, y: 280, w: 180, h: 65, relation: 'dext-serensia' },
  { id: 'serensia', x: 535, y: 280, w: 195, h: 65, relation: 'dext-serensia' },
  { id: 'cerfrance', x: 255, y: 440, w: 180, h: 65, relation: 'cerfrance-serensia' },
];
const paths = [
  { id: 'obligation', d: 'M110 175V280', x: 110, y: 220, label: 'réception', sub: '09.2026', layer: 'obligation' },
  { id: 'designation', d: 'M200 312H255', x: 227, y: 292, label: 'choix', sub: '', layer: 'contrat' },
  { id: 'investisseurs-iris', d: 'M345 66V110', x: 380, y: 90, label: '', sub: '', layer: 'capital' },
  { id: 'iris-dext', d: 'M345 175V280', x: 345, y: 220, label: 'détention indirecte', sub: '100 % · 30.04.2026', layer: 'capital' },
  { id: 'quadient-serensia', d: 'M632 175V280', x: 632, y: 220, label: 'acquisition', sub: '02.06.2025', layer: 'capital' },
  { id: 'dext-serensia', d: 'M435 312H535', x: 485, y: 284, label: 'PA chez', sub: 'Serensia', layer: 'infrastructure' },
  { id: 'cerfrance-serensia', d: 'M435 472H590Q632 472 632 430V345', x: 585, y: 409, label: 'marque blanche', sub: 'déclarée · 12.2025', layer: 'infrastructure' },
];
---

<div class="peage" data-peage data-reviewed-on={dossier.reviewedOn}>
  <header class="peage-header">
    <div class="identity"><span class="wordmark">PÉAGE<span class="cursor" aria-hidden="true">_</span></span><span>par l0g</span></div>
    <div class="dossier-meta"><span>DOSSIER 001 · FRANCE</span><span>Revue du <time datetime={dossier.reviewedOn}>{date(dossier.reviewedOn)}</time></span></div>
    <h1>Dext appartient à IRIS.<br />Sa PA repose sur <span>Serensia.</span></h1>
    <p class="intro">Suivez l’obligation, les propriétaires et le fournisseur technique. Puis préparez une sortie avec les bonnes clauses en main.</p>
    <div class="header-links"><a href="#carte">Explorer la carte ↓</a><a href="#sortie">Préparer une sortie ↗</a><a href="/peage/dossier.md" download>Emporter le dossier ↓</a></div>
  </header>

  <section id="carte" class="map-section" aria-labelledby="map-title">
    <div class="section-top"><div><p class="eyebrow">01 / REMONTER LES LIENS</p><h2 id="map-title">Une marque, plusieurs dépendances</h2></div><span class="small-note">{dossier.relations.length} relations · {dossier.sources.length} sources</span></div>
    <div class="map-toolbar">
      <p>Cliquez sur un acteur ou un lien pour ouvrir ses preuves.</p>
      <div class="filters" data-peage-controls hidden role="group" aria-label="Mettre en évidence une couche">
        <button type="button" data-layer="all" aria-pressed="true">Tout</button>
        <button type="button" data-layer="capital" aria-pressed="false">Capital</button>
        <button type="button" data-layer="infrastructure" aria-pressed="false">Infrastructure</button>
        <button type="button" data-layer="contrat" aria-pressed="false">Contrat</button>
      </div>
    </div>
    <div class="explorer">
      <div class="map-area">
        <svg class="dependency-map" viewBox="0 0 760 530" width="760" height="530" aria-labelledby="network-title network-desc">
          <title id="network-title">Dext : capital, obligation et infrastructure</title>
          <desc id="network-desc">La réforme concerne l’entreprise, qui peut désigner Dext. Le groupe IRIS détient indirectement Dext. La PA de Dext utilise Serensia, acquise par Quadient. Cerfrance utilise aussi Serensia selon Quadient. Les liens ouvrent les preuves et leurs limites.</desc>
          <defs>
            {Object.keys(layerLabels).map(layer => <marker id={`arrow-${layer}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class={`arrow ${layer}`} d="M0 1L9 5L0 9Z" /></marker>)}
          </defs>
          {paths.map(path => (
            <a href={`#preuve-${path.id}`} data-relation={path.id} data-map-layer={path.layer} class={`graph-edge ${path.layer}`} aria-label={`Preuve : ${dossier.relations.find(relation => relation.id === path.id)!.title}`}>
              <path class="edge-hit" d={path.d} />
              <path class="edge-line" d={path.d} marker-end={`url(#arrow-${path.layer})`} />
              {path.label && <text class="edge-label" x={path.x} y={path.y} text-anchor="middle">{path.label}{path.sub && <tspan x={path.x} dy="18" class="edge-sub">{path.sub}</tspan>}</text>}
            </a>
          ))}
          {positions.map(position => (
            <a href={`#preuve-${position.relation}`} data-relation={position.relation} data-node={position.id} class={`graph-node ${position.id}`} aria-label={`${nodeFor(position.id).label} : ouvrir la relation documentée`}>
              <rect x={position.x} y={position.y} width={position.w} height={position.h} rx="7" />
              <text x={position.x + position.w / 2} y={position.y + (position.h === 51 ? 21 : 29)} text-anchor="middle" class="node-label">{nodeFor(position.id).label}</text>
              <text x={position.x + position.w / 2} y={position.y + (position.h === 51 ? 39 : 49)} text-anchor="middle" class="node-detail">{nodeFor(position.id).detail}</text>
            </a>
          ))}
          <text x="20" y="448" class="map-annotation"><tspan x="20">Même fournisseur</tspan><tspan x="20" dy="20">technique documenté.</tspan><tspan x="20" dy="27" class="annotation-small">Périmètres à confirmer</tspan><tspan x="20" dy="17" class="annotation-small">avant une migration.</tspan></text>
        </svg>
        <div class="mobile-map" aria-label="Relations de la carte">
          {dossier.relations.map(relation => (
            <a class={`mobile-relation ${relation.layer}`} href={`#preuve-${relation.id}`} data-relation={relation.id} data-map-layer={relation.layer} aria-label={`${layerLabels[relation.layer]} : ${nodeFor(relation.from).label} vers ${nodeFor(relation.to).label}. Ouvrir la preuve.`}>
              <span class="relation-kind">{layerLabels[relation.layer]}</span>
              <strong>{nodeFor(relation.from).label}<span aria-hidden="true"> → </span>{nodeFor(relation.to).label}</strong>
              <span>{relation.id === 'dext-serensia' ? 'Hébergement de la PA' : relation.id === 'iris-dext' ? '100 % indirects au 30 avril 2026' : relation.id === 'cerfrance-serensia' ? 'Marque blanche déclarée' : 'Ouvrir la preuve'} <b aria-hidden="true">↗</b></span>
            </a>
          ))}
        </div>
        <div class="legend" aria-label="Légende">
          {Object.entries(layerLabels).map(([layer, label]) => <span class={layer}><i aria-hidden="true"></i>{label}</span>)}
        </div>
        <p class="map-caption">Relations documentaires datées. Les flèches ne représentent ni des paiements ni le trajet réel d’une facture. PA : plateforme agréée.</p>
      </div>
      <div class="proofs" aria-label="Preuves des relations">
        <p class="proof-caption" data-peage-controls hidden aria-live="polite" data-selection-status>Preuve sélectionnée</p>
        {dossier.relations.map((relation, index) => (
          <article id={`preuve-${relation.id}`} data-proof={relation.id} class="proof" tabindex="-1">
            <div class="proof-badges"><span class={`category ${relation.layer}`}>{layerLabels[relation.layer]}</span><span>{relation.status === 'documente' ? 'Documenté' : 'Déclaration fournisseur'}</span></div>
            <h3>{relation.title}</h3>
            <p>{relation.statement}</p>
            <p class="evidence-date">Situation documentée : <time datetime={relation.asOf}>{date(relation.asOf)}</time></p>
            <div class="evidence-links">
              {relation.evidence.map(ref => {
                const source = sourceFor(ref.source);
                return <div><a href={source.url} target="_blank" rel="noopener noreferrer">{source.publisher} ↗</a><span>{ref.locator}</span><small>{date(source.datedOn)} · {source.dateKind}</small></div>;
              })}
            </div>
            <details class="proof-limit"><summary>Portée et limites</summary><p>{relation.limit}</p></details>
            <div class="next-question"><span>À DEMANDER</span><p>{relation.question}</p></div>
            <a class="permalink" href={`#preuve-${relation.id}`}>Lien vers cette preuve · {index + 1}/{dossier.relations.length}</a>
            <a class="back-to-map" href="#carte">← Revenir à la carte</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <aside class="cross-reading">
    <span class="eyebrow">LECTURE CROISÉE L0G</span>
    <p>Passer de Dext à une offre Cerfrance <strong>peut laisser Serensia dans la chaîne technique.</strong> Faites confirmer le périmètre de la nouvelle offre avant de conclure à une diversification.</p>
    <a href="#preuve-cerfrance-serensia" data-relation="cerfrance-serensia">Comparer les liens documentés ↗</a>
  </aside>

  <section id="sortie" class="exit-section" aria-labelledby="exit-title">
    <div class="section-top"><div><p class="eyebrow">02 / PRÉPARER LA SORTIE</p><h2 id="exit-title">Trois démarches, trois règles</h2></div></div>
    <p class="section-intro">Le changement de PA, l’échéance commerciale et la restitution des données se lisent séparément. Voici les repères des textes publics Dext.</p>
    <div class="exit-grid">
      {dossier.exits.map((exit, index) => (
        <article class="exit-card" id={`sortie-${exit.id}`}>
          <span class="exit-number">0{index + 1}</span><h3>{exit.title}</h3>
          <strong class="exit-timing">{exit.timing}</strong>
          <p>{exit.statement}</p>
          <p class="exit-limit">{exit.limit}</p>
          {exit.evidence.map(ref => <a href={sourceFor(ref.source).url} target="_blank" rel="noopener noreferrer">{sourceFor(ref.source).id === 'dext-dpa' ? 'DPA' : 'CGV'} · {ref.locator} ↗</a>)}
        </article>
      ))}
    </div>
    <p class="exit-footnote">Repères documentaires au {date(dossier.reviewedOn)}. Relisez les conditions particulières avant de fixer une date de départ.</p>
  </section>

  <section class="request-section" aria-labelledby="request-title">
    <div class="request-intro"><p class="eyebrow">03 / PASSER À L’ACTION</p><h2 id="request-title">Les pièces à réclamer</h2><p>Sélectionnez les questions utiles à votre dossier et emportez-les avec les références.</p><button type="button" class="export-button" data-export-questions hidden>Exporter mes 5 demandes ↓</button><p class="local-note">Sélection locale, aucun envoi au prestataire. L’export ne certifie pas l’obtention des pièces.</p><p class="export-status" data-export-status role="status"></p><details class="export-preview" data-export-preview hidden><summary>Lire ou copier le dernier export</summary><textarea readonly aria-label="Texte du dernier export préparé" rows="10"></textarea></details></div>
    <div class="request-list">
      {dossier.requests.map(request => (
        <div class="request-item" data-request-item>
          <label><input type="checkbox" value={request.id} checked data-request-check /><span><strong>{request.title}</strong><span data-request-question>{request.question}</span></span></label>
          <div class="request-refs">{request.relations.map(id => <a href={`#preuve-${id}`} data-relation={id}>Preuve : {nodeFor(dossier.relations.find(relation => relation.id === id)!.from).label} → {nodeFor(dossier.relations.find(relation => relation.id === id)!.to).label}</a>)}{request.exits.map(id => <a href={`#sortie-${id}`} data-exit-ref={id}>Clause : {dossier.exits.find(exit => exit.id === id)!.title}</a>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="method" aria-labelledby="method-title">
    <p class="eyebrow">PÉRIMÈTRE DE L’ENQUÊTE</p><h2 id="method-title">Des liens vérifiables, des inconnues visibles</h2>
    <div class="method-columns"><div><p>{dossier.scope}</p><p>Les rapports et contrats documentent leur contenu. Les communiqués engagent leur émetteur. La date de revue indique notre consultation, sans actualiser les périodes attestées.</p><p>Pour les fiches et parcours des plateformes : <a href="https://pa.l0g.fr/plateformes/dext/">Dext sur PA Check</a> et <a href="https://pa.l0g.fr/plateformes/serensia/">Serensia sur PA Check</a>.</p><p>Prolonger la lecture : <a href="/publications/grand-peage-facture/">l’enquête sur le grand péage de la facture</a>.</p></div><ul>{dossier.unknowns.map(unknown => <li>{unknown}</li>)}</ul></div>
    <details class="source-register"><summary>Ouvrir les {dossier.sources.length} sources primaires</summary><ol>{dossier.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a><span>{source.publisher} · {date(source.datedOn)} · {source.dateKind}</span></li>)}</ol></details>
    <div class="downloads"><a href="/peage/dossier.md" download>Dossier complet · Markdown ↓</a><a href="/peage/dossier.json" download>Relations et sources · JSON ↓</a></div>
  </section>
</div>

<script>
  import '../scripts/peage.ts';
</script>

<style>
  .peage { --capital: var(--color-amber); --infrastructure: var(--color-signal); --contrat: var(--color-accent); --obligation: var(--color-muted); color: var(--color-paper); font-family: var(--font-read); padding-bottom: 2rem; }
  .peage-header { padding: 1rem 0 2.2rem; }
  .identity { display: flex; align-items: baseline; gap: .65rem; font-family: var(--font-display); font-size: .75rem; color: var(--color-muted); }
  .wordmark { font-size: 1.5rem; font-weight: 800; letter-spacing: -.06em; color: var(--color-paper); }
  .cursor { color: var(--color-signal); }
  .dossier-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; margin: 1.2rem 0 .9rem; color: var(--color-muted); font: .68rem/1.6 var(--font-display); letter-spacing: .04em; }
  h1 { font-family: var(--font-read); font-size: clamp(1.8rem, 4vw, 3.2rem); line-height: 1.13; letter-spacing: -.045em; font-weight: 760; margin: 0 0 1rem; }
  h1 > span { color: var(--color-signal); }
  .intro { font-size: 1rem; color: var(--color-prose); max-width: 43rem; line-height: 1.65; }
  .header-links { display: flex; flex-wrap: wrap; gap: .7rem 1.4rem; margin-top: 1.3rem; font: .72rem/1.6 var(--font-display); }
  a { text-underline-offset: .22em; }
  .header-links a:first-child { color: var(--color-signal); }
  .header-links a, .downloads a { border-bottom: 1px solid var(--color-line-strong); padding-bottom: .2rem; }
  .map-section, .exit-section, .request-section, .method { scroll-margin-top: 1rem; }
  .section-top { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
  .eyebrow { font: .65rem/1.6 var(--font-display); color: var(--color-muted); letter-spacing: .1em; margin: 0 0 .45rem; }
  h2 { font: 650 clamp(1.15rem, 2.5vw, 1.5rem)/1.3 var(--font-read); letter-spacing: -.025em; margin: 0; }
  .small-note { color: var(--color-muted); font: .65rem/1.5 var(--font-display); flex-shrink: 0; }
  .map-toolbar { display: flex; justify-content: space-between; align-items: center; gap: .7rem; flex-wrap: wrap; margin: 1rem 0; }
  .map-toolbar > p { color: var(--color-muted); font-size: .78rem; margin: 0; }
  .filters { display: flex; flex-wrap: wrap; gap: .3rem; }
  .filters button { cursor: pointer; border: 1px solid var(--color-line-strong); border-radius: 4px; padding: .4rem .6rem; color: var(--color-muted); background: var(--color-surface); font: .65rem/1.5 var(--font-display); }
  .filters button[aria-pressed="true"] { background: var(--color-paper); border-color: var(--color-paper); color: var(--color-ink); }
  .explorer { display: grid; grid-template-columns: minmax(0, 1fr) 320px; border: 1px solid var(--color-line-strong); border-radius: 9px; overflow: clip; }
  .map-area { min-width: 0; padding: .85rem .6rem 1rem; background: var(--color-surface); }
  .dependency-map { width: 100%; height: auto; display: block; overflow: visible; }
  .graph-edge { color: var(--obligation); cursor: pointer; }
  .capital { --relation-color: var(--capital); color: var(--capital); }
  .infrastructure { --relation-color: var(--infrastructure); color: var(--infrastructure); }
  .contrat { --relation-color: var(--contrat); color: var(--contrat); }
  .obligation { --relation-color: var(--obligation); color: var(--obligation); }
  .arrow { fill: currentColor; }
  .edge-hit { fill: none; stroke: transparent; stroke-width: 22; }
  .edge-line { fill: none; stroke: currentColor; stroke-width: 1.8; }
  .graph-edge.contrat .edge-line, .graph-edge.obligation .edge-line { stroke-dasharray: 5 4; }
  .graph-edge.is-selected .edge-line { stroke-width: 3.8; }
  .edge-label { fill: currentColor; font: 500 13px var(--font-display); paint-order: stroke; stroke: var(--color-surface); stroke-width: 7; stroke-linejoin: round; }
  .edge-sub { font-size: 11px; }
  .graph-node rect { fill: var(--color-surface-2); stroke: var(--color-line-strong); stroke-width: 1.2; }
  .graph-node.dext rect, .graph-node.serensia rect { stroke: var(--color-signal); }
  .graph-node.is-selected rect { stroke: var(--color-signal); stroke-width: 2.2; }
  .node-label { font: 650 19px var(--font-read); fill: var(--color-paper); letter-spacing: -.3px; }
  .node-detail { font: 11px var(--font-display); fill: var(--color-muted); }
  .graph-node.investisseurs .node-label { font-size: 15px; }
  .map-annotation { fill: var(--color-paper); font: 500 14px var(--font-read); }
  .annotation-small { font-size: 12px; fill: var(--color-muted); }
  .graph-edge:hover .edge-line, .graph-edge:focus .edge-line { stroke-width: 4; }
  .graph-node:hover rect, .graph-node:focus rect { stroke: var(--color-paper); stroke-width: 2.5; }
  .graph-edge.is-muted { opacity: .18; }
  .legend { display: flex; justify-content: center; gap: .65rem 1rem; flex-wrap: wrap; font: .62rem var(--font-display); }
  .legend span { display: flex; align-items: center; gap: .35rem; }
  .legend i { width: 15px; border-top: 2px solid currentColor; }
  .legend .contrat i, .legend .obligation i { border-top-style: dashed; }
  .map-caption { color: var(--color-muted); font-size: .7rem; line-height: 1.6; margin: 1rem .5rem 0; }
  .proofs { padding: 1.15rem; border-left: 1px solid var(--color-line-strong); background: var(--color-ink); min-width: 0; }
  .proof-caption { color: var(--color-muted); font: .6rem/1.6 var(--font-display); margin: 0 0 .6rem; }
  .proof { scroll-margin-top: 1rem; }
  .proof + .proof { margin-top: 2rem; }
  .enhanced .proof + .proof { margin-top: 0; }
  .proof-badges { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; font: .58rem/1.5 var(--font-display); color: var(--color-muted); }
  .category { border: 1px solid currentColor; padding: .15rem .3rem; border-radius: 3px; }
  .proof h3 { font: 650 1.05rem/1.35 var(--font-read); letter-spacing: -.02em; margin: .8rem 0; }
  .proof > p { font-size: .8rem; line-height: 1.65; color: var(--color-prose); }
  .proof .evidence-date { font: .63rem/1.6 var(--font-display); color: var(--color-muted); margin: .8rem 0; }
  .evidence-links { display: grid; gap: .65rem; border-top: 1px solid var(--color-line); padding: .8rem 0; }
  .evidence-links a { color: var(--color-signal); font-size: .73rem; font-weight: 600; }
  .evidence-links span, .evidence-links small { display: block; font-size: .69rem; line-height: 1.5; margin-top: .15rem; color: var(--color-prose); }
  .evidence-links small { color: var(--color-muted); font-size: .6rem; }
  .proof-limit { border-top: 1px solid var(--color-line); padding-top: .55rem; font-size: .73rem; line-height: 1.6; color: var(--color-muted); }
  summary { cursor: pointer; }
  .proof-limit p { margin: .5rem 0; }
  .next-question { border-left: 2px solid var(--color-signal); padding-left: .7rem; margin: .9rem 0; }
  .next-question > span { font: .6rem var(--font-display); color: var(--color-signal); }
  .next-question > p { font-size: .76rem; line-height: 1.55; margin: .3rem 0 0; color: var(--color-prose); }
  .permalink { font: .6rem/1.6 var(--font-display); color: var(--color-muted); text-decoration: underline; }
  .back-to-map { display: none; color: var(--color-signal); font: .7rem/1.6 var(--font-display); margin-top: .8rem; }
  .cross-reading { display: grid; grid-template-columns: 155px minmax(0, 1fr); gap: .5rem 1.1rem; margin: 1.1rem 0 2.6rem; padding: 1.1rem 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .cross-reading > .eyebrow { padding-top: .2rem; }
  .cross-reading p { font-size: .87rem; line-height: 1.65; margin: 0; color: var(--color-prose); }
  .cross-reading strong { color: var(--color-paper); }
  .cross-reading a { grid-column: 2; color: var(--color-signal); font: .68rem/1.6 var(--font-display); }
  .section-intro { color: var(--color-prose); font-size: .87rem; line-height: 1.65; max-width: 51rem; margin: .8rem 0 1.2rem; }
  .exit-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .exit-card { padding: 1.1rem; border: 1px solid var(--color-line-strong); border-top: 3px solid var(--color-signal); border-radius: 5px; }
  .exit-card:nth-child(2) { border-top-color: var(--color-amber); }
  .exit-card:nth-child(3) { border-top-color: var(--color-accent); }
  .exit-number { font: .7rem var(--font-display); color: var(--color-muted); }
  .exit-card h3 { font-size: .94rem; font-weight: 600; margin: .5rem 0 1.15rem; }
  .exit-timing { font: 650 clamp(.94rem, 1.7vw, 1.15rem)/1.4 var(--font-display); color: var(--color-signal); display: block; }
  .exit-card:nth-child(2) .exit-timing { color: var(--color-amber); }
  .exit-card:nth-child(3) .exit-timing { color: var(--color-accent); }
