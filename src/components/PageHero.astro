---
import L0gGlyph, { type GlyphName } from './L0gGlyph.astro';

interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  index: string;
  kicker: string;
  title: string;
  highlight?: string;
  description: string;
  secondary?: string;
  glyph?: GlyphName;
  accent?: string;
  stats?: Stat[];
}

const {
  index,
  kicker,
  title,
  highlight,
  description,
  secondary,
  glyph = 'understand',
  accent = 'var(--color-signal)',
  stats = [],
} = Astro.props;
---

<section
  class="page-hero instrument-plate rise"
  style={`--hero-accent:${accent};--plate-accent:${accent}`}
  data-pagefind-ignore
>
  <div class="page-hero-top">
    <div class="page-hero-id">
      <span>{index}</span>
      <p>{kicker}</p>
    </div>
    <L0gGlyph name={glyph} size="lg" />
  </div>

  <h1>
    <slot name="title">
      {title}
      {highlight && <> <span>{highlight}</span></>}
    </slot>
  </h1>

  <p class="page-hero-lede">{description}</p>
  {secondary && <p class="page-hero-secondary">{secondary}</p>}

  {stats.length > 0 && (
    <dl class="page-hero-stats">
      {stats.map((stat) => (
        <div>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))}
    </dl>
  )}

  <slot />
</section>

<style>
  .page-hero {
    --hero-accent: var(--color-signal);
    padding: clamp(1.1rem, 2.5vw, 1.7rem);
    background: radial-gradient(ellipse at 0 0, color-mix(in srgb, var(--hero-accent) 5%, transparent), transparent 65%),
      linear-gradient(125deg, transparent 40%, color-mix(in srgb, var(--color-accent) 3%, transparent)), var(--surface-elevated);
    box-shadow: inset 0 1px 0 var(--edge-highlight);
  }
  .page-hero-top { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .page-hero-top :global(.l0g-glyph) { --glyph-color:var(--hero-accent); --glyph-size:2.25rem; }
  .page-hero-id { display:flex; align-items:center; gap:.65rem; font-family:var(--font-mono); }
  .page-hero-id > span { color:var(--hero-accent); font-size:.7rem; font-variant-numeric:tabular-nums; }
  .page-hero-id p { color:var(--color-muted); font-size:.66rem; font-weight:400; letter-spacing:.1em; text-transform:uppercase; }
  .page-hero h1 { max-width:32ch; margin-top:.85rem; color:var(--color-bright); font:450 var(--page-title-size, clamp(1.55rem, 3.1vw, 2.45rem))/1.22 var(--font-display); letter-spacing:-.035em; text-wrap:balance; }
  .page-hero h1 span { color:var(--hero-accent); }
  .page-hero-lede { max-width:65ch; margin-top:.8rem; color:var(--color-paper); font:400 1rem/1.65 var(--font-read); }
  .page-hero-secondary { max-width:70ch; margin-top:.6rem; color:var(--color-muted); font:400 .8rem/1.65 var(--font-read); }
  .page-hero-stats { display:flex; flex-wrap:wrap; gap:.8rem 1.6rem; margin-top:1.1rem; padding-top:.85rem; border-top:1px solid var(--color-line); }
  .page-hero-stats div { display:flex; align-items:baseline; flex-wrap:wrap; gap:.35rem; min-width:0; }
  .page-hero-stats dt { order:1; color:var(--color-muted); font:400 .68rem/1.5 var(--font-read); }
  .page-hero-stats dd { color:var(--hero-accent); font:400 .86rem/1.5 var(--font-mono); font-variant-numeric:tabular-nums; }
  @media(max-width:540px) { .page-hero { padding:1rem; }.page-hero h1 { max-width:100%; font-size:var(--page-title-size, 1.55rem); }.page-hero-lede { font-size:.92rem; }.page-hero-stats { gap:.5rem 1rem; } }
  @media(prefers-reduced-motion:reduce) { .page-hero { animation:none; } }
</style>
