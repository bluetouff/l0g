---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CollectionFilter from '../../components/CollectionFilter.astro';
import {
  primaryInstitutions,
  primarySourcesUpdated,
  primarySourcesUpdatedIso,
  primarySourceUrl,
} from '../../config/primary-sources.ts';

const site = (Astro.site?.toString() ?? 'https://l0g.fr/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}/sources/#primary-sources`,
  name: 'Sources primaires l0g',
  description:
    'Pages de lecture des institutions primaires utilisées par l0g : SEC, Fed, BIS, FMI, FSB, BCE, CFTC, EIA, Treasury TIC, BLS et BEA.',
  inLanguage: 'fr',
  isAccessibleForFree: true,
  dateModified: primarySourcesUpdatedIso,
  publisher: { '@id': `${site}/#org` },
  mainEntity: primaryInstitutions.map((source) => ({
    '@type': 'Organization',
    name: source.name,
    url: source.url,
    description: source.description,
  })),
};
const safeJsonLd = JSON.stringify(jsonLd).replace(/</g, '\\u003c');


---

<BaseLayout
  title="Sources primaires"
  description="Les institutions que l0g utilise comme points d'ancrage : quoi lire, pourquoi, limites, cadence et liens de vérification."
  sidebar={false}

  alternateLinks={[{ hreflang: 'fr', href: new URL('/sources/', Astro.site).toString() }, { hreflang: 'en', href: new URL('/en/sources/', Astro.site).toString() }, { hreflang: 'x-default', href: new URL('/sources/', Astro.site).toString() }]}>
  <p class="language-switch mono-label" data-pagefind-ignore style="color: var(--color-signal)">
    <a href="/en/sources/" class="link-term">English version available →</a>
  </p>

  <script type="application/ld+json" is:inline set:html={safeJsonLd} />

  <article class="sources-page rise" data-pagefind-body>
    <PageHero index="04" kicker="sources primaires" title="Revenir aux documents" highlight="d’origine."
      description="Institutions, jeux de données et documents utilisés dans les enquêtes. Retrouvez leur cadence, leur périmètre et leurs limites."
      glyph="source" stats={[{value:primaryInstitutions.length,label:'institutions documentées'},{value:primarySourcesUpdated,label:'révision du répertoire'}]} />
    <section class="sources-section" id="institutions" data-filter-collection>
      <CollectionFilter label="Trouver une institution ou un document" placeholder="SEC, inflation, pétrole, sanctions…" />
      <h2 class="sources-heading">Les institutions de référence</h2>

      <div class="institution-grid">
        {primaryInstitutions.map((source) => (
          <article class="institution-card" data-filter-card data-filter-text={[source.shortName,source.name,source.category,source.description,...source.readFor,...source.datasets.map(item=>item.name)].join(' ')} style={`--accent:${source.accent}`}>
            <header><span class="institution-k">{source.shortName}</span><span class="institution-count">{source.datasets.length} document{source.datasets.length>1?'s':''}</span></header>
            <h3><a href={primarySourceUrl(source.slug)}>{source.name}</a></h3>
            <p class="institution-category">{source.category}</p>
            <p>{source.description}</p>
            <dl class="institution-data"><div><dt>À consulter</dt><dd>{source.datasets[0]?.name}</dd></div><div><dt>Cadence</dt><dd>{source.datasets[0]?.cadence}</dd></div></dl>
            <details><summary>Usage et limites</summary><p>{source.readFor[0]}</p><ul>{source.limits.map(limit=><li>{limit}</li>)}</ul></details>
            <a class="institution-open" href={primarySourceUrl(source.slug)}>Documents et méthode de lecture <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>
  </article>

  <style>
    .sources-page { max-width:none; }.sources-section { margin-top:1.5rem; }
    .sources-heading { font:450 1.1rem/1.5 var(--font-display);color:var(--color-paper); }
    .institution-grid { grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem; }
    .institution-card { --accent:var(--color-signal);display:flex;flex-direction:column;border:1px solid var(--color-line);min-height:0;gap:.65rem;padding:1.2rem;border-radius:12px;background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 3%,transparent),transparent 60%),var(--color-surface);font-family:var(--font-read); }
    .institution-card header { display:flex;justify-content:space-between;align-items:center;gap:.75rem; }
    .institution-k { display:grid;align-items:center;min-height:2rem;letter-spacing:.02em;font-weight:400; }
    .institution-count { color:var(--color-muted);font-size:.65rem; }
    .institution-card h3 { margin:0;font:450 1.02rem/1.4 var(--font-read); }.institution-card p { color:var(--color-muted);font:400 .85rem/1.7 var(--font-read);margin:0; }.institution-card h3 a { color:var(--color-paper); }.institution-category { font-size:.68rem!important;color:var(--accent)!important; }
    .institution-data { display:grid;gap:.65rem;padding-block:.75rem;border-block:1px solid var(--color-line); }
    .institution-data dt { color:var(--color-muted);font-size:.65rem; }.institution-data dd { color:var(--color-paper);font-size:.77rem;line-height:1.6;margin-top:.2rem; }
    .institution-card details { color:var(--color-muted);font-size:.76rem;line-height:1.65; }.institution-card summary { min-height:44px;cursor:pointer;padding:.6rem 0; }.institution-card li { margin:.45rem 0; }
    .institution-open { display:flex;justify-content:space-between;align-items:center;gap:.6rem;margin-top:auto;min-height:44px;color:var(--color-signal);font-size:.75rem; }
    .institution-card :is(a,summary):focus-visible { outline:2px solid var(--color-signal);outline-offset:4px; }
    @media(max-width:1050px) { .institution-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:600px) { .institution-grid { grid-template-columns:1fr; } }
  </style>
</BaseLayout>
