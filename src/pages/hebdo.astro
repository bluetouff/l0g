---
import { getCollection } from 'astro:content';
import '../styles/weekly-magazine.css';
import WeeklyMasthead from '../components/WeeklyMasthead.astro';
import { weeklyIllustrations, weeklyCoverImage, weeklyCoverTitle, weeklyDate } from '../lib/weekly-presentation.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyIssue from '../components/WeeklyIssue.astro';
import { latestWeeklyEdition, weeklyEditions } from '../config/weekly-editions.ts';
import { serializeInlineScriptData } from '../lib/security.ts';

const edition = latestWeeklyEdition();
const illustrations = weeklyIllustrations(await getCollection('posts'));
const archiveYears = new Map<string, typeof weeklyEditions>();
for (const item of weeklyEditions.filter((item) => item.slug !== edition.slug).sort((left, right) => right.publishedAt.localeCompare(left.publishedAt))) {
  const year = item.publishedAt.slice(0, 4);
  archiveYears.set(year, [...(archiveYears.get(year) ?? []), item]);
}
const site = (Astro.site?.toString() ?? 'https://l0g.fr/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Periodical', '@id': `${site}/hebdo/#periodical`,
  name: 'L’hebdo l0g', description: 'La revue de la semaine : des dossiers expliqués, leurs sources et les prochaines vérifications.',
  url: `${site}/hebdo/`, inLanguage: 'fr', isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/', publisher: { '@id': `${site}/#org` },
};
---

<BaseLayout title="L’hebdo l0g : la revue de la semaine" description="Une lecture des dossiers de la semaine, leurs mécanismes, leurs limites et les prochaines vérifications. Sources, analyses et archives en accès libre." sidebar={false}>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(jsonLd)} />
  <div class="weekly-magazine weekly-page">
    <WeeklyMasthead home />
    <WeeklyIssue edition={edition} illustrations={illustrations} />
    <p class="edition-permalink"><a href={`/hebdo/${edition.slug}/`}>Le lien permanent de cette édition <span aria-hidden="true">↗</span></a></p>

    <section class="watch-boundary" aria-labelledby="watch-title">
      <div><p class="magazine-eyebrow">Après la lecture</p><h2 id="watch-title">L’Hebdo explique. Watch surveille.</h2><p>Retrouvez les nouveaux éléments et gardez votre historique de veille dans l0g Watch.</p></div>
      <a href="https://watch.l0g.fr/" target="_blank" rel="noopener noreferrer">Découvrir Watch <span aria-hidden="true">↗</span></a>
    </section>

    <section class="weekly-archive" id="archives" aria-labelledby="archive-title">
      <div class="archive-head"><div><p class="magazine-eyebrow">La bibliothèque de l’Hebdo</p><h2 id="archive-title">Les éditions précédentes</h2></div><p>Un autre dimanche, un autre regard.</p></div>
      {[...archiveYears].map(([year, editions]) => <section class="archive-year" aria-labelledby={`archive-${year}`}>
        <h3 id={`archive-${year}`}>{year}<span>{editions.length} éditions</span></h3>
        <ol class="archive-grid">{editions.map((item) => <li>
          <a class="archive-card" href={`/hebdo/${item.slug}/`}>
            <div class="archive-art">
              {weeklyCoverImage(item, illustrations) ? <img src={weeklyCoverImage(item, illustrations)} alt="" width="1200" height="630" loading="lazy" decoding="async" /> : <span class="archive-monogram" aria-hidden="true">l0g</span>}
              <span class="archive-number">N° {String(item.issue).padStart(2, '0')}</span>
            </div>
            <div class="archive-caption"><time datetime={item.publishedAt}>{weeklyDate(item.publishedAt, true)}</time><h4>{weeklyCoverTitle(item)}</h4><span class="archive-open">Ouvrir le numéro <span aria-hidden="true">↗</span></span></div>
          </a>
        </li>)}</ol>
      </section>)}
    </section>
  </div>
</BaseLayout>
