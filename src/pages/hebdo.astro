---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeeklyIssue from '../components/WeeklyIssue.astro';
import {
  WEEKLY_SCHEDULE,
  latestWeeklyEdition,
  weeklyEditions,
} from '../config/weekly-editions.ts';
import { serializeInlineScriptData } from '../lib/security.ts';

const edition = latestWeeklyEdition();
const archiveYears = new Map<string, typeof weeklyEditions>();
for (const item of [...weeklyEditions].sort((left, right) => right.publishedAt.localeCompare(left.publishedAt))) {
  const year = item.publishedAt.slice(0, 4);
  archiveYears.set(year, [...(archiveYears.get(year) ?? []), item]);
}
const site = (Astro.site?.toString() ?? 'https://l0g.fr/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Periodical',
  '@id': `${site}/hebdo/#periodical`,
  name: "L'hebdo l0g",
  description: 'Une édition hebdomadaire centrée sur un chiffre, son mécanisme, son prochain test et des formats faciles à réutiliser.',
  url: `${site}/hebdo/`,
  inLanguage: 'fr',
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  publisher: { '@id': `${site}/#org` },
};
---

<BaseLayout
  title="L’hebdo l0g : un chiffre, un mécanisme, un test"
  description="Chaque dimanche, une analyse centrée sur un chiffre, son mécanisme, le test suivant, un graphique SVG, son CSV et les formats à réutiliser."
  sidebar={false}
>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(jsonLd)} />

  <main class="weekly-page">
    <header class="weekly-hero rise">
      <div class="hero-copy">
        <p class="mono-label">// l’hebdo l0g</p>
        <h1>Une idée forte, lisible en quelques minutes.</h1>
        <p class="hero-lede">
          Chaque dimanche, l’Hebdo isole un chiffre, explique son mécanisme et indique ce qu’il
          faudra vérifier ensuite. Le graphique, les données et les sources restent accessibles.
        </p>
        <dl class="delivery-contract">
          <div><dt>nouvelle édition</dt><dd>{WEEKLY_SCHEDULE.weekday}</dd></div>
          <div><dt>heure</dt><dd>{WEEKLY_SCHEDULE.time}</dd></div>
          <div><dt>fuseau</dt><dd>{WEEKLY_SCHEDULE.timeZone}</dd></div>
          <div><dt>accès</dt><dd>libre</dd></div>
        </dl>
      </div>
    </header>

    <WeeklyIssue edition={edition} />

    <section class="factory" aria-labelledby="factory-title">
      <div class="factory-head">
        <div>
          <p class="mono-label">// tous les formats</p>
          <h2 id="factory-title">Un même sujet, six façons de l’utiliser.</h2>
        </div>
        <span>1 → 6</span>
      </div>
      <ol>
        <li><span>01</span><strong>Analyse ou dossier</strong><p>Le raisonnement complet, les sources et les limites.</p></li>
        <li><span>02</span><strong>SVG + CSV</strong><p>Le graphique et les données exactes qui le produisent.</p></li>
        <li><span>03</span><strong>Citation</strong><p>Un extrait attribué, prêt à reprendre sans déformer.</p></li>
        <li><span>04</span><strong>LinkedIn</strong><p>Un post construit autour du chiffre central.</p></li>
        <li><span>05</span><strong>Thread X</strong><p>Le mécanisme découpé, avec sa limite et son lien canonique.</p></li>
        <li><span>06</span><strong>Édition web</strong><p>La lecture courte, sourcée et conservée à une adresse stable.</p></li>
      </ol>
    </section>

    <section class="watch-boundary" aria-labelledby="watch-title">
      <div class="watch-mark" aria-hidden="true"><span>7j</span><i></i><b>veille</b></div>
      <div>
        <p class="mono-label">// deux rythmes complémentaires</p>
        <h2 id="watch-title">L’Hebdo explique. Watch surveille.</h2>
        <p>
          L’Hebdo propose une lecture publique chaque semaine. l0g Watch conserve votre historique
          de veille et vous alerte lorsque de nouveaux éléments vérifiables apparaissent.
        </p>
        <a href="https://watch.l0g.fr/" target="_blank" rel="noopener noreferrer">Découvrir l0g Watch <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="weekly-archive" aria-labelledby="archive-title">
      <div class="archive-head">
        <div>
          <p class="mono-label">// archives</p>
          <h2 id="archive-title">Toutes les éditions gardent une URL stable.</h2>
        </div>
        <a href="/hebdo/rss.xml" type="application/rss+xml">Flux RSS de l’Hebdo</a>
      </div>
      {[...archiveYears].map(([year, editions]) => (
        <section class="archive-year" aria-labelledby={`archive-${year}`}>
          <h3 id={`archive-${year}`}>{year} <span>{editions.length} édition{editions.length > 1 ? 's' : ''}</span></h3>
          <ol>
            {editions.map((item) => (
            <li>
              <span>{String(item.issue).padStart(2, '0')}</span>
              <a href={`/hebdo/${item.slug}/`}>{item.title}</a>
              <time datetime={item.publishedAt}>{new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeZone: 'Europe/Paris' }).format(new Date(item.publishedAt))}</time>
            </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
  </main>

  <style>
    .weekly-page { max-width: 72rem; margin: 0 auto; }
    .weekly-hero { display: grid; gap: 1.2rem; }
    .hero-copy {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--color-line);
      border-radius: 16px 4px 16px 16px;
      padding: clamp(1.3rem, 4vw, 2.4rem);
      background:
        radial-gradient(70% 100% at 100% 0, color-mix(in srgb, var(--color-accent) 9%, transparent), transparent 72%),
        radial-gradient(85% 120% at 0 100%, color-mix(in srgb, var(--color-signal) 10%, transparent), transparent 70%),
        var(--color-surface);
    }
    .hero-copy::after { content: '7j'; position: absolute; right: clamp(1rem, 4vw, 2rem); top: 0.5rem; color: color-mix(in srgb, var(--color-line-strong) 58%, transparent); font-family: var(--font-display); font-size: clamp(5rem, 16vw, 10rem); font-weight: 800; line-height: 1; pointer-events: none; }
    .hero-copy > * { position: relative; z-index: 1; }
    .hero-copy .mono-label { color: var(--color-signal); }
    .hero-copy h1 { max-width: 48rem; margin-top: 0.8rem; color: var(--color-bright); font-family: var(--font-display); font-size: clamp(2.2rem, 6vw, 4.5rem); line-height: 0.98; letter-spacing: -0.05em; text-wrap: balance; }
    .hero-lede { max-width: 46rem; margin-top: 1.2rem; border-left: 2px solid var(--color-signal); padding-left: 1rem; color: var(--color-paper); font-family: var(--font-read); font-size: clamp(1rem, 2vw, 1.18rem); line-height: 1.7; }
    .delivery-contract { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; overflow: hidden; margin-top: 1.5rem; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-line); }
    .delivery-contract div { display: flex; flex-direction: column-reverse; padding: 0.72rem; background: color-mix(in srgb, var(--color-surface) 82%, var(--color-ink)); }
    .delivery-contract dt { color: var(--color-muted); font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .delivery-contract dd { margin-bottom: 0.15rem; color: var(--color-signal); font-family: var(--font-display); font-size: 0.9rem; font-weight: 700; }
    .factory, .watch-boundary, .weekly-archive { margin-top: clamp(4rem, 9vw, 7rem); }
    .factory-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
    .factory .mono-label, .weekly-archive .mono-label { color: var(--color-signal); }
    .factory h2, .watch-boundary h2, .weekly-archive h2 { margin-top: 0.55rem; color: var(--color-bright); font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.35rem); line-height: 1.12; }
    .factory-head > span { color: var(--color-line-strong); font-family: var(--font-display); font-size: 2rem; }
    .factory ol { display: grid; gap: 1px; overflow: hidden; margin-top: 1.1rem; border: 1px solid var(--color-line); border-radius: 14px 4px 14px 14px; background: var(--color-line); }
    .factory li { min-width: 0; padding: 1rem; background: var(--color-surface); list-style: none; }
    .factory li > span { color: var(--color-line-strong); font-family: var(--font-display); font-size: 1.7rem; }
    .factory li strong { display: block; margin-top: 0.55rem; color: var(--color-bright); }
    .factory li p { margin-top: 0.4rem; color: var(--color-muted); font-size: 0.74rem; line-height: 1.5; }
    .watch-boundary { display: grid; gap: 1.2rem; border: 1px solid color-mix(in srgb, var(--color-accent) 38%, var(--color-line)); border-radius: 4px 16px 16px 16px; padding: clamp(1.2rem, 4vw, 2rem); background: radial-gradient(70% 100% at 0 0, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 72%), var(--color-surface); }
    .watch-mark { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .65rem; color: var(--color-muted); font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; }
    .watch-mark i { display: block; width: .45rem; height: .45rem; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 65%, transparent); }
    .watch-mark b { color: var(--color-accent); font-weight: 700; }
    .watch-boundary .mono-label { color: var(--color-accent); }
    .watch-boundary p:not(.mono-label) { max-width: 48rem; margin-top: 0.7rem; color: var(--color-muted); line-height: 1.65; }
    .watch-boundary a { display: inline-block; margin-top: 1rem; border: 1px solid color-mix(in srgb, var(--color-accent) 55%, var(--color-line)); border-radius: 999px; padding: .55rem .75rem; color: var(--color-accent); font-family: var(--font-mono); font-size: .65rem; font-weight: 700; text-transform: uppercase; }
    .watch-boundary a:hover { color: var(--color-ink); background: var(--color-accent); }
    .archive-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; }
    .archive-head > a { color: var(--color-signal); font-family: var(--font-mono); font-size: .64rem; text-transform: uppercase; }
    .archive-year { margin-top: 1.5rem; }
    .archive-year h3 { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; color: var(--color-bright); font-family: var(--font-display); font-size: 1.2rem; }
    .archive-year h3 span { color: var(--color-muted); font-family: var(--font-mono); font-size: .6rem; font-weight: 400; text-transform: uppercase; }
    .archive-year > ol { margin-top: .65rem; border-top: 1px solid var(--color-line); }
    .weekly-archive li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.8rem; align-items: center; border-bottom: 1px solid var(--color-line); padding: 0.85rem 0; }
    .weekly-archive li > span { color: var(--color-signal); font-family: var(--font-mono); font-size: 0.66rem; }
    .weekly-archive a { color: var(--color-bright); font-weight: 650; }
    .weekly-archive time { color: var(--color-muted); font-family: var(--font-mono); font-size: 0.62rem; }
    @media (min-width: 760px) {
      .factory ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .watch-boundary { grid-template-columns: 10rem minmax(0, 1fr); align-items: center; }
    }
    @media (max-width: 600px) {
      .delivery-contract { grid-template-columns: 1fr; }
      .weekly-archive li { grid-template-columns: auto minmax(0, 1fr); }
      .weekly-archive time { grid-column: 2; }
    }
  </style>
</BaseLayout>
