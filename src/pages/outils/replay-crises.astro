---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrisisGallery from '../../components/CrisisGallery.astro';
import { crisisCollection, getCrisisGallery } from '../../config/crisis-gallery';
import { serializeInlineScriptData } from '../../lib/security';
const lang='fr';
const meta=crisisCollection[lang];
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const collection={'@context':'https://schema.org','@type':'CollectionPage',name:meta.title,description:meta.description,url:canonical,mainEntity:{'@type':'ItemList',itemListElement:getCrisisGallery(lang).map((episode,index)=>({'@type':'ListItem',position:index+1,item:{'@type':'WebPage',name:episode.name[lang],url:new URL(episode.href,Astro.site).toString(),image:new URL(`/illustrations/crisis-replay/og/${episode.id}-${lang}.jpg`,Astro.site).toString()}}))}};
---
<BaseLayout title={meta.title} description={meta.description} ogImage="/illustrations/crisis-replay/og/collection-fr.jpg" ogImageAlt="Cinq illustrations des crises des gilts, de SVB, de Terra / Luna, d’AIG et de LTCM." sidebar={false} alternateLinks={[
  {hreflang:'fr',href:new URL('/outils/replay-crises/',Astro.site).toString()},
  {hreflang:'en',href:new URL('/en/tools/crisis-replay/',Astro.site).toString()},
  {hreflang:'x-default',href:new URL('/outils/replay-crises/',Astro.site).toString()},
]}>
  <script type="application/ld+json" set:html={serializeInlineScriptData(collection)} />
  <CrisisGallery lang={lang} />
</BaseLayout>
