---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrisisReplay from '../../../components/CrisisReplay.astro';
import { crisisGallery } from '../../../config/crisis-gallery';
---
<BaseLayout title={crisisGallery.cash2020.name.fr} description={crisisGallery.cash2020.summary.fr} ogImage="/illustrations/crisis-replay/og/cash2020-fr.jpg" ogImageAlt={crisisGallery.cash2020.alt.fr} sidebar={false} alternateLinks={[
  {hreflang:'fr',href:new URL('/outils/replay-crises/ruee-vers-le-cash/',Astro.site).toString()},
  {hreflang:'en',href:new URL('/en/tools/crisis-replay/dash-for-cash/',Astro.site).toString()},
  {hreflang:'x-default',href:new URL('/outils/replay-crises/ruee-vers-le-cash/',Astro.site).toString()},
]}>
  <link rel="stylesheet" href="/styles/article-sources-v1.css" />
  <CrisisReplay lang="fr" episodeId="cash2020" />
</BaseLayout>
