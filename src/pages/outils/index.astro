---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnalysisToolsCatalogue from '../../components/AnalysisToolsCatalogue.astro';
import { analysisTools } from '../../config/analysis-tools.ts';
import { serializeInlineScriptData } from '../../lib/security.ts';

const SITE = (Astro.site?.toString() ?? 'https://l0g.fr/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Outils d’analyse l0g',
  description: 'Simulateurs économiques interactifs, sourcés, gratuits et sans tracker.', url: `${SITE}/outils/`, inLanguage: 'fr',
  mainEntity: { '@type': 'ItemList', numberOfItems: analysisTools.length, itemListElement: analysisTools.map((tool, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@type': 'WebApplication', name: tool.fr.title, url: `${SITE}${tool.fr.href}`, description: tool.fr.description, applicationCategory: 'EducationalApplication', isAccessibleForFree: true } })) },
};
---

<BaseLayout seoTitle="Outils d’analyse économique et simulateurs | l0g" ogTitle="Le laboratoire d’analyse interactif de l0g" title="Laboratoire d’analyse" description="Outils économiques interactifs pour tester des hypothèses, comprendre les mécanismes et prolonger les enquêtes l0g. Gratuits, sourcés et sans tracker." sidebar={false} alternateLinks={[
  { hreflang: 'fr', href: new URL('/outils/', Astro.site).toString() },
  { hreflang: 'en', href: new URL('/en/tools/', Astro.site).toString() },
  { hreflang: 'x-default', href: new URL('/outils/', Astro.site).toString() },
]}>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(jsonLd)} />
  <AnalysisToolsCatalogue language="fr" />
</BaseLayout>
