---
import { getCollection } from 'astro:content';
import '../../styles/weekly-magazine.css';
import WeeklyMasthead from '../../components/WeeklyMasthead.astro';
import { weeklyIllustrations, weeklyCoverTitle } from '../../lib/weekly-presentation.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeeklyIssue from '../../components/WeeklyIssue.astro';
import { weeklyEditions } from '../../config/weekly-editions.ts';

export async function getStaticPaths() {
  const illustrations = weeklyIllustrations(await getCollection('posts'));
  const editions = [...weeklyEditions].sort((left, right) => left.publishedAt.localeCompare(right.publishedAt));
  return editions.map((edition, index) => ({
    params: { slug: edition.slug },
    props: {
      edition,
      illustrations,
      older: editions[index - 1],
      newer: editions[index + 1],
    },
  }));
}

const { edition, older, newer, illustrations } = Astro.props;
---

<BaseLayout title={`${edition.title} · L’hebdo`} description={edition.description} sidebar={false}>
  <div class="weekly-magazine issue-page">
    <WeeklyMasthead />
    <a class="back" href="/hebdo/">← La collection</a>
    <WeeklyIssue edition={edition} headingLevel="h1" illustrations={illustrations} />
    <nav class="issue-navigation" aria-label="Naviguer entre les éditions de l’Hebdo">
      {older
        ? <a href={`/hebdo/${older.slug}/`} rel="prev"><span>édition précédente</span><strong>{String(older.issue).padStart(2, '0')} · {weeklyCoverTitle(older)}</strong></a>
        : <span aria-hidden="true"></span>}
      <a class="all" href="/hebdo/">Toutes les éditions</a>
      {newer
        ? <a href={`/hebdo/${newer.slug}/`} rel="next"><span>édition suivante</span><strong>{String(newer.issue).padStart(2, '0')} · {weeklyCoverTitle(newer)}</strong></a>
        : <span aria-hidden="true"></span>}
    </nav>
  </div>
</BaseLayout>
