---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnalysisPagination from '../components/AnalysisPagination.astro';
import ConfluenceEntry from '../components/ConfluenceEntry.astro';
import PublicationDates from '../components/PublicationDates.astro';
import ReadingLibrary from '../components/ReadingLibrary.astro';
import PostCard from '../components/PostCard.astro';
import DiscoveryCard from '../components/DiscoveryCard.astro';
import ReadingDiscovery from '../components/ReadingDiscovery.astro';
import ReadingContinue from '../components/ReadingContinue.astro';
import { buildDiscoveryCatalog } from '../lib/reading-discovery.ts';
import { selectHomeFeaturedPost, sortPostsByPublicationDate } from '../lib/content-order.mjs';
import { keepFrenchPunctuation } from '../lib/typography.ts';
import '../styles/home.css';
import RiskBand from '../components/RiskBand.astro';
import { readingTime } from '../lib/reading-time.ts';
import { accentForTags, topicLabelForTags } from '../config/topics.ts';

type PostEntry = CollectionEntry<'posts'>;
type PaginatedPosts = {
  data: PostEntry[];
  start: number;
  currentPage: number;
  lastPage: number;
  total: number;
  url: {
    prev?: string;
    next?: string;
  };
};

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = sortPostsByPublicationDate(await getCollection('posts', ({ data }) => !data.draft));
  const homeFeaturedPost = selectHomeFeaturedPost(posts);
  return paginate(posts, { pageSize: 10 }).map((path) => ({
    ...path,
    props: {
      ...path.props,
      homeFeaturedPost: path.props.page.currentPage === 1 ? homeFeaturedPost : null,
    },
  }));
}

const { page, homeFeaturedPost } = Astro.props as { page: PaginatedPosts; homeFeaturedPost: PostEntry | null };
const isFirst = page.currentPage === 1;
const pageTitle = isFirst
  ? 'l0g : les angles morts de la finance'
  : `Analyses financières, page ${page.currentPage}`;
const pageDescription = isFirst
  ? 'Enquêtes sur les mécanismes financiers invisibles : bilans, collatéral, crédit privé, levier et chaînes de contagion.'
  : `Archives des analyses l0g sur la finance, la macroéconomie, le crédit et les risques systémiques, page ${page.currentPage} sur ${page.lastPage}.`;

const items = page.data.map((post: PostEntry, i: number) => ({
  post,
  absIndex: page.start + i + 1,
  accent: accentForTags(post.data.tags || []),
  accentLabel: topicLabelForTags(post.data.tags || []),
  rt: readingTime(post.body),
}));
const hero = isFirst && homeFeaturedPost ? {
  post: homeFeaturedPost,
  accent: accentForTags(homeFeaturedPost.data.tags || []),
  accentLabel: topicLabelForTags(homeFeaturedPost.data.tags || []),
  rt: readingTime(homeFeaturedPost.body),
} : null;
const feed = isFirst && hero ? items.filter((item) => item.post.id !== hero.post.id) : items;
const discoveryEntries = buildDiscoveryCatalog(feed.map(it => it.post));
const discoveryByPath = new Map(discoveryEntries.map(entry => [entry.path, entry]));
const pageHref = (n: number) => (n <= 1 ? '/' : `/${n}/`);
const needCards = [
  {
    title: 'Financement de l’IA', href: '/dossiers/financement-ia/',
    description: 'Capitaux, infrastructures et bilans.', label: 'Dossier',
  },
  {
    title: 'Suivre un risque', href: '/radar/',
    description: 'Indicateurs, sources et signaux croisés.', label: 'Radar',
  },
  {
    title: 'Vérifier un chiffre', href: '/preuves/',
    description: 'Remonter aux données et à la méthode.', label: 'Preuves',
  },
  {
    title: 'Crédit privé et assurance', href: '/dossiers/credit-prive-assurance/',
    description: 'Prêts, assureurs et chaînes de risque.', label: 'Dossier',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={isFirst ? '/og-home.png' : '/og-default.png'}
  ogImageAlt={isFirst ? 'l0g : les angles morts de la finance, économie, marchés et risques sur un dégradé turquoise, rose et ambre' : undefined}
  sidebar={!isFirst}
  home={isFirst}
>
  {isFirst && <ReadingLibrary slot="header-tools" lang="fr" variant="header" />}
  <div class:list={{ 'home-page': isFirst }}>
  {isFirst && (
    <section class="home-intro">
      <div>
        <p class="home-kicker"><span class="home-cut" aria-hidden="true"></span>Économie · marchés · risques</p>
        <h1><span class="home-title-gradient">Les angles morts</span> de la finance.</h1>
      </div>
      <div class="home-intro-copy">
        <p>Des enquêtes indépendantes et des données traçables pour lire les mécanismes de l’économie.</p>
        <a href="/atlas/" class="home-action primary">Explorer les atlas <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  )}

  {isFirst && <RiskBand summary />}

  {!isFirst && (
    <header class="rise border-b border-dashed border-line pb-8">
      <p class="mono-label" style="color: var(--color-signal)">$ ls /analyses | page {page.currentPage}</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,5vw,3rem)] leading-tight tracking-wider glow">
        Analyses financières <span style="color: var(--color-accent)">, page {page.currentPage}</span>
      </h1>
      <p class="mt-4 max-w-xl text-muted">
        Archives des enquêtes l0g, de la plus récente à la plus ancienne.
      </p>
    </header>
  )}

  {isFirst && <ReadingContinue />}

  {isFirst && <div class="home-lead">{hero && (
    <section class="home-featured" aria-labelledby="featured-title">
      <p class="home-section-label"><span>01</span><i class="home-cut" aria-hidden="true"></i>À la une <span class="home-featured-date"><PublicationDates pubDate={hero.post.data.pubDate} updatedDate={hero.post.data.updatedDate} month="short" /> · {hero.rt} min</span></p>
      <a class="home-featured-link" href={`/posts/${hero.post.id}/`}>
        <figure class="home-cover">
          <img src={hero.post.data.ogImage ?? `/og/${hero.post.id}.png`} width="1200" height="630" alt="" loading="eager" fetchpriority="high" decoding="async" data-home-hero />
          <figcaption>{hero.accentLabel}</figcaption>
        </figure>
        <h2 id="featured-title">{keepFrenchPunctuation(hero.post.data.title)}</h2>
      </a>
      <p class="home-featured-description">{keepFrenchPunctuation(hero.post.data.description)}</p>
      <a class="home-featured-cta" href={`/posts/${hero.post.id}/`}>Lire l’enquête <span aria-hidden="true">↗</span></a>
    </section>
  )}<section class="home-risk" aria-label="L’observatoire"><RiskBand /></section></div>}

  {isFirst && (
    <section class="home-needs" aria-labelledby="home-needs-title">
      <h2 id="home-needs-title">Suivre les mécanismes</h2>
      <nav class="need-grid" aria-label="Choisir une entrée dans l0g">
        {needCards.map((card) => (
          <a href={card.href} class="need-card">
            <span class="need-copy">
              <small>{card.label}</small>
              <strong>{card.title}</strong>
              <span class="need-description">{card.description}</span>
            </span>
            <span class="need-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </section>
  )}

  <section class="pb-4 latest-feed" id="dernieres-analyses">
    {isFirst
      ? <header class="home-feed-heading"><p class="home-section-label"><span>03</span><i class="home-cut" aria-hidden="true"></i>Chronologie</p><h2>Le fil des enquêtes</h2></header>
      : <div class="section-heading feed-heading" style="display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:0.75rem 1rem;margin-bottom:0.9rem">
          <div>
            <p class="mono-label" style="color: var(--color-signal)">// archives</p>
            <h2 class="section-title" style="margin-top:0.25rem;color:var(--color-bright);font-family:var(--font-display);font-size:var(--section-title-size);line-height:1.25">Page {page.currentPage}</h2>
          </div>
          <p class="mono-label" style="color:var(--color-muted)">{page.total} entrées</p>
        </div>
    }
    {isFirst ? <ReadingDiscovery entries={discoveryEntries}>
      {feed.map(it => <DiscoveryCard entry={discoveryByPath.get(`/posts/${it.post.id}/`)!} index={it.absIndex} />)}
    </ReadingDiscovery> : (
      feed.map((it: (typeof items)[number]) => (
        <PostCard
          url={`/posts/${it.post.id}/`}
          title={it.post.data.title}
          description={it.post.data.description}
          pubDate={it.post.data.pubDate}
          updatedDate={it.post.data.updatedDate}
          tags={it.post.data.tags}
          readingTime={it.rt}
          index={it.absIndex}
          accent={it.accent}
          accentLabel={it.accentLabel}
        />
      ))
    )}

  </section>

  <div data-discovery-pagination>
  <AnalysisPagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    pageHref={pageHref}
    ariaLabel="Pages des analyses"
    previousLabel="Précédent"
    nextLabel="Suivant"
  />
  </div>

  {isFirst && (
    <div class="home-discovery">
      <ConfluenceEntry />
    </div>
  )}
  {isFirst && <aside class="home-services" aria-label="À découvrir sur l0g">
    <a class="home-support" href="/soutenir/"><span aria-hidden="true">♥︎</span><span><strong>Faire vivre l’analyse indépendante.</strong><small>Je soutiens l0g ↗</small></span></a>
    <a href="https://watch.l0g.fr/" target="_blank" rel="noopener noreferrer"><strong>l0g Watch</strong><small>La mémoire privée de votre veille. ↗</small></a>
    <a href="/hebdo/"><strong>L’Hebdo</strong><small>La revue de la semaine ↗</small></a>
    <nav aria-label="Raccourcis l0g"><a href="/maintenant/">Maintenant</a><a href="/demarrer/">Découvrir l0g</a><a href="/sujets/">Sujets suivis</a></nav>
  </aside>}
  </div>
</BaseLayout>
