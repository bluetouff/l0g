---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnalysisPagination from '../components/AnalysisPagination.astro';
import ConfluenceEntry from '../components/ConfluenceEntry.astro';
import HomeSidebar from '../components/HomeSidebar.astro';
import ReadingLibrary from '../components/ReadingLibrary.astro';
import PostCard from '../components/PostCard.astro';
import { selectHomeFeaturedPost, sortPostsByPublicationDate } from '../lib/content-order.mjs';
import PostHero from '../components/PostHero.astro';
import RiskBand from '../components/RiskBand.astro';
import SectionSignature from '../components/SectionSignature.astro';
import { readingTime } from '../lib/reading-time.ts';
import { accentForTags, topicLabelForTags } from '../config/topics.ts';

type PostEntry = CollectionEntry<'posts'>;
type PaginatedPosts = {
  data: PostEntry[];
  start: number;
  currentPage: number;
  lastPage: number;
  total: number;
  url: {
    prev?: string;
    next?: string;
  };
};

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = sortPostsByPublicationDate(await getCollection('posts', ({ data }) => !data.draft));
  const homeFeaturedPost = selectHomeFeaturedPost(posts);
  return paginate(posts, { pageSize: 10 }).map((path) => ({
    ...path,
    props: {
      ...path.props,
      homeFeaturedPost: path.props.page.currentPage === 1 ? homeFeaturedPost : null,
    },
  }));
}

const { page, homeFeaturedPost } = Astro.props as { page: PaginatedPosts; homeFeaturedPost: PostEntry | null };
const isFirst = page.currentPage === 1;
const pageTitle = isFirst
  ? 'l0g : les angles morts de la finance'
  : `Analyses financières, page ${page.currentPage}`;
const pageDescription = isFirst
  ? 'Enquêtes sur les mécanismes financiers invisibles : bilans, collatéral, crédit privé, levier et chaînes de contagion.'
  : `Archives des analyses l0g sur la finance, la macroéconomie, le crédit et les risques systémiques, page ${page.currentPage} sur ${page.lastPage}.`;

const items = page.data.map((post: PostEntry, i: number) => ({
  post,
  absIndex: page.start + i + 1,
  accent: accentForTags(post.data.tags || []),
  accentLabel: topicLabelForTags(post.data.tags || []),
  rt: readingTime(post.body),
}));
const hero = isFirst && homeFeaturedPost ? {
  post: homeFeaturedPost,
  accent: accentForTags(homeFeaturedPost.data.tags || []),
  accentLabel: topicLabelForTags(homeFeaturedPost.data.tags || []),
  rt: readingTime(homeFeaturedPost.body),
} : null;
const feed = isFirst && hero ? items.filter((item) => item.post.id !== hero.post.id) : items;
const pageHref = (n: number) => (n <= 1 ? '/' : `/${n}/`);
const needCards = [
  {
    title: 'Financement de l’IA', href: '/dossiers/financement-ia/',
    description: 'Capitaux, infrastructures et bilans.', label: 'Dossier', tone: 'signal',
    icon: 'M9 3v3m6-3v3M9 18v3m6-3v3M3 9h3m-3 6h3m12-6h3m-3 6h3M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm2 4h4v4h-4Z',
  },
  {
    title: 'Suivre un risque', href: '/radar/',
    description: 'Indicateurs, sources et signaux croisés.', label: 'Radar', tone: 'accent',
    icon: 'M21 12a9 9 0 1 1-9-9m5 9a5 5 0 1 1-5-5m0 5 8-8M12 12h.01',
  },
  {
    title: 'Vérifier un chiffre', href: '/preuves/',
    description: 'Remonter aux données et à la méthode.', label: 'Preuves', tone: 'amber',
    icon: 'M13 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10Zm0 0v7h7M8 15l3 3 5-5',
  },
  {
    title: 'Crédit privé et assurance', href: '/dossiers/credit-prive-assurance/',
    description: 'Prêts, assureurs et chaînes de risque.', label: 'Dossier', tone: 'signal',
    icon: 'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6ZM8 11h8m-8 4h5',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={isFirst ? '/og-home.png' : '/og-default.png'}
  ogImageAlt={isFirst ? 'l0g : les angles morts de la finance, économie, marchés et risques sur un dégradé turquoise, rose et ambre' : undefined}
>
  {isFirst && <HomeSidebar slot="sidebar" />}
  {isFirst && <ReadingLibrary slot="header-tools" lang="fr" variant="header" />}

  {isFirst && (
    <section class="home-intro">
      <div class="home-kicker">
        <p class="mono-label">// économie · marchés · risques</p>
        <span aria-hidden="true"><i></i><b></b></span>
      </div>
      <h1 class="mt-3 font-display glow">
        l<span style="color: var(--color-signal)">0</span>g <span style="color: var(--color-accent)">:</span> les angles morts de <span class="home-title-gradient">la finance</span>
      </h1>
      <p class="home-promise">
        l0g décrypte les changements de l’économie et des marchés,
        avec les chiffres, les sources et leurs limites.
      </p>
      <div class="home-actions">
        <a href="/atlas/" class="home-action primary">
          <svg class="home-action-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m6 13.75 1-5.5m2-1.5 6.75 1.5m1.5 2-1.25 5.5m-2 1.5L7.5 16m.25-1.75 8-4.5" />
            <circle cx="7.5" cy="6.5" r="1.75" />
            <circle cx="17.5" cy="8.5" r="1.75" />
            <circle cx="15.5" cy="17.5" r="1.75" />
            <circle cx="5.5" cy="15.5" r="1.75" />
          </svg>
          <span class="home-action-label">Explorer les atlas</span>
          <svg class="home-action-arrow" width="28" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M3 8h10M8 3l5 5-5 5" />
          </svg>
        </a>
        <a href="#dernieres-analyses" class="home-action">
          <span class="home-action-label">Lire les dernières analyses</span>
          <svg class="home-action-arrow" width="28" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M8 3v10m-5-5 5 5 5-5" />
          </svg>
        </a>
      </div>
    </section>
  )}

  {!isFirst && (
    <header class="rise border-b border-dashed border-line pb-8">
      <p class="mono-label" style="color: var(--color-signal)">$ ls /analyses | page {page.currentPage}</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,5vw,3rem)] leading-tight tracking-wider glow">
        Analyses financières <span style="color: var(--color-accent)">, page {page.currentPage}</span>
      </h1>
      <p class="mt-4 max-w-xl text-muted">
        Archives des enquêtes l0g, de la plus récente à la plus ancienne.
      </p>
    </header>
  )}

  {hero && (
    <section class="home-featured" aria-labelledby="featured-title">
      <SectionSignature index="01" eyebrow="à la une" title="L’analyse à retenir" id="featured-title" />
      <PostHero
        url={`/posts/${hero.post.id}/`}
        title={hero.post.data.title}
        description={hero.post.data.description}
        imageSrc={hero.post.data.ogImage ?? `/og/${hero.post.id}.png`}
        pubDate={hero.post.data.pubDate}
        updatedDate={hero.post.data.updatedDate}
        readingTime={hero.rt}
        accent={hero.accent}
        accentLabel={hero.accentLabel}
      />
    </section>
  )}

  {isFirst && (
    <section class="home-risk" aria-label="Les signaux de risque">
      <RiskBand />
    </section>
  )}

  <section class="pb-4 latest-feed" id="dernieres-analyses">
    {isFirst
      ? <SectionSignature index="03" eyebrow="chronologie" title="Les dernières analyses" />
      : <div class="section-heading feed-heading" style="display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:0.75rem 1rem;margin-bottom:0.9rem">
          <div>
            <p class="mono-label" style="color: var(--color-signal)">// archives</p>
            <h2 class="section-title" style="margin-top:0.25rem;color:var(--color-bright);font-family:var(--font-display);font-size:var(--section-title-size);line-height:1.25">Page {page.currentPage}</h2>
          </div>
          <p class="mono-label" style="color:var(--color-muted)">{page.total} entrées</p>
        </div>
    }
    {
      feed.map((it: (typeof items)[number]) => (
        <PostCard
          url={`/posts/${it.post.id}/`}
          title={it.post.data.title}
          description={it.post.data.description}
          pubDate={it.post.data.pubDate}
          updatedDate={it.post.data.updatedDate}
          tags={it.post.data.tags}
          readingTime={it.rt}
          index={it.absIndex}
          accent={it.accent}
          accentLabel={it.accentLabel}
        />
      ))
    }
  </section>

  <AnalysisPagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    pageHref={pageHref}
    ariaLabel="Pages des analyses"
    previousLabel="Précédent"
    nextLabel="Suivant"
  />

  {isFirst && (
    <div class="home-discovery">
      <ConfluenceEntry />
      <section class="home-needs rise" aria-labelledby="home-needs-title">
        <SectionSignature index="04" eyebrow="choisir une entrée" title="Que cherchez-vous ?" id="home-needs-title" />
        <nav class="need-grid" aria-label="Choisir une entrée dans l0g">
          {needCards.map((card) => (
            <a href={card.href} class={`need-card need-card--${card.tone}`}>
              <span class="need-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d={card.icon} />
                </svg>
              </span>
              <span class="need-copy">
                <small>{card.label}</small>
                <strong>{card.title}</strong>
                <span class="need-description">{card.description}</span>
              </span>
              <span class="need-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </section>
    </div>
  )}

</BaseLayout>

<style is:global>
  .home-intro { padding: 1.1rem 0 0.4rem; }
  .home-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .home-kicker > p { color: var(--color-signal); }
  .home-kicker > span {
    display: grid;
    grid-template-columns: minmax(2.5rem, 7rem) auto;
    align-items: center;
    gap: 0.35rem;
    flex: 1;
    max-width: 8rem;
  }
  .home-kicker i {
    height: 1px;
    background: linear-gradient(90deg, var(--color-signal), color-mix(in srgb, var(--color-signal) 12%, transparent));
  }
  .home-kicker b {
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid var(--color-signal);
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-signal) 6%, transparent);
  }
  .home-title-gradient {
    color: var(--color-bright);
    background: linear-gradient(
      90deg,
      var(--color-signal),
      var(--color-accent) 48%,
      var(--color-amber)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 16%, transparent);
  }
  .home-promise {
    max-width: 40rem;
    margin-top: 1.2rem;
    border-left: 2px solid var(--color-signal);
    padding-left: 1rem;
    color: var(--color-paper);
    font-family: var(--font-read);
    font-size: clamp(1.08rem, 2.1vw, 1.28rem);
    line-height: 1.65;
  }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem 1.4rem; margin-top: 1.35rem; }
  .home-action {
    display: inline-flex;
    min-width: 0;
    min-height: 3rem;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-line-strong);
    padding: 0.65rem 0.15rem;
    color: var(--color-paper);
    font-family: var(--font-read);
    font-size: 0.84rem;
    font-weight: 550;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
  }
  .home-action.primary {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid #9de0d0;
    border-radius: 9px;
    padding: 0.65rem 0.95rem;
    background:
      linear-gradient(115deg, #c8ede3, #87d7c5);
    box-shadow: inset 0 1px 0 #ffffff80, 0 2px 4px #0000000d;
    color: #102c28;
    font-weight: 650;
  }
  .home-action.primary::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(120deg, transparent 58%, #ffffff24 58%, #ffffff08 78%, transparent 78%);
    pointer-events: none;
  }
  .home-action-icon { flex-shrink: 0; }
  .home-action-label { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .home-action-arrow {
    flex-shrink: 0;
    width: 1.7rem;
    height: 1.7rem;
    margin-left: 0.1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    padding: 0.32rem;
    transition: transform 0.18s;
  }
  .home-action.primary .home-action-arrow {
    width: 1rem;
    height: 1rem;
    margin-left: 0.35rem;
    border: 0;
    padding: 0;
  }
  .home-action:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 4px; }
  @media (hover: hover) {
    .home-action:hover { border-color: var(--color-signal); }
    .home-action:hover .home-action-arrow { transform: translateY(2px); }
    .home-action.primary:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 #ffffff80, 0 6px 18px #5eead418; }
    .home-action.primary:hover .home-action-arrow { transform: translateX(2px); }
  }
  .home-needs,
  .home-featured,
  .latest-feed { margin-top: 2.4rem; }
  .home-discovery { margin-top: 2.4rem; }
  .need-grid { display: grid; grid-template-columns: 1fr; gap: 0.85rem; }
  .need-card {
    --need-color: var(--color-signal);
    display: grid;
    grid-template-columns: 2.65rem minmax(0, 1fr) 1.65rem;
    align-items: center;
    gap: 0.8rem;
    min-height: 8.5rem;
    padding: 1.15rem;
    border: 1px solid transparent;
    border-radius: 16px 4px 16px 16px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--need-color) 6%, var(--surface-elevated)), var(--surface-elevated) 80%) padding-box,
      linear-gradient(135deg, color-mix(in srgb, var(--need-color) 40%, var(--color-line)), var(--color-line) 70%) border-box;
    box-shadow: inset 0 1px 0 var(--edge-highlight);
    color: var(--color-bright);
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .need-card--accent { --need-color: var(--color-accent); }
  .need-card--amber { --need-color: var(--color-amber); }
  .need-icon {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border: 1px solid color-mix(in srgb, var(--need-color) 25%, var(--color-line));
    border-radius: 12px 4px 12px 12px;
    background: color-mix(in srgb, var(--need-color) 8%, transparent);
    color: var(--need-color);
  }
  .need-icon svg { display: block; width: 1.5rem; height: 1.5rem; }
  .need-copy { min-width: 0; }
  .need-copy small {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--need-color);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .need-copy strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .need-description {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.73rem;
    line-height: 1.6;
  }
  .need-arrow {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid color-mix(in srgb, var(--need-color) 28%, var(--color-line));
    border-radius: 50%;
    color: var(--need-color);
    font-size: 0.8rem;
  }
  .need-card:hover {
    border-color: var(--need-color);
    box-shadow: inset 0 1px 0 var(--edge-highlight), var(--shadow-elevated);
  }
  .need-card:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; }
  .home-featured .hero-title { hyphens: none; }
  .home-risk {
    margin-top: 1.65rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 1.15rem 0 1.2rem;
  }
  .home-risk .rise { margin-top: 0; margin-bottom: 0; }
  @media (min-width: 640px) {
    .need-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .home-actions { display: grid; grid-template-columns: 1fr; }
    .home-action { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-action, .home-action-arrow { transition: none; }
    .home-action.primary:hover,
    .home-action:hover .home-action-arrow,
    .home-action.primary:hover .home-action-arrow { transform: none; }
    .need-card { transition: none; }
  }
</style>
