---
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import { ORGANIZATION_ID, WEBSITE_ID } from '../../../config/entities.ts';
import { serializeInlineScriptData } from '../../../lib/security.ts';
const site = (Astro.site?.toString() ?? 'https://l0g.fr/').replace(/\/$/, '');
const pageUrl = `${site}/en/about/`;
const aboutPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${pageUrl}#about-page`,
  url: pageUrl,
  name: 'About l0g, an independent economic news publication',
  description:
    'l0g is an independent economic news outlet, online journal and digital newsroom publishing sourced analysis of macroeconomics, markets and systemic risk.',
  inLanguage: 'en',
  about: { '@id': ORGANIZATION_ID },
  mainEntity: { '@id': ORGANIZATION_ID },
  isPartOf: { '@id': WEBSITE_ID },
  publisher: { '@id': ORGANIZATION_ID },
};
const principles = [
  ['Primary sources first', 'Official datasets, filings and regulator publications are preferred over summaries and recycled narratives.'],
  ['Risk calibration', 'l0g tracks stress, opacity and market plumbing. It does not pretend to forecast the next tick.'],
  ['Open surface', 'The public API, Agent Surface and MCP server make the corpus queryable without scraping or hidden access.'],
  ['No fake precision', 'Scores and dashboards are reading aids, not a single omniscient index. Coverage and limits matter.'],
];
---

<EnglishGuidesLayout
  title="l0g, independent economic news publication"
  description="l0g is an independent economic news outlet, online journal and digital newsroom publishing sourced analysis of macroeconomics, markets and systemic risk."
  alternateLinks={[{ hreflang: 'en', href: `${site}/en/about/` }, { hreflang: 'fr', href: `${site}/about/` }, { hreflang: 'x-default', href: `${site}/about/` }]}
>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(aboutPageJsonLd)} />
  <article class="rise about-page" data-pagefind-body>
    <p class="mono-label glow" style="color: var(--color-signal)">// about</p>
    <h1 class="mt-5 font-display text-[clamp(2.1rem,5vw,3.25rem)] leading-tight tracking-wider glow">
      l0g, an independent economic <span style="color: var(--color-accent)">news publication</span>
    </h1>
    <p class="lede">
      l0g.fr is an independent economic news outlet, online journal and digital newsroom published by Olivier Laurelli,
      also known as Bluetouff, in Chartres, France. The newsroom covers macroeconomics, markets, credit, digital assets,
      economic policy and systemic risk through dated, bylined and sourced reporting, analysis and investigations.
    </p>

    <section>
      <h2>Publication and newsroom</h2>
      <p>
        l0g is edited and published by Olivier Laurelli as a sole proprietor. He serves as publication director, journalist,
        author and analyst. Each article identifies its author and publication date, links claims to sources and exposes material corrections.
      </p>
      <p>
        Editorial, press and technical enquiries use the <a href="/en/contact/" class="link-term">l0g contact page</a>.
        The <a href="/en/editorial-protocol/" class="link-term">editorial protocol</a> explains sourcing, verification and corrections.
        Legal publisher information is available in the <a href="/rgpd/" class="link-term">legal and privacy notice</a>, and reusable material is listed in{' '}
        <a href="/en/press-resources/" class="link-term">press resources</a>.
      </p>
    </section>

    <section>
      <h2>Editorial coverage</h2>
      <p>
        The publication is built for readers who want to understand the mechanisms behind market narratives: Treasury funding, central-bank balance sheets,
        repo stress, private credit opacity, sanctions, stablecoins, dollar funding, on-chain data and macro releases.
      </p>
      <p>
        News articles cover current events. Guides define durable concepts. Investigations assemble evidence over time. Dashboards expose signals.
        Machine-readable endpoints make the underlying public evidence reusable.
      </p>
    </section>

    <section class="principles">
      {principles.map(([title, desc]) => (
        <div>
          <h3>{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </section>

    <section>
      <h2>The boundaries of l0g</h2>
      <p>
        l0g is not investment advice, a trading signal service, a paid data terminal, or a black-box score vendor. It is a public notebook with strong source discipline,
        explicit caveats and a bias toward verifiable evidence.
      </p>
    </section>

    <section>
      <h2>How to reuse it</h2>
      <p>
        Start with the <a href="/en/guides/" class="link-term">English guides</a>, read the <a href="/en/methodology/" class="link-term">methodology</a>,
        and use the <a href="/en/api/" class="link-term">API</a> or <a href="/en/mcp/" class="link-term">MCP server</a> when a workflow needs structured data.
        The <a href="/en/editorial-protocol/" class="link-term">stable editorial protocol</a> defines the evidence contract.
        Code is licensed under MIT. Editorial text, public data and evidence artifacts are licensed under CC BY 4.0 with attribution to l0g.fr.
        Third-party material keeps its original rights.
      </p>
    </section>
  </article>
</EnglishGuidesLayout>

<style>
  .about-page { max-width: 56rem; }
  .lede { margin-top: 1.25rem; color: var(--color-paper); font-size: clamp(1.05rem, 2vw, 1.22rem); line-height: 1.75; border-left: 2px solid var(--color-signal); padding-left: 1rem; }
  .about-page section { margin-top: 2.4rem; }
  .about-page h2 { color: var(--color-bright); font-size: 1.35rem; font-weight: 700; }
  .about-page p { margin-top: 0.85rem; color: var(--color-muted); line-height: 1.75; }
  .principles { display: grid; gap: 1rem; }
  @media (min-width: 760px) { .principles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .principles div { border: 1px solid var(--color-line); border-radius: 10px; padding: 1rem; background: color-mix(in srgb, var(--color-surface) 62%, transparent); }
  .principles h3 { color: var(--color-signal); font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.07em; }
</style>
