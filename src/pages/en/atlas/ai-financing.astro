---
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import EngagementAtlas from '../../../components/EngagementAtlas.astro';
import EnglishRelatedReading from '../../../components/EnglishRelatedReading.astro';
import { englishAtlasDatasets } from '../../../config/english-atlas-datasets';
import { atlasAlternateLinks } from '../../../config/atlases';
const dataset = englishAtlasDatasets['ai-financing'];
---

<EnglishGuidesLayout title={dataset.title} seoTitle="AI financing atlas: Nvidia, Shanghai collateral and guarantees | l0g" description="Trace Nvidia, Anthropic and OpenAI financing, then inspect the collateral registrations reported in Shanghai. Every relationship retains its sources and limitations." ogImage="/illustrations/news/ai-financing-dossier-v1.jpg" alternateLinks={atlasAlternateLinks(dataset.id)}>
  <EngagementAtlas
    language="en"
    dataset={dataset}
    subject="AI financing"
    intro="A supplier can sell chips, fund its customer and back the value of equipment. Trace these roles across Nvidia, Anthropic, Google and Broadcom, then the circuits around OpenAI, SB Energy, Aligned, Nebius and SpaceX. A separate Shanghai circuit shows the server collateral reported by Bloomberg."
    boundary="Share subscriptions, compute purchases and guarantees are different obligations. Amounts can cover successive stages of the same circuit and cannot be added together. Each relationship retains its publication date and conditions. SB Energy’s prepayment remains separate from the campus guarantees, with no AIP funding inferred. Shanghai’s declared equipment value is in CNY. Loan principal is unknown."
    selectedRelation="shanghai-collateral-registrations"
    hubs={['nvidia', 'anthropic', 'aip', 'shanghai-longjie-yaoteng']}
    entryPoints={[
      { label: 'Shanghai: the reported collateral registrations', relation: 'shanghai-collateral-registrations', date: '2026-11-13' },
      { label: 'Nvidia’s proposed Anthropic subscription', relation: 'nvidia-anthropic-equity', date: '2026-11-10' },
      { label: 'Google: equity and cloud purchases', relation: 'google-anthropic-equity', date: '2026-11-10' },
      { label: 'Broadcom finances rents', relation: 'broadcom-anthropic-rent-facility', date: '2026-11-02' },
      { label: 'Broadcom backs the equipment lessor', relation: 'broadcom-spv-residual-support', date: '2026-10-26' },
      { label: 'SpaceX’s GPU finance lease', relation: 'gpu-lessor-spacex', date: '2026-10-26' },
      { label: 'Citi’s Nebius facility', relation: 'citi-nebius-facility', date: '2026-10-22' },
      { label: 'OpenAI: explore a hypothetical default', relation: 'nvidia-sb-guarantee', date: dataset.milestones.at(-1)!.date, scenario: true },
      { label: 'AIP and the Aligned acquisition', relation: 'consortium-aligned-acquisition', date: '2026-07-21' },
    ]}
    outlinks={[
      { href: '/en/topics/ai-financing/', label: 'All investigations in the AI financing dossier' },
      { href: '/en/analysis/nvidia-shanghai-server-collateral-lutnick-bessent/', label: 'Nvidia VIII: Shanghai’s servers and Washington’s blame game' },
      { href: '/en/analysis/anthropic-supplier-financing-ipo/', label: 'Anthropic: suppliers financing their customer' },
      { href: '/en/analysis/nvidia-ai-financing-guarantees-asian-investigations/', label: 'Nvidia: financial guarantees and Asian investigations' },
      { href: '/en/atlas/private-credit/', label: 'Apollo, Athene and private credit funding chains' },
      { href: '/en/analysis/nebius-citi-364-day-gpu-credit/', label: 'Nebius’s 364-day credit facility' },
      { href: '/en/analysis/nvidia-the-500-billion-that-does-not-exist-yet/', label: 'Read the investigation' },
      { href: '/api/v1/en/atlases/ai-financing.json', label: 'Reuse the relationships and sources · English JSON' },
      { href: '/en/methodology/', label: 'Read the methodology behind l0g’s indicators' },
    ]}
  >
    <section slot="overview" class="atlas-overview" aria-labelledby="ai-review-title">
      <p class="ia-review-date">Reviewed <time datetime="2026-11-13">13 November 2026</time></p>
      <div class="ia-review-grid">
        <div>
          <h2 id="ai-review-title">Shanghai: servers reported as collateral</h2>
          <p>A <a href="https://ba.bloombergadria.com/tehnologija/ai/117069/kompanija-povezana-s-alice-huang-nabavljala-zabranjene-nvidia-cipove-u-kini/news">Bloomberg investigation published on November 13</a>, with details reported by <a href="https://www.taisounds.com/news/content/84/309645">TaiSounds</a>, describes Shanghai Longjie Yaoteng pledging 193 servers in January 2025. Their declared equipment value was CNY485m.</p>
          <p>TaiSounds mentions two loans. The map groups the reported security interests, leaving the lenders and loan amounts to be established. The <a href="https://fgw.sh.gov.cn/cmsres/00/00ed174f4ac74c55abec30d9b33b44fb/20235839cd48ee3784ef54b789d67706.pdf">registration rules</a> define the parties’ and creditor’s responsibilities. The individual filings have not been obtained.</p>
        </div>
        <div>
          <h2>Washington: pressure over export controls</h2>
          <p>On <a href="https://www.cnbc.com/2026/11/13/us-inflation-outlook-federal-reserve-rate-hike.html">CNBC on November 13</a>, Scott Bessent said several agencies had supported restrictions on Megaspeed and directed questions to Commerce. Treasury is publicly leaving Howard Lutnick’s department to explain the outcome.</p>
          <p>The <a href="https://www.ecfr.gov/current/title-15/subtitle-B/chapter-VII/subchapter-C/part-744/appendix-Supplement%20No.%205%20to%20Part%20744">committee responsible for Entity List designations is chaired by Commerce</a>. <a href="/en/analysis/nvidia-shanghai-server-collateral-lutnick-bessent/">Part VIII</a> examines this political context. Map arrows continue to represent financial relationships and guarantees.</p>
        </div>
      </div>
      <details class="ia-previous"><summary>Nvidia and Anthropic: earlier developments</summary>
      <div class="ia-review-grid">
        <div>
          <h2>Nvidia’s leadership changes</h2>
          <p>On <a href="https://nvidianews.nvidia.com/news/nvidia-announces-ceo-transition">November 12, Nvidia announced Jensen Huang’s immediate resignation</a> as president, chief executive and director. Colette Kress became interim CEO. The board said it expected customer commitments to continue.</p>
          <p>The map traces corporate obligations through the documents. The transition’s effect on new investments remains to be seen.</p>
        </div>
        <div>
          <h2>Suppliers financing their customer</h2>
          <p><a href="https://www.sec.gov/Archives/edgar/data/2130357/000162828026072484/anthropicpbc-sx1ax2.htm">Anthropic’s November 10 prospectus</a> adds proposed subscriptions by Nvidia, Google, Microsoft and Broadcom. Cloud purchases have their own relationships: the same partner can have separate obligations.</p>
          <p><a href="https://www.sec.gov/Archives/edgar/data/2130357/000162828026068676/exhibit44-sx1a1.htm">The Broadcom agreement filed on November 2</a> also allows convertible debt to finance eligible rents. That facility’s cap and the equipment financing cover different parts of the chain.</p>
        </div>
      </div>
      </details>
      <details class="ia-previous"><summary>October 31 additions: SpaceX and other circuits</summary>
      <p><a href="https://www.sec.gov/Archives/edgar/data/1181412/000110465926118614/tm2628247d1_8k.htm">SpaceX’s October 26 Form 8-K</a> documents a GPU finance lease commitment with an Apollo-managed entity. About $40 billion represents expected principal payments over the leases. Closing remains conditional, with the first leases expected to begin in the first half of 2027.</p>
      <p><a href="https://www.apollo.com/insights-news/pressreleases/2026/10/spacex-secures--40-billion-in-the-largest-gpu-financing-ever">The release published by Apollo</a> identifies announced financing parties without individual allocations. No AIP or Athene contribution is inferred. Nvidia–SB Energy guarantees, prepayment, Aligned and Citi–Nebius retain their earlier observations. <a href="https://data.sec.gov/submissions/CIK0002133037.json">SB Energy’s SEC register</a>, checked on October 31, shows no filing after the September 21 S-1/A; that check does not confirm a completed IPO.</p>
      </details>
    </section>
  </EngagementAtlas>
  <EnglishRelatedReading id="ai-financing" collection="atlas" />
</EnglishGuidesLayout>

<style>
  .atlas-overview { margin:1rem 0 2rem; padding:1rem 1.2rem; border:1px solid var(--color-line); border-left:3px solid var(--color-signal); border-radius:8px; background:var(--color-surface); }
  .atlas-overview h2 { margin:0 0 .7rem; color:var(--color-bright); font-family:var(--font-display); font-size:1rem; }
  .atlas-overview p { max-width:90ch; margin:.7rem 0; font-family:var(--font-read); font-size:.85rem; line-height:1.7; }
  .atlas-overview a { color:var(--color-signal); text-decoration:underline; text-underline-offset:3px; }
  .atlas-overview a:focus-visible { outline:2px solid var(--color-signal); outline-offset:4px; }
  .ia-review-date { color:var(--color-signal); font:400 .72rem/1.5 var(--font-mono) !important; }
  .ia-review-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.6rem; margin-top:1rem; }
  .ia-previous { border-top:1px solid var(--color-line); margin-top:1.2rem; padding-top:.7rem; }
  .ia-previous summary { cursor:pointer; color:var(--color-muted); font:400 .78rem/1.6 var(--font-read); min-height:44px; padding-block:.5rem; }
  @media (max-width:700px) { .ia-review-grid { grid-template-columns:1fr; gap:1rem; } }
</style>
