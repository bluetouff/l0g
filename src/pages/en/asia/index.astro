---
import { getCollection } from 'astro:content';
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import { asiaDollarStages, asiaReadingPaths, selectAsiaAnalyses } from '../../../config/english-reading-paths.ts';

const SITE = (Astro.site?.toString() ?? 'https://l0g.fr/').replace(/\/$/, '');
const canonical = `${SITE}/en/asia/`;
const posts = await getCollection('postsEn', ({ data }) => !data.draft);
const guides = await getCollection('guidesEn', ({ data }) => !data.draft);
const postsById = new Map(posts.map((post) => [post.id, post]));
const guidesById = new Map(guides.map((guide) => [guide.id, guide]));
const paths = asiaReadingPaths.map((path) => ({
  ...path,
  analyses: path.analysisIds.map((id) => {
    const post = postsById.get(id);
    if (!post) throw new Error(`Missing English analysis in Asia reading path: ${id}`);
    return post;
  }),
  guides: path.guideIds.map((id) => {
    const guide = guidesById.get(id);
    if (!guide) throw new Error(`Missing English guide in Asia reading path: ${id}`);
    return guide;
  }),
}));
const dollarPath = paths.find((path) => path.id === 'insurer-nodes')!;
const regionalPaths = paths.filter((path) => path.id !== dollarPath.id);
const latest = selectAsiaAnalyses(posts).slice(0, 5);
const [lead, ...recent] = latest;
const fmt = (date: Date) => date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris',
});
const analysisHref = (id: string) => `/en/analysis/${id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  url: canonical,
  name: 'Asia: capital, currencies and supply chains',
  description: 'English l0g investigations into Asian economies and their connections to global finance, industry and trade.',
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: latest.map((post, index) => ({
      '@type': 'ListItem', position: index + 1,
      name: post.data.title, url: `${SITE}${analysisHref(post.id)}`,
    })),
  },
};
---

<EnglishGuidesLayout
  title="Asia: capital, currencies and supply chains"
  seoTitle="Asia: capital, currencies and supply chains | l0g"
  ogTitle="Asia: capital, currencies and supply chains"
  description="Explore Asian economies through capital flows, currencies and supply chains. Read the latest investigations and follow the Asian dollar loop with interactive tools."
  canonical={canonical}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <div class="asia-edition" data-pagefind-body>
    <header class="asia-hero">
      <div class="edition-line"><p class="mono-label">// Asia in the global system</p><span>l0g · English edition</span></div>
      <h1>Asia: capital, currencies <span>and supply chains.</span></h1>
      <p class="asia-lede">Follow the money, the institutions and the industrial links connecting Asian economies to the world.</p>
      <nav class="section-nav" aria-label="Asia sections">
        <a href="#latest">Latest analysis <span aria-hidden="true">↓</span></a>
        <a href="#asian-dollar-loop">The Asian dollar loop <span aria-hidden="true">↓</span></a>
        <a href="#paths">Regional reading paths <span aria-hidden="true">↓</span></a>
      </nav>
    </header>

    <section id="latest" class="asia-section latest-section" aria-labelledby="latest-title">
      <div class="section-head"><h2 id="latest-title">Latest Asia analysis</h2><a href="/en/rss.xml" class="section-link">English RSS <span aria-hidden="true">↗</span></a></div>
      {lead ? (
        <div class="latest-grid">
          <article class="lead-story">
            <a class="lead-image" href={analysisHref(lead.id)} tabindex="-1" aria-hidden="true">
              <img src={lead.data.ogImage ?? `/og/en/${lead.id}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
            </a>
            <p class="story-meta"><time datetime={lead.data.pubDate.toISOString()}>{fmt(lead.data.pubDate)}</time><span>Latest investigation</span></p>
            <h3><a href={analysisHref(lead.id)}>{lead.data.title}</a></h3>
            <p class="story-description">{lead.data.description}</p>
          </article>
          <ol role="list" class="recent-list" aria-label="More recent Asia analysis">
            {recent.map((post, index) => (
              <li>
                <span class="story-number" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
                <div>
                  <p class="story-meta"><time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time></p>
                  <h3><a href={analysisHref(post.id)}>{post.data.title}</a></h3>
                  <p class="story-description">{post.data.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ) : <p class="empty-state">Asia investigations will appear here as they are published.</p>}
    </section>

    <section id="asian-dollar-loop" class="asia-section dollar-section" aria-labelledby="dollar-title">
      <span id="insurer-nodes" class="anchor-alias" aria-hidden="true"></span>
      <div class="dollar-intro">
        <p class="mono-label">// The Asian dollar loop</p>
        <h2 id="dollar-title">Asian savings <span>and dollar risk.</span></h2>
        <p>A reading path through the assets, the institutions that hold them and the cash needed to keep the system running.</p>
        <a class="start-link" href={analysisHref(asiaDollarStages[0].readings[0].id)}>Start with the assets <span aria-hidden="true">↗</span></a>

      </div>
      <ol role="list" class="dollar-stages">
        {asiaDollarStages.map((stage, index) => (
          <li>
            <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
              <ul role="list" class="stage-readings">
                {stage.readings.map((reading) => <li><a href={analysisHref(reading.id)}>{reading.label}<span aria-hidden="true">↗</span></a></li>)}
              </ul>
              {stage.tool && <a class="tool-link" href={`${analysisHref(stage.readings[0].id)}#${stage.tool.fragment}`}><span class="tool-kind">Interactive</span>{stage.tool.label}<span aria-hidden="true">→</span></a>}
            </div>
          </li>
        ))}
      </ol>
      <aside class="dollar-reference" aria-label="Dollar reference guides and tool methodology">
        <div class="guide-list">
          <h3>Reference guides</h3>
          {dollarPath.guides.map((guide) => <a href={`/en/guides/${guide.id}/`}>{guide.data.title}<span aria-hidden="true">↗</span></a>)}
        </div>
        <p class="tool-note">The linked tools explain mechanisms through stated assumptions. Scenarios are hypothetical; source observations retain their own dates.</p>
      </aside>
    </section>

    <section id="paths" class="asia-section" aria-labelledby="paths-title">
      <div class="section-head"><div><p class="mono-label">// Go deeper</p><h2 id="paths-title">Regional reading paths</h2></div></div>
      <div class="path-grid">
        {regionalPaths.map((path, index) => (
          <article class="path-card" id={path.id}>
            <header>
              <span class="path-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{path.title}</h3>
              <p>{path.description}</p>
            </header>
            <p class="transmission">{path.transmission}</p>
            <div class="path-links"><h4>Analysis</h4>{path.analyses.map((post) => <a href={analysisHref(post.id)}>{post.data.title}<span aria-hidden="true">↗</span></a>)}</div>
            <div class="path-links guides"><h4>Reference guides</h4>{path.guides.map((guide) => <a href={`/en/guides/${guide.id}/`}>{guide.data.title}<span aria-hidden="true">↗</span></a>)}</div>
          </article>
        ))}
      </div>
    </section>

    <nav class="edition-footer" aria-label="Continue beyond Asia">
      <p>Continue through l0g</p>
      <a href="/en/analysis/">All English analysis <span aria-hidden="true">↗</span></a>
      <a href="/en/guides/">Reference guides <span aria-hidden="true">↗</span></a>
      <a href="/en/start/">Start with l0g <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</EnglishGuidesLayout>

<style>
  .asia-edition { --asia-rule: color-mix(in srgb, var(--color-signal) 32%, var(--color-line)); }
  .asia-edition a { text-decoration: none; }
  .asia-edition a:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 5px; border-radius: 2px; }
  .asia-edition a:hover { color: var(--color-signal); }
  .asia-hero { border-top: 2px solid var(--color-signal); padding-top: 1rem; }
  .edition-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; align-items: center; }
  .mono-label, .edition-line > span, .story-meta, .section-link, .section-nav, .tool-kind, .path-links h4, .guide-list h3, .edition-footer > p { font-family: var(--font-mono); font-size: .7rem; line-height: 1.5; letter-spacing: .06em; text-transform: uppercase; }
  .mono-label { color: var(--color-signal); }
  .edition-line > span { color: var(--color-muted); }
  .asia-hero h1 { max-width: 60rem; margin: 1.05rem 0 .8rem; font-family: var(--font-display); color: var(--color-bright); text-wrap: balance; }
  .asia-hero h1 span { color: var(--color-signal); }
  .asia-lede { max-width: 50rem; color: var(--color-muted); line-height: 1.65; font-size: 1rem; }
  .section-nav { display: flex; flex-wrap: wrap; gap: .25rem 2rem; margin-top: 1.4rem; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .section-nav a { display: inline-flex; gap: .7rem; align-items: center; min-height: 2.8rem; color: var(--color-paper); }
  .section-nav a span { color: var(--color-signal); }
  .asia-section { margin-top: clamp(2.2rem, 5vw, 4rem); scroll-margin-top: 1.5rem; }
  .section-head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.4rem; }
  .section-head h2 { font-family: var(--font-display); color: var(--color-bright); font-size: clamp(1.3rem, 2.2vw, 1.8rem); letter-spacing: -.04em; line-height: 1.25; }
  .section-head .mono-label { margin-bottom: .4rem; }
  .section-link { color: var(--color-muted); }
  .latest-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); }
  .lead-image { display: block; overflow: hidden; border: 1px solid var(--color-line); border-radius: 8px; background: var(--color-surface); }
  .lead-image img { display: block; width: 100%; height: auto; aspect-ratio: 40 / 21; object-fit: cover; }
  .story-meta { display: flex; flex-wrap: wrap; gap: .35rem 1rem; color: var(--color-muted); margin-bottom: .5rem; font-size: .65rem; }
  .lead-story .story-meta { margin-top: 1.1rem; }
  .lead-story .story-meta span { color: var(--color-signal); }
  .lead-story h3 { font-family: var(--font-display); color: var(--color-bright); font-size: clamp(1.3rem, 2.3vw, 1.75rem); line-height: 1.3; letter-spacing: -.04em; text-wrap: balance; }
  .story-description { margin-top: .65rem; color: var(--color-muted); line-height: 1.65; font-size: .88rem; }
  .recent-list { list-style: none; margin: 0; padding: 0; }
  .recent-list > li { display: grid; grid-template-columns: 1.7rem minmax(0, 1fr); gap: .8rem; padding: 1.1rem 0; border-top: 1px solid var(--color-line); }
  .recent-list > li:first-child { padding-top: 0; border-top: 0; }
  .story-number { font-family: var(--font-mono); font-size: .7rem; color: var(--color-accent); line-height: 1.5; }
  .recent-list h3 { font-family: var(--font-display); font-size: 1rem; line-height: 1.45; color: var(--color-bright); letter-spacing: -.025em; }
  .recent-list .story-description { font-size: .8rem; margin-top: .4rem; }
  .dollar-section { position: relative; display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.4fr); grid-template-areas: "intro stages" "reference stages"; grid-template-rows: auto 1fr; gap: clamp(2rem, 6vw, 5rem); border-top: 2px solid var(--color-signal); border-bottom: 1px solid var(--asia-rule); padding: clamp(1.5rem, 4vw, 3rem) 0; }
  .anchor-alias { position: absolute; top: 0; }
  .dollar-intro { grid-area: intro; }
  .dollar-reference { grid-area: reference; align-self: start; }
  .dollar-intro h2 { margin-top: .8rem; font-family: var(--font-display); font-size: clamp(1.8rem, 3.1vw, 2.6rem); letter-spacing: -.05em; line-height: 1.15; color: var(--color-bright); }
  .dollar-intro h2 span { color: var(--color-signal); }
  .dollar-intro > p:not(.mono-label) { margin-top: 1rem; color: var(--color-muted); line-height: 1.75; font-size: .9rem; }
  .start-link { display: inline-flex; gap: 1rem; align-items: center; margin-top: 1.3rem; padding: .8rem 1rem; border: 1px solid var(--asia-rule); border-radius: 6px; background: color-mix(in srgb, var(--color-signal) 6%, var(--color-ink)); color: var(--color-signal); font-size: .8rem; }
  .guide-list { display: grid; gap: .8rem; margin-top: 0; padding-top: 1.2rem; border-top: 1px solid var(--color-line); }
  .guide-list h3 { color: var(--color-muted); }
  .guide-list a { display: flex; justify-content: space-between; gap: 1rem; font-size: .8rem; line-height: 1.6; color: var(--color-paper); }
  .tool-note { margin-top: 1rem; color: var(--color-muted); font-size: .75rem; line-height: 1.75; }
  .dollar-stages { grid-area: stages; list-style: none; margin: 0; padding: 0; }
  .dollar-stages > li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding: 1.3rem 0; border-top: 1px solid var(--color-line); }
  .dollar-stages > li:first-child { padding-top: 0; border-top: 0; }
  .stage-number { display: flex; justify-content: center; align-items: center; height: 2.5rem; border: 1px solid var(--asia-rule); border-radius: 50%; color: var(--color-signal); font-family: var(--font-mono); font-size: .8rem; }
  .dollar-stages h3 { font-family: var(--font-display); font-size: 1.05rem; line-height: 1.4; color: var(--color-bright); letter-spacing: -.03em; }
  .dollar-stages p { margin-top: .45rem; color: var(--color-muted); font-size: .8rem; line-height: 1.7; }
  .stage-readings { list-style: none; padding: 0; margin: .7rem 0 0; display: grid; gap: .5rem; }
  .stage-readings a { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; color: var(--color-paper); font-size: .8rem; line-height: 1.6; }
  .stage-readings a span, .guide-list a span, .path-links a span { flex-shrink: 0; color: var(--color-signal); }
  .tool-link { display: flex; align-items: center; flex-wrap: wrap; gap: .4rem .6rem; width: fit-content; margin-top: .8rem; color: var(--color-signal); font-size: .75rem; line-height: 1.6; }
  .tool-kind { border: 1px solid var(--asia-rule); border-radius: 3px; padding: .1rem .3rem; font-size: .58rem; letter-spacing: .03em; }
  .path-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .path-card { min-width: 0; border-top: 1px solid var(--asia-rule); padding-top: 1rem; }
  .path-number { color: var(--color-signal); font-family: var(--font-mono); font-size: .75rem; }
  .path-card h3 { margin-top: .7rem; color: var(--color-bright); font-family: var(--font-display); font-size: 1.15rem; line-height: 1.4; letter-spacing: -.035em; }
  .path-card header p { margin-top: .7rem; font-size: .8rem; color: var(--color-muted); line-height: 1.7; }
  .transmission { padding: .7rem 0 .7rem .8rem; margin-top: 1rem; border-left: 2px solid var(--color-signal); color: var(--color-signal); font-size: .75rem; line-height: 1.7; }
  .path-links { display: grid; gap: .7rem; margin-top: 1.3rem; }
  .path-links h4 { color: var(--color-muted); font-weight: normal; }
  .path-links a { display: flex; justify-content: space-between; gap: .7rem; color: var(--color-paper); font-size: .8rem; line-height: 1.65; }
  .path-links.guides { padding-top: 1rem; border-top: 1px solid var(--color-line); }
  .edition-footer { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; border-top: 1px solid var(--color-line); margin-top: 3rem; padding-top: 1.2rem; }
  .edition-footer > p { color: var(--color-muted); margin-right: auto; }
  .edition-footer a { color: var(--color-paper); font-size: .75rem; line-height: 1.5; }
  @media (max-width: 850px) {
    .latest-grid { gap: 1.5rem; }
    .recent-list .story-description { display: none; }
    .dollar-section { grid-template-columns: minmax(0, .9fr) minmax(0, 1.2fr); gap: 2rem; }
    .path-grid { grid-template-columns: 1fr; gap: 2rem; }
    .path-card { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; }
    .path-card header { grid-column: 1; }
    .path-card .transmission { grid-column: 1; align-self: start; }
    .path-card .path-links { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; }
    .path-card .guides { grid-row: 3; margin-top: 1rem; }
  }
  @media (max-width: 600px) {
    .edition-line > span { display: none; }
    .asia-hero h1 { margin-top: .8rem; }
    .asia-lede { font-size: .88rem; }
    .section-nav { gap: 0 1.2rem; font-size: .62rem; }
    .section-nav a { min-height: 2.75rem; }
    .latest-grid, .dollar-section { grid-template-columns: 1fr; }
    .recent-list > li:first-child { border-top: 1px solid var(--color-line); padding-top: 1.1rem; }
    .dollar-section { grid-template-areas: "intro" "stages" "reference"; grid-template-rows: auto; }
    .dollar-intro h2 { max-width: 20rem; }
    .dollar-stages > li { grid-template-columns: 2rem minmax(0, 1fr); gap: .8rem; }
    .stage-number { height: 2rem; }
    .path-card { display: block; }
    .path-card .path-links { margin-top: 1.2rem; }
    .section-head { margin-bottom: 1rem; }
  }
</style>
