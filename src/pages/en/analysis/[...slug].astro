---
import { getCollection, render } from 'astro:content';
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import '../../../styles/reserves-pump-infographics.css';
import '../../../styles/paramount-warner-infographics.css';
import '../../../styles/danfoss-figures.css';
import AiEditorialDisclosure from '../../../components/AiEditorialDisclosure.astro';
import EnglishRelatedReading from '../../../components/EnglishRelatedReading.astro';
import ArticleHeroImage from '../../../components/ArticleHeroImage.astro';
import ReadingResume from '../../../components/ReadingResume.astro';
import ReadingLibrary from '../../../components/ReadingLibrary.astro';
import ArticleTools from '../../../components/ArticleTools.astro';
import { articleGlossaryTerms } from '../../../lib/article-glossary.ts';
import '../../../styles/article-print.css';
import '../../../styles/analysis-infographics.css';
import ArticleNavigator from '../../../components/ArticleNavigator.astro';
import ArticleServices from '../../../components/ArticleServices.astro';
import DebtEpubCard from '../../../components/DebtEpubCard.astro';
import CyberRecoveryEpubCard from '../../../components/CyberRecoveryEpubCard.astro';
import InsurancePromiseEpubCard from '../../../components/InsurancePromiseEpubCard.astro';
import { insurancePromiseEditions } from '../../../config/insurance-promise-publication.mjs';
import CumCumEpubCard from '../../../components/CumCumEpubCard.astro';
import { cumcumEditions } from '../../../config/cumcum-publication.mjs';
import { cyberRecoveryEditions } from '../../../config/cyber-recovery-publication.mjs';
import { debtEditions } from '../../../config/debt-publication.mjs';
import { authorEntity, organizationEntity } from '../../../config/entities.ts';
import { isAsiaAnalysis } from '../../../config/english-reading-paths.ts';
import { readingTime } from '../../../lib/reading-time.ts';
import { isTranslationStale } from '../../../lib/agent-surface.ts';

export async function getStaticPaths() {
  const posts = await getCollection('postsEn', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const hasDebtEpub = debtEditions.en.chapters.some(chapter => chapter.slug === post.id);
const hasCyberRecoveryEpub = cyberRecoveryEditions.en.chapters.some(chapter => chapter.slug === post.id);
const hasInsurancePromiseEpub = insurancePromiseEditions.en.chapters.some(chapter => chapter.slug === post.id);
const hasCumCumEpub = cumcumEditions.en.chapters.some(chapter => chapter.slug === post.id);
const sourcePost = (await getCollection('posts')).find((entry) => entry.id === post.data.sourceArticle);
const { Content, headings } = await render(post);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
const updated = post.data.updatedDate ?? post.data.pubDate;
const publishedLabel = fmt(post.data.pubDate);
const updatedLabel = fmt(updated);
const isoPub = post.data.pubDate.toISOString();
const isoUpd = updated.toISOString();
const rt = readingTime(post.body);
const ogImage = post.data.ogImage ?? `/og/en/${post.id}.png`;

const url = new URL(`/en/analysis/${post.id}/`, Astro.site).toString();
const articleId = `${url}#article`;
const imageUrl = new URL(ogImage, Astro.site).toString();
const primaryImage = {
  '@type': 'ImageObject',
  '@id': `${imageUrl}#primary-image`,
  url: imageUrl,
  contentUrl: imageUrl,
  width: 1200,
  height: 630,
  caption: post.data.title,
  representativeOfPage: true,
};
const frUrl = sourcePost ? new URL(`/posts/${sourcePost.id}/`, Astro.site).toString() : new URL('/', Astro.site).toString();
const sourceUpdated = sourcePost ? (sourcePost.data.updatedDate ?? sourcePost.data.pubDate) : post.data.sourceUpdatedDate;
const translationIsStale = sourcePost && isTranslationStale(sourceUpdated, post.data.sourceUpdatedDate);
const belongsToAsiaPath = isAsiaAnalysis(post.id, post.data.tags, post.data);

const alternateLinks = [
  { hreflang: 'en', href: url },
  { hreflang: 'fr', href: frUrl },
  { hreflang: 'x-default', href: frUrl },
];

const shareTitle = post.data.ogTitle ?? post.data.seoTitle ?? post.data.title;
const u = encodeURIComponent(url);
const t = encodeURIComponent(shareTitle);
const share = {
  x: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
  bluesky: `https://bsky.app/intent/compose?text=${t}%20${u}`,
};

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsArticle',
      '@id': articleId,
      headline: post.data.title,
      description: post.data.description,
      image: primaryImage,
      thumbnailUrl: imageUrl,
      url,
      datePublished: isoPub,
      dateModified: isoUpd,
      inLanguage: 'en',
      isAccessibleForFree: true,
      author: authorEntity,
      publisher: organizationEntity,
      mainEntityOfPage: { '@id': url },
      isBasedOn: { '@type': 'Article', url: frUrl },
      keywords: post.data.tags,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'English analysis', item: new URL('/en/analysis/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: post.data.title, item: url },
      ],
    },
  ],
};
const safeLd = JSON.stringify(ld).replace(/</g, '\\u003c');
---

<EnglishGuidesLayout
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  ogTitle={post.data.ogTitle}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  canonical={url}
  alternateLinks={alternateLinks}
>
  <script type="application/ld+json" is:inline set:html={safeLd} />

  <div class="en-article-shell">
  <article class="rise max-w-2xl" data-pagefind-body>
    <header class="post-head mb-10">
      <p class="mono-label glow post-kicker">// analysis</p>

      <h1 class="post-title mt-3 font-display text-[clamp(1.9rem,4.5vw,3rem)] leading-tight tracking-wider glow">
        {post.data.title}
      </h1>

      <ReadingResume body={post.body} lang="en" />

      <ArticleHeroImage
        src={ogImage}
        alt={`Illustration for the analysis: ${post.data.title}`}
      />

      <p class="post-lede mt-5">{post.data.description}</p>

      <div class="post-meta mono-label mt-6">
        <a href="/about/" rel="author" class="link-term post-author">By Olivier Laurelli / bluetouff</a>
        <a class="article-language" href={frUrl} hreflang="fr" data-pagefind-ignore><span>FR</span> French original <span aria-hidden="true">↗</span></a>
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={isoPub} data-pagefind-meta="date">published {publishedLabel}</time>
        {post.data.updatedDate && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <time datetime={isoUpd}>updated {updatedLabel}</time>
          </>
        )}
        <span class="sep" aria-hidden="true">·</span>
        <span>{rt} min read</span>
      </div>

      <div class="article-secondary">
        <details class="article-context">
          <summary data-pagefind-ignore><span>Sources and reading context</span><span class="article-context-toggle" aria-hidden="true">+</span></summary>
          <div class="article-context-body">
            {post.data.tags.length > 0 && <p class="en-context-topics"><span>Topics</span><span class="post-tags">{post.data.tags.map((tag) => <span class="text-signal">#{tag}</span>)}</span></p>}
            <div class="en-trust" data-pagefind-ignore>
              <span>dated revision: {updatedLabel}</span>
              <a href="/sites-reference/">primary sources</a>
              <a href="/rgpd/">no tracker</a>
            </div>
            {belongsToAsiaPath && (
              <a class="context-path" href="/en/asia/">
                <span>// reading path</span>
                <strong>Asia in the global financial system</strong>
                <em>Follow the rates, currencies, credit and capital flows around this analysis.</em>
              </a>
            )}
          </div>
        </details>
      </div>

      {translationIsStale && (
        <p class="stale-note" data-pagefind-ignore>
          Translation freshness warning: the French source was revised after this English version.
        </p>
      )}

    </header>

    <ArticleNavigator headings={headings} lang="en" variant="inline" />

    <div class="article-reading-actions" data-pagefind-ignore>
      <ReadingLibrary lang="en" articleTitle={post.data.title} />
      <ArticleTools lang="en" title={post.data.title} terms={articleGlossaryTerms(post.body ?? '')} />
    </div>
    <div class="prose" data-reading-body>
      <Content />
    </div>

    {hasDebtEpub && <DebtEpubCard lang="en" />}
    {hasCyberRecoveryEpub && <CyberRecoveryEpubCard lang="en" />}
    {hasInsurancePromiseEpub && <InsurancePromiseEpubCard lang="en" />}
    {hasCumCumEpub && <CumCumEpubCard lang="en" />}

    <EnglishRelatedReading id={post.id} collection="postsEn" />

    <div class="share mt-14" data-pagefind-ignore>
      <span class="mono-label share-label">// share</span>
      <div class="share-row">
        <a class="share-btn" href={share.x} target="_blank" rel="noopener nofollow" aria-label="Share on X" title="Share on X">
          <span>X</span>
        </a>
        <a class="share-btn" href={share.bluesky} target="_blank" rel="noopener nofollow" aria-label="Share on Bluesky" title="Share on Bluesky">
          <span>Bluesky</span>
        </a>
        <a class="share-btn" href={share.linkedin} target="_blank" rel="noopener nofollow" aria-label="Share on LinkedIn" title="Share on LinkedIn">
          <span>LinkedIn</span>
        </a>
        <a class="share-btn" href={share.facebook} target="_blank" rel="noopener nofollow" aria-label="Share on Facebook" title="Share on Facebook">
          <span>Facebook</span>
        </a>
        <button class="share-btn" type="button" data-copy-url={url} aria-label="Copy link" title="Copy link">
          <span data-copy-label>Copy link</span>
        </button>
      </div>
    </div>

    <p class="post-disclaimer" data-pagefind-ignore>
      <em>This analysis is not investment advice.</em>
    </p>

    <div class="citation-en" data-pagefind-ignore>
      <p class="mono-label">// cite this analysis</p>
      <p>
        l0g, “{post.data.title}”, l0g.fr, published {fmt(post.data.pubDate)}, updated {updatedLabel}, {url}
      </p>
    </div>

    <AiEditorialDisclosure lang="en" />

    <hr class="hairline mt-12" />
    <a href="/en/analysis/" class="mono-label link-term mt-6 inline-block">$ cd ../analysis</a>
  </article>

  <aside class="en-article-sidebar" aria-label="Reading navigation and services" data-pagefind-ignore>
    <ArticleNavigator headings={headings} lang="en" />
    <ArticleServices lang="en" />
  </aside>
  </div>

  <script>
    // @ts-nocheck -- script navigateur autonome, validé sur le DOM construit.
    document.querySelectorAll('[data-copy-url]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var u = btn.getAttribute('data-copy-url');
        var label = btn.querySelector('[data-copy-label]');
        var flash = function (text) {
          if (!label) return;
          var original = label.textContent;
          label.textContent = text;
          setTimeout(function () { label.textContent = original; }, 1800);
        };
        if (!u || !window.isSecureContext || !navigator.clipboard || !navigator.clipboard.writeText) {
          flash('Copy unavailable');
          return;
        }
        navigator.clipboard.writeText(u)
          .then(function () { flash('Link copied'); })
          .catch(function () { flash('Copy unavailable'); });
      });
    });
  </script>
</EnglishGuidesLayout>

<script>
  import '../../../scripts/article-print.ts';
</script>

<style>
  .en-article-shell {
    display: grid;
    width: 100%;
    min-width: 0;
    gap: 2rem;
    align-items: start;
  }
  .en-article-shell > article { width: 100%; min-width: 0; }
  .post-head { margin-bottom: .75rem; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .65rem; margin-top: .9rem; font-size: .66rem; line-height: 1.5; letter-spacing: .04em; }
  .post-meta > .sep { display: none; }
  .en-article-sidebar {
    display: grid;
    min-width: 0;
    gap: 1.1rem;
  }
  .article-secondary { margin-top: .25rem; }
  .article-language { display: inline-flex; align-items: center; gap: .35rem; min-height: 24px; padding-left: .65rem; border-left: 1px solid var(--color-line); color: var(--color-signal); font: 500 .72rem/1.4 var(--font-read); letter-spacing: normal; text-transform: none; white-space: nowrap; }
  .article-language > :first-child { font: 600 .63rem/1 var(--font-mono); letter-spacing: .06em; }
  .article-language > :last-child { color: var(--color-muted); }
  .article-language:hover { text-decoration: underline; text-underline-offset: .2em; }
  .article-language:focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; border-radius: var(--radius-control); }
  .article-context { min-width: 0; border-block: 1px solid var(--color-line); }
  .article-context > summary { display: flex; align-items: center; justify-content: space-between; gap: .65rem; min-height: 44px; padding: .6rem 0; list-style: none; cursor: pointer; color: var(--color-paper); font: 500 .75rem/1.4 var(--font-read); }
  .article-context > summary::-webkit-details-marker { display: none; }
  .article-context-toggle { flex: none; color: var(--color-signal); font: 400 1rem/1 var(--font-mono); }
  .article-context[open] .article-context-toggle { transform: rotate(45deg); }
  .article-context > summary:hover { color: var(--color-signal); }
  .article-secondary :is(a, summary):focus-visible { outline: 2px solid var(--color-signal); outline-offset: 3px; border-radius: var(--radius-control); }
  .article-context-body { padding: .2rem 0 .8rem; }
  .en-context-topics { display: grid; gap: .4rem; margin: .25rem 0 .75rem; font: .72rem/1.5 var(--font-read); }
  .en-context-topics > :first-child { color: var(--color-muted); font: 500 .64rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .en-trust {
    margin-top: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .post-meta,
  .post-tags { min-width: 0; }
  @media (max-width: 620px) {
    :global(.post-head .article-primary-image) { margin: 1rem 0; }
    .post-lede { margin-top: 1rem; font-size: 1rem; line-height: 1.6; }
    .post-meta { gap: .3rem .6rem; margin-top: .75rem; font-size: .62rem; line-height: 1.6; }
    .en-trust { gap: .35rem; font-size: .6rem; }
    .article-secondary { margin-top: 0; }
  }
  .post-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.15rem 0;
  }
  .en-trust span,
  .en-trust a {
    border: 1px solid color-mix(in srgb, var(--color-signal) 35%, transparent);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    color: var(--color-signal);
    background: color-mix(in srgb, var(--color-signal) 8%, transparent);
  }
  .context-path {
    display: grid;
    gap: .28rem;
    margin-top: 1rem;
    padding: .8rem .9rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    text-decoration: none;
  }
  .context-path:hover { border-color: var(--color-accent); }
  .context-path span { color: var(--color-accent); font-family: var(--font-mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .06em; }
  .context-path strong { color: var(--color-bright); line-height: 1.35; }
  .context-path em { color: var(--color-muted); font-size: .84rem; font-style: normal; line-height: 1.45; }
  .stale-note {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border: 1px dashed var(--color-amber);
    border-radius: 12px;
    color: var(--color-amber);
    background: color-mix(in srgb, var(--color-amber) 8%, transparent);
    font-size: 0.86rem;
  }
  .share {
    border-top: 1px solid var(--color-line);
    padding-top: 1.2rem;
  }
  .share-label {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--color-signal);
  }
  .share-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    color: var(--color-muted);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .share-btn:hover {
    border-color: var(--color-signal);
    color: var(--color-signal);
    background: color-mix(in srgb, var(--color-signal) 8%, transparent);
  }
  .post-disclaimer {
    margin-top: 1.6rem;
    color: var(--color-accent);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .citation-en {
    margin-top: 2rem;
    padding: 1rem;
    border: 1px dashed var(--color-line);
    border-radius: 12px;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .citation-en p {
    overflow-wrap: anywhere;
  }
  @media (min-width: 1024px) {
    .en-article-shell {
      grid-template-columns: minmax(0, 42rem) 290px;
      justify-content: space-between;
      gap: 3rem;
    }
    .en-article-sidebar { position: sticky; top: 2rem; max-height: calc(100dvh - 4rem); overflow-y: auto; scrollbar-width: thin; padding: .25rem .45rem .25rem .25rem; }
  }
</style>
