---
import { getCollection } from 'astro:content';
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import AnalysisList from '../../../components/AnalysisList.astro';
import { readingTime } from '../../../lib/reading-time.ts';
import { sortPostsByPublicationDate } from '../../../lib/content-order.mjs';

const PAGE_SIZE = 20;

const all = sortPostsByPublicationDate(await getCollection('postsEn', ({ data }) => !data.draft));

const total = all.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

const items = all.slice(0, PAGE_SIZE).map((p, i) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  updatedDate: p.data.updatedDate,
  tag: p.data.tags[0],
  rt: readingTime(p.body),
  index: i + 1,
}));

const canonical = new URL('/en/analysis/', Astro.site).toString();
---

<EnglishGuidesLayout
  title="Financial analysis in English"
  seoTitle="English financial analysis: macro, credit and risk | l0g"
  ogTitle="Financial risk, traced through evidence and balance sheets"
  description="Independent English l0g analysis of macro, credit, technology, public policy, market plumbing and the machinery of systemic risk."
  canonical={canonical}
>
  <section class="rise border-b border-dashed border-line pb-10">
    <p class="mono-label" style="color: var(--color-signal)">$ ls /en/analysis</p>
    <h1 class="mt-5 font-display text-[clamp(2.1rem,5vw,3.2rem)] leading-tight tracking-wider glow">
      English <span style="color: var(--color-accent)">analysis</span>
    </h1>
    <p class="mt-5 max-w-xl text-muted">
      Sourced, adversarially reviewed investigations into the plumbing of finance and systemic risk. English editions are selected and edited for an international audience, with the French source linked when one exists.
      {total} {total === 1 ? 'piece is' : 'pieces are'} currently available in English.
    </p>
    <div class="analysis-entry-links" data-pagefind-ignore>
      <a href="/en/start/">choose a reading path</a>
      <a href="/en/asia/">follow Asia through the global system</a>
      <a href="/en/guides/">open the reference guides</a>
    </div>
  </section>

  {
    total === 0 ? (
      <p class="mt-10 text-muted">No English analysis is published yet.</p>
    ) : (
      <AnalysisList items={items} currentPage={1} totalPages={totalPages} />
    )
  }
</EnglishGuidesLayout>

<style>
  .analysis-entry-links { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.25rem; }
  .analysis-entry-links a { display: inline-flex; align-items: center; min-height: 2.15rem; padding: .45rem .7rem; border: 1px solid var(--color-line); border-radius: 999px; color: var(--color-signal); font-family: var(--font-mono); font-size: .68rem; text-decoration: none; }
  .analysis-entry-links a:hover { border-color: var(--color-signal); color: var(--color-bright); }
</style>
