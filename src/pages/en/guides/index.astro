---
import { getCollection } from 'astro:content';
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import GuideDirectory from '../../../components/GuideDirectory.astro';
import { readingTime } from '../../../lib/reading-time.ts';

const guides = (await getCollection('guidesEn', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).getTime() - (a.data.updatedDate ?? a.data.pubDate).getTime())
  .map(g => ({
    id: g.id,
    title: g.data.title,
    description: g.data.description,
    category: g.data.category,
    date: g.data.updatedDate ?? g.data.pubDate,
    minutes: readingTime(g.body),
  }));
---

<EnglishGuidesLayout
  title="English guides"
  description="Guides to economics and finance: macro data, banks, liquidity, markets and crypto. Browse by topic or search a concept."
  alternateLinks={[
    { hreflang: 'fr', href: new URL('/guides/', Astro.site).toString() },
    { hreflang: 'en', href: new URL('/en/guides/', Astro.site).toString() },
    { hreflang: 'x-default', href: new URL('/guides/', Astro.site).toString() },
  ]}
>
  <GuideDirectory guides={guides} lang="en" />
</EnglishGuidesLayout>
