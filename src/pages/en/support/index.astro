---
import EnglishGuidesLayout from '../../../layouts/EnglishGuidesLayout.astro';
import SupportExperience from '../../../components/SupportExperience.astro';
import { serializeInlineScriptData } from '../../../lib/security.ts';

const title = 'Support independent analysis';
const description =
  'Support l0g with a one-time or monthly voluntary contribution to fund public analysis, data collection and infrastructure, without editorial influence.';
const url = 'https://l0g.fr/en/support/';
const frenchUrl = 'https://l0g.fr/soutenir/';

const alternateLinks = [
  { hreflang: 'en', href: url },
  { hreflang: 'fr', href: frenchUrl },
  { hreflang: 'x-default', href: frenchUrl },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#page`,
  url,
  name: title,
  description,
  inLanguage: 'en',
  isAccessibleForFree: true,
  publisher: { '@id': 'https://l0g.fr/#org' },
};
---

<EnglishGuidesLayout
  title={title}
  description={description}
  canonical={url}
  alternateLinks={alternateLinks}
  compactNavigation
  ogImage="/og-support-v1.jpg"
  ogImageAlt="An illuminated open book of investigative reporting on a charcoal background, representing support for l0g’s independence."
>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(jsonLd)} />

  <article data-pagefind-body>
    <SupportExperience lang="en" />
  </article>
</EnglishGuidesLayout>
