---
import EnglishLayout from '../../../layouts/EnglishGuidesLayout.astro';
import PublicationLibrary from '../../../components/PublicationLibrary.astro';
import PublicationSpotlight from '../../../components/PublicationSpotlight.astro';
import { SITE_URL } from '../../../config/entities.ts';
import AnalysisPagination from '../../../components/AnalysisPagination.astro';
import { publicationPage, publicationPageHref } from '../../../config/publication-catalog.mjs';

interface Props { currentPage?: number }
const page = publicationPage('en', Astro.props.currentPage ?? 1);
const isFirst = page.currentPage === 1;
const pageUrl = `${SITE_URL}${publicationPageHref('en', page.currentPage)}`;
---

<EnglishLayout
  title={isFirst ? 'English publications' : `English publications, page ${page.currentPage}`}
  description={isFirst
    ? 'Free English l0g publications that preserve source links, reading order, limitations and correction paths.'
    : `English l0g publications, page ${page.currentPage} of ${page.totalPages}. Free EPUB investigations with sources, reading order and limitations.`}
  canonical={pageUrl}
  alternateLinks={isFirst ? [
    { hreflang: 'en', href: pageUrl },
    { hreflang: 'fr', href: `${SITE_URL}/publications/` },
    { hreflang: 'x-default', href: `${SITE_URL}/publications/` },
  ] : []}
  ogImage="/og/catalogue/publications-en-v1.jpg"
  ogImageAlt="l0g investigations in EPUB. The publications library, illustrated by dark glass books linked by fine cyan and rose source pathways."
>
  <header class="publication-index rise" data-pagefind-body>
    <p class="mono-label glow">// l0g editions</p>
    <h1>Investigations <span>in EPUB</span></h1>
    <p>
      l0g publications assemble related investigations into a continuous reading order.
      Sources, limitations and links to the canonical articles remain attached to every edition.
    </p>
  </header>

  <section class="publication-list" aria-labelledby="publication-list-title">
    <p class="mono-label">// available now</p>
    <h2 id="publication-list-title">English editions</h2>
    <p class="publication-range">Publications {page.start} to {page.end} of {page.total} · Page {page.currentPage} of {page.totalPages}</p>
    <PublicationLibrary currentPage={page.currentPage} lang="en">
    {page.items.map((item) => <PublicationSpotlight lang="en" publication={item.id} />)}
    </PublicationLibrary>
    <div data-publication-pagination>
    <AnalysisPagination
      currentPage={page.currentPage}
      totalPages={page.totalPages}
      pageHref={(number) => publicationPageHref('en', number)}
      ariaLabel="Publications pagination"
      previousLabel="Previous"
      nextLabel="Next"
    />
    </div>
  </section>
</EnglishLayout>

<style>
  .publication-index { max-width: 56rem; padding: clamp(2rem, 4vw, 3rem) 0; }
  .publication-index > .mono-label { color: var(--color-signal); }
  .publication-index h1 { margin-top: .6rem; color: var(--color-bright); font-family: var(--font-display); font-size: clamp(2.25rem, 5vw, 4.25rem); letter-spacing: -.04em; line-height: .98; }
  .publication-index h1 span { display: block; color: var(--color-accent); }
  .publication-index > p:last-child { max-width: 46rem; margin-top: 1.4rem; color: var(--color-prose); font-family: var(--font-read); font-size: 1.05rem; line-height: 1.75; }
  .publication-list { padding-top: 2.5rem; border-top: 1px solid var(--color-line); }
  .publication-list > .mono-label { color: var(--color-amber); }
  .publication-list > h2 { margin: .35rem 0 1rem; color: var(--color-bright); font-family: var(--font-display); font-size: var(--section-title-size); line-height: 1.25; }
  .publication-list :global(.publication-spotlight + .publication-spotlight) { margin-top: 1.25rem; }
  .publication-range { margin: -0.25rem 0 1.5rem; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.7; }
</style>
