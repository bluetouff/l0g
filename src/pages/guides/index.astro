---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideDirectory from '../../components/GuideDirectory.astro';
import { readingTime } from '../../lib/reading-time.ts';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).getTime() - (a.data.updatedDate ?? a.data.pubDate).getTime())
  .map(g => ({
    id: g.id,
    title: g.data.title,
    description: g.data.description,
    category: g.data.category,
    date: g.data.updatedDate ?? g.data.pubDate,
    minutes: readingTime(g.body),
  }));
---

<BaseLayout
  title="Guides"
  description="Guides pour lire l’économie et la finance : macroéconomie, banques, liquidité, marchés et crypto. Parcourez les catégories ou recherchez une notion."
  sidebar={false}
  alternateLinks={[
    { hreflang: 'fr', href: new URL('/guides/', Astro.site).toString() },
    { hreflang: 'en', href: new URL('/en/guides/', Astro.site).toString() },
    { hreflang: 'x-default', href: new URL('/guides/', Astro.site).toString() },
  ]}
>
  <GuideDirectory guides={guides} lang="fr" />
</BaseLayout>
