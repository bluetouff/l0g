---
import BaseLayout from '../layouts/BaseLayout.astro';
import { atlasAlternateLinks } from '../config/atlases';
import AtlasCollection from '../components/AtlasCollection.astro';
---

<BaseLayout
  title="Atlas des circuits financiers"
  seoTitle="Atlas financiers : IA, crédit privé et pétrole | l0g"
  description="Explorez les atlas l0g : financement de l’IA, crédit privé et pétrole. Des cartes interactives pour comprendre les acteurs, les contrats et les circuits financiers."
  alternateLinks={atlasAlternateLinks()}
  sidebar={false}
>
  <AtlasCollection />
</BaseLayout>

<script>
  import { legacyAtlasDestination } from '../lib/atlas-legacy-links';
  // Preserve previously shared AI selections while /atlas/ becomes the collection.
  const destination = legacyAtlasDestination(window.location.hash);
  if (destination) window.location.replace(destination);
</script>
