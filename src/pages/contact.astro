---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { ORGANIZATION_ID, SITE_URL, WEBSITE_ID, organizationEntity } from '../config/entities.ts';
import { serializeInlineScriptData } from '../lib/security.ts';

const pageUrl = `${SITE_URL}/contact/`;
const email = 'olivier@l0g.fr';
const phoneDisplay = '06 95 32 87 21';
const phoneInternational = '+33695328721';
const contactPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${pageUrl}#contact-page`,
  url: pageUrl,
  name: 'Contacter l0g',
  description:
    'Coordonnées de la rédaction de l0g pour une correction, une demande presse, une question sur les données, l’API ou le serveur MCP, et une proposition de collaboration.',
  inLanguage: 'fr',
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': ORGANIZATION_ID },
  mainEntity: {
    ...organizationEntity,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'newsroom',
        email: `mailto:${email}`,
        telephone: phoneInternational,
        availableLanguage: ['fr', 'en'],
        areaServed: 'Worldwide',
      },
      {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: `mailto:${email}`,
        url: `${pageUrl}#api-mcp`,
        availableLanguage: ['fr', 'en'],
        areaServed: 'Worldwide',
      },
    ],
  },
};
---

<BaseLayout
  title="Contacter l0g"
  description="Contacter la rédaction de l0g pour une correction, une demande presse, une question sur les données, l’API ou le serveur MCP, et une collaboration."
  sidebar={false}
  alternateLinks={[
    { hreflang: 'fr', href: pageUrl },
    { hreflang: 'en', href: `${SITE_URL}/en/contact/` },
    { hreflang: 'x-default', href: pageUrl },
  ]}
>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(contactPageJsonLd)} />

  <article class="contact-page rise" data-pagefind-body>
    <p class="language-switch mono-label" data-pagefind-ignore>
      <a href="/en/contact/" class="link-term">English version available →</a>
    </p>

    <PageHero
      index="C01"
      kicker="contact direct"
      title="Contacter"
      highlight="l0g"
      description="Une seule porte d’entrée pour la rédaction, la presse, les données publiques, l’API, le serveur MCP et les collaborations."
      secondary="Aucun formulaire tiers, aucun cookie et aucun intermédiaire : le message arrive directement à Olivier Laurelli."
      glyph="retrieve"
      stats={[
        { value: 'FR · EN', label: 'langues' },
        { value: 'Chartres', label: 'rédaction' },
        { value: 'direct', label: 'canal' },
      ]}
    />

    <section class="contact-direct instrument-plate" aria-labelledby="direct-title">
      <div>
        <p class="mono-label glow">// coordonnées</p>
        <h2 id="direct-title">Écrire ou appeler.</h2>
        <p>
          Précisez l’URL concernée et l’objet de la demande. Pour une correction, joignez la
          source qui permet de vérifier le point signalé.
        </p>
      </div>
      <address>
        <a class="contact-primary" href={`mailto:${email}`}>{email}</a>
        <a href={`tel:${phoneInternational}`}>{phoneDisplay}</a>
        <span>Olivier Laurelli · Chartres (28000) · France</span>
      </address>
    </section>

    <div class="contact-grid">
      <section class="contact-card" id="correction" aria-labelledby="correction-title">
        <p class="card-index">01</p>
        <h2 id="correction-title">Correction ou source</h2>
        <p>
          Signaler une erreur factuelle, une source cassée ou un élément à préciser. Les
          corrections matérielles sont consignées dans le journal éditorial.
        </p>
        <div class="card-links">
          <a href={`mailto:${email}?subject=Correction%20ou%20source%20l0g`}>signaler un point</a>
          <a href="/changelog-editorial/">voir les corrections</a>
        </div>
      </section>

      <section class="contact-card" id="presse" aria-labelledby="presse-title">
        <p class="card-index">02</p>
        <h2 id="presse-title">Presse et réutilisation</h2>
        <p>
          Demander un éclairage, une vérification méthodologique ou un format réutilisable.
          Les graphiques, séries et règles d’attribution sont déjà accessibles publiquement.
        </p>
        <div class="card-links">
          <a href={`mailto:${email}?subject=Demande%20presse%20l0g`}>demande presse</a>
          <a href="/ressources-journalistes/">ressources journalistes</a>
        </div>
      </section>

      <section class="contact-card" id="api-mcp" aria-labelledby="api-title">
        <p class="card-index">03</p>
        <h2 id="api-title">Données, API et MCP</h2>
        <p>
          Documenter une intégration, proposer un cas d’usage ou signaler un défaut technique.
          L’accès public reste ouvert et sans inscription ; les limites de chaque donnée restent visibles.
        </p>
        <div class="card-links">
          <a href={`mailto:${email}?subject=API%20ou%20MCP%20l0g`}>question d’intégration</a>
          <a href="/api/">documentation API</a>
          <a href="/mcp/">serveur MCP</a>
          <a href="https://github.com/bluetouff/l0g/issues" rel="noopener">incident public</a>
        </div>
      </section>

      <section class="contact-card" id="collaboration" aria-labelledby="collaboration-title">
        <p class="card-index">04</p>
        <h2 id="collaboration-title">Collaboration et étude</h2>
        <p>
          Proposer une étude documentée, un outil, une intervention ou un travail de recherche
          appliquée. Une collaboration ne donne aucun droit sur les conclusions éditoriales.
        </p>
        <div class="card-links">
          <a href={`mailto:${email}?subject=Collaboration%20avec%20l0g`}>présenter la demande</a>
          <a href="/protocole-editorial/">règles éditoriales</a>
        </div>
      </section>
    </div>

    <section class="contact-boundary" aria-labelledby="boundary-title">
      <p class="mono-label glow">// délai et confidentialité</p>
      <h2 id="boundary-title">Ce que ce canal garantit.</h2>
      <p>
        Chaque message peut être lu, mais aucune réponse ni aucun calendrier ne sont garantis.
        N’envoyez pas de secret, de donnée personnelle sensible ou d’identifiant d’accès par
        courriel. Pour une alerte de sécurité, utilisez les coordonnées et la clé indiquées dans{' '}
        <a href="/.well-known/security.txt">security.txt</a>.
      </p>
    </section>
  </article>

  <style>
    .contact-page { max-width: 70rem; }
    .language-switch { margin-bottom: 1rem; color: var(--color-signal); }
    .contact-direct {
      display: grid;
      gap: 1.25rem;
      margin-top: 1.4rem;
      padding: clamp(1rem, 3vw, 1.4rem);
      background: color-mix(in srgb, var(--color-surface) 68%, transparent);
    }
    .contact-direct h2,
    .contact-card h2,
    .contact-boundary h2 {
      margin-top: .45rem;
      color: var(--color-bright);
      font-family: var(--font-display);
      font-size: 1.35rem;
    }
    .contact-direct p:not(.mono-label),
    .contact-card p:not(.card-index),
    .contact-boundary > p:not(.mono-label) {
      margin-top: .65rem;
      color: var(--color-muted);
      line-height: 1.65;
    }
    address {
      display: grid;
      align-content: center;
      gap: .45rem;
      font-style: normal;
    }
    address a { width: fit-content; color: var(--color-paper); font-family: var(--font-mono); }
    address .contact-primary { color: var(--color-signal); font-size: clamp(1rem, 3vw, 1.25rem); }
    address span { color: var(--color-muted); font-family: var(--font-mono); font-size: .7rem; }
    .contact-grid { display: grid; gap: .9rem; margin-top: .9rem; }
    .contact-card {
      min-width: 0;
      border: 1px solid var(--color-line);
      border-radius: 10px 3px 10px 10px;
      padding: 1.1rem;
      background: color-mix(in srgb, var(--color-surface) 52%, transparent);
    }
    .card-index { color: var(--color-signal); font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; }
    .card-links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .card-links a {
      border: 1px solid color-mix(in srgb, var(--color-signal) 42%, var(--color-line));
      border-radius: 999px;
      padding: .36rem .62rem;
      color: var(--color-signal);
      font-family: var(--font-mono);
      font-size: .67rem;
      text-transform: uppercase;
    }
    .contact-boundary {
      margin-top: 1.8rem;
      border-left: 2px solid var(--color-amber);
      padding: .2rem 0 .2rem 1rem;
    }
    .contact-boundary a { color: var(--color-signal); }
    @media (min-width: 760px) {
      .contact-direct { grid-template-columns: minmax(0, 1.25fr) minmax(16rem, .75fr); }
      .contact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</BaseLayout>
