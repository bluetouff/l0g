---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ORGANIZATION_ID, SITE_URL } from '../../config/entities.ts';
import { serializeInlineScriptData } from '../../lib/security.ts';

const title = 'Auditer l’Opacité, essai gratuit en EPUB';
const description =
  'Télécharger gratuitement Auditer l’Opacité de Bluetouff, un essai en treize chapitres sur les zones d’opacité et les canaux de transmission du risque financier.';
const pageUrl = `${SITE_URL}/publications/auditer-l-opacite/`;
const epubUrl = '/publications/auditer-l-opacite-bluetouff.epub';
const coverUrl = '/publications/auditer-l-opacite-cover.jpg';
const epubBytes = readFileSync(new URL('../../../public/publications/auditer-l-opacite-bluetouff.epub', import.meta.url));
const epubSize = `${new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(epubBytes.length / 1024)} Ko`;
const epubSha256 = createHash('sha256').update(epubBytes).digest('hex');

const parts = [
  {
    number: 'I',
    title: 'Le monde que Phil a vu venir',
    summary: 'Deux chapitres posent la différence entre prix et valeur, puis décrivent les propriétés qui distinguent la période actuelle des crises précédentes.',
    chapters: [
      'Crises et bascules : pourquoi cette époque n’est pas comme les autres',
      'La grande déconnexion : prix, valeur, et tout ce qui se cache entre les deux',
    ],
  },
  {
    number: 'II',
    title: 'L’opacité comme produit financier',
    summary: 'Le crédit privé, les valorisations internes et l’assurance sont examinés comme trois lieux où la visibilité, la liquidité et le risque peuvent diverger.',
    chapters: [
      'Le retour du prêteur de l’ombre',
      'La fabrique du flou',
      'Quand l’assureur devient banquier',
    ],
  },
  {
    number: 'III',
    title: 'Les passerelles invisibles',
    summary: 'La recherche de rendement, la tokenisation de la finance traditionnelle et les dollars synthétiques dessinent des canaux entre deux systèmes souvent présentés comme séparés.',
    chapters: [
      'Le yield comme drogue',
      'Quand la crypto absorbe la finance ancienne',
      'Le grand pari du dollar synthétique',
    ],
  },
  {
    number: 'IV',
    title: 'La géopolitique de la valeur',
    summary: 'Dollar, yen, Treasuries et régulation replacent ces mécanismes dans un changement de régime monétaire et politique plus large.',
    chapters: [
      'La fin du consensus monétaire',
      'Le yen, les Treasuries, la mèche japonaise',
      'Le régulateur a toujours un coup de retard',
    ],
  },
  {
    number: 'V',
    title: 'La décentralisation à l’épreuve d’elle-même',
    summary: 'Les deux derniers chapitres confrontent les promesses de gouvernance décentralisée à la concentration réelle du pouvoir, sans effacer les apports de l’auditabilité native.',
    chapters: [
      'Le mirage de la décentralisation',
      'Ce qu’elle peut quand même',
    ],
  },
];

const bookJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': `${pageUrl}#book`,
  name: 'Auditer l’Opacité',
  alternateName: 'Auditer l’Opacité : Anatomie d’une crise qu’on ne veut pas voir',
  description,
  author: {
    '@type': 'Person',
    name: 'Bluetouff',
    url: `${SITE_URL}/about/`,
  },
  publisher: { '@id': ORGANIZATION_ID },
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
  inLanguage: 'fr',
  bookFormat: 'https://schema.org/EBook',
  isAccessibleForFree: true,
  url: pageUrl,
  image: `${SITE_URL}${coverUrl}`,
  copyrightYear: 2026,
  copyrightHolder: {
    '@type': 'Person',
    name: 'Bluetouff',
  },
  hasPart: parts.map((part) => ({
    '@type': 'CreativeWork',
    name: part.title,
    hasPart: part.chapters.map((chapter) => ({ '@type': 'Chapter', name: chapter })),
  })),
  associatedMedia: {
    '@type': 'MediaObject',
    contentUrl: `${SITE_URL}${epubUrl}`,
    encodingFormat: 'application/epub+zip',
    contentSize: `${epubBytes.length} bytes`,
    sha256: epubSha256,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  sidebar={false}
  alternateLinks={[
    { hreflang: 'fr', href: pageUrl },
    { hreflang: 'x-default', href: pageUrl },
  ]}
  ogImage={coverUrl}
  ogImageAlt="Couverture de l’essai Auditer l’Opacité de Bluetouff"
>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(bookJsonLd)} />

  <article class="book-page rise" data-pagefind-body>
    <section class="book-hero">
      <div class="cover-stage" aria-label="Couverture de l’essai Auditer l’Opacité">
        <div class="cover-aura" aria-hidden="true"></div>
        <div class="book-shell">
          <span class="book-spine" aria-hidden="true">l0g · essai · 2026</span>
          <img
            src={coverUrl}
            width="1600"
            height="2560"
            alt="Auditer l’Opacité, Anatomie d’une crise qu’on ne veut pas voir, par Bluetouff"
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="cover-caption">Édition l0g · août 2026</span>
      </div>

      <div class="hero-copy">
        <p class="mono-label glow">// publication l0g</p>
        <h1>Auditer <span>l’opacité</span></h1>
        <p class="hero-deck">Anatomie d’une crise qu’on ne veut pas voir.</p>
        <p class="hero-lede">
          Ce livre ne fixe ni date, ni détonateur, ni prophétie d’effondrement. Il propose une
          grammaire pour lire les zones d’opacité et les canaux par lesquels un choc pourrait
          circuler entre crédit privé, assurance, cryptoactifs, monnaies et régulation.
        </p>

        <div class="hero-actions">
          <a class="download-action" href={epubUrl} download="Auditer-l-opacite-Bluetouff.epub">
            <span>Télécharger l’EPUB</span>
            <small>Gratuit · {epubSize}</small>
          </a>
          <a class="contents-action" href="#sommaire">
            Parcourir les cinq parties <span aria-hidden="true">↓</span>
          </a>
        </div>

        <ul class="proof-line" aria-label="Caractéristiques de l’édition">
          <li>13 chapitres</li>
          <li>5 parties</li>
          <li>Bibliographie</li>
          <li>Lexique</li>
        </ul>
      </div>
    </section>

    <section class="promise-section">
      <div class="section-index" aria-hidden="true">01</div>
      <div class="promise-heading">
        <p class="mono-label glow">une plomberie à rendre lisible</p>
        <h2>Comprendre les raccords avant la rupture.</h2>
      </div>
      <div class="promise-copy">
        <p>
          L’essai traverse le crédit privé, les valorisations internes, l’assurance, la
          tokenisation, les stablecoins, la gouvernance crypto, le dollar, le yen et la
          régulation. Son fil conducteur n’est pas l’annonce d’un krach. C’est l’examen des
          endroits où le prix affiché, la valeur économique, la liquidité et le risque cessent
          de raconter la même histoire.
        </p>
        <aside>
          <strong>Cadre de lecture</strong>
          <span>Une cartographie critique des mécanismes, pas un calendrier de marché.</span>
        </aside>
      </div>
    </section>

    <section class="visuals-section" aria-labelledby="visuals-title">
      <header class="section-heading">
        <div class="section-index" aria-hidden="true">02</div>
        <div>
          <p class="mono-label glow">carte de lecture</p>
          <h2 id="visuals-title">Treize chapitres, cinq angles d’audit.</h2>
          <p>Les deux cartes reprennent uniquement l’architecture et les thèmes annoncés dans le sommaire de l’ouvrage.</p>
        </div>
      </header>

      <div class="visual-grid">
        <figure class="visual-card">
          <svg class="reading-map" viewBox="0 0 840 620" role="img" aria-labelledby="parts-map-title parts-map-desc">
            <title id="parts-map-title">Les cinq parties d’Auditer l’Opacité</title>
            <desc id="parts-map-desc">Un parcours en cinq étapes, de la crise de la valeur à l’auditabilité des systèmes décentralisés.</desc>
            <defs>
              <linearGradient id="parts-line" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#5eead4" />
                <stop offset="0.55" stop-color="#ff4d87" />
                <stop offset="1" stop-color="#f5b13d" />
              </linearGradient>
            </defs>
            <rect x="1" y="1" width="838" height="618" rx="18" fill="#0c0d10" stroke="#343841" />
            <text x="52" y="58" class="svg-kicker">// ARCHITECTURE DE L’ESSAI</text>
            <path d="M92 126 C180 126 180 228 268 228 S356 330 444 330 S532 432 620 432 S680 518 748 518" fill="none" stroke="url(#parts-line)" stroke-width="3" />
            <g class="map-node">
              <circle cx="92" cy="126" r="19" fill="#0c0d10" stroke="#5eead4" stroke-width="3" />
              <circle cx="92" cy="126" r="6" fill="#5eead4" />
              <text x="128" y="118" class="svg-number">01</text>
              <text x="128" y="144" class="svg-label">Crises et valeur</text>
            </g>
            <g class="map-node">
              <circle cx="268" cy="228" r="19" fill="#0c0d10" stroke="#5eead4" stroke-width="3" />
              <circle cx="268" cy="228" r="6" fill="#5eead4" />
              <text x="304" y="220" class="svg-number">02</text>
              <text x="304" y="246" class="svg-label">Crédit et assurance</text>
            </g>
            <g class="map-node">
              <circle cx="444" cy="330" r="19" fill="#0c0d10" stroke="#ff4d87" stroke-width="3" />
              <circle cx="444" cy="330" r="6" fill="#ff4d87" />
              <text x="480" y="322" class="svg-number">03</text>
              <text x="480" y="348" class="svg-label">Passerelles crypto</text>
            </g>
            <g class="map-node">
              <circle cx="620" cy="432" r="19" fill="#0c0d10" stroke="#f5b13d" stroke-width="3" />
              <circle cx="620" cy="432" r="6" fill="#f5b13d" />
              <text x="656" y="424" class="svg-number">04</text>
              <text x="790" y="450" text-anchor="end" class="svg-label">Monnaies et régulation</text>
            </g>
            <g class="map-node map-node-last">
              <circle cx="748" cy="518" r="19" fill="#0c0d10" stroke="#f5b13d" stroke-width="3" />
              <circle cx="748" cy="518" r="6" fill="#f5b13d" />
              <text x="512" y="514" class="svg-number">05</text>
              <text x="512" y="540" class="svg-label">Décentralisation et audit</text>
            </g>
          </svg>
          <figcaption>Une progression du diagnostic vers les outils de contre-pouvoir.</figcaption>
        </figure>

        <figure class="visual-card">
          <svg class="channel-map" viewBox="0 0 840 620" role="img" aria-labelledby="channels-map-title channels-map-desc">
            <title id="channels-map-title">Les zones de transmission étudiées dans l’essai</title>
            <desc id="channels-map-desc">L’opacité est placée au centre de six domaines reliés : prix, crédit privé, assurance, cryptoactifs, monnaies et régulation.</desc>
            <rect x="1" y="1" width="838" height="618" rx="18" fill="#0c0d10" stroke="#343841" />
            <text x="52" y="58" class="svg-kicker">// POINTS DE PASSAGE ÉTUDIÉS</text>
            <g fill="none" stroke="#343841" stroke-width="2">
              <path d="M420 310 L420 126" />
              <path d="M420 310 L668 194" />
              <path d="M420 310 L668 426" />
              <path d="M420 310 L420 494" />
              <path d="M420 310 L172 426" />
              <path d="M420 310 L172 194" />
            </g>
            <circle cx="420" cy="310" r="74" fill="#121419" stroke="#ff4d87" stroke-width="3" />
            <circle cx="420" cy="310" r="91" fill="none" stroke="#ff4d87" stroke-opacity="0.22" />
            <text x="420" y="302" text-anchor="middle" class="svg-number">AUDIT</text>
            <text x="420" y="336" text-anchor="middle" class="svg-center">OPACITÉ</text>
            <g class="channel-node">
              <circle cx="420" cy="126" r="38" fill="#121419" stroke="#5eead4" stroke-width="2" />
              <text x="420" y="132" text-anchor="middle">PRIX</text>
              <circle cx="668" cy="194" r="51" fill="#121419" stroke="#5eead4" stroke-width="2" />
              <text x="668" y="188" text-anchor="middle">CRÉDIT</text>
              <text x="668" y="213" text-anchor="middle">PRIVÉ</text>
              <circle cx="668" cy="426" r="51" fill="#121419" stroke="#f5b13d" stroke-width="2" />
              <text x="668" y="432" text-anchor="middle">ASSURANCE</text>
              <circle cx="420" cy="494" r="51" fill="#121419" stroke="#f5b13d" stroke-width="2" />
              <text x="420" y="500" text-anchor="middle">MONNAIES</text>
              <circle cx="172" cy="426" r="51" fill="#121419" stroke="#ff4d87" stroke-width="2" />
              <text x="172" y="432" text-anchor="middle">CRYPTO</text>
              <circle cx="172" cy="194" r="51" fill="#121419" stroke="#5eead4" stroke-width="2" />
              <text x="172" y="200" text-anchor="middle">RÉGULATION</text>
            </g>
          </svg>
          <figcaption>Des domaines distincts, reliés par la liquidité, les garanties et la confiance.</figcaption>
        </figure>
      </div>
    </section>

    <section class="contents-section" id="sommaire">
      <header class="section-heading">
        <div class="section-index" aria-hidden="true">03</div>
        <div>
          <p class="mono-label glow">sommaire</p>
          <h2>Cinq parties pour suivre les connexions.</h2>
        </div>
      </header>

      <div class="parts-grid">
        {parts.map((part) => (
          <article class="part-card">
            <header>
              <span>Partie {part.number}</span>
              <h3>{part.title}</h3>
              <p>{part.summary}</p>
            </header>
            <ol>
              {part.chapters.map((chapter, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{chapter}</strong>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </section>

    <section class="edition-section">
      <div class="edition-panel">
        <div>
          <p class="mono-label glow">édition vérifiable</p>
          <h2>Un fichier lisible et contrôlable.</h2>
          <p>
            Cette édition EPUB 3 reprend le texte fourni par l’auteur, sa bibliographie et son
            lexique. La mise en page et la couverture ont été adaptées à la charte l0g. Le
            contenu éditorial reste attribué à Bluetouff et demeure protégé par son droit d’auteur.
          </p>
        </div>

        <dl class="file-card">
          <div><dt>Format</dt><dd>EPUB 3</dd></div>
          <div><dt>Langue</dt><dd>Français</dd></div>
          <div><dt>Révision</dt><dd>12 août 2026</dd></div>
          <div><dt>Taille</dt><dd>{epubSize}</dd></div>
          <div class="checksum"><dt>SHA-256</dt><dd>{epubSha256}</dd></div>
        </dl>
      </div>
    </section>

    <section class="final-download" data-pagefind-ignore>
      <div>
        <p class="mono-label glow">lecture complète</p>
        <h2>Lire les mécanismes avant de subir leur récit.</h2>
        <p>Téléchargement direct, sans formulaire. © 2026 Bluetouff.</p>
      </div>
      <a href={epubUrl} download="Auditer-l-opacite-Bluetouff.epub">
        Télécharger l’EPUB
        <span>{epubSize} · EPUB 3</span>
      </a>
    </section>
  </article>
</BaseLayout>

<style>
  .book-page { max-width: 72rem; margin: 0 auto; }
  .book-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(15rem, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6.5rem);
    min-height: 42rem;
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--color-line);
  }
  .book-hero::before {
    position: absolute;
    top: 0;
    right: 0;
    width: min(42rem, 70%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-signal), var(--color-accent));
    content: '';
  }
  .cover-stage { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; perspective: 1200px; }
  .cover-aura {
    position: absolute;
    inset: 18% -8% 8%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--color-signal) 24%, transparent), transparent 44%),
      radial-gradient(circle at 78% 74%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 48%);
    filter: blur(32px);
    opacity: 0.7;
  }
  .book-shell {
    position: relative;
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 19rem);
    width: min(100%, 20.2rem);
    filter: drop-shadow(0 32px 42px rgba(0, 0, 0, 0.45));
    transform: rotateY(-5deg) rotateZ(-0.7deg);
    transform-style: preserve-3d;
  }
  .book-shell::after {
    position: absolute;
    right: -0.35rem;
    bottom: 0.35rem;
    width: 0.5rem;
    height: calc(100% - 0.7rem);
    border-radius: 0 6px 6px 0;
    background: repeating-linear-gradient(0deg, #e4e0d8 0 1px, #b9b6af 1px 2px);
    content: '';
    transform: translateZ(-1px);
  }
  .book-spine {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-signal) 48%, var(--color-line));
    border-right: 0;
    border-radius: 8px 0 0 9px;
    padding: 0.9rem 0 0.75rem;
    background: #08090b;
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .book-shell img { display: block; width: 100%; height: auto; border: 1px solid var(--color-line-strong); border-radius: 0 9px 9px 0; background: #050608; }
  .cover-caption { position: relative; margin-top: 1.4rem; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .hero-copy { min-width: 0; }
  .hero-copy h1 {
    max-width: 12ch;
    margin: 0.45rem 0 0.8rem;
    color: var(--color-bright);
    font-family: var(--font-read);
    font-size: clamp(3rem, 7.2vw, 6.4rem);
    font-weight: 760;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }
  .hero-copy h1 span { display: block; color: var(--color-accent); font-weight: 610; }
  .hero-deck { max-width: 35rem; margin: 1.5rem 0 0; color: var(--color-signal); font-family: var(--font-read); font-size: clamp(1.25rem, 2.4vw, 1.8rem); font-weight: 590; letter-spacing: -0.025em; line-height: 1.25; }
  .hero-lede { max-width: 40rem; margin: 1.25rem 0 0; color: var(--color-prose); font-family: var(--font-read); font-size: 1.03rem; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.8rem; margin-top: 2rem; }
  .download-action,
  .contents-action { display: inline-flex; align-items: center; justify-content: center; min-height: 3.7rem; border-radius: 6px; transition: border-color 160ms ease, background 160ms ease, transform 160ms ease; }
  .download-action { flex-direction: column; align-items: flex-start; min-width: 13.5rem; padding: 0.72rem 1.15rem; color: var(--color-ink); background: var(--color-signal); }
  .download-action span { font-family: var(--font-mono); font-size: 0.82rem; font-weight: 800; letter-spacing: 0.045em; text-transform: uppercase; }
  .download-action small { margin-top: 0.15rem; font-size: 0.68rem; font-weight: 650; opacity: 0.76; }
  .contents-action { gap: 0.7rem; padding: 0 1.1rem; border: 1px solid var(--color-line-strong); color: var(--color-paper); font-family: var(--font-mono); font-size: 0.72rem; }
  .download-action:hover,
  .contents-action:hover { transform: translateY(-2px); }
  .contents-action:hover { border-color: var(--color-signal); background: color-mix(in srgb, var(--color-signal) 7%, transparent); }
  .proof-line { display: flex; flex-wrap: wrap; gap: 0.55rem 1.4rem; margin: 1.4rem 0 0; padding: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.055em; list-style: none; text-transform: uppercase; }
  .proof-line li { position: relative; }
  .proof-line li:not(:last-child)::after { position: absolute; right: -0.85rem; color: var(--color-accent); content: '·'; }
  .promise-section { display: grid; grid-template-columns: 4rem minmax(15rem, 0.85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 4rem); padding: clamp(4rem, 8vw, 7rem) 0; border-bottom: 1px solid var(--color-line); }
  .section-index { color: var(--color-line-strong); font-family: var(--font-mono); font-size: 2.5rem; font-weight: 800; line-height: 1; }
  .promise-heading h2,
  .section-heading h2,
  .edition-panel h2,
  .final-download h2 { margin: 0.55rem 0 0; color: var(--color-bright); font-family: var(--font-read); font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 650; letter-spacing: -0.045em; line-height: 1.04; }
  .promise-copy { color: var(--color-prose); font-family: var(--font-read); font-size: 1rem; line-height: 1.78; }
  .promise-copy p { margin: 0 0 1.2rem; }
  .promise-copy aside { display: grid; gap: 0.25rem; border-left: 3px solid var(--color-accent); padding: 0.8rem 1rem; background: color-mix(in srgb, var(--color-accent) 5%, transparent); }
  .promise-copy aside strong { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .promise-copy aside span { color: var(--color-paper); font-size: 0.86rem; }
  .visuals-section,
  .contents-section { padding: clamp(4rem, 8vw, 7rem) 0; border-bottom: 1px solid var(--color-line); }
