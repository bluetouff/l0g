---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PublicationSpotlight from '../../components/PublicationSpotlight.astro';
---

<BaseLayout
  title="Publications numériques"
  description="Les essais et enquêtes l0g réunis en éditions numériques gratuites, structurées et vérifiables."
  alternateLinks={[
    { hreflang: 'fr', href: 'https://l0g.fr/publications/' },
    { hreflang: 'en', href: 'https://l0g.fr/en/publications/' },
    { hreflang: 'x-default', href: 'https://l0g.fr/publications/' },
  ]}
  ogImage="/publications/cumcum-la-bataille-de-l-impot-og-v1.jpg"
  ogImageAlt="Cum-cum : la bataille de l’impôt. Six analyses l0g, leurs sources et vingt-six infographies, en EPUB gratuit."
>
  <div class="publication-intro">
    <PageHero
      index="06"
      kicker="éditions l0g"
      title="Les enquêtes l0g"
      description="Les publications numériques réunissent essais et séries d’articles dans un ordre de lecture continu, avec leurs sources, leurs limites et leurs documents associés."
      glyph="read"
      accent="var(--color-amber)"
      stats={[
        { value: 17, label: 'éditions disponibles' },
        { value: 120, label: 'chapitres et enquêtes' },
        { value: 17, label: 'EPUB gratuits' },
      ]}
    >
      <Fragment slot="title">
        Les enquêtes <span class="publication-wordmark brand-mark"><span class="text-paper">l</span><span class="brand-0 text-signal">0</span><span class="text-paper">g</span><span class="brand-cursor text-accent" aria-hidden="true">_</span></span>
      </Fragment>
    </PageHero>
  </div>

  <section class="publication-list" aria-labelledby="publication-list-title">
    <p class="mono-label">// catalogue</p>
    <h2 id="publication-list-title">Éditions disponibles</h2>
    <div class="publication-grid">
      <PublicationSpotlight publication="cumcum" />
      <PublicationSpotlight publication="insurance-promise" />
      <PublicationSpotlight publication="cyber-recovery" />
      <PublicationSpotlight publication="debt-chain" />
      <PublicationSpotlight publication="microsoft" />
      <PublicationSpotlight publication="reserves" />
      <PublicationSpotlight publication="ai-slowdown" />
      <PublicationSpotlight publication="ia-recouvrement" />
      <PublicationSpotlight publication="commerce-traces" />
      <PublicationSpotlight publication="scpi" />
      <PublicationSpotlight publication="oil-trading" />
      <PublicationSpotlight publication="digital-identity" />
      <PublicationSpotlight publication="e-invoicing" />
      <PublicationSpotlight publication="water-electricity" />
      <PublicationSpotlight publication="digital-euro" />
      <PublicationSpotlight />
      <PublicationSpotlight publication="auditer-opacite" />
    </div>
  </section>
</BaseLayout>

<style>
  .publication-intro { --page-title-size: clamp(1.25rem, 6.5vw, 2.6rem); }
  .publication-wordmark { font-size: 1em; vertical-align: baseline; }
  .publication-list { margin-top: 2.8rem; }
  .publication-list > .mono-label { color: var(--color-amber); }
  .publication-list > h2 {
    margin: 0.35rem 0 1rem;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: var(--section-title-size);
    line-height: 1.25;
  }
  .publication-grid { display: grid; gap: 1.25rem; }
</style>
