---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PublicationSpotlight from '../../components/PublicationSpotlight.astro';
import AnalysisPagination from '../../components/AnalysisPagination.astro';
import { publicationPage, publicationPageHref } from '../../config/publication-catalog.mjs';

interface Props { currentPage?: number }
const page = publicationPage('fr', Astro.props.currentPage ?? 1);
const isFirst = page.currentPage === 1;
---

<BaseLayout
  title={isFirst ? 'Publications numériques' : `Publications numériques, page ${page.currentPage}`}
  description={isFirst
    ? 'Les essais et enquêtes l0g réunis en éditions numériques gratuites, structurées et vérifiables.'
    : `Catalogue des publications numériques l0g, page ${page.currentPage} sur ${page.totalPages}. Essais et enquêtes gratuits en EPUB, avec leurs sources et références.`}
  alternateLinks={isFirst ? [
    { hreflang: 'fr', href: 'https://l0g.fr/publications/' },
    { hreflang: 'en', href: 'https://l0g.fr/en/publications/' },
    { hreflang: 'x-default', href: 'https://l0g.fr/publications/' },
  ] : []}
  ogImage="/publications/la-guerre-des-machines-ordinaires-og-v1.jpg"
  ogImageAlt="La guerre des machines ordinaires. Sept analyses l0g, leurs sources et trente-trois infographies, en EPUB gratuit."
>
  <div class="publication-intro">
    <PageHero
      index="06"
      kicker="éditions l0g"
      title="Les enquêtes l0g"
      description="Les publications numériques réunissent essais et séries d’articles dans un ordre de lecture continu, avec leurs sources, leurs limites et leurs documents associés."
      glyph="read"
      accent="var(--color-amber)"
      stats={[
        { value: page.total, label: 'éditions disponibles' },
        { value: 127, label: 'chapitres et enquêtes' },
        { value: page.total, label: 'EPUB gratuits' },
      ]}
    >
      <Fragment slot="title">
        Les enquêtes <span class="publication-wordmark brand-mark"><span class="text-paper">l</span><span class="brand-0 text-signal">0</span><span class="text-paper">g</span><span class="brand-cursor text-accent" aria-hidden="true">_</span></span>
      </Fragment>
    </PageHero>
  </div>

  <section class="publication-list" aria-labelledby="publication-list-title">
    <p class="mono-label">// catalogue</p>
    <h2 id="publication-list-title">Éditions disponibles</h2>
    <p class="publication-range">Publications {page.start} à {page.end} sur {page.total} · Page {page.currentPage} sur {page.totalPages}</p>
    <div class="publication-grid">
      {page.items.map((item) => <PublicationSpotlight publication={item.id} />)}
    </div>
    <AnalysisPagination
      currentPage={page.currentPage}
      totalPages={page.totalPages}
      pageHref={(number) => publicationPageHref('fr', number)}
      ariaLabel="Pagination des publications"
      previousLabel="Précédent"
      nextLabel="Suivant"
    />
  </section>
</BaseLayout>

<style>
  .publication-intro { --page-title-size: clamp(1.25rem, 6.5vw, 2.6rem); }
  .publication-wordmark { font-size: 1em; vertical-align: baseline; }
  .publication-list { margin-top: 2.8rem; }
  .publication-list > .mono-label { color: var(--color-amber); }
  .publication-list > h2 {
    margin: 0.35rem 0 1rem;
    color: var(--color-bright);
    font-family: var(--font-display);
    font-size: var(--section-title-size);
    line-height: 1.25;
  }
  .publication-grid { display: grid; gap: 1.25rem; }
  .publication-range { margin: -0.25rem 0 1.5rem; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.7; }
</style>
