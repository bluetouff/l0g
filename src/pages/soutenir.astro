---
import BaseLayout from '../layouts/BaseLayout.astro';
import SupportExperience from '../components/SupportExperience.astro';
import { serializeInlineScriptData } from '../lib/security.ts';

const title = 'Soutenir l0g';
const description =
  "Contribuer ponctuellement ou chaque mois au financement de l'infrastructure, des données et des analyses publiques de l0g, sans contrepartie ni influence éditoriale.";
const alternateLinks = [
  { hreflang: 'fr', href: 'https://l0g.fr/soutenir/' },
  { hreflang: 'en', href: 'https://l0g.fr/en/support/' },
  { hreflang: 'x-default', href: 'https://l0g.fr/soutenir/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://l0g.fr/soutenir/#page',
  url: 'https://l0g.fr/soutenir/',
  name: title,
  description,
  inLanguage: 'fr',
  isAccessibleForFree: true,
  publisher: { '@id': 'https://l0g.fr/#org' },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImageAlt="Soutenir l0g : contributions volontaires ponctuelles ou mensuelles"
  alternateLinks={alternateLinks}
  sidebar={false}
>
  <script type="application/ld+json" is:inline set:html={serializeInlineScriptData(jsonLd)} />

  <article data-pagefind-body>
    <SupportExperience lang="fr" />
  </article>
</BaseLayout>
