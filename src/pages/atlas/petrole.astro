---
import { atlasAlternateLinks } from '../../config/atlases';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngagementAtlas from '../../components/EngagementAtlas.astro';
import dataset from '../../data/oil-financing-atlas.json';
const latestDate = dataset.milestones.at(-1)!.date;
---

<BaseLayout
  title={dataset.title}
  seoTitle="Atlas du financement du pétrole : banques et négoce | l0g"
  description="Qui finance le commerce du pétrole ? Explorez les liens entre banques, Trafigura, Glencore et le Tchad : cargaisons, crédits et recettes publiques."
  ogImage="/illustrations/news/oil-trade-bank-finance-v1.jpg"
  ogImageAlt="Les banques et le financement du commerce pétrolier"
  alternateLinks={atlasAlternateLinks(dataset.id)} sidebar={false}
>
  <EngagementAtlas
    dataset={dataset}
    subject="financement du pétrole"
    intro="Qui paie le vendeur, qui avance l’argent et qui reçoit les recettes ? Suivez une cargaison, le financement d’un négociant, un prêt pétrolier au Tchad et le financement de la flotte Volare."
    boundary="Quatre cas documentés, à des périodes différentes. Les flèches représentent la relation décrite dans chaque fiche, pas toujours un versement. Volare est coté depuis le 5 octobre et annonce un exercice partiel de l’option d’émission le 13. Les garanties de construction, les locations de navires, l’achat d’actions et les crédits d’entreprise de Trafigura restent distincts. Les deux rôles de Glencore restent séparés : acheteur et créancier."
    selectedRelation="investors-volare"
    hubs={['unicredit', 'trafigura', 'escrow']}
    entryPoints={[
      { label: 'Où en est le financement de Volare ?', relation: 'investors-volare', date: latestDate },
      { label: 'Comment les navires exploités sont-ils financés ?', relation: 'bocomm-volare-leasebacks', date: '2026-10-05' },
      { label: 'Quels engagements de construction Trafigura garantit-il ?', relation: 'trafigura-volare-construction-guarantees', date: '2026-10-05' },
      { label: 'Comment fonctionne l’option d’émission ?', relation: 'volare-clarksons-option', date: latestDate },
      { label: 'Quel financement reste à compléter ?', relation: 'volare-fleet-programme', date: '2026-10-05' },
      { label: 'Qui paie la cargaison ?', relation: 'unicredit-bp-payment', date: '2023-05-04' },
      { label: 'Que refinance Trafigura en octobre ?', relation: 'usd-cnh-trafigura-credit', date: '2026-10-01' },
      { label: 'Que reçoit le Trésor tchadien ?', relation: 'escrow-treasury-balance', date: '2025-12-30' },
    ]}
    outlinks={[
      { href: '/posts/les-banquiers-du-baril-1-financement-cargaison-petrole/', label: 'Le paiement d’une cargaison' },
      { href: '/posts/les-banquiers-du-baril-2-banques-financement-trafigura/', label: 'Les banques derrière Trafigura' },
      { href: '/posts/les-banquiers-du-baril-3-tchad-glencore-dette-petrole/', label: 'Le pétrole tchadien et la dette' },
      { href: '/api/v1/oil-financing-atlas.json', label: 'Réutiliser les relations et leurs sources · JSON' },
    ]}
  >
    <section slot="overview" class="oil-overview" aria-labelledby="oil-circuits-title">
      <p><strong>Revue ciblée du <time datetime="2026-10-21">21 octobre 2026</time>.</strong> Ajout des garanties de Trafigura aux chantiers à partir du <a href="https://mb.cision.com/Public/24324/4404303/ad59eaca69c8f1aa.pdf">document d’admission du 5 octobre, section 6.8</a>. Le montant indiqué regroupe des engagements garantis ou à garantir ; il ne mesure pas un versement. Le besoin de liquidité de la section 6.6 reste une prévision à la date du document, sans confirmation de sa couverture par cette revue. Le <a href="https://www.volareshipping.com/news/">registre Volare</a> consulté conserve le <a href="https://www.volareshipping.com/news/volare-shipping-ltd-stabilisation-notice/">13 octobre</a> comme dernière publication. Les pages <a href="https://www.trafigura.com/news-and-insights/">actualités</a> et <a href="https://www.trafigura.com/finance/funding/">financement de Trafigura</a> examinées n’ajoutent pas de pièce sur les crédits représentés. Le cas tchadien conserve sa période documentaire, fondée sur le <a href="https://eiti.org/documents/chad-2023-eiti-report">rapport ITIE 2023</a>.</p>
      <details>
        <summary id="oil-circuits-title">Quatre circuits pour lire le financement</summary>
        <ol>
          <li><h3>La cargaison</h3><p>Repérez le vendeur, l’emprunteur, le paiement effectué et le remboursement prévu.</p></li>
          <li><h3>Le négociant</h3><p>Distinguez l’organisation du crédit, sa disponibilité et l’argent effectivement emprunté.</p></li>
          <li><h3>Le pays producteur</h3><p>Suivez l’affectation des recettes avant leur arrivée au budget.</p></li>
          <li><h3>La flotte</h3><p>Distinguez actionnaire, gestionnaire commercial, capitaux recherchés et navires en commande.</p></li>
        </ol>
        <p>UniCredit Bank est citée sous la forme AG dans l’affaire du Sienna et GmbH dans le financement de Trafigura. Son <a href="https://www.hypovereinsbank.de/content/dam/hypovereinsbank/ueber-uns/pdf/investor-relations/Berichte/EN/2023/20240311-Geschaeftsbericht-UCB-GmbH-2023-ENGLISCH.pdf">rapport annuel 2023, page 14</a>, documente le changement de forme juridique. Sa présence dans deux dossiers n’établit aucun financement entre leurs autres participants.</p>
        <p>Les dates ci-dessous sont celles des publications. Chaque fiche précise la période des opérations et donne accès à l’enquête correspondante.</p>
      </details>
    </section>
  </EngagementAtlas>
</BaseLayout>

<style>
  .oil-overview { margin:1rem 0 2rem; }
  .oil-overview details { padding:1rem; border:1px solid var(--color-line); border-radius:8px; }
  .oil-overview summary { cursor:pointer; min-height:32px; color:var(--color-bright); font-family:var(--font-display); font-size:.95rem; }
  .oil-overview ol { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; list-style:none; padding:0; margin:1.2rem 0; }
  .oil-overview li { padding:1rem; border:1px solid var(--color-line); border-radius:8px; background:var(--color-surface); }
  .oil-overview h3 { margin:0 0 .6rem; color:var(--color-bright); font-size:.95rem; }
  .oil-overview p { max-width:85ch; margin:.7rem 0; font-family:var(--font-read); font-size:.85rem; line-height:1.7; }
  .oil-overview a { color:var(--color-signal); text-decoration:underline; text-underline-offset:3px; }
  .oil-overview :is(a,summary):focus-visible { outline:2px solid var(--color-signal); outline-offset:4px; }
  @media(max-width:760px) { .oil-overview ol { grid-template-columns:minmax(0,1fr); } }
</style>
