---
import { atlasAlternateLinks } from '../../config/atlases';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngagementAtlas from '../../components/EngagementAtlas.astro';
import FrenchRelatedReading from '../../components/FrenchRelatedReading.astro';
import dataset from '../../data/engagement-atlas.json';
---

<BaseLayout title={dataset.title} seoTitle="Atlas du financement de l’IA : Nvidia, OpenAI | l0g" description="Nvidia, OpenAI, SB Energy, AIP et Nebius : explorez les acteurs, les contrats et les garanties du financement de l’intelligence artificielle." ogImage="/illustrations/news/openai-credit-guarantee-v1.jpg" alternateLinks={atlasAlternateLinks(dataset.id)} sidebar={false}>
  <EngagementAtlas
    dataset={dataset}
    subject="financement de l’IA"
    intro="Nvidia, OpenAI, SB Energy, AIP et Nebius : qui finance les infrastructures de l’intelligence artificielle, qui garantit quoi et sous quelles conditions ? Explorez les relations documentées et leur évolution au fil des publications."
    boundary="Le prospectus du 21 septembre distingue le préfinancement reçu via Energy Global, LP de l’achat d’actions encore conditionnel. SE Global Holdings, Inc. y est renommée SB Energy, Inc. ; le nœud conserve son nom contractuel pour les lectures historiques. Ces opérations restent distinctes des garanties du campus. Aucun financement d’AIP vers ce campus n’est établi ici."
    selectedRelation="citi-nebius-facility"
    hubs={['nvidia', 'aip']}
    entryPoints={[
      { label: 'Comment Citi finance-t-il les GPU de Nebius ?', relation: 'citi-nebius-facility', date: '2026-10-22' },
      { label: 'Quel argent Nvidia a-t-elle déjà versé ?', relation: 'nvidia-energy-global-prepayment', date: '2026-09-21' },
      { label: 'Qu’a acquis le consortium AIP, MGX et GIP ?', relation: 'consortium-aligned-acquisition', date: '2026-07-21' },
      { label: 'Comment Aligned se finance-t-elle par titrisation ?', relation: 'investors-aligned-abs', date: '2026-07-28' },
      { label: 'Qui paie si OpenAI ne paie plus ?', relation: 'nvidia-sb-guarantee', date: dataset.milestones.at(-1)!.date, scenario: true },
      { label: 'Comment le rôle de Nvidia évolue-t-il ?', relation: 'nvidia-aip', date: '2025-03-19' },
    ]}
    outlinks={[
      { href: '/posts/nebius-citi-credit-364-jours-gpu/', label: 'Le crédit de 364 jours de Nebius' },
      { href: '/posts/nvidia-500-milliards-qui-n-existent-pas-encore/#suivi-septembre-2026', label: 'Lire l’enquête et son suivi' },
      { href: '/api/v1/engagement-atlas.json', label: 'Réutiliser les relations et leurs sources · JSON' },
      { href: '/radar/', label: 'Explorer les transmissions macroéconomiques' },
    ]}
  >
    <section slot="overview" class="ia-review" aria-labelledby="ia-review-title">
      <h2 id="ia-review-title">Ajouts vérifiés le <time datetime="2026-10-28">28 octobre 2026</time></h2>
      <p>Le <a href="https://www.sec.gov/Archives/edgar/data/1513845/000110465926117978/tm2628078d1_6k.htm">6-K de Nebius publié le 22 octobre</a> ajoute un crédit garanti de 3,5 milliards de dollars avec Citi. Les trois coemprunteurs sont regroupés ; le principal contractuel ne prouve pas un tirage intégral. Le prêt arrive à échéance le 16 octobre 2027.</p>
      <p>Ce circuit bancaire est distinct des garanties Nvidia–SB Energy, du préfinancement et des opérations d’Aligned. Ces dossiers conservent leurs observations et dates de revue antérieures. L’ajout ne constitue pas une actualisation générale de tous les contrats.</p>
    </section>
  </EngagementAtlas>
  <FrenchRelatedReading id="ai-financing" collection="atlas" />
</BaseLayout>

<style>
  .ia-review { margin:1rem 0 2rem; padding:1rem 1.2rem; border:1px solid var(--color-line); border-left:3px solid var(--color-signal); border-radius:8px; background:var(--color-surface); }
  .ia-review h2 { margin:0 0 .7rem; color:var(--color-bright); font-family:var(--font-display); font-size:1rem; }
  .ia-review p { max-width:90ch; margin:.7rem 0; font-family:var(--font-read); font-size:.85rem; line-height:1.7; }
  .ia-review a { color:var(--color-signal); text-decoration:underline; text-underline-offset:3px; }
  .ia-review a:focus-visible { outline:2px solid var(--color-signal); outline-offset:4px; }
</style>
