---
import { atlasAlternateLinks } from '../../config/atlases';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EngagementAtlas from '../../components/EngagementAtlas.astro';
import FrenchRelatedReading from '../../components/FrenchRelatedReading.astro';
import dataset from '../../data/engagement-atlas.json';
---

<BaseLayout title={dataset.title} seoTitle="Atlas du financement de l’IA : Nvidia, Shanghai et garanties | l0g" description="Explorez les financements de Nvidia, Anthropic et OpenAI, puis les garanties sur serveurs rapportées à Shanghai. Chaque relation conserve ses sources et ses limites." ogImage="/illustrations/news/ai-financing-dossier-v1.jpg" alternateLinks={atlasAlternateLinks(dataset.id)} sidebar={false}>
  <EngagementAtlas
    dataset={dataset}
    subject="financement de l’IA"
    intro="Un fournisseur peut vendre des puces, financer son client et garantir la valeur des équipements. Suivez ces rôles chez Nvidia, Anthropic, Google et Broadcom, puis les circuits d’OpenAI, SB Energy, Aligned, Nebius et SpaceX. À Shanghai, un circuit séparé représente les garanties sur serveurs rapportées par Bloomberg."
    boundary="Souscriptions en actions, achats de calcul et garanties sont des obligations différentes. Plusieurs montants peuvent couvrir des étapes d’un même circuit et ne s’additionnent pas. Chaque relation conserve sa date de publication et ses conditions. Le préfinancement de SB Energy reste distinct des garanties du campus, sans financement d’AIP déduit. À Shanghai, la valeur déclarée du matériel est en CNY. Le principal des prêts reste à établir."
    selectedRelation="shanghai-collateral-registrations"
    hubs={['nvidia', 'anthropic', 'aip', 'shanghai-longjie-yaoteng']}
    entryPoints={[
      { label: 'Shanghai : les serveurs déclarés en garantie', relation: 'shanghai-collateral-registrations', date: '2026-11-13' },
      { label: 'Nvidia : souscription proposée à Anthropic', relation: 'nvidia-anthropic-equity', date: '2026-11-10' },
      { label: 'Google : capital et achats cloud', relation: 'google-anthropic-equity', date: '2026-11-10' },
      { label: 'Broadcom finance les loyers', relation: 'broadcom-anthropic-rent-facility', date: '2026-11-02' },
      { label: 'Broadcom soutient le bailleur', relation: 'broadcom-spv-residual-support', date: '2026-10-26' },
      { label: 'SpaceX : le crédit-bail GPU', relation: 'gpu-lessor-spacex', date: '2026-10-26' },
      { label: 'Citi : le crédit de Nebius', relation: 'citi-nebius-facility', date: '2026-10-22' },
      { label: 'OpenAI : explorer un défaut hypothétique', relation: 'nvidia-sb-guarantee', date: dataset.milestones.at(-1)!.date, scenario: true },
      { label: 'AIP et l’acquisition d’Aligned', relation: 'consortium-aligned-acquisition', date: '2026-07-21' },
    ]}
    outlinks={[
      { href: '/dossiers/financement-ia/', label: 'Toutes les enquêtes du dossier Financement de l’IA' },
      { href: '/posts/nvidia-shanghai-serveurs-garantie-lutnick-bessent/', label: 'Nvidia VIII : les serveurs de Shanghai et la bataille de Washington' },
      { href: '/posts/anthropic-financement-fournisseurs-ipo/', label: 'Anthropic : les fournisseurs financent leur client' },
      { href: '/posts/nvidia-garanties-financement-ia-enquetes-asie/', label: 'Nvidia : garanties financières et enquêtes en Asie' },
      { href: '/atlas/credit-prive/', label: 'Apollo, Athene et les circuits du crédit privé' },
      { href: '/posts/nebius-citi-credit-364-jours-gpu/', label: 'Le crédit de 364 jours de Nebius' },
      { href: '/posts/nvidia-500-milliards-qui-n-existent-pas-encore/#suivi-septembre-2026', label: 'Lire l’enquête et son suivi' },
      { href: '/api/v1/engagement-atlas.json', label: 'Réutiliser les relations et leurs sources · JSON' },
      { href: '/radar/', label: 'Explorer les transmissions macroéconomiques' },
    ]}
  >
    <section slot="overview" class="ia-review" aria-labelledby="ia-review-title">
      <p class="ia-review-date">Revue du <time datetime="2026-11-13">13 novembre 2026</time></p>
      <div class="ia-review-grid">
        <div>
          <h2 id="ia-review-title">Shanghai : des machines déclarées en garantie</h2>
          <p>Une <a href="https://ba.bloombergadria.com/tehnologija/ai/117069/kompanija-povezana-s-alice-huang-nabavljala-zabranjene-nvidia-cipove-u-kini/news">enquête Bloomberg publiée le 13 novembre</a>, détaillée par <a href="https://www.taisounds.com/news/content/84/309645">TaiSounds</a>, décrit 193 serveurs donnés en garantie en janvier 2025 par Shanghai Longjie Yaoteng. La valeur déclarée des équipements atteint 485 millions de yuans.</p>
          <p>TaiSounds évoque deux prêts. La carte regroupe ces garanties rapportées, avec des créanciers à identifier et un montant emprunté à établir. Le <a href="https://fgw.sh.gov.cn/cmsres/00/00ed174f4ac74c55abec30d9b33b44fb/20235839cd48ee3784ef54b789d67706.pdf">règlement du registre</a> précise le rôle des déclarants et du créancier. Le dépôt individuel reste à obtenir.</p>
        </div>
        <div>
          <h2>Washington : le contrôle des exportations sous pression</h2>
          <p>Sur <a href="https://www.cnbc.com/2026/11/13/us-inflation-outlook-federal-reserve-rate-hike.html">CNBC, le 13 novembre</a>, Scott Bessent affirme que plusieurs administrations favorisaient des restrictions visant Megaspeed et renvoie les questions au Commerce. Le Trésor place ainsi publiquement le département de Howard Lutnick devant ses arbitrages.</p>
          <p>Le <a href="https://www.ecfr.gov/current/title-15/subtitle-B/chapter-VII/subchapter-C/part-744/appendix-Supplement%20No.%205%20to%20Part%20744">comité chargé des inscriptions à l’Entity List est présidé par le Commerce</a>. Ce contexte politique est développé dans le <a href="/posts/nvidia-shanghai-serveurs-garantie-lutnick-bessent/">volet VIII</a>. Les flèches de la carte restent consacrées aux relations financières et aux garanties.</p>
        </div>
      </div>
      <details class="ia-previous"><summary>Nvidia et Anthropic : les repères précédents</summary>
      <div class="ia-review-grid">
        <div>
          <h2>Nvidia change de direction</h2>
          <p>Le <a href="https://nvidianews.nvidia.com/news/nvidia-announces-ceo-transition">12 novembre, Nvidia annonce la démission immédiate de Jensen Huang</a> de ses fonctions de président, directeur général et administrateur. Colette Kress assure la direction par intérim. Le conseil affirme vouloir maintenir les engagements clients.</p>
          <p>La carte suit les obligations des sociétés à partir de leurs documents. L’effet de cette transition sur les nouveaux investissements reste à observer.</p>
        </div>
        <div>
          <h2>Les fournisseurs financent leur client</h2>
          <p>Le <a href="https://www.sec.gov/Archives/edgar/data/2130357/000162828026072484/anthropicpbc-sx1ax2.htm">prospectus d’Anthropic du 10 novembre</a> ajoute les souscriptions proposées de Nvidia, Google, Microsoft et Broadcom. Les achats cloud figurent sur des relations séparées : même partenaire, obligations différentes.</p>
          <p>Le <a href="https://www.sec.gov/Archives/edgar/data/2130357/000162828026068676/exhibit44-sx1a1.htm">contrat Broadcom déposé le 2 novembre</a> permet aussi de financer certains loyers en émettant une dette convertible. Le plafond de cette facilité et le financement du matériel couvrent des objets distincts.</p>
        </div>
      </div>
      </details>
      <details class="ia-previous"><summary>Ajouts du 31 octobre : SpaceX et les autres circuits</summary>
      <p>Le <a href="https://www.sec.gov/Archives/edgar/data/1181412/000110465926118614/tm2628247d1_8k.htm">8-K de SpaceX du 26 octobre</a> documente un engagement de crédit-bail GPU avec un véhicule géré par Apollo. Les quelque 40 milliards de dollars désignent le principal attendu sur les locations. La réalisation reste conditionnelle et les premières locations sont prévues au premier semestre 2027.</p>
      <p>Le <a href="https://www.apollo.com/insights-news/pressreleases/2026/10/spacex-secures--40-billion-in-the-largest-gpu-financing-ever">communiqué publié par Apollo</a> précise les financeurs annoncés, sans donner leurs parts. Aucun apport d’AIP ou d’Athene n’est déduit. Les garanties Nvidia–SB Energy, le préfinancement, Aligned et le prêt Citi–Nebius conservent leurs observations antérieures. Le <a href="https://data.sec.gov/submissions/CIK0002133037.json">registre SEC de SB Energy</a> consulté le 31 octobre ne présente aucun dépôt postérieur au S-1/A du 21 septembre ; ce contrôle ne confirme pas la réalisation de l’introduction.</p>
      </details>
    </section>
  </EngagementAtlas>
  <FrenchRelatedReading id="ai-financing" collection="atlas" />
</BaseLayout>

<style>
  .ia-review { margin:1rem 0 2rem; padding:1rem 1.2rem; border:1px solid var(--color-line); border-left:3px solid var(--color-signal); border-radius:8px; background:var(--color-surface); }
  .ia-review h2 { margin:0 0 .7rem; color:var(--color-bright); font-family:var(--font-display); font-size:1rem; }
  .ia-review p { max-width:90ch; margin:.7rem 0; font-family:var(--font-read); font-size:.85rem; line-height:1.7; }
  .ia-review a { color:var(--color-signal); text-decoration:underline; text-underline-offset:3px; }
  .ia-review a:focus-visible { outline:2px solid var(--color-signal); outline-offset:4px; }
  .ia-review-date { color:var(--color-signal); font:400 .72rem/1.5 var(--font-mono) !important; }
  .ia-review-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.6rem; margin-top:1rem; }
  .ia-previous { border-top:1px solid var(--color-line); margin-top:1.2rem; padding-top:.7rem; }
  .ia-previous summary { cursor:pointer; color:var(--color-muted); font:400 .78rem/1.6 var(--font-read); min-height:44px; padding-block:.5rem; }
  @media (max-width:700px) { .ia-review-grid { grid-template-columns:1fr; gap:1rem; } }
</style>
